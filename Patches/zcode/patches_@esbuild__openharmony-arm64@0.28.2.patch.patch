diff --git a/patches/@esbuild__openharmony-arm64@0.28.2.patch b/patches/@esbuild__openharmony-arm64@0.28.2.patch
new file mode 100644
index 00000000..db8dc996
--- /dev/null
+++ b/patches/@esbuild__openharmony-arm64@0.28.2.patch
