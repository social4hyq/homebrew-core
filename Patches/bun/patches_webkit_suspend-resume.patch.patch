diff --git a/patches/webkit/suspend-resume.patch b/patches/webkit/suspend-resume.patch
new file mode 100644
index 0000000000..71af38b930
--- /dev/null
+++ b/patches/webkit/suspend-resume.patch
@@ -0,0 +1,145 @@
+diff --git a/Source/WTF/wtf/Threading.h b/Source/WTF/wtf/Threading.h
+index 4e582e5..78a1b25 100644
+--- a/Source/WTF/wtf/Threading.h
++++ b/Source/WTF/wtf/Threading.h
+@@ -420,6 +420,10 @@ protected:
+ #endif
+     PlatformRegisters* m_platformRegisters { nullptr };
+     unsigned m_suspendCount { 0 };
++#if defined(__OHOS__)
++    // Handshake state for suspend/resume; the signal is only a wake-up hint.
++    std::atomic<bool> m_suspendRequested { false };
++#endif
+ #endif
+ 
+ #if OS(WINDOWS)
+diff --git a/Source/WTF/wtf/posix/ThreadingPOSIX.cpp b/Source/WTF/wtf/posix/ThreadingPOSIX.cpp
+index ab02cf3..7d3ec25 100644
+--- a/Source/WTF/wtf/posix/ThreadingPOSIX.cpp
++++ b/Source/WTF/wtf/posix/ThreadingPOSIX.cpp
+@@ -118,6 +118,26 @@ public:
+         while (sem_wait(&m_platformSemaphore) == -1 && errno == EINTR) { }
+     }
+ 
++#if defined(__OHOS__)
++    // Bounded wait: returns false on timeout so the suspender can resend the
++    // signal instead of waiting forever for a wake-up that never comes.
++    bool waitFor(double relativeSeconds)
++    {
++        struct timespec deadline;
++        clock_gettime(CLOCK_REALTIME, &deadline);
++        time_t wholeSeconds = static_cast<time_t>(relativeSeconds);
++        deadline.tv_sec += wholeSeconds;
++        deadline.tv_nsec += static_cast<long>((relativeSeconds - wholeSeconds) * 1e9);
++        if (deadline.tv_nsec >= 1000000000L) {
++            deadline.tv_sec += 1;
++            deadline.tv_nsec -= 1000000000L;
++        }
++        int rc;
++        while ((rc = sem_timedwait(&m_platformSemaphore, &deadline)) == -1 && errno == EINTR) { }
++        return rc == 0;
++    }
++#endif
++
+     void post()
+     {
+         sem_post(&m_platformSemaphore);
+@@ -135,6 +155,13 @@ void Thread::signalHandlerSuspendResume(int, siginfo_t*, void* ucontext)
+     // Touching a global variable atomic types from signal handlers is allowed.
+     Thread* thread = targetThread.load();
+ 
++#if defined(__OHOS__)
++    // Ignore stray or late signals (e.g. a resume signal delivered after the
++    // handshake completed) and signals that reach a thread other than the
++    // current suspend target.
++    if (!thread->m_suspendRequested.load(std::memory_order_acquire) || !pthread_equal(thread->m_handle, pthread_self()))
++        return;
++#else
+     if (thread->m_suspendCount) {
+         // This is signal handler invocation that is intended to be used to resume sigsuspend.
+         // So this handler invocation itself should not process.
+@@ -144,6 +171,7 @@ void Thread::signalHandlerSuspendResume(int, siginfo_t*, void* ucontext)
+         // http://pubs.opengroup.org/onlinepubs/009695399/functions/sigsuspend.html
+         return;
+     }
++#endif
+ 
+     void* approximateStackPointer = currentStackPointer();
+     if (!thread->m_stack.contains(approximateStackPointer)) {
+@@ -175,12 +203,26 @@ void Thread::signalHandlerSuspendResume(int, siginfo_t*, void* ucontext)
+     // http://pubs.opengroup.org/onlinepubs/9699919799/basedefs/V1_chap04.html#tag_04_11
+     globalSemaphoreForSuspendResume->post();
+ 
++#if defined(__OHOS__)
++    // Wait for release by polling m_suspendRequested through a bounded
++    // sigtimedwait. On OHOS (HongMeng kernel) sigsuspend can fail to return after
++    // its wake-up signal was handled when the process is stopped and continued,
++    // which would leave this thread and the suspender's global locks stuck for
++    // good; sigtimedwait is woken reliably.
++    sigset_t waitSet;
++    sigemptyset(&waitSet);
++    sigaddset(&waitSet, g_wtfConfig.sigThreadSuspendResume);
++    const timespec wakeInterval { 0, 100 * 1000 * 1000 };
++    while (thread->m_suspendRequested.load(std::memory_order_acquire))
++        sigtimedwait(&waitSet, nullptr, &wakeInterval);
++#else
+     // Reaching here, sigThreadSuspendResume is blocked in this handler (this is configured by sigaction's sa_mask).
+     // So before calling sigsuspend, sigThreadSuspendResume to this thread is deferred. This ensures that the handler is not executed recursively.
+     sigset_t blockedSignalSet;
+     sigfillset(&blockedSignalSet);
+     sigdelset(&blockedSignalSet, g_wtfConfig.sigThreadSuspendResume);
+     sigsuspend(&blockedSignalSet);
++#endif
+ 
+     thread->m_platformRegisters = nullptr;
+ 
+@@ -607,18 +649,36 @@ auto Thread::suspend(const ThreadSuspendLocker&) -> std::expected<void, Platform
+ #else
+     if (!m_suspendCount) {
+         targetThread.store(this);
++#if defined(__OHOS__)
++        m_suspendRequested.store(true, std::memory_order_release);
++#endif
+ 
+         while (true) {
+             // We must use pthread_kill to avoid queue-overflow problem with real-time signals.
+             int result = pthread_kill(m_handle, g_wtfConfig.sigThreadSuspendResume);
+-            if (result)
++            if (result) {
++#if defined(__OHOS__)
++                m_suspendRequested.store(false, std::memory_order_release);
++#endif
+                 return makeUnexpected(result);
++            }
++#if defined(__OHOS__)
++            // Bounded wait so a lost wake-up leads to a resend instead of an
++            // unbounded wait while holding global locks.
++            globalSemaphoreForSuspendResume->waitFor(0.1);
++            if (m_platformRegisters)
++                break;
++            // Because of an alternative signal stack we failed to suspend this
++            // thread, or a wake-up was lost. Retry suspension after yielding.
++            Thread::yield();
++#else
+             globalSemaphoreForSuspendResume->wait();
+             if (m_platformRegisters)
+                 break;
+             // Because of an alternative signal stack, we failed to suspend this thread.
+             // Retry suspension again after yielding.
+             Thread::yield();
++#endif
+         }
+     }
+     ++m_suspendCount;
+@@ -641,6 +701,11 @@ void Thread::resume(const ThreadSuspendLocker&)
+         // In this implementaiton, we take (3). m_suspendCount is used to distinguish it.
+         // Note that we must use pthread_kill to avoid queue-overflow problem with real-time signals.
+         targetThread.store(this);
++#if defined(__OHOS__)
++        // Clear the flag before signaling: the handler's wait loop exits on the
++        // flag alone, so the handshake completes even if this signal is lost.
++        m_suspendRequested.store(false, std::memory_order_release);
++#endif
+         if (pthread_kill(m_handle, g_wtfConfig.sigThreadSuspendResume) == ESRCH)
+             return;
+         globalSemaphoreForSuspendResume->wait();
