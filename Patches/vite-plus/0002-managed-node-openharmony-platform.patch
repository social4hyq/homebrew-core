From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: social4hyq <social4hyq@users.noreply.github.com>
Date: Wed, 30 Sep 2026 22:30:00 +0800
Subject: [PATCH] OHOS: managed-Node platform string.
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

platform_string() maps Os::Linux to "linux" and only appends a suffix for
target_env=musl. OpenHarmony reports target_os="linux" with
target_env="ohos", so it fell through to "linux-arm64" -- a name the OHOS
Node.js mirror does not publish, making every managed-runtime download a
404. It serves "node-v<version>-openharmony-<arch>" instead, so name that
explicitly.

The mirror is otherwise usable: its binaries are OpenHarmony musl builds
(INTERP /lib/ld-musl-aarch64.so.1, NEEDED libc++_shared.so + libc.so) that
run unsigned, and archive_format, binary_relative_path and SHASUMS256.txt
all match what it serves.
---
 crates/vp_js_runtime/src/providers/node.rs | 33 +++++++++++++++-----
 1 file changed, 32 insertions(+), 1 deletion(-)

--- a/crates/vp_js_runtime/src/providers/node.rs
+++ b/crates/vp_js_runtime/src/providers/node.rs
@@ -610,6 +610,12 @@
         if platform.os == Os::Linux {
             return vt_str::format!("{os}-{arch}-musl");
         }
+        // OpenHarmony ships Node.js as "node-v<version>-openharmony-<arch>";
+        // there is no "linux-arm64" build to fall back to.
+        #[cfg(target_env = "ohos")]
+        if platform.os == Os::Linux {
+            return vt_str::format!("openharmony-{arch}");
+        }
         vt_str::format!("{os}-{arch}")
     }
 
@@ -719,6 +725,15 @@
             (Platform { os: Os::Windows, arch: Arch::X64 }, "win-x64"),
             (Platform { os: Os::Windows, arch: Arch::Arm64 }, "win-arm64"),
         ];
+        #[cfg(target_env = "ohos")]
+        let cases = [
+            (Platform { os: Os::Linux, arch: Arch::X64 }, "openharmony-x64"),
+            (Platform { os: Os::Linux, arch: Arch::Arm64 }, "openharmony-arm64"),
+            (Platform { os: Os::Darwin, arch: Arch::X64 }, "darwin-x64"),
+            (Platform { os: Os::Darwin, arch: Arch::Arm64 }, "darwin-arm64"),
+            (Platform { os: Os::Windows, arch: Arch::X64 }, "win-x64"),
+            (Platform { os: Os::Windows, arch: Arch::Arm64 }, "win-arm64"),
+        ];
 
         for (platform, expected) in cases {
             assert_eq!(provider.platform_string(platform), expected);
@@ -737,7 +752,7 @@
                 provider.get_download_info("22.13.1", platform)
             });
 
-        #[cfg(not(target_env = "musl"))]
+        #[cfg(all(not(target_env = "musl"), not(target_env = "ohos")))]
         {
             assert_eq!(info.archive_filename, "node-v22.13.1-linux-x64.tar.gz");
             assert_eq!(
@@ -754,6 +769,22 @@
                 panic!("Expected ShasumsFile verification");
             }
         }
+        #[cfg(target_env = "ohos")]
+        {
+            assert_eq!(info.archive_filename, "node-v22.13.1-openharmony-x64.tar.gz");
+            assert_eq!(
+                info.archive_url,
+                "https://nodejs.org/dist/v22.13.1/node-v22.13.1-openharmony-x64.tar.gz"
+            );
+            assert_eq!(info.extracted_dir_name, "node-v22.13.1-openharmony-x64");
+            if let HashVerification::ShasumsFile { url, signature } = &info.hash_verification {
+                assert_eq!(url, "https://nodejs.org/dist/v22.13.1/SHASUMS256.txt");
+                let signature = signature.as_ref().expect("official builds are signature-verified");
+                assert!(signature.required, "official builds must require signature verification");
+            } else {
+                panic!("Expected ShasumsFile verification");
+            }
+        }
         #[cfg(target_env = "musl")]
         {
             assert_eq!(info.archive_filename, "node-v22.13.1-linux-x64-musl.tar.gz");
