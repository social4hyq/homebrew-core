diff --git a/cmake/RustStaticLibrary.cmake b/cmake/RustStaticLibrary.cmake
--- a/cmake/RustStaticLibrary.cmake
+++ b/cmake/RustStaticLibrary.cmake
@@ -118,6 +118,12 @@
         endif()
