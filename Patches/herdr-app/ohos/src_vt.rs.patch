+unsafe extern "C" fn on_clipboard_read(_t: GhosttyTerminal, userdata: *mut c_void, request: *const GhosttyClipboardRead) {
+    let shared = unsafe { &*(userdata as *const Shared) };
+    let request = unsafe { &*request };
+    if request.size < std::mem::size_of::<GhosttyClipboardRead>() {
+        return;
+    }
+    let Some(reply_fn) = request.reply else { return };
+    if shared.clipboard_read.is_empty() {
+        let reply = GhosttyClipboardReadReply {
+            size: std::mem::size_of::<GhosttyClipboardReadReply>(),
+            result: GHOSTTY_CLIPBOARD_READ_RESULT_DENIED,
+            contents: std::ptr::null(),
+            contents_len: 0,
+            available: std::ptr::null(),
+            available_len: 0,
+            remember: false,
+        };
+        unsafe { reply_fn(request, &reply) };
+        return;
+    }
+    // Return every staged representation; ghostty filters to what the program
+    // requested (and OSC52 takes the first text/plain entry).
+    let mut contents: Vec<GhosttyClipboardContent> = Vec::new();
+    for (mime, data) in &shared.clipboard_read {
+        contents.push(GhosttyClipboardContent {
+            mime: GhosttyString { ptr: mime.as_ptr(), len: mime.len() },
+            data: GhosttyString { ptr: data.as_ptr(), len: data.len() },
+        });
+    }
+    let result = if contents.is_empty() { GHOSTTY_CLIPBOARD_READ_RESULT_UNSUPPORTED } else { GHOSTTY_CLIPBOARD_READ_RESULT_SUCCESS };
+    let reply = GhosttyClipboardReadReply {
+        size: std::mem::size_of::<GhosttyClipboardReadReply>(),
+        result,
+        contents: if contents.is_empty() { std::ptr::null() } else { contents.as_ptr() },
+        contents_len: contents.len(),
+        available: std::ptr::null(),
+        available_len: 0,
+        remember: false,
+    };
+    unsafe { reply_fn(request, &reply) };
+}
