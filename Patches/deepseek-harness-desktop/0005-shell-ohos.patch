diff --git a/apps/desktop/src/ohos-bridge-channel.ts b/apps/desktop/src/ohos-bridge-channel.ts
new file mode 100644
index 00000000..5f0f1081
--- /dev/null
+++ b/apps/desktop/src/ohos-bridge-channel.ts
@@ -0,0 +1,93 @@
+/**
+ * OHOS bridge-backed Host channel: the desktop Host runs on the host side
+ * (outside the HAP sandbox), relayed by dsh-desktop-bridge over loopback TCP.
+ * This class emulates the narrow ChildProcess surface that DesktopHostProcess
+ * consumes (see host-process.ts): send/on('message')/once('close','error')/
+ * kill/connected/exitCode/signalCode. stderr/stdout stay undefined — Host
+ * output lives in the bridge log on the host side.
+ *
+ * Activated when DSH_DESKTOP_BRIDGE_PORT is set; otherwise upstream spawn is
+ * used unchanged. Wire-in lives in host-process.ts (one call-site branch).
+ */
+
+import net from 'node:net'
+import { EventEmitter } from 'node:events'
+
+export class DesktopBridgeHostChannel {
+  private readonly socket: net.Socket
+  private readonly emitter = new EventEmitter()
+  private buffer = ''
+  /** Mirrors ChildProcess.connected: true while the channel can send. */
+  connected = false
+  exitCode: number | null = null
+  signalCode: NodeJS.Signals | null = null
+  readonly stderr = undefined
+  readonly stdout = undefined
+  /** Set when the local end initiated shutdown and the socket closed cleanly. */
+  private stopping = false
+
+  constructor(port: number) {
+    this.socket = net.createConnection(port, '127.0.0.1')
+    this.socket.on('connect', () => { this.connected = true })
+    this.socket.on('data', (chunk) => {
+      this.buffer += chunk.toString('utf8')
+      for (;;) {
+        const nl = this.buffer.indexOf('\n')
+        if (nl < 0) break
+        const line = this.buffer.slice(0, nl)
+        this.buffer = this.buffer.slice(nl + 1)
+        if (line.trim() === '') continue
+        try {
+          this.emitter.emit('message', JSON.parse(line))
+        } catch {
+          // 半截行/坏 JSON 不产生消息；协议错误由对端超时路径兜底。
+        }
+      }
+    })
+    this.socket.on('error', (error) => { this.emitter.emit('error', error) })
+    this.socket.on('close', () => {
+      this.connected = false
+      if (this.exitCode === null && this.signalCode === null) {
+        // 主动停机后的干净关闭按 exit 0 上报；意外断开按 null（上游据此报错）。
+        this.exitCode = this.stopping ? 0 : null
+      }
+      this.emitter.emit('close', this.exitCode, this.signalCode)
+    })
+  }
+
+  on(event: 'message', listener: (message: unknown) => void): this
+  on(event: string, listener: (...args: never[]) => void): this {
+    this.emitter.on(event, listener as (...args: unknown[]) => void)
+    return this
+  }
+
+  once(event: 'close', listener: (code: number | null, signal: NodeJS.Signals | null) => void): this
+  once(event: 'error', listener: (error: Error) => void): this
+  once(event: string, listener: (...args: never[]) => void): this {
+    this.emitter.once(event, listener as (...args: unknown[]) => void)
+    return this
+  }
+
+  send(message: unknown, callback?: (error: Error | null) => void): boolean {
+    if (!this.connected || this.socket.destroyed) {
+      const error = new Error('dsh desktop bridge channel is closed')
+      if (callback !== undefined) queueMicrotask(() => callback(error))
+      else this.emitter.emit('error', error)
+      return false
+    }
+    // 协议级 shutdown 之后的干净关闭按 exit 0 上报（对齐上游 stop() 语义）。
+    if ((message as { type?: unknown })?.type === 'shutdown') this.stopping = true
+    return this.socket.write(JSON.stringify(message) + '\n', () => callback?.(null))
+  }
+
+  kill(signal: NodeJS.Signals | number = 'SIGTERM'): boolean {
+    this.stopping = true
+    const sig = typeof signal === 'number' ? 'SIGTERM' : signal
+    // bridge 本地处理 bridge-* 消息；Host 不在时也无害。
+    if (this.connected && !this.socket.destroyed) {
+      this.socket.write(JSON.stringify({ type: 'bridge-kill', signal: sig }) + '\n')
+    }
+    this.socket.end()
+    return true
+  }
+}
