+static int mq_host_supported(void)
+{
+	struct utsname host;
+	if (uname(&host) < 0 || !strcmp(host.sysname, "HarmonyOS")) {
+		errno = ENOSYS;
+		return 0;
+	}
+	return 1;
+}
