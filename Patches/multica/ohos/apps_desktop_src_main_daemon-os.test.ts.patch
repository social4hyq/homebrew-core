+  // OpenHarmony: the daemon is the host's own native process, even though
+  // Node and Go spell the OS differently. Flagging it hides the start/stop/
+  // restart controls and disables crash recovery.
+  it("does NOT flag a native OpenHarmony daemon (GOOS linux) under an OpenHarmony desktop", () => {
+    expect(
+      isDaemonExternallyManaged("linux", normalizeHostOS("openharmony")),
+    ).toBe(false);
+  });
+
+  it("still flags a genuinely foreign daemon under an OpenHarmony desktop", () => {
+    expect(
