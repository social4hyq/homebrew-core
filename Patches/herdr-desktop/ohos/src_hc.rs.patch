+    /// Connects to a core bridge: a host-side proxy that owns `hc connect` and
+    /// forwards its stdio over TCP. The OHOS sandbox cannot spawn the host binary.
+    ///
+    /// The bridge only answers a connection that opens with `HERDR-AUTH <token>`; the token comes from
+    /// `bridge_auth` (the file `herdr-app install` baked into the HAP, or `HERDR_CORE_TOKEN`).
+    pub fn connect_bridge(endpoint: &str) -> Result<Arc<Core>> {
+        use crate::bridge_auth::{self, Reply};
+        let stream = std::net::TcpStream::connect(endpoint)
+            .with_context(|| format!("cannot reach the core bridge at {endpoint}"))?;
+        stream.set_nodelay(true).ok();
+        // Whatever listens on that port may not be a bridge: no step of the handshake waits forever.
+        stream.set_read_timeout(Some(std::time::Duration::from_secs(10))).ok();
+        let mut reader = BufReader::new(stream.try_clone()?);
+        let mut stdin = stream;
+        if let Some(token) = bridge_auth::token(&crate::mods::app_dir()) {
+            stdin.write_all(bridge_auth::auth_line(&token).as_bytes())?;
+            stdin.flush()?;
+            let mut reply = String::new();
+            reader.read_line(&mut reply).context("the core bridge did not answer the token")?;
+            match bridge_auth::classify(&reply) {
+                Reply::Accepted => {}
+                other => bail!("{}", bridge_auth::explain(&other)),
+            }
+        }
+        stdin.write_all(b"{\"jsonrpc\":\"2.0\",\"id\":0,\"method\":\"hello\",\"params\":{\"framed\":true}}\n")?;
+        stdin.flush()?;
+        let mut line = String::new();
+        reader.read_line(&mut line).context("the core bridge did not answer hello")?;
+        if line.trim() == "DENIED" {
+            // No token was sent, and this bridge wants one.
+            bail!("{}", bridge_auth::explain(&Reply::Refused));
+        }
+        let hello: Value = serde_json::from_str(&line).context("bad hello reply from core bridge")?;
+        if let Some(err) = hello.get("error") {
+            bail!("core refused hello: {err}");
+        }
+        stdin.set_read_timeout(None).ok();
+        Self::finish_connect(hello, reader, stdin, None)
+    }
