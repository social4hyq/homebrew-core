+/** Caption buttons for the windows that have no title bar of their own
+ * (OpenHarmony): the renderer drives the window it lives in, so the main
+ * window and a detached one share the handlers. */
+function registerWindowControlsIpc(): void {
+  app.on('browser-window-created', (_event, win) => {
+    const send = (): void => {
+      if (win.isDestroyed()) return
+      win.webContents.send(WINDOW_CHANNELS.maximizedChanged, win.isMaximized())
+    }
+    win.on('maximize', send)
+    win.on('unmaximize', send)
+  })
+  ipcMain.handle(
+    WINDOW_CHANNELS.isMaximized,
+    (event) => BrowserWindow.fromWebContents(event.sender)?.isMaximized() ?? false,
+  )
+  ipcMain.handle(WINDOW_CHANNELS.control, (event, action: unknown) => {
+    const win = BrowserWindow.fromWebContents(event.sender)
+    if (!win || win.isDestroyed()) return false
+    if (action === 'minimize') win.minimize()
+    else if (action === 'close') win.close()
+    else if (action === 'toggle-maximize') {
+      if (win.isMaximized()) win.unmaximize()
+      else win.maximize()
+    } else {
+      return false
+    }
+    return win.isMaximized()
+  })
+}
