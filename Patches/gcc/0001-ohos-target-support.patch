diff -Naur a/gcc/config/aarch64/aarch64-ohos.h b/gcc/config/aarch64/aarch64-ohos.h
--- a/gcc/config/aarch64/aarch64-ohos.h	1970-01-01 00:00:00.000000000 +0000
+++ b/gcc/config/aarch64/aarch64-ohos.h	2026-09-16 12:05:33.448374604 +0000
@@ -0,0 +1,47 @@
+/* Definitions for AArch64 running OpenHarmony (OHOS).
+
+   The AArch64 ABI itself (LP64, asynchronous unwind tables, the musl dynamic
+   linker) comes from aarch64-linux.h via DEFAULT_LIBC == LIBC_MUSL.  What is
+   left for this file is where the sysroot keeps the architecture's headers
+   and start files, the platform's predefined macros, and the one linker flag
+   OHOS needs.  */
+
+#ifndef GCC_AARCH64_OHOS_H
+#define GCC_AARCH64_OHOS_H
+
+/* OpenHarmony's sysroot keeps the architecture-specific files in a
+   Debian-style multiarch directory named after the target triple: asm/ and
+   bits/ (including the <bits/alltypes.h> that <stdint.h> and friends
+   include) live in usr/include/aarch64-linux-ohos, the libc and the crt*.o
+   start files in usr/lib/aarch64-linux-ohos.  Point the driver at both, the
+   way the platform's own clang driver does.  */
+#define OHOS_ARCH_DIR "aarch64-linux-ohos"
+
+#undef CPP_SPEC
+#define CPP_SPEC "%{pthread:-D_REENTRANT} %{!nostdinc:-isystem %R/usr/include/" OHOS_ARCH_DIR "}"
+
+/* The sysroot ships only stub libraries of the device's libc, and those stubs
+   do not export every symbol the real libraries do (rindex, used by libgm2's
+   libm2pim, for example).  GNU ld refuses undefined references from shared
+   libraries when it links an executable, which those stubs trip over; the
+   platform's own clang + ld.lld allows them, so ask GNU ld for the same.  */
+#undef LINK_SPEC
+#define LINK_SPEC LINUX_TARGET_LINK_SPEC AARCH64_ERRATA_LINK_SPEC \
+  "%{!static:--allow-shlib-undefined}"
+
+#undef STANDARD_STARTFILE_PREFIX_1
+#define STANDARD_STARTFILE_PREFIX_1 "/lib/" OHOS_ARCH_DIR "/"
+
+#undef STANDARD_STARTFILE_PREFIX_2
+#define STANDARD_STARTFILE_PREFIX_2 "/usr/lib/" OHOS_ARCH_DIR "/"
+
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()		\
+  do						\
+    {						\
+      GNU_USER_TARGET_OS_CPP_BUILTINS();	\
+      OHOS_TARGET_OS_CPP_BUILTINS();		\
+    }						\
+  while (0)
+
+#endif /* GCC_AARCH64_OHOS_H */
diff -Naur a/gcc/config/ohos.h b/gcc/config/ohos.h
--- a/gcc/config/ohos.h	1970-01-01 00:00:00.000000000 +0000
+++ b/gcc/config/ohos.h
@@ -0,0 +1,22 @@
+/* Definitions for OpenHarmony (OHOS) systems using the Linux kernel.
+
+   OpenHarmony is a Linux-based system that uses musl libc.  config.gcc sets
+   DEFAULT_LIBC to LIBC_MUSL for *-*-*ohos* targets, so linux.h selects the
+   musl dynamic linker (/lib/ld-musl-<cpu>.so.1, defined per architecture)
+   and the musl include directory layout.  There is therefore nothing
+   OHOS-specific to say about the C library itself; this file only adds the
+   predefined macros the platform's own toolchain defines.  */
+
+#ifndef GCC_OHOS_H
+#define GCC_OHOS_H
+
+#define OHOS_TARGET_OS_CPP_BUILTINS()		\
+  do						\
+    {						\
+      builtin_define ("__OHOS__");		\
+      builtin_define ("__OHOS_FAMILY__");	\
+      builtin_assert ("system=ohos");		\
+    }						\
+  while (0)
+
+#endif /* GCC_OHOS_H */
diff -Naur a/gcc/config/t-ohos b/gcc/config/t-ohos
--- a/gcc/config/t-ohos	1970-01-01 00:00:00.000000000 +0000
+++ b/gcc/config/t-ohos	2026-09-16 12:05:29.190348047 +0000
@@ -0,0 +1,5 @@
+# OpenHarmony (OHOS) uses the linux-ohos triplet, so the multiarch directory
+# is aarch64-linux-ohos rather than the aarch64-linux-gnu that
+# t-aarch64-linux sets.
+MULTIARCH_DIRNAME := $(subst -linux-gnu,-linux-ohos,$(MULTIARCH_DIRNAME))
+MULTILIB_OSDIRNAMES := $(subst -linux-gnu,-linux-ohos,$(MULTILIB_OSDIRNAMES))
