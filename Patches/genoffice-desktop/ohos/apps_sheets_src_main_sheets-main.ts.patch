OHOS: save a workbook into the app's temp dir when the picked path is refused.
The dialog grants this app access to the picked file only, and the xlsx
sidecar's File::create on that path fails with EPERM ("Operation not permitted
(os error 1)"), so Save As to a picked folder failed while the main process can
write the same file in place. Retry in the app's temp directory and copy the
bytes over the picked file. Gated on OpenHarmony and on that error only.

diff --git a/apps/sheets/src/main/sheets-main.ts b/apps/sheets/src/main/sheets-main.ts
index 4680f7c..d1428d0 100644
--- a/apps/sheets/src/main/sheets-main.ts
+++ b/apps/sheets/src/main/sheets-main.ts
@@ -4737,6 +4737,16 @@ export function resolveSheetsSessionPath(senderId: number, sessionId: string): s
   return sheetsTabs.get(senderId)?.sessions.get(sessionId)?.path ?? null
 }
 
+/// True only for the save the picked-file sandbox refused on OpenHarmony: the
+/// sidecar reports the refused File::create as an io error that carries no
+/// errno, so the message is the only signal. Other platforms keep failing the
+/// save as before.
+function pickedPathRefusesSidecar(error: unknown): boolean {
+  if ((process.platform as string) !== 'openharmony') return false
+  const message = error instanceof Error ? error.message : String(error)
+  return message.includes('Operation not permitted (os error 1)') || message.includes('EPERM')
+}
