+#endif
 #if SNOW_SHOT_ENABLE_TEXT_TRANSLATION
     {
         .id = u"translation",
@@ -5330,6 +5336,7 @@
     globalShortcuts.pageId = QString::fromLatin1(GLOBAL_SHORTCUTS_PAGE_ID);
     globalShortcuts.iconFactory = []() { return outlined_icons::Thunderbolt(); };
 
