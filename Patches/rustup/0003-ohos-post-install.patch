+// Post-process a freshly installed/updated toolchain:
+//   * `cargo` links libssl/libz that are not present; add an rpath pointing at
+//     the Homebrew-provided openssl@3 / zlib-ng-compat libraries (patchelf);
+//   * wrap `cargo` so `SSL_CERT_FILE` resolves to the provided cert.pem;
+//   * self-sign every unsigned ELF executable / shared object with the
+//     vendored selfsign implementation (src/dist/selfsign.rs).
+//
+// Skipped when `RUSTUP_OHOS_RPATH` is unset (i.e. when not run through the
+// Homebrew wrapper script), so non-Homebrew builds are unaffected.
+fn ohos_post_install_toolchain(prefix: &InstallPrefix) {
+    let rpath = match env::var("RUSTUP_OHOS_RPATH") {
+        Ok(v) if !v.is_empty() => v,
+        _ => {
+            warn!("ohos-post-install: RUSTUP_OHOS_RPATH not set, skipping post-processing");
+            return;
+        }
+    };
+    let cert_file = env::var("SSL_CERT_FILE").unwrap_or_default();
+
+    let bin_dir = prefix.path().join("bin");
+    let cargo = bin_dir.join("cargo");
+    let cargo_real = bin_dir.join("cargo.real");
+
+    // 1) point cargo at the Homebrew-provided openssl/zlib libraries, but only
+    // when it is still an ELF: on a later pass cargo is already the wrapper
+    // script (patchelf would reject it). Then 2) wrap it with the
+    // SSL_CERT_FILE script.
+    if cargo.exists() && is_elf_signed_target(&cargo) {
+        match std::process::Command::new("patchelf")
+            .args(["--add-rpath", &rpath])
+            .arg(&cargo)
+            .status()
+        {
+            Ok(s) if s.success() => {
+                info!("ohos-post-install: patchelf rpath -> {}", cargo.display())
+            }
+            _ => warn!("ohos-post-install: patchelf failed for {}", cargo.display()),
+        }
+
+        // 2) wrap cargo so SSL_CERT_FILE resolves to the provided CA bundle
+        if !cargo_real.exists() {
+            if std::fs::rename(&cargo, &cargo_real).is_ok() {
+                let wrapper = format!(
+                    "#!/bin/sh\nexport SSL_CERT_FILE=\"${{SSL_CERT_FILE:-{cert_file}}}\"\nexec \"{}\" \"$@\"\n",
+                    cargo_real.display()
+                );
+                if std::fs::write(&cargo, wrapper).is_ok() {
+                    use std::os::unix::fs::PermissionsExt;
+                    let _ = std::fs::set_permissions(
+                        &cargo,
+                        std::fs::Permissions::from_mode(0o755),
+                    );
+                    info!("ohos-post-install: wrapped cargo -> {}", cargo_real.display());
+                }
+            }
+        }
+    }
+
+    // 3) self-sign every unsigned ELF executable / shared object
+    let mut stack = vec![prefix.path().to_path_buf()];
+    while let Some(dir) = stack.pop() {
+        let entries = match std::fs::read_dir(&dir) {
+            Ok(e) => e,
+            Err(_) => continue,
+        };
+        for entry in entries.flatten() {
+            let path = entry.path();
+            if path.is_dir() {
+                stack.push(path);
+            } else if is_elf_signed_target(&path) && !is_signed_elf(&path) {
+                info!("ohos-post-install: signing {}", path.display());
+                if let Err(err) = selfsign::sign_file_atomic(&path.to_string_lossy(), false) {
+                    warn!(
+                        "ohos-post-install: signing failed for {}: {}",
+                        path.display(),
+                        err
+                    );
+                }
+            }
+        }
+    }
+}
+
+fn is_elf_signed_target(path: &Path) -> bool {
+    use std::io::Read;
+    let Ok(mut f) = std::fs::File::open(path) else {
+        return false;
+    };
+    let mut buf = [0u8; 18];
+    if f.read_exact(&mut buf).is_err() {
+        return false;
+    }
+    if &buf[0..4] != b"\x7fELF" {
+        return false;
+    }
+    // e_type at offset 16, little-endian: 2 = ET_EXEC, 3 = ET_DYN
+    // (ET_REL (1, .o files) is skipped: signing would corrupt it)
+    let e_type = u16::from_le_bytes([buf[16], buf[17]]);
+    matches!(e_type, 2 | 3)
+}
+
+fn is_signed_elf(path: &Path) -> bool {
+    use std::io::Read;
+    let Ok(mut f) = std::fs::File::open(path) else {
+        return false;
+    };
+    let mut buf = Vec::new();
+    if f.read_to_end(&mut buf).is_err() {
+        return false;
+    }
+    selfsign::has_codesign_section(&buf)
+}
+
