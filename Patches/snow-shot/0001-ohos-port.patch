+class OhosWindowMonitor final : public live_window_detail::NativeWindowMonitor {
+  public:
+    explicit OhosWindowMonitor(LiveWindowTarget target) : m_target(std::move(target)) {}
+
+    bool initialize(QString* error) override {
+        const auto current = inspect();
+        if (current.state == LiveWindowState::Live)
+            return true;
+        if (error)
+            *error = current.error.isEmpty()
+                         ? QStringLiteral("The selected window is no longer available")
+                         : current.error;
+        return false;
+    }
+
+    live_window_detail::NativeState inspect() override {
+        const auto windowId = static_cast<int32_t>(m_target.nativeId);
+        const auto lookup = windowLookup(windowId);
+        if (lookup == ohos_live_window_detail::WindowLookupState::Unavailable)
+            return {ohos_live_window_detail::stateForWindowLookup(lookup), {}, {}};
+        if (lookup == ohos_live_window_detail::WindowLookupState::Hidden)
+            return {LiveWindowState::Closed, {}, {}};
+        QRect bounds;
+        if (!windowBounds(windowId, &bounds))
+            return {LiveWindowState::Unavailable,
+                    {},
+                    QStringLiteral("The window content is temporarily unavailable. Retrying…")};
+        return {LiveWindowState::Live, bounds, {}};
+    }
+
+  private:
+    LiveWindowTarget m_target;
+};
