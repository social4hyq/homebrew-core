+#if defined(Q_OS_HARMONY)
+namespace {
+QMutex g_latestClipboardPngMutex;
+QByteArray g_latestClipboardPng;
+std::uint32_t g_latestClipboardChangeCount = 0;
+quint64 g_latestClipboardPublishSerial = 0;
+
+std::uint32_t pasteboardChangeCount() {
+    auto* pasteboard = OH_Pasteboard_Create();
+    if (pasteboard == nullptr)
+        return 0;
+    const auto count = OH_Pasteboard_GetChangeCount(pasteboard);
+    OH_Pasteboard_Destroy(pasteboard);
+    return count;
+}
+} // namespace
+
+std::optional<QByteArray> latestPublishedClipboardPng() {
+    QMutexLocker locker(&g_latestClipboardPngMutex);
+    if (g_latestClipboardPng.isEmpty())
+        return std::nullopt;
+    const auto currentCount = pasteboardChangeCount();
+    // Do not serve stale content after another process changed the clipboard.
+    if (currentCount != g_latestClipboardChangeCount) {
+        qWarning("SNOW_CLIP_CACHE stale current=%u recorded=%u", currentCount,
+                 g_latestClipboardChangeCount);
+        return std::nullopt;
+    }
+    qWarning("SNOW_CLIP_CACHE hit count=%u bytes=%d", currentCount,
+             static_cast<int>(g_latestClipboardPng.size()));
+    return g_latestClipboardPng;
+}
+#endif
+
