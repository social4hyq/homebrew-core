diff --git a/vendor/gpui-ohos/tests/renderer/Cargo.toml b/vendor/gpui-ohos/tests/renderer/Cargo.toml
new file mode 100644
index 0000000..18e7e3d
--- /dev/null
+++ b/vendor/gpui-ohos/tests/renderer/Cargo.toml
@@ -0,0 +1,34 @@
+[package]
+name = "gpui-ohos-renderer-tests"
+version = "0.0.0"
+edition = "2021"
+publish = false
+
+# Host-only harness: compile production renderer modules without OHOS N-API.
+[workspace]
+
+[features]
+default = ["fast", "vulkan"]
+fast = []
+gles = ["wgpu/gles"]
+vulkan = ["wgpu/vulkan"]
+
+[dependencies]
+anyhow = "1"
+bytemuck = "1"
+etagere = "0.2"
+gpui = { package = "gpui-fast", version = "=0.1.13", default-features = false, features = ["test-support"] }
+itertools = "0.14"
+log = "0.4"
+parking_lot = "0.12"
+profiling = "1"
+raw-window-handle = "0.6"
+rustc-hash = "2"
+smol = "2"
+wgpu = { version = "=30.0.1", default-features = false, features = ["std", "metal", "wgsl"] }
+
+[profile.dev]
+debug = 0
+
+[profile.test]
+debug = 0
diff --git a/vendor/gpui-ohos/tests/renderer/README.md b/vendor/gpui-ohos/tests/renderer/README.md
new file mode 100644
index 0000000..739c201
--- /dev/null
+++ b/vendor/gpui-ohos/tests/renderer/README.md
@@ -0,0 +1,13 @@
+# Host renderer tests
+
+Run `cargo test --manifest-path tests/renderer/Cargo.toml` on a host with a
+Metal or Vulkan GPU. This separate, unpublished harness compiles production
+OHOS rendering modules directly; it avoids linking OHOS N-API on the host.
+The Fast core is the unmodified official 0.1.13 release.
+
+The pixel fixtures are adapted from gpui-fast-wgpu 0.1.13 and use its Apache
+license and notices in `src/ohos/fast/`. GPU tests compare tile output with
+direct drawing and exercise actual GPUI rounded-overflow scenes, including
+paths and clips within tiles. Pure cache tests cover dirty generations and
+memory-budget eviction. OHOS cross-compilation and device tests remain
+necessary to validate GLES and native surfaces.
