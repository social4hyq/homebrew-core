+    #[test]
+    fn late_post_callback_for_a_release_cannot_claim_the_next_press() {
+        // Fast typing: "n" up is still unanswered when "o" down arrives; the IME
+        // then declines "n" up late and types "o". "o" down must stay consumed by
+        // the IME, or the app inserts it a second time.
+        let queue = InputQueue::default();
+        let owner = queue.activate("main").unwrap();
+        let (n_down, n_up, o_down, o_up) =
+            ((2030, true), (2030, false), (2031, true), (2031, false));
+        queue.push_key(&owner, n_down, "n down").unwrap();
+        queue.ime_edit(&owner).unwrap();
+        queue.push_key(&owner, n_up, "n up").unwrap();
+        queue.push_key(&owner, o_down, "o down").unwrap();
+        queue.after_ime(&owner, n_up).unwrap();
+        queue.ime_edit(&owner).unwrap();
+        queue.push_key(&owner, o_up, "o up").unwrap();
+        queue.after_ime(&owner, o_up).unwrap();
+        assert_eq!(
+            input(queue.pop().unwrap()),
+            ("main".into(), "n down", Some(true))
+        );
+        assert_eq!(
+            input(queue.pop().unwrap()),
+            ("main".into(), "n up", Some(true))
+        );
+        assert_eq!(
+            input(queue.pop().unwrap()),
+            ("main".into(), "o down", Some(true))
+        );
+        assert_eq!(
+            input(queue.pop().unwrap()),
+            ("main".into(), "o up", Some(false))
+        );
+        assert!(queue.pop().unwrap().is_none());
+    }
+
+    #[test]
+    fn late_edit_does_not_consume_the_release_that_followed() {
+        let queue = InputQueue::default();
+        let owner = queue.activate("main").unwrap();
+        queue.push_key(&owner, (2017, true), "a down").unwrap();
+        queue.push_key(&owner, (2017, false), "a up").unwrap();
+        queue.ime_edit(&owner).unwrap();
+        queue.after_ime(&owner, (2017, false)).unwrap();
+        assert_eq!(input(queue.pop().unwrap()).2, Some(true));
+        assert_eq!(input(queue.pop().unwrap()).2, Some(false));
+    }
