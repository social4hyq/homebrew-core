+// === T35 diagnostic (DNM): per-heap live/free census over all libpas heaps ===
+#include "pas_all_heaps.h"
+#include "pas_heap.h"
+#include "pas_heap_lock.h"
+#include "pas_heap_summary.h"
+
+#include <stdio.h>
+
+static bool t35CensusCallback(pas_heap* heap, void*)
+{
+    pas_heap_summary summary = pas_heap_compute_summary(heap, pas_lock_is_held);
+    fprintf(stderr, "T35HEAP type=%p objsize=%zu allocated=%zu free=%zu committed=%zu meta=%zu\n",
+            static_cast<const void*>(heap->type), pas_heap_get_type_size(heap),
+            summary.allocated, summary.free, summary.committed, summary.meta);
+    return true;
+}
+
+extern "C" void bmallocDumpHeapCensusT35()
+{
+    // pas_all_heaps_for_each_heap asserts pas_heap_lock held.
+    pas_heap_lock_lock();
+    pas_all_heaps_for_each_heap(t35CensusCallback, nullptr);
+    pas_heap_lock_unlock();
+}
