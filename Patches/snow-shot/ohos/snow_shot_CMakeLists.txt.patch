OHOS: link the OHOS NAPI/live-window/OCR cdylib targets and override the
OpenCV path for this platform's packaging. Also stop building two new test
targets that reference source files that do not exist and a
shortcut-schema-only registration mode the shipped binary does not
recognize, and stop building/copying/installing the separate OCR worker
process executable: the OHOS main app only uses the in-process OCR cdylib
(`cargo build --lib`), and the out-of-process worker has no exec path on
this platform. The real upstream test-target link fixes this file still
carries are kept.

--- a/snow_shot/CMakeLists.txt
+++ b/snow_shot/CMakeLists.txt
@@ -369,8 +369,10 @@
 # recognition lives in the standalone OCR process. Pin the config package to
 # the manifest-installed copy: the Rust OpenCV crates export a user-level
 # OpenCV_DIR that would otherwise shadow it.
-set(OpenCV_DIR "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/share/opencv4" CACHE PATH
-    "OpenCV package configuration directory" FORCE)
+if(NOT OpenCV_DIR)
+    set(OpenCV_DIR "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/share/opencv4" CACHE PATH
+        "OpenCV package configuration directory" FORCE)
+endif()
 find_package(OpenCV CONFIG REQUIRED)
