+struct PixelMapDeleter {
+    void operator()(OH_PixelmapNative* pixelmap) const noexcept {
+        if (pixelmap) {
+            static_cast<void>(OH_PixelmapNative_Release(pixelmap));
+            static_cast<void>(OH_PixelmapNative_Destroy(&pixelmap));
+        }
+    }
+};
+using PixelMap = std::unique_ptr<OH_PixelmapNative, PixelMapDeleter>;
+
+struct PixelMapOptionsDeleter {
+    void operator()(OH_Pixelmap_InitializationOptions* options) const noexcept {
+        if (options)
+            static_cast<void>(OH_PixelmapInitializationOptions_Release(options));
+    }
+};
+using PixelMapOptions = std::unique_ptr<OH_Pixelmap_InitializationOptions, PixelMapOptionsDeleter>;
+
+PixelMap makePixelMap(const QSize& size) {
+    if (size.isEmpty())
+        return {};
+    OH_Pixelmap_InitializationOptions* rawOptions = nullptr;
+    const auto createOptionsResult = OH_PixelmapInitializationOptions_Create(&rawOptions);
+    if (createOptionsResult != IMAGE_SUCCESS) {
+        qWarning() << "SNOW_OHOS_LIVE_WINDOW_PIXELMAP_OPTIONS_FAILED" << createOptionsResult;
+        return {};
+    }
+    PixelMapOptions options(rawOptions);
+    if (OH_PixelmapInitializationOptions_SetWidth(
+            options.get(), static_cast<uint32_t>(size.width())) != IMAGE_SUCCESS ||
+        OH_PixelmapInitializationOptions_SetHeight(
+            options.get(), static_cast<uint32_t>(size.height())) != IMAGE_SUCCESS ||
+        OH_PixelmapInitializationOptions_SetPixelFormat(options.get(), PIXEL_FORMAT_BGRA_8888) !=
+            IMAGE_SUCCESS ||
+        OH_PixelmapInitializationOptions_SetAlphaType(options.get(), PIXELMAP_ALPHA_TYPE_OPAQUE) !=
+            IMAGE_SUCCESS ||
+        OH_PixelmapInitializationOptions_SetEditable(options.get(), true) != IMAGE_SUCCESS)
+        return {};
+    OH_PixelmapNative* rawPixelmap = nullptr;
+    const auto createPixelMapResult =
+        OH_PixelmapNative_CreateEmptyPixelmap(options.get(), &rawPixelmap);
+    if (createPixelMapResult != IMAGE_SUCCESS) {
+        qWarning() << "SNOW_OHOS_LIVE_WINDOW_PIXELMAP_CREATE_FAILED" << createPixelMapResult;
+        return {};
+    }
+    return PixelMap(rawPixelmap);
+}
+
+QImage readPixelMap(OH_PixelmapNative* pixelmap) {
+    OH_Pixelmap_ImageInfo* rawInfo = nullptr;
+    if (!pixelmap || OH_PixelmapImageInfo_Create(&rawInfo) != IMAGE_SUCCESS)
+        return {};
+    std::unique_ptr<OH_Pixelmap_ImageInfo, decltype(&OH_PixelmapImageInfo_Release)> info(
+        rawInfo, OH_PixelmapImageInfo_Release);
+    uint32_t width = 0;
+    uint32_t height = 0;
+    uint32_t stride = 0;
+    int32_t format = PIXEL_FORMAT_UNKNOWN;
+    if (OH_PixelmapNative_GetImageInfo(pixelmap, info.get()) != IMAGE_SUCCESS ||
+        OH_PixelmapImageInfo_GetWidth(info.get(), &width) != IMAGE_SUCCESS ||
+        OH_PixelmapImageInfo_GetHeight(info.get(), &height) != IMAGE_SUCCESS ||
+        OH_PixelmapImageInfo_GetRowStride(info.get(), &stride) != IMAGE_SUCCESS ||
+        OH_PixelmapImageInfo_GetPixelFormat(info.get(), &format) != IMAGE_SUCCESS || !width ||
+        !height || width > static_cast<uint32_t>(std::numeric_limits<int>::max()) ||
+        height > static_cast<uint32_t>(std::numeric_limits<int>::max()))
+        return {};
+    QImage::Format qtFormat = QImage::Format_Invalid;
+    if (format == PIXEL_FORMAT_BGRA_8888)
+        qtFormat = QImage::Format_ARGB32;
+    else if (format == PIXEL_FORMAT_RGBA_8888)
+        qtFormat = QImage::Format_RGBA8888;
+    else if (format == PIXEL_FORMAT_RGB_888)
+        qtFormat = QImage::Format_RGB888;
+    const int bytesPerPixel = qtFormat == QImage::Format_RGB888 ? 3 : 4;
+    const auto minimumStride = static_cast<uint64_t>(width) * static_cast<uint64_t>(bytesPerPixel);
+    if (qtFormat == QImage::Format_Invalid || stride < minimumStride)
+        return {};
+    const size_t byteCount = static_cast<size_t>(stride) * height;
+    std::vector<uint8_t> bytes(byteCount);
+    size_t capacity = byteCount;
+    if (OH_PixelmapNative_ReadPixels(pixelmap, bytes.data(), &capacity) != IMAGE_SUCCESS ||
+        capacity < byteCount)
+        return {};
+    return QImage(bytes.data(), static_cast<int>(width), static_cast<int>(height),
+                  static_cast<int>(stride), qtFormat)
+        .copy();
+}
