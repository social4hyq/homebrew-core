-    return std::ranges::any_of(layout.glyphRuns(), [](const QGlyphRun& run) {
+    const QList<QGlyphRun> glyphRuns = layout.glyphRuns();
+    return std::any_of(glyphRuns.cbegin(), glyphRuns.cend(), [](const QGlyphRun& run) {
         const QRawFont font = run.rawFont();
         return !font.fontTable("CFF ").isEmpty() || !font.fontTable("CFF2").isEmpty();
     });
@@ -242,7 +243,7 @@
 }

