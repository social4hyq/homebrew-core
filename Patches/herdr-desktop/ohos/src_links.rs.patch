-#[cfg(not(windows))]
+/// The system browser's own ability, started the way `aa start -b com.huawei.hmos.browser -a MainAbility
+/// -U <url>` does in a shell. Only web links: the browser would take a `file:` or `hwbrowser:` link too,
+/// but nothing else a terminal link can hold (`ssh:`, `tel:`, `magnet:`, ...) is for it.
+#[cfg(any(all(target_os = "linux", target_env = "ohos"), test))]
+fn browser_args(url: &str) -> Option<Vec<String>> {
+    let host_and_path = url.strip_prefix("https://").or_else(|| url.strip_prefix("http://"))?;
+    if host_and_path.is_empty() || url.chars().any(|c| c.is_whitespace() || c.is_control()) {
+        return None;
+    }
+    Some(["start", "-b", "com.huawei.hmos.browser", "-a", "MainAbility", "-U", url].map(str::to_owned).to_vec())
+}
+
+/// The HAP sandbox cannot run a program (there is no `xdg-open` to spawn anyway), so the host's `aa` starts
+/// the browser through the core, like the mods' `herdr.exec`. `/usr/bin/aa` is only a stub: the program is
+/// `/bin/aa`, and the core does not run a shell to find it.
+#[cfg(all(target_os = "linux", target_env = "ohos"))]
+fn open_system(arg: &std::ffi::OsStr) {
+    let Some(args) = arg.to_str().and_then(browser_args) else {
+        tracing::warn!("cannot open {arg:?} from the HarmonyOS app: only http and https links go to the browser");
+        return;
+    };
+    // The call waits for the core: never on the UI thread.
+    std::thread::spawn(move || match crate::ohos_exec::exec("/bin/aa", &args, None, std::time::Duration::from_secs(15)) {
+        Ok((0, out, _)) if String::from_utf8_lossy(&out).contains("successfully") => {}
+        Ok((code, out, err)) => {
+            tracing::warn!("cannot open link: aa exited {code}: {} {}", String::from_utf8_lossy(&out).trim(), String::from_utf8_lossy(&err).trim())
+        }
+        Err(e) => tracing::warn!("cannot open link: {e}"),
+    });
+}
+
