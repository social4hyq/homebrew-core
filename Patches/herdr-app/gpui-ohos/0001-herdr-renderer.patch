+#[gpui::test]
+fn rounded_groups_preserve_square_descendant_corners(cx: &mut gpui::TestAppContext) {
+    use gpui::{ParentElement as _, Styled as _};
+    let (pixels, side) = render_div_fixture(cx, || {
+        let row = |height, color| {
+            gpui::div()
+                .w_full()
+                .h(px(height))
+                .flex_shrink_0()
+                .overflow_hidden()
+                .bg(color)
+        };
+        gpui::div().size(px(64.)).bg(gpui::white()).child(
+            gpui::div()
+                .flex()
+                .flex_col()
+                .size(px(64.))
+                .rounded(px(16.))
+                .overflow_hidden()
+                .child(row(16., gpui::black()))
+                .child(row(16., gpui::red()))
+                .child(row(16., gpui::blue()))
+                .child(row(16., gpui::green())),
+        )
+    });
+    for x in [0, 63] {
+        assert_eq!(pixel(&pixels, side, x * side / 64, 0), [255, 255, 255, 255]);
+        for y in [16, 31] {
+            assert_eq!(
+                pixel(&pixels, side, x * side / 64, y * side / 64),
+                [255, 0, 0, 255]
+            );
+        }
+        for y in [32, 47] {
+            assert_eq!(
+                pixel(&pixels, side, x * side / 64, y * side / 64),
+                [0, 0, 255, 255]
+            );
+        }
+    }
+}
