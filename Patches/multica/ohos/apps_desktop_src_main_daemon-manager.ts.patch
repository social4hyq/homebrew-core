+// OpenHarmony: the log lives on the host, so there is no file to watch. Ask the
+// bridge for the bytes past the last known offset on the same interval.
+function startRemoteLogTail(win: BrowserWindow, retryCount: number): void {
+  const generation = logTailGeneration;
+  void ensureActiveProfile().then(async (active) => {
+    if (generation !== logTailGeneration) return;
+    const logPath = active ? profileLogPath(active.name) : null;
+    if (!logPath) {
+      if (retryCount < LOG_TAIL_MAX_RETRIES) {
+        setTimeout(() => startLogTail(win, retryCount + 1), LOG_TAIL_RETRY_MS);
+      }
+      return;
+    }
+
+    let position = 0;
+    try {
+      const size = (await host.stat(logPath)).size;
+      const startAt = size - Math.min(size, LOG_TAIL_INITIAL_WINDOW_BYTES);
+      const { text } = await host.readRange(logPath, startAt);
+      if (win.isDestroyed() || generation !== logTailGeneration) return;
+      const lines = text
+        .split("\n")
+        .filter((line) => line.length > 0)
+        .slice(-LOG_TAIL_INITIAL_LINES);
+      for (const line of lines) win.webContents.send("daemon:log-line", line);
+      position = startAt + Buffer.byteLength(text, "utf-8");
+    } catch (err) {
+      const code = (err as NodeJS.ErrnoException)?.code;
+      if (code === "ENOENT" && retryCount < LOG_TAIL_MAX_RETRIES) {
+        setTimeout(() => startLogTail(win, retryCount + 1), LOG_TAIL_RETRY_MS);
+      } else {
+        console.warn("[daemon] log tail initial read failed:", err);
+      }
+      return;
+    }
