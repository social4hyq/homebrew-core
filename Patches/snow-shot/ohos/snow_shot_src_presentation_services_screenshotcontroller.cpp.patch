+void ScreenshotController::exportScreenRecordingToUserFile(const QString& path) {
+    if (path.isEmpty() ||
+        (m_impl->m_recordingFileExport && m_impl->m_recordingFileExport->active()))
+        return;
+
+    auto* exportSession = new snow_shot::platform::ohos::RecordingFileExport(this);
+    m_impl->m_recordingFileExport = exportSession;
+    const QPointer<ScreenshotController> receiver(this);
+    exportSession->setCompletion(
+        [receiver](snow_shot::platform::ohos::RecordingFileExport::Result result, QString error) {
+            if (!receiver || receiver->m_impl == nullptr)
+                return;
+            if (result == snow_shot::platform::ohos::RecordingFileExport::Result::Failed) {
+                qWarning() << "SNOW_RECORDING_USER_FILE_EXPORT_FAILED" << error;
+                receiver->m_impl->m_messages->error(
+                    QStringLiteral("screen-recording-user-file-export"),
+                    QCoreApplication::translate("ScreenshotController",
+                                                "Could not write the selected user file"));
+            }
+            if (receiver->m_impl->m_recordingFileExport)
+                receiver->m_impl->m_recordingFileExport->deleteLater();
+        });
+    static_cast<void>(exportSession->start(path));
+}
