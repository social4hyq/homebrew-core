+//! Owned, reusable audio files for GPUI clients. Commands are delivered in
+//! order, and every submitted descriptor remains live until native duplication.
+use crate::ForegroundExecutor;
+use futures::{StreamExt, channel::mpsc};
+use openharmony_ability::OpenHarmonyApp;
+pub use openharmony_ability_plugin_audio::AudioBridgePlugin;
+use openharmony_ability_plugin_audio::{AudioClient, AudioUpdateRequest};
+use std::{
+    fs::File,
+    os::fd::AsFd,
+    sync::atomic::{AtomicU64, Ordering},
+};
+
+static NEXT_PLAYER: AtomicU64 = AtomicU64::new(1);
+
+#[derive(Clone)]
+pub struct NativeAudioService {
+    app: OpenHarmonyApp,
+    executor: ForegroundExecutor,
+}
+#[derive(Clone, Copy, Default)]
+pub struct NativeAudioPlayerOptions {
+    pub diagnostics: bool,
+}
+impl NativeAudioService {
+    /// Register AudioBridgePlugin and the matching ArkTS AudioPlugin before creating this service.
+    pub fn new(
+        app: OpenHarmonyApp,
+        executor: ForegroundExecutor,
+    ) -> Result<Self, NativeAudioError> {
+        if app
+            .registered_plugin::<AudioBridgePlugin>()
+            .ok()
+            .flatten()
+            .is_none()
+        {
+            return Err(NativeAudioError::Unavailable);
+        }
+        Ok(Self { app, executor })
+    }
+    pub fn player(
+        &self,
+        _options: NativeAudioPlayerOptions,
+    ) -> Result<NativeAudioPlayer, NativeAudioError> {
+        let client = AudioClient::new(&self.app).map_err(|_| NativeAudioError::Unavailable)?;
+        let id = NEXT_PLAYER
+            .try_update(Ordering::Relaxed, Ordering::Relaxed, |id| id.checked_add(1))
+            .map_err(|_| NativeAudioError::Unavailable)?
+            .to_string();
+        let (sender, mut receiver) = mpsc::unbounded::<Command>();
+        let player_id = id.clone();
+        self.executor
+            .spawn(async move {
+                while let Some(command) = receiver.next().await {
+                    let request = AudioUpdateRequest {
+                        player: player_id.clone(),
+                        replace: command.replace,
+                        release: command.release,
+                        play: command.play,
+                        volume: command.volume,
+                        report_errors: command.report_errors,
+                        label: command.label,
+                    };
+                    if let Err(error) = client
+                        .update(request, command.source.as_ref().map(AsFd::as_fd))
+                        .await
+                    {
+                        log::warn!("OHOS audio player {player_id}: {error}");
+                    }
+                    // The command, including its File, drops only after acknowledgement.
+                }
+            })
+            .detach();
+        Ok(NativeAudioPlayer { id, sender })
+    }
+}
+
+struct Command {
+    source: Option<File>,
+    replace: bool,
+    release: bool,
+    play: bool,
+    volume: f64,
+    report_errors: bool,
+    label: String,
+}
+
+pub struct NativeAudioPlayer {
+    id: String,
+    sender: mpsc::UnboundedSender<Command>,
+}
+impl NativeAudioPlayer {
+    pub fn id(&self) -> &str {
+        &self.id
+    }
+    pub fn clear(&self) -> Result<(), NativeAudioError> {
+        self.send(Command {
+            source: None,
+            replace: true,
+            release: false,
+            play: false,
+            volume: 1.,
+            report_errors: false,
+            label: String::new(),
+        })
+    }
+    pub fn replace_and_play(
+        &self,
+        source: File,
+        volume: f64,
+        report_errors: bool,
+        label: String,
+    ) -> Result<(), NativeAudioError> {
+        self.send(Command {
+            source: Some(source),
+            replace: true,
+            release: false,
+            play: true,
+            volume,
+            report_errors,
+            label,
+        })
+    }
+    pub fn replay(&self, volume: f64) -> Result<(), NativeAudioError> {
+        self.send(Command {
+            source: None,
+            replace: false,
+            release: false,
+            play: true,
+            volume,
+            report_errors: false,
+            label: String::new(),
+        })
+    }
+    fn send(&self, command: Command) -> Result<(), NativeAudioError> {
+        if !command.volume.is_finite() || !(0.0..=1.0).contains(&command.volume) {
+            return Err(NativeAudioError::InvalidVolume);
+        }
+        self.sender
+            .unbounded_send(command)
+            .map_err(|_| NativeAudioError::Closed)
+    }
+}
+impl Drop for NativeAudioPlayer {
+    fn drop(&mut self) {
+        let _ = self.send(Command {
+            source: None,
+            replace: false,
+            release: true,
+            play: false,
+            volume: 1.,
+            report_errors: false,
+            label: String::new(),
+        });
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NativeAudioError {
+    Unavailable,
+    Closed,
+    InvalidVolume,
+}
+impl std::fmt::Display for NativeAudioError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(match self {
+            Self::Unavailable => "native audio unavailable",
+            Self::Closed => "audio command queue closed",
+            Self::InvalidVolume => "audio volume must be finite and between 0 and 1",
+        })
+    }
+}
+impl std::error::Error for NativeAudioError {}
diff --git a/vendor/gpui-ohos/src/ohos/capture_pixels.rs b/vendor/gpui-ohos/src/ohos/capture_pixels.rs
new file mode 100644
index 0000000..a8d071d
--- /dev/null
+++ b/vendor/gpui-ohos/src/ohos/capture_pixels.rs
@@ -0,0 +1,53 @@
+/// Row-local conversion avoids zeroing and then rescanning a complete capture frame.
+#[derive(Clone, Copy)]
+pub(crate) enum CaptureFormat {
+    Rgba,
+    Rgbx,
+    Bgra,
+    Bgrx,
+}
+pub(crate) struct CapturePixels {
+    bytes: Vec<u8>,
+    row_bytes: usize,
+    height: usize,
+    format: CaptureFormat,
+}
+impl CapturePixels {
+    pub(crate) fn new(width: usize, height: usize, format: CaptureFormat) -> Option<Self> {
+        let row_bytes = width.checked_mul(4)?;
+        let size = row_bytes.checked_mul(height)?;
+        if width == 0 || height == 0 || size > 256 * 1024 * 1024 {
+            return None;
+        }
+        Some(Self {
+            bytes: Vec::with_capacity(size),
+            row_bytes,
+            height,
+            format,
+        })
+    }
+    pub(crate) fn push_row(&mut self, source: &[u8]) -> bool {
+        if source.len() != self.row_bytes || self.bytes.len() / self.row_bytes >= self.height {
+            return false;
+        }
+        let start = self.bytes.len();
+        self.bytes.extend_from_slice(source);
+        if matches!(self.format, CaptureFormat::Rgba) {
+            return true;
+        }
+        let swap = matches!(self.format, CaptureFormat::Bgra | CaptureFormat::Bgrx);
+        let opaque = matches!(self.format, CaptureFormat::Rgbx | CaptureFormat::Bgrx);
+        for pixel in self.bytes[start..].as_chunks_mut::<4>().0 {
+            if swap {
+                pixel.swap(0, 2);
+            }
+            if opaque {
+                pixel[3] = 255;
+            }
+        }
+        true
+    }
+    pub(crate) fn finish(self) -> Option<Vec<u8>> {
+        (self.bytes.len() == self.row_bytes * self.height).then_some(self.bytes)
+    }
+}
diff --git a/vendor/gpui-ohos/src/ohos/clipboard.rs b/vendor/gpui-ohos/src/ohos/clipboard.rs
new file mode 100644
index 0000000..3ff9dd0
--- /dev/null
+++ b/vendor/gpui-ohos/src/ohos/clipboard.rs
@@ -0,0 +1,354 @@
+use std::{
+    cell::{Cell, RefCell},
+    path::PathBuf,
+    rc::Rc,
+};
+
+use crate::{
+    BackgroundExecutor, ClipboardEntry, ClipboardItem, ClipboardReadError, ClipboardString,
+    ExternalPaths, ForegroundExecutor, Image, ImageFormat, Task,
+};
+use anyhow::Result;
+use futures::{
+    FutureExt,
+    channel::oneshot,
+    future::{LocalBoxFuture, Shared},
+    lock::Mutex,
+};
+use openharmony_ability::OpenHarmonyApp;
+use openharmony_ability_plugin_clipboard::{
+    ClipboardBridgePlugin, ClipboardClient, ClipboardError, ClipboardRecord,
+};
+
+const METADATA_MIME: &str = "application/x-gpui-ohos-text-metadata-v1";
+
+type CachedClipboardItem = Rc<RefCell<Option<(u32, Option<ClipboardItem>)>>>;
+type PendingClipboardWrite = Rc<RefCell<Option<(u64, Option<ClipboardItem>)>>>;
+
+#[derive(Clone)]
+pub(crate) struct OhosClipboard {
+    app: Rc<RefCell<Option<OpenHarmonyApp>>>,
+    foreground_executor: ForegroundExecutor,
+    background_executor: BackgroundExecutor,
+    cache: CachedClipboardItem,
+    pending_write_item: PendingClipboardWrite,
+    operation: Rc<Cell<u64>>,
+    refresh_pending: Rc<Cell<bool>>,
+    write_tail: Rc<RefCell<Option<Shared<LocalBoxFuture<'static, ()>>>>>,
+    read_lock: Rc<Mutex<()>>,
+}
+
+impl OhosClipboard {
+    pub(crate) fn new(
+        app: Rc<RefCell<Option<OpenHarmonyApp>>>,
+        foreground_executor: ForegroundExecutor,
+        background_executor: BackgroundExecutor,
+    ) -> Self {
+        Self {
+            app,
+            foreground_executor,
+            background_executor,
+            cache: Rc::new(RefCell::new(None)),
+            pending_write_item: Rc::new(RefCell::new(None)),
+            operation: Rc::new(Cell::new(0)),
+            refresh_pending: Rc::new(Cell::new(false)),
+            write_tail: Rc::new(RefCell::new(None)),
+            read_lock: Rc::new(Mutex::new(())),
+        }
+    }
+
+    fn revision(app: &OpenHarmonyApp) -> Option<u32> {
+        match app.registered_plugin::<ClipboardBridgePlugin>() {
+            Ok(Some(plugin)) => query_revision(&plugin),
+            Ok(None) => {
+                log::warn!("OHOS clipboard cache unavailable: plugin is not registered");
+                None
+            }
+            Err(error) => {
+                log::warn!("Failed to query OHOS clipboard plugin: {error}");
+                None
+            }
+        }
+    }
+
+    fn next_operation(&self) -> u64 {
+        let next = self.operation.get().wrapping_add(1);
+        self.operation.set(next);
+        next
+    }
+
+    fn schedule_refresh(&self) {
+        if self.app.borrow().is_some() && !self.refresh_pending.replace(true) {
+            let clipboard = self.clone();
+            self.foreground_executor
+                .spawn(async move {
+                    if let Err(error) = clipboard.read().await {
+                        log::warn!("OHOS clipboard cache refresh failed: {error}");
+                    }
+                    clipboard.refresh_pending.set(false);
+                })
+                .detach();
+        }
+    }
+
+    pub(crate) fn refresh_if_needed(&self) {
+        if self.pending_write_item.borrow().is_some() {
+            return;
+        }
+        let revision = self.app.borrow().as_ref().and_then(Self::revision);
+        if let Some(revision) = revision {
+            if self
+                .cache
+                .borrow()
+                .as_ref()
+                .is_some_and(|(cached_revision, _)| *cached_revision == revision)
+            {
+                return;
+            }
+            *self.cache.borrow_mut() = None;
+            self.schedule_refresh();
+        } else {
+            *self.cache.borrow_mut() = None;
+        }
+    }
+
+    pub(crate) fn read_cached(&self) -> Option<ClipboardItem> {
+        if let Some((_, item)) = self.pending_write_item.borrow().as_ref() {
+            return item.clone();
+        }
+        let revision = self.app.borrow().as_ref().and_then(Self::revision);
+        if let Some((cached_revision, item)) = self.cache.borrow().as_ref() {
+            if Some(*cached_revision) == revision {
+                return item.clone();
+            }
+        }
+        *self.cache.borrow_mut() = None;
+        self.schedule_refresh();
+        None
+    }
+
+    pub(crate) fn read(
+        &self,
+    ) -> Task<std::result::Result<Option<ClipboardItem>, ClipboardReadError>> {
+        let Some(app) = self.app.borrow().clone() else {
+            return Task::ready(Err(ClipboardReadError::Unavailable));
+        };
+        let client = match ClipboardClient::new(&app)
+            .and_then(|client| client.with_metadata_mime_type(METADATA_MIME))
+        {
+            Ok(client) => client,
+            Err(error) => return Task::ready(Err(read_error(error))),
+        };
+        let plugin = match app.registered_plugin::<ClipboardBridgePlugin>() {
+            Ok(plugin) => plugin,
+            Err(error) => {
+                log::warn!("Failed to query OHOS clipboard plugin: {error}");
+                return Task::ready(Err(ClipboardReadError::Unavailable));
+            }
+        };
+        let pending_write = self.write_tail.borrow().clone();
+        let clipboard = self.clone();
+        let operation = self.next_operation();
+        let (sender, receiver) = oneshot::channel();
+        self.foreground_executor
+            .spawn(async move {
+                if let Some(pending) = pending_write {
+                    pending.await;
+                }
+                let _read_guard = clipboard.read_lock.lock().await;
+                if sender.is_canceled() {
+                    return;
+                }
+                // The native facade performs synchronous IPC when polled. Keep
+                // the detached guard alive through completion, even if canceled.
+                let result = clipboard
+                    .background_executor
+                    .spawn(async move {
+                        let before = plugin.as_deref().and_then(query_revision);
+                        let records = client.read_records().await.map_err(read_error)?;
+                        let after = plugin.as_deref().and_then(query_revision);
+                        Ok((records, before.filter(|before| Some(*before) == after)))
+                    })
+                    .await;
+                let result = result.and_then(|(records, revision)| {
+                    let mut entries = Vec::with_capacity(records.len());
+                    for record in records {
+                        if let Some(text) = record.text {
+                            entries.push(ClipboardEntry::String(ClipboardString {
+                                text,
+                                metadata: record.metadata,
+                            }));
+                        } else if let Some(bytes) = record.encoded_image {
+                            let format = image::guess_format(&bytes)
+                                .ok()
+                                .and_then(|format| {
+                                    ImageFormat::from_mime_type(format.to_mime_type())
+                                })
+                                .ok_or_else(|| {
+                                    log::warn!("Unsupported encoded OHOS clipboard image format");
+                                    ClipboardReadError::UnsupportedContent
+                                })?;
+                            entries.push(ClipboardEntry::Image(Image::from_bytes(format, bytes)));
+                        } else if let Some(uri) = record.uri {
+                            let path =
+                                ohos_fileuri_binding::get_path_from_uri(&uri).map_err(|error| {
+                                    log::warn!("Unsupported OHOS clipboard URI {uri}: {error}");
+                                    ClipboardReadError::UnsupportedContent
+                                })?;
+                            entries.push(ClipboardEntry::ExternalPaths(ExternalPaths(
+                                smallvec::smallvec![PathBuf::from(path)],
+                            )));
+                        }
+                    }
+                    let item = (!entries.is_empty()).then_some(ClipboardItem { entries });
+                    if clipboard.operation.get() == operation {
+                        *clipboard.cache.borrow_mut() =
+                            revision.map(|revision| (revision, item.clone()));
+                    }
+                    Ok(item)
+                });
+                if result.is_err() && clipboard.operation.get() == operation {
+                    *clipboard.cache.borrow_mut() = None;
+                }
+                if let Err(Err(error)) = sender.send(result) {
+                    log::warn!("Abandoned OHOS clipboard read failed: {error}");
+                }
+            })
+            .detach();
+        self.foreground_executor.spawn(async move {
+            receiver
+                .await
+                .unwrap_or(Err(ClipboardReadError::Unavailable))
+        })
+    }
+
+    pub(crate) fn write(&self, item: ClipboardItem) -> Task<Result<()>> {
+        let Some(app) = self.app.borrow().clone() else {
+            return Task::ready(Err(anyhow::anyhow!("Clipboard is unavailable")));
+        };
+        let client = match ClipboardClient::new(&app)
+            .and_then(|client| client.with_metadata_mime_type(METADATA_MIME))
+        {
+            Ok(client) => client,
+            Err(error) => return Task::ready(Err(error.into())),
+        };
+        let mut records = Vec::new();
+        for entry in item.entries() {
+            match entry {
+                ClipboardEntry::String(text) => records.push(ClipboardRecord {
+                    text: Some(text.text.clone()),
+                    metadata: text.metadata.clone(),
+                    ..Default::default()
+                }),
+                ClipboardEntry::Image(image) => records.push(ClipboardRecord {
+                    encoded_image: Some(image.bytes.clone()),
+                    ..Default::default()
+                }),
+                ClipboardEntry::ExternalPaths(paths) => {
+                    for path in paths.paths() {
+                        let Some(path) = path.to_str() else {
+                            return Task::ready(Err(anyhow::anyhow!(
+                                "Clipboard path is not UTF-8"
+                            )));
+                        };
+                        let uri = match ohos_fileuri_binding::get_uri_from_path(path) {
+                            Ok(uri) => uri,
+                            Err(error) => return Task::ready(Err(error.into())),
+                        };
+                        records.push(ClipboardRecord {
+                            uri: Some(uri),
+                            ..Default::default()
+                        });
+                    }
+                }
+            }
+        }
+        let plugin = app
+            .registered_plugin::<ClipboardBridgePlugin>()
+            .ok()
+            .flatten();
+        let cached_item = (!item.entries().is_empty()).then(|| item.clone());
+        let clipboard = self.clone();
+        let operation = self.next_operation();
+        *self.cache.borrow_mut() = None;
+        *self.pending_write_item.borrow_mut() = Some((operation, cached_item.clone()));
+        let previous = self.write_tail.borrow().clone();
+        let (complete, completion) = oneshot::channel();
+        *self.write_tail.borrow_mut() = Some(
+            completion
+                .map(|_: Result<(), oneshot::Canceled>| ())
+                .boxed_local()
+                .shared(),
+        );
+        let (sender, receiver) = oneshot::channel();
+        self.foreground_executor
+            .spawn(async move {
+                if let Some(previous) = previous {
+                    previous.await;
+                }
+                let result = clipboard
+                    .background_executor
+                    .spawn(async move {
+                        if records.is_empty() {
+                            client.clear().await?;
+                        } else {
+                            client.write_records(records).await?;
+                        }
+                        let after = plugin.as_deref().and_then(query_revision);
+                        Ok::<_, ClipboardError>(after)
+                    })
+                    .await;
+                if clipboard
+                    .pending_write_item
+                    .borrow()
+                    .as_ref()
+                    .is_some_and(|(pending_op, _)| *pending_op == operation)
+                {
+                    *clipboard.pending_write_item.borrow_mut() = None;
+                }
+                let result = result
+                    .map(|revision| {
+                        if clipboard.operation.get() == operation {
+                            *clipboard.cache.borrow_mut() =
+                                revision.map(|revision| (revision, cached_item));
+                        }
+                    })
+                    .map_err(|error| {
+                        if clipboard.operation.get() == operation {
+                            *clipboard.cache.borrow_mut() = None;
+                        }
+                        anyhow::Error::from(error)
+                    });
+                let _ = complete.send(());
+                if let Err(Err(error)) = sender.send(result) {
+                    log::warn!("Abandoned OHOS clipboard write failed: {error}");
+                }
+            })
+            .detach();
+        self.foreground_executor
+            .spawn(async move { receiver.await.map_err(anyhow::Error::from)? })
+    }
+}
+
+fn query_revision(plugin: &ClipboardBridgePlugin) -> Option<u32> {
+    match plugin.revision() {
+        Ok(revision) => Some(revision),
+        Err(error) => {
+            log::warn!("OHOS clipboard cache disabled for this query: {error}");
+            None
+        }
+    }
+}
+
+fn read_error(error: ClipboardError) -> ClipboardReadError {
+    log::warn!("Failed to read OHOS clipboard: {error}");
+    match error {
+        ClipboardError::AuthorizationRequired => ClipboardReadError::Denied(error.to_string()),
+        ClipboardError::InvalidContent(_)
+        | ClipboardError::InvalidText { .. }
+        | ClipboardError::EmptyBinaryUnsupported { .. } => ClipboardReadError::UnsupportedContent,
+        ClipboardError::ApiUnavailable { .. }
+        | ClipboardError::RevisionUnavailable
+        | ClipboardError::Native(_) => ClipboardReadError::Unavailable,
+    }
+}
diff --git a/vendor/gpui-ohos/src/ohos/credentials.rs b/vendor/gpui-ohos/src/ohos/credentials.rs
new file mode 100644
index 0000000..0da436e
--- /dev/null
+++ b/vendor/gpui-ohos/src/ohos/credentials.rs
@@ -0,0 +1,98 @@
+use std::mem::ManuallyDrop;
+
+use anyhow::{Result, anyhow, bail};
+use ohos_asset_binding::{
+    AssetAccessibility, AssetAttr, AssetResultCode, AssetReturnType, AssetTag, AssetValue,
+    asset_add, asset_query, asset_remove, asset_update,
+};
+
+fn bytes(tag: AssetTag, value: impl Into<Vec<u8>>) -> AssetAttr {
+    AssetAttr {
+        tag,
+        value: AssetValue::Blob(ManuallyDrop::new(value.into())),
+    }
+}
+
+fn alias_attr(alias: &str) -> AssetAttr {
+    bytes(AssetTag::AssetTagAlias, alias.as_bytes())
+}
+
+fn check(operation: &str, result: AssetResultCode) -> Result<()> {
+    match result {
+        AssetResultCode::Success => Ok(()),
+        error => Err(anyhow!("AssetStore {operation} failed: {error}")),
+    }
+}
+
+pub(super) fn write(alias: &str, username: &str, password: &[u8]) -> Result<()> {
+    let accessibility: u32 = AssetAccessibility::AssetAccessibilityDeviceFirstUnlocked.into();
+    let result = asset_add(vec![
+        alias_attr(alias),
+        bytes(AssetTag::AssetTagSecret, password),
+        bytes(AssetTag::AssetTagDataLabelNormal1, username.as_bytes()),
+        AssetAttr {
+            tag: AssetTag::AssetTagAccessibility,
+            value: AssetValue::U32IntT(accessibility),
+        },
+    ]);
+
+    match result {
+        AssetResultCode::Duplicated => check(
+            "update",
+            asset_update(
+                vec![alias_attr(alias)],
+                vec![
+                    bytes(AssetTag::AssetTagSecret, password),
+                    bytes(AssetTag::AssetTagDataLabelNormal1, username.as_bytes()),
+                ],
+            ),
+        ),
+        other => check("add", other),
+    }
+}
+
+pub(super) fn read(alias: &str) -> Result<Option<(String, Vec<u8>)>> {
+    let return_type: u32 = AssetReturnType::AssetReturnAll.into();
+    let result = asset_query(vec![
+        alias_attr(alias),
+        AssetAttr {
+            tag: AssetTag::AssetTagReturnType,
+            value: AssetValue::U32IntT(return_type),
+        },
+    ]);
+    let results = match result {
+        Ok(results) => results,
+        Err(AssetResultCode::NotFound) => return Ok(None),
+        Err(error) => bail!("AssetStore query failed: {error}"),
+    };
+    let Some(first) = results.result.first() else {
+        return Ok(None);
+    };
+
+    let value = |tag| {
+        first.attrs.iter().find_map(|attr| {
+            if std::mem::discriminant(&attr.tag) != std::mem::discriminant(&tag) {
+                return None;
+            }
+            match &attr.value {
+                AssetValue::Blob(blob) => Some(blob.as_slice()),
+                _ => None,
+            }
+        })
+    };
+    let username = value(AssetTag::AssetTagDataLabelNormal1)
+        .ok_or_else(|| anyhow!("AssetStore credential has no username"))?;
+    let password = value(AssetTag::AssetTagSecret)
+        .ok_or_else(|| anyhow!("AssetStore credential has no password"))?;
+    Ok(Some((
+        std::str::from_utf8(username)?.to_owned(),
+        password.to_vec(),
+    )))
+}
+
+pub(super) fn delete(alias: &str) -> Result<()> {
+    match asset_remove(vec![alias_attr(alias)]) {
+        AssetResultCode::Success | AssetResultCode::NotFound => Ok(()),
+        error => bail!("AssetStore remove failed: {error}"),
+    }
+}
diff --git a/vendor/gpui-ohos/src/ohos/cursor_visibility.rs b/vendor/gpui-ohos/src/ohos/cursor_visibility.rs
new file mode 100644
index 0000000..d38d4c8
--- /dev/null
+++ b/vendor/gpui-ohos/src/ohos/cursor_visibility.rs
@@ -0,0 +1,53 @@
+pub(super) struct CursorVisibility {
+    visible: bool,
+    applied: Option<bool>,
+    pending: bool,
+    supported: bool,
+}
+
+impl Default for CursorVisibility {
+    fn default() -> Self {
+        Self {
+            visible: true,
+            applied: Some(true),
+            pending: false,
+            supported: true,
+        }
+    }
+}
+
+impl CursorVisibility {
+    pub(super) fn is_visible(&self) -> bool {
+        self.visible
+    }
+
+    pub(super) fn request(&mut self, visible: bool) -> Option<bool> {
+        if !self.supported {
+            return None;
+        }
+        self.visible = visible;
+        if self.pending || self.applied == Some(visible) {
+            return None;
+        }
+        self.pending = true;
+        Some(visible)
+    }
+
+    pub(super) fn complete(&mut self, visible: bool, succeeded: bool) -> Option<bool> {
+        self.pending = false;
+        self.applied = succeeded.then_some(visible);
+        // A failed native request must remain retryable on the next input, but
+        // must not create an unbounded retry loop while the service is failing.
+        if !succeeded && self.visible == visible {
+            return None;
+        }
+        self.request(self.visible)
+    }
+
+    pub(super) fn mark_unsupported(&mut self) {
+        self.supported = false;
+        self.pending = false;
+        self.visible = true;
+        self.applied = None;
+    }
+}
diff --git a/vendor/gpui-ohos/src/ohos/device.rs b/vendor/gpui-ohos/src/ohos/device.rs
new file mode 100644
index 0000000..927d9d2
--- /dev/null
+++ b/vendor/gpui-ohos/src/ohos/device.rs
@@ -0,0 +1,147 @@
+//! Synchronous OpenHarmony device metadata, SDK version, and SysCap queries.
+//!
+//! Uses direct C NDK bindings (`ohos-device-binding` and `ohos-init-binding`) so
+//! version checks, capability probes, and desktop/mobile form-factor adaptation
+//! work synchronously on any thread without waiting for ArkTS initialization.
+
+/// Runtime device form factor reported by `OH_GetDeviceType`.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum DeviceFormFactor {
+    /// HarmonyOS PC / 2-in-1 desktop (`"2in1"` / `"pc"`).
+    Desktop,
+    /// Phone (`"phone"` or `"default"`).
+    Phone,
+    /// Tablet (`"tablet"`).
+    Tablet,
+    /// Watch / wearable (`"wearable"` or `"liteWearable"`).
+    Wearable,
+    /// TV, car, or unclassified device profile.
+    Other,
+}
+
+impl DeviceFormFactor {
+    pub(crate) fn detect() -> Self {
+        Self::from_device_type(raw_device_type(), openharmony_ability::is_desktop_device())
+    }
+
+    pub(crate) fn from_device_type(raw: Option<&str>, compile_time_desktop: bool) -> Self {
+        let Some(raw) = raw.map(str::trim).filter(|value| !value.is_empty()) else {
+            return if compile_time_desktop {
+                Self::Desktop
+            } else {
+                Self::Other
+            };
+        };
+        if raw.eq_ignore_ascii_case("2in1") || raw.eq_ignore_ascii_case("pc") {
+            Self::Desktop
+        } else if raw.eq_ignore_ascii_case("phone") || raw.eq_ignore_ascii_case("default") {
+            Self::Phone
+        } else if raw.eq_ignore_ascii_case("tablet") {
+            Self::Tablet
+        } else if raw.eq_ignore_ascii_case("wearable") || raw.eq_ignore_ascii_case("liteWearable") {
+            Self::Wearable
+        } else {
+            Self::Other
+        }
+    }
+
+    pub(crate) const fn is_desktop(self) -> bool {
+        matches!(self, Self::Desktop)
+    }
+
+    pub(crate) const fn should_auto_hide_scrollbars(self) -> bool {
+        matches!(self, Self::Phone | Self::Tablet | Self::Wearable)
+    }
+}
+
+/// Maps `window.WindowStatusType` values to whether the window operates in
+/// free-window management mode (`FLOATING = 4` or `MAXIMIZE = 2`).
+///
+/// Returns `None` for `MINIMIZE = 3` (which changes visibility without altering
+/// the underlying windowing mode) and unknown status codes.
+pub(crate) const fn is_free_window_status(status: i32) -> Option<bool> {
+    match status {
+        2 | 4 => Some(true),
+        1 | 5 => Some(false),
+        _ => None,
+    }
+}
+
+/// Returns the OpenHarmony base SDK API version (`OH_GetSdkApiVersion`).
+pub(crate) fn sdk_api_version() -> u32 {
+    ohos_device_binding::sdk_api_version()
+}
+
+/// Returns the distribution OS API version (`OH_GetDistributionOSApiVersion`),
+/// encoded as `M * 10000 + S * 100 + F` (for example, `60000` for HarmonyOS 6.0.0).
+#[allow(dead_code)]
+pub(crate) fn distribution_os_api_version() -> u32 {
+    ohos_device_binding::distribution_os_api_version()
+}
+
+/// Synchronously queries whether a `SystemCapability.*` identifier is supported
+/// by the current device (`canIUse` NDK symbol, API 8+).
+pub(crate) fn can_i_use(syscap: &str) -> bool {
+    if syscap.is_empty() || syscap.contains('\0') {
+        return false;
+    }
+    ohos_init_binding::canIUse(syscap)
+}
+
+fn raw_device_type() -> Option<&'static str> {
+    ohos_device_binding::device_type()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{DeviceFormFactor, can_i_use, is_free_window_status};
+
+    #[test]
+    fn classifies_ohos_device_types_for_desktop_and_scrollbars() {
+        let desktop = DeviceFormFactor::from_device_type(Some("2in1"), false);
+        assert_eq!(desktop, DeviceFormFactor::Desktop);
+        assert!(desktop.is_desktop());
+        assert!(!desktop.should_auto_hide_scrollbars());
+
+        for phone_alias in ["phone", "default", "Phone"] {
+            let phone = DeviceFormFactor::from_device_type(Some(phone_alias), true);
+            assert_eq!(phone, DeviceFormFactor::Phone);
+            assert!(!phone.is_desktop());
+            assert!(phone.should_auto_hide_scrollbars());
+        }
+
+        let tablet = DeviceFormFactor::from_device_type(Some("tablet"), false);
+        assert_eq!(tablet, DeviceFormFactor::Tablet);
+        assert!(!tablet.is_desktop());
+        assert!(tablet.should_auto_hide_scrollbars());
+
+        let wearable = DeviceFormFactor::from_device_type(Some("liteWearable"), false);
+        assert_eq!(wearable, DeviceFormFactor::Wearable);
+        assert!(wearable.should_auto_hide_scrollbars());
+
+        assert_eq!(
+            DeviceFormFactor::from_device_type(None, true),
+            DeviceFormFactor::Desktop
+        );
+        assert_eq!(
+            DeviceFormFactor::from_device_type(None, false),
+            DeviceFormFactor::Other
+        );
+    }
+
+    #[test]
+    fn maps_window_status_to_free_window_mode() {
+        assert_eq!(is_free_window_status(1), Some(false)); // FULL_SCREEN
+        assert_eq!(is_free_window_status(2), Some(true)); // MAXIMIZE
+        assert_eq!(is_free_window_status(3), None); // MINIMIZE preserves prior mode
+        assert_eq!(is_free_window_status(4), Some(true)); // FLOATING
+        assert_eq!(is_free_window_status(5), Some(false)); // SPLIT_SCREEN
+        assert_eq!(is_free_window_status(0), None);
+    }
+
+    #[test]
+    fn rejects_empty_or_nul_syscap_without_panicking() {
+        assert!(!can_i_use(""));
+        assert!(!can_i_use("SystemCapability.Window\0.SessionManager"));
+    }
+}
diff --git a/vendor/gpui-ohos/src/ohos/dispatcher.rs b/vendor/gpui-ohos/src/ohos/dispatcher.rs
new file mode 100644
index 0000000..cb352a9
--- /dev/null
+++ b/vendor/gpui-ohos/src/ohos/dispatcher.rs
@@ -0,0 +1,219 @@
+use super::task_queue::TaskQueue;
+use crate::{PlatformDispatcher, Priority, PriorityQueueSender, RunnableVariant};
+use openharmony_ability::OpenHarmonyWaker;
+use std::{
+    cmp::Ordering,
+    collections::BinaryHeap,
+    sync::{
+        Arc, Condvar, Mutex,
+        atomic::{AtomicBool, Ordering as AtomicOrdering},
+    },
+    thread,
+    time::{Duration, Instant},
+};
+
+struct TimerAfter {
+    when: Instant,
+    sequence: u64,
+    runnable: RunnableVariant,
+}
+impl Ord for TimerAfter {
+    fn cmp(&self, other: &Self) -> Ordering {
+        other
+            .when
+            .cmp(&self.when)
+            .then_with(|| other.sequence.cmp(&self.sequence))
+    }
+}
+impl PartialOrd for TimerAfter {
+    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
+        Some(self.cmp(other))
+    }
+}
+impl PartialEq for TimerAfter {
+    fn eq(&self, other: &Self) -> bool {
+        self.when == other.when && self.sequence == other.sequence
+    }
+}
+impl Eq for TimerAfter {}
+#[derive(Default)]
+struct TimerState {
+    heap: BinaryHeap<TimerAfter>,
+    next_sequence: u64,
+    closed: bool,
+}
+#[derive(Default)]
+struct MainWake {
+    requested: AtomicBool,
+    waker: Mutex<Option<OpenHarmonyWaker>>,
+    stopped: AtomicBool,
+    enqueue_gate: Mutex<()>,
+}
+impl MainWake {
+    fn notify(&self) {
+        if self.stopped.load(AtomicOrdering::Acquire)
+            || self.requested.swap(true, AtomicOrdering::AcqRel)
+        {
+            return;
+        }
+        let waker = self.waker.lock().unwrap_or_else(|e| e.into_inner()).clone();
+        if let Some(waker) = waker {
+            waker.wake();
+        } else {
+            self.requested.store(false, AtomicOrdering::Release);
+        }
+    }
+}
+
+pub(crate) struct OhosDispatcher {
+    main_thread_id: thread::ThreadId,
+    main_sender: PriorityQueueSender<RunnableVariant>,
+    background: Arc<TaskQueue<RunnableVariant>>,
+    timers: Arc<(Mutex<TimerState>, Condvar)>,
+    wake: Arc<MainWake>,
+}
+impl OhosDispatcher {
+    pub(crate) fn new(main_sender: PriorityQueueSender<RunnableVariant>) -> Self {
+        let background = Arc::new(TaskQueue::<RunnableVariant>::default());
+        super::workers::Workers::start(background.clone());
+        let timers = Arc::new((Mutex::new(TimerState::default()), Condvar::new()));
+        let wake = Arc::new(MainWake::default());
+        let timer_state = timers.clone();
+        thread::Builder::new()
+            .name("OhosTimer".into())
+            .spawn(move || {
+                let (lock, changed) = &*timer_state;
+                loop {
+                    let mut state = lock.lock().unwrap_or_else(|e| e.into_inner());
+                    loop {
+                        if state.closed {
+                            return;
+                        }
+                        match state.heap.peek() {
+                            Some(next) if next.when <= Instant::now() => break,
+                            Some(next) => {
+                                let timeout = next.when.saturating_duration_since(Instant::now());
+                                state = changed
+                                    .wait_timeout(state, timeout)
+                                    .unwrap_or_else(|e| e.into_inner())
+                                    .0;
+                            }
+                            None => state = changed.wait(state).unwrap_or_else(|e| e.into_inner()),
+                        }
+                    }
+                    let runnable = state.heap.pop().unwrap().runnable;
+                    drop(state);
+                    runnable.run();
+                }
+            })
+            .expect("Failed to start OHOS timer");
+        Self {
+            main_thread_id: thread::current().id(),
+            main_sender,
+            background,
+            timers,
+            wake,
+        }
+    }
+    pub(crate) fn set_waker(&self, waker: OpenHarmonyWaker) {
+        *self.wake.waker.lock().unwrap_or_else(|e| e.into_inner()) = Some(waker);
+        self.wake.notify();
+    }
+    pub(crate) fn begin_main_turn(&self) {
+        self.wake.requested.store(false, AtomicOrdering::Release);
+    }
+    pub(crate) fn wake_main_thread(&self) {
+        self.wake.notify();
+    }
+    pub(crate) fn execute_runnable(runnable: RunnableVariant) {
+        runnable.run();
+    }
+    pub(crate) fn shutdown(&self) {
+        {
+            let _gate = self
+                .wake
+                .enqueue_gate
+                .lock()
+                .unwrap_or_else(|e| e.into_inner());
+            if self.wake.stopped.swap(true, AtomicOrdering::AcqRel) {
+                return;
+            }
+        }
+        drop(self.background.close());
+        let (lock, changed) = &*self.timers;
+        let pending = {
+            let mut state = lock.lock().unwrap_or_else(|e| e.into_inner());
+            state.closed = true;
+            let pending: Vec<_> = state.heap.drain().map(|entry| entry.runnable).collect();
+            changed.notify_all();
+            pending
+        };
+        drop(pending);
+        self.wake
+            .waker
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .take();
+    }
+}
+impl Drop for OhosDispatcher {
+    fn drop(&mut self) {
+        self.shutdown();
+    }
+}
+impl PlatformDispatcher for OhosDispatcher {
+    fn is_main_thread(&self) -> bool {
+        thread::current().id() == self.main_thread_id
+    }
+    fn dispatch(&self, runnable: RunnableVariant, priority: Priority) {
+        if let Err(runnable) = self.background.push(priority, runnable) {
+            drop(runnable);
+        }
+    }
+    fn dispatch_on_main_thread(&self, runnable: RunnableVariant, priority: Priority) {
+        let gate = self
+            .wake
+            .enqueue_gate
+            .lock()
+            .unwrap_or_else(|e| e.into_inner());
+        if self.wake.stopped.load(AtomicOrdering::Acquire) {
+            drop(gate);
+            if self.is_main_thread() {
+                drop(runnable);
+            } else {
+                std::mem::forget(runnable);
+            }
+            return;
+        }
+        let result = self.main_sender.send(priority, runnable);
+        drop(gate);
+        match result {
+            Ok(()) => self.wake.notify(),
+            Err(runnable) => std::mem::forget(runnable),
+        }
+    }
+
+    fn dispatch_after(&self, duration: Duration, runnable: RunnableVariant) {
+        let (lock, changed) = &*self.timers;
+        let mut state = lock.lock().unwrap_or_else(|e| e.into_inner());
+        if state.closed {
+            drop(state);
+            drop(runnable);
+            return;
+        }
+        let sequence = state.next_sequence;
+        state.next_sequence = sequence.wrapping_add(1);
+        state.heap.push(TimerAfter {
+            when: Instant::now() + duration,
+            sequence,
+            runnable,
+        });
+        changed.notify_one();
+    }
+    fn spawn_realtime(&self, f: Box<dyn FnOnce() + Send>) {
+        thread::spawn(f);
+    }
+    fn now(&self) -> Instant {
+        Instant::now()
+    }
+}
diff --git a/vendor/gpui-ohos/src/ohos/display.rs b/vendor/gpui-ohos/src/ohos/display.rs
new file mode 100644
index 0000000..489e171
--- /dev/null
+++ b/vendor/gpui-ohos/src/ohos/display.rs
@@ -0,0 +1,278 @@
+use std::{
+    fmt::Debug,
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+use uuid::Uuid;
+
+use super::platform::system_state_plugin::{AvailableArea, DisplaySnapshot};
+use openharmony_ability::{OpenHarmonyApp, display::DisplayInfo as NativeDisplayInfo};
+
+use crate::{Bounds, DisplayId, Pixels, PlatformDisplay, Result, point, px, size};
+
+#[derive(Clone)]
+pub(crate) struct OhosDisplay {
+    app: OpenHarmonyApp,
+    snapshot: Arc<Mutex<Option<DisplaySnapshot>>>,
+    available_area: Arc<Mutex<Option<Bounds<Pixels>>>>,
+}
+
+impl OhosDisplay {
+    pub(crate) fn new(app: OpenHarmonyApp) -> Self {
+        Self {
+            app,
+            snapshot: Arc::new(Mutex::new(None)),
+            available_area: Arc::new(Mutex::new(None)),
+        }
+    }
+
+    pub(crate) fn from_snapshot(app: OpenHarmonyApp, snapshot: DisplaySnapshot) -> Self {
+        let display = Self::new(app);
+        display.update_snapshot(snapshot);
+        display
+    }
+
+    pub(crate) fn id_raw(&self) -> i64 {
+        self.snapshot
+            .lock()
+            .unwrap()
+            .as_ref()
+            .map_or(0, |snapshot| snapshot.id)
+    }
+
+    pub(crate) fn update_snapshot(&self, snapshot: DisplaySnapshot) {
+        if snapshot.id < 0
+            || snapshot.width <= 0
+            || snapshot.height <= 0
+            || !snapshot.density_pixels.is_finite()
+            || snapshot.density_pixels <= 0.0
+        {
+            log::warn!("Ignoring invalid OHOS display snapshot: {snapshot:?}");
+            return;
+        }
+        let area = snapshot.available_area.clone();
+        *self.snapshot.lock().unwrap() = Some(snapshot);
+        *self.available_area.lock().unwrap() = None;
+        if let Some(area) = area {
+            self.set_available_area(area.left, area.top, area.width, area.height);
+        }
+    }
+
+    pub(crate) fn dimensions_and_scale(&self) -> (i32, i32, f32) {
+        if let Some(snapshot) = self.snapshot.lock().unwrap().as_ref() {
+            return (
+                snapshot.width,
+                snapshot.height,
+                snapshot.density_pixels as f32,
+            );
+        }
+        let (width, height) = self.app.display_size();
+        (
+            i32::try_from(width).unwrap_or(i32::MAX),
+            i32::try_from(height).unwrap_or(i32::MAX),
+            self.app.scale().max(f32::EPSILON),
+        )
+    }
+
+    pub(crate) fn scale_factor(&self) -> f32 {
+        self.dimensions_and_scale().2
+    }
+
+    pub(crate) fn set_available_area(&self, left: i32, top: i32, width: i32, height: i32) {
+        let (display_width, display_height, scale) = self.dimensions_and_scale();
+        if left < 0
+            || top < 0
+            || width <= 0
+            || height <= 0
+            || left as i64 + width as i64 > display_width as i64
+            || top as i64 + height as i64 > display_height as i64
+        {
+            log::warn!("Ignoring invalid OHOS available area: {left},{top} {width}x{height}");
+            return;
+        }
+        let bounds = Bounds::new(
+            point(px(left as f32 / scale), px(top as f32 / scale)),
+            size(px(width as f32 / scale), px(height as f32 / scale)),
+        );
+        *self.available_area.lock().unwrap() = Some(bounds);
+        log::info!("OHOS available display area: {bounds:?}");
+    }
+}
+
+impl Debug for OhosDisplay {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("OhosDisplay")
+            .field("id", &self.id_raw())
+            .finish()
+    }
+}
+
+impl PlatformDisplay for OhosDisplay {
+    fn id(&self) -> DisplayId {
+        DisplayId::new(self.id_raw() as u64)
+    }
+
+    fn uuid(&self) -> Result<Uuid> {
+        Ok(Uuid::from_u128(self.id_raw() as u128 + 1))
+    }
+
+    fn bounds(&self) -> Bounds<Pixels> {
+        let (width, height, scale) = self.dimensions_and_scale();
+        if width > 0 && height > 0 {
+            Bounds::new(
+                point(px(0.0), px(0.0)),
+                size(px(width as f32 / scale), px(height as f32 / scale)),
+            )
+        } else {
+            let content_rect = self.app.content_rect();
+            Bounds::new(
+                point(px(0.0), px(0.0)),
+                size(
+                    px(content_rect.width.max(1) as f32 / scale),
+                    px(content_rect.height.max(1) as f32 / scale),
+                ),
+            )
+        }
+    }
+
+    fn visible_bounds(&self) -> Bounds<Pixels> {
+        self.available_area
+            .lock()
+            .unwrap()
+            .unwrap_or_else(|| self.bounds())
+    }
+}
+
+pub(crate) fn seed_native_displays(app: &OpenHarmonyApp) -> (OhosDisplay, Vec<OhosDisplay>) {
+    if super::device::sdk_api_version() < 14 {
+        return (OhosDisplay::new(app.clone()), Vec::new());
+    }
+    let primary_info = openharmony_ability::display::primary_display().ok();
+    let all_infos = openharmony_ability::display::all_displays().ok();
+    let primary_id = primary_info.as_ref().map(|info| info.id).or_else(|| {
+        all_infos
+            .as_ref()
+            .and_then(|list| list.first().map(|info| info.id))
+    });
+
+    let primary_snapshot = primary_info
+        .as_ref()
+        .and_then(|info| snapshot_from_native(info, true))
+        .or_else(|| {
+            let target_id = primary_id?;
+            all_infos
+                .as_ref()?
+                .iter()
+                .find(|info| info.id == target_id)
+                .and_then(|info| snapshot_from_native(info, true))
+        });
+
+    let primary = match primary_snapshot {
+        Some(snapshot) => OhosDisplay::from_snapshot(app.clone(), snapshot),
+        None => OhosDisplay::new(app.clone()),
+    };
+
+    let others = all_infos
+        .unwrap_or_default()
+        .into_iter()
+        .filter(|info| info.is_alive && Some(info.id) != primary_id)
+        .filter_map(|info| snapshot_from_native(&info, false))
+        .map(|snapshot| OhosDisplay::from_snapshot(app.clone(), snapshot))
+        .collect();
+
+    (primary, others)
+}
+
+fn snapshot_from_native(info: &NativeDisplayInfo, is_default: bool) -> Option<DisplaySnapshot> {
+    if info.width <= 0
+        || info.height <= 0
+        || !info.density_pixels.is_finite()
+        || info.density_pixels <= 0.0
+    {
+        return None;
+    }
+    Some(DisplaySnapshot {
+        id: i64::from(info.id),
+        width: info.width,
+        height: info.height,
+        density_pixels: f64::from(info.density_pixels),
+        refresh_rate: (info.refresh_rate > 0).then(|| f64::from(info.refresh_rate)),
+        available_area: query_native_available_area(info.id),
+        is_default,
+    })
+}
+
+fn query_native_available_area(display_id: u32) -> Option<AvailableArea> {
+    #[cfg(feature = "api-26")]
+    {
+        if super::device::sdk_api_version() >= 20 {
+            if let Ok(rect) =
+                openharmony_ability::display::display_available_area(u64::from(display_id))
+            {
+                return Some(AvailableArea {
+                    left: rect.left,
+                    top: rect.top,
+                    width: i32::try_from(rect.width).ok()?,
+                    height: i32::try_from(rect.height).ok()?,
+                });
+            }
+        }
+    }
+    let _ = display_id;
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::snapshot_from_native;
+    use openharmony_ability::display::{DisplayInfo, DisplayState, Orientation, Rotation};
+
+    fn sample_display_info() -> DisplayInfo {
+        DisplayInfo {
+            id: 2,
+            name: "External".into(),
+            is_alive: true,
+            width: 2560,
+            height: 1600,
+            physical_width: 2560,
+            physical_height: 1600,
+            refresh_rate: 120,
+            available_width: 2560,
+            available_height: 1520,
+            density_dpi: 320.0,
+            density_pixels: 2.0,
+            scaled_density: 2.0,
+            x_dpi: 254.0,
+            y_dpi: 254.0,
+            rotation: Rotation::Rotation0,
+            state: DisplayState::On,
+            orientation: Orientation::Landscape,
+            hdr_formats: Vec::new(),
+            color_spaces: Vec::new(),
+        }
+    }
+
+    #[test]
+    fn converts_valid_native_display_info_and_rejects_invalid_metrics() {
+        let info = sample_display_info();
+        let snapshot = snapshot_from_native(&info, false).expect("valid snapshot");
+        assert_eq!(snapshot.id, 2);
+        assert_eq!((snapshot.width, snapshot.height), (2560, 1600));
+        assert_eq!(snapshot.density_pixels, 2.0);
+        assert_eq!(snapshot.refresh_rate, Some(120.0));
+        assert!(!snapshot.is_default);
+
+        let mut zero_refresh = sample_display_info();
+        zero_refresh.refresh_rate = 0;
+        assert_eq!(
+            snapshot_from_native(&zero_refresh, true)
+                .expect("zero refresh rate should map to None")
+                .refresh_rate,
+            None
+        );
+
+        let mut bad_density = sample_display_info();
+        bad_density.density_pixels = 0.0;
+        assert!(snapshot_from_native(&bad_density, true).is_none());
+    }
+}
