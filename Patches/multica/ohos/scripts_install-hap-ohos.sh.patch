OHOS: install a built HAP on the local device in chunks (the local hdc
loopback stalls on transfers of about 20 MB or more), and optionally start it.

diff --git a/scripts/install-hap-ohos.sh b/scripts/install-hap-ohos.sh
new file mode 100644
index 0000000..06528cf
--- /dev/null
+++ b/scripts/install-hap-ohos.sh
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+# Chunk-transfer a built HAP to the local device and install it.
+# (The local hdc loopback stalls on transfers >= ~20MB, hence the chunks.)
+#
+# Usage: install-hap.sh <path-to-signed.hap> [--start]
+#   --start also launches the app (requires an unlocked screen; warns instead
+#   of failing when the screen is locked).
+
+set -euo pipefail
+
+HAP="${1:?usage: install-hap.sh <signed.hap> [--start]}"
+START="${2:-}"
+name=multica-install
+
+parts=$(mktemp -d /data/storage/el2/base/cache/multica-iparts-XXXXXX)
+trap 'rm -r "$parts"' EXIT
+
+split -b 10000000 "$HAP" "$parts/part-"
+hdc shell "rm -f /data/local/tmp/$name-part-*"
+for p in "$parts"/part-*; do
+  hdc file send "$p" "/data/local/tmp/$name-$(basename "$p")"
+done
+hdc shell "cat /data/local/tmp/$name-part-* > /data/local/tmp/$name.hap"
+hdc shell aa force-stop com.huawei.ohos_electron
+if ! install_output=$(hdc shell bm install -p "/data/local/tmp/$name.hap" 2>&1); then
+  printf '%s\n' "$install_output" >&2
+  exit 1
+fi
+printf '%s\n' "$install_output"
+if ! printf '%s\n' "$install_output" | grep -qiE 'install bundle successfully|^success'; then
+  echo "ERROR: HAP installation did not report success" >&2
+  exit 1
+fi
+
+if [[ "$START" == "--start" ]]; then
+  if start_output=$(hdc shell aa start -a EntryAbility -b com.huawei.ohos_electron -m electron 2>&1) &&
+    printf '%s\n' "$start_output" | grep -qi 'start ability successfully'; then
+    printf '%s\n' "$start_output"
+  else
+    printf '%s\n' "$start_output" >&2
+    echo "WARN: aa start failed (screen locked?) — start the app manually" >&2
+  fi
+fi
