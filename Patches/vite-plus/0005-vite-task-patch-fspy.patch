OHOS: point fspy and fspy_preload_unix at the patched vite-task checkout.

The formula stages the vite-task-src resource at ../vite-task. vt is
deliberately not patched: packages/cli/build.ts stamps the toolchain node with
the exact git revision of the vt package, and a path source has none.

--- a/Cargo.toml
+++ b/Cargo.toml
@@ -442,3 +442,7 @@
 # The installer binary is downloaded by users, so optimize for size.
 [profile.release.package.vp_installer]
 opt-level = "z"
+
+[patch."https://github.com/voidzero-dev/vite-task.git"]
+fspy = { path = "../vite-task/crates/fspy" }
+fspy_preload_unix = { path = "../vite-task/crates/fspy_preload_unix" }
