+    endif()
     if(APPLE)
         set(_snow_rust_deployment_target "15.0")
         if(CMAKE_OSX_DEPLOYMENT_TARGET)
@@ -358,8 +376,8 @@
 
 function(snow_add_rust_static_library target_name)
     set(options STRIP_MSVC_DIRECTIVES NO_DEFAULT_FEATURES)
