OHOS: accept live-window targets without requiring `processId > 0`, since
OHOS window queries do not expose that field; drop a fallback definition from
an earlier revision that only compiles on neither OHOS nor Windows/macOS —
this tap only ships OHOS, so there is no such configuration to support.

--- a/snow_shot/src/presentation/pinned/livewindowsource.cpp
+++ b/snow_shot/src/presentation/pinned/livewindowsource.cpp
@@ -968,8 +968,12 @@

 std::shared_ptr<LiveWindowSource> createLiveWindowSource(const LiveWindowTarget& target,
                                                          const QRect& selection) {
-    if (!target.nativeId || target.processId <= 0 || selection.isEmpty())
+    if (!target.nativeId || selection.isEmpty())
         return {};
+#if !defined(Q_OS_OHOS) && !defined(Q_OS_HARMONY)
+    if (target.processId <= 0)
+        return {};
+#endif
     return std::make_shared<CapturedLiveWindowSource>(target, selection);
 }
 } // namespace snow_shot::presentation
