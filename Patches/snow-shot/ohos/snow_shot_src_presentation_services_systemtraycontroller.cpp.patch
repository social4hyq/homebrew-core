OHOS: `showRecordingExportMessage`'s notification delivery is independent of
whether the tray icon is shown at all, and still has a real caller; on OHOS
the user must be told to pick a destination through Files, so the wording
changes to avoid implying the recording was already saved to some private
app path. Only the message text changes, not the notification protocol.

diff --git a/snow_shot/src/presentation/services/systemtraycontroller.cpp b/snow_shot/src/presentation/services/systemtraycontroller.cpp
index 0fb3c4f..8eeda7d 100644
--- a/snow_shot/src/presentation/services/systemtraycontroller.cpp
+++ b/snow_shot/src/presentation/services/systemtraycontroller.cpp
@@ -991,8 +991,13 @@ void SystemTrayController::showRecordingExportMessage(const QString& path) {
     if (path.isEmpty())
         return;
     const QString absolutePath = QFileInfo(path).absoluteFilePath();
-    m_impl->showBalloon(tr("Video export completed"), QDir::toNativeSeparators(absolutePath),
-                        QSystemTrayIcon::Information, BalloonKind::RecordingExport, absolutePath);
+#ifdef Q_OS_HARMONY
+    const QString message = tr("Choose a destination in Files to save the recording.");
+#else
+    const QString message = QDir::toNativeSeparators(absolutePath);
+#endif
+    m_impl->showBalloon(tr("Video export completed"), message, QSystemTrayIcon::Information,
+                        BalloonKind::RecordingExport, absolutePath);
 }
 
 void SystemTrayController::setEnabled(bool enabled) {
