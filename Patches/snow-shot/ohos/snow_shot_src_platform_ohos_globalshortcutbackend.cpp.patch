+napi_value activateRegisteredHotkey(napi_env env, napi_callback_info info) {
+    size_t argc = 1;
+    napi_value argv[1] = {nullptr};
+    if (napi_get_cb_info(env, info, &argc, argv, nullptr, nullptr) != napi_ok || argc != 1)
+        return nullptr;
+    size_t length = 0;
+    if (napi_get_value_string_utf8(env, argv[0], nullptr, 0, &length) != napi_ok || length == 0)
+        return nullptr;
+    std::vector<char> buffer(length + 1);
+    if (napi_get_value_string_utf8(env, argv[0], buffer.data(), buffer.size(), &length) != napi_ok)
+        return nullptr;
+    const QString shortcut = QString::fromUtf8(buffer.data(), static_cast<qsizetype>(length));
+    qInfo() << "SNOW_OHOS_HOTKEY_NAPI_RECEIVED" << shortcut;
+    GlobalShortcutBackend::ActivationHandler handler;
+    int id = 0;
+    {
+        const std::lock_guard lock(callbackMutex);
+        const auto it = registeredShortcuts.find(shortcut);
+        if (it != registeredShortcuts.end()) {
+            id = it->second.first;
+            handler = it->second.second;
+        }
+    }
+    auto* app = QCoreApplication::instance();
+    if (app != nullptr && handler) {
+        const bool queued = QMetaObject::invokeMethod(
+            app, [handler = std::move(handler), id] { handler(id); }, Qt::QueuedConnection);
+        qInfo() << "SNOW_OHOS_HOTKEY_DISPATCH" << shortcut << "id" << id << "queued" << queued;
+        if (!queued)
+            qWarning() << "Failed to queue OHOS shortcut activation" << shortcut;
+    } else {
+        qWarning() << "SNOW_OHOS_HOTKEY_UNREGISTERED" << shortcut << "app" << (app != nullptr)
+                   << "handler" << static_cast<bool>(handler);
+    }
+    napi_value undefined = nullptr;
+    napi_get_undefined(env, &undefined);
+    return undefined;
+}
+
+napi_value initializeNativeHotkeys(napi_env env, napi_value exports) {
+    napi_property_descriptor properties[] = {
+        {"getRegisteredHotkeys", nullptr, getRegisteredHotkeys, nullptr, nullptr, nullptr,
+         napi_default, nullptr},
+        {"activateHotkey", nullptr, activateRegisteredHotkey, nullptr, nullptr, nullptr,
+         napi_default, nullptr},
+        {"parseShortcut", nullptr, parseShortcutForArkTs, nullptr, nullptr, nullptr, napi_default,
+         nullptr},
+        {"rejectHotkeyRegistration", nullptr, rejectHotkeyRegistration, nullptr, nullptr, nullptr,
+         napi_default, nullptr},
+        {"takePendingUserFileExports", nullptr, takePendingUserFileExports, nullptr, nullptr,
+         nullptr, napi_default, nullptr},
+        {"completeUserFileExport", nullptr, completeUserFileExport, nullptr, nullptr, nullptr,
+         napi_default, nullptr},
+        {"takePendingUserFileSavePickers", nullptr, takePendingUserFileSavePickers, nullptr,
+         nullptr, nullptr, napi_default, nullptr},
+        {"completeUserFileSavePicker", nullptr, completeUserFileSavePicker, nullptr, nullptr,
+         nullptr, napi_default, nullptr},
+    };
+    napi_define_properties(env, exports, std::size(properties), properties);
+    return exports;
+}
+
+NAPI_MODULE(snow_shot, initializeNativeHotkeys)
+
+GlobalShortcutValidationResult validation(const shortcuts::ShortcutBinding& binding,
+                                          bool supported) {
+    return {binding.portableText, supported,
+            supported ? GlobalShortcutFailureReason::None
+                      : GlobalShortcutFailureReason::InvalidShortcut,
+            binding};
+}
+
+class OhosGlobalShortcutBackend final : public GlobalShortcutBackend {
+  public:
+    void setActivationHandler(ActivationHandler handler) override {
+        handler_ = std::move(handler);
+    }
+    void setAvailabilityChangedHandler(AvailabilityChangedHandler handler) override {
+        const std::lock_guard lock(callbackMutex);
+        availabilityChangedHandler = std::move(handler);
+    }
+    void refreshAvailability() override {
+        AvailabilityChangedHandler handler;
+        {
+            const std::lock_guard lock(callbackMutex);
+            rejectedShortcutErrors.clear();
+            handler = availabilityChangedHandler;
+        }
+        if (handler)
+            handler({});
+    }
+    GlobalShortcutValidationResult
+    validateShortcut(const shortcuts::ShortcutBinding& binding) const override {
+        return validation(binding, parse(binding).has_value());
+    }
+    GlobalShortcutBackendResult
+    registerShortcut(int id, const shortcuts::ShortcutBinding& binding) override {
+        if (!parse(binding))
+            return {false, GlobalShortcutFailureReason::InvalidShortcut, 0};
+        if (shortcutTexts_.contains(id))
+            unregisterShortcut(id);
+        {
+            const std::lock_guard lock(callbackMutex);
+            const auto rejected = rejectedShortcutErrors.find(binding.portableText);
+            if (rejected != rejectedShortcutErrors.end()) {
+                const bool occupied = rejected->second == 4200002 || rejected->second == 4200003;
+                return {false,
+                        occupied ? GlobalShortcutFailureReason::AlreadyInUse
+                                 : GlobalShortcutFailureReason::SystemError,
+                        static_cast<qint64>(rejected->second)};
+            }
+        }
+        shortcutTexts_.insert_or_assign(id, binding.portableText);
+        {
+            const std::lock_guard lock(callbackMutex);
+            registeredShortcuts.insert_or_assign(binding.portableText,
+                                                 std::make_pair(id, handler_));
+        }
+        // OH_Input_AddHotkeyMonitor reports success but does not deliver the
+        // callback on this device. ArkTS InputKit owns the OS subscription;
+        // this backend tracks logical registrations and dispatches NAPI events.
+        return {true, GlobalShortcutFailureReason::None, 0};
+    }
+    void unregisterShortcut(int id) override {
+        const auto text = shortcutTexts_.find(id);
+        if (text != shortcutTexts_.end()) {
+            const std::lock_guard lock(callbackMutex);
+            const auto registered = registeredShortcuts.find(text->second);
+            if (registered != registeredShortcuts.end() && registered->second.first == id)
+                registeredShortcuts.erase(registered);
+            shortcutTexts_.erase(text);
+        }
+    }
+
+  private:
+    ActivationHandler handler_;
+    std::map<int, QString> shortcutTexts_;
+};
+} // namespace
+
+std::unique_ptr<GlobalShortcutBackend> createOhosGlobalShortcutBackend() {
+    return std::make_unique<OhosGlobalShortcutBackend>();
+}
