+#if defined(Q_OS_HARMONY)
+namespace {
+std::uint32_t pasteboardChangeCount() {
+    auto* pasteboard = OH_Pasteboard_Create();
+    if (pasteboard == nullptr)
+        return 0;
+    const auto count = OH_Pasteboard_GetChangeCount(pasteboard);
+    OH_Pasteboard_Destroy(pasteboard);
+    return count;
+}
+} // namespace
+
+std::optional<QByteArray> latestPublishedClipboardPng() {
+    using namespace snow_shot::presentation::clipboard_cache;
+    QMutexLocker locker(&mutex());
+    const auto& png = latestPng();
+    qWarning("SNOW_CLIP_CACHE query present=%d bytes=%d", png.has_value(),
+             png.has_value() ? static_cast<int>(png->size()) : -1);
+    if (!png.has_value() || png->isEmpty())
+        return std::nullopt;
+    const auto currentCount = pasteboardChangeCount();
+    const auto recordedCount = recordedChangeCount();
+    // Do not serve stale content after another process changed the clipboard.
+    if (currentCount != recordedCount) {
+        qWarning("SNOW_CLIP_CACHE stale current=%u recorded=%u", currentCount, recordedCount);
+        return std::nullopt;
+    }
+    qWarning("SNOW_CLIP_CACHE hit count=%u bytes=%d", currentCount,
+             static_cast<int>(png->size()));
+    return *png;
+}
+#endif
