+void recognitionSaveUsesDocumentPickerAndUriExportQueue() {
+    using namespace snow_shot::platform::ohos;
+    QCoreApplication::setOrganizationName(QStringLiteral("SnowShotTests"));
+    QCoreApplication::setApplicationName(QStringLiteral("image-editing-user-file-save-tests"));
+    QObject lifetime;
+    QWidget owner;
+    owner.show();
+    ExportController controller(nullptr, &lifetime);
+    bool completed = false;
+    bool succeeded = false;
+    QString completionError;
+    controller.start(ExportController::Operation::Save, QStringLiteral("recognized text"), &owner,
+                     nullptr, [&](bool success, QString error) {
+                         completed = true;
+                         succeeded = success;
+                         completionError = std::move(error);
+                     });
+
+    auto& pickerQueue = sharedUserFileSavePickerQueue();
+    const auto pendingPickers = pickerQueue.takePending();
+    require(pendingPickers.size() == 1 &&
+                pendingPickers.front().suggestedName.endsWith(QStringLiteral(".txt")),
+            "image-editing recognition save must request a system document destination");
+    const QString targetUri =
+        QStringLiteral("file://docs/storage/Users/currentUser/Documents/Recognized.txt");
+    require(pickerQueue.complete(pendingPickers.front().id, targetUri, 0),
+            "the authorized destination URI must resume the image-editing save");
+
+    UserFileExportRequest pendingExport;
+    bool exportReady = false;
+    auto& exportQueue = sharedUserFileExportQueue();
+    awaitCondition(
+        [&] {
+            const auto requests = exportQueue.takePending();
+            if (!requests.empty()) {
+                pendingExport = requests.front();
+                exportReady = true;
+            }
+            return exportReady || completed;
+        },
+        "image-editing recognition save must either publish or report a failure");
+    if (completed && !exportReady)
+        throw std::runtime_error(completionError.toStdString());
+    require(pendingExport.uri == targetUri && QFileInfo::exists(pendingExport.sourcePath),
+            "the export queue must receive a staged file and the unchanged authorized URI");
+    require(exportQueue.complete(pendingExport.id, true),
+            "the platform writer completion must settle the export");
+    awaitCondition([&] { return completed; },
+                   "image-editing recognition save must complete after publication");
+    require(succeeded && !QFileInfo::exists(pendingExport.sourcePath),
+            "successful user-file publication must remove its private staging file");
+
+    completed = false;
+    succeeded = true;
+    controller.start(ExportController::Operation::Save, QStringLiteral("cancelled text"), &owner,
+                     nullptr, [&](bool success, QString) {
+                         completed = true;
+                         succeeded = success;
+                     });
+    const auto cancelledPicker = pickerQueue.takePending();
+    require(cancelledPicker.size() == 1 && pickerQueue.complete(cancelledPicker.front().id, {}, -1,
+                                                                QStringLiteral("cancelled")),
+            "cancelling the system picker must be reported to the pending save");
+    awaitCondition([&] { return completed; },
+                   "picker cancellation must release the image-editing save request");
+    require(!succeeded && !controller.busy(),
+            "picker cancellation must not report a successful recognition export");
+
+    completed = false;
+    succeeded = false;
+    controller.start(ExportController::Operation::Save,
+                     ScreenshotRecognitionFileSnapshot{ScreenshotRecognitionFileKind::Html,
+                                                       QStringLiteral("<p>recognized html</p>")},
+                     &owner, nullptr, [&](bool success, QString) {
+                         completed = true;
+                         succeeded = success;
+                     });
+    const auto primaryPicker = pickerQueue.takePending();
+    require(primaryPicker.size() == 1 &&
+                primaryPicker.front().suggestedName.endsWith(QStringLiteral(".html")),
+            "HTML recognition export must choose its primary document through the picker");
+    const QString primaryUri =
+        QStringLiteral("file://docs/storage/Users/currentUser/Documents/Recognition.html");
+    require(pickerQueue.complete(primaryPicker.front().id, primaryUri, 0),
+            "the primary HTML URI must resume the document exporter");
+    UserFileExportRequest primaryExport;
+    bool primaryReady = false;
+    awaitCondition(
+        [&] {
+            const auto requests = exportQueue.takePending();
+            if (!requests.empty()) {
+                primaryExport = requests.front();
+                primaryReady = true;
+            }
+            return primaryReady;
+        },
+        "HTML output must be staged before the primary URI write");
+    require(exportQueue.complete(primaryExport.id, true),
+            "the primary HTML user-file write must complete");
+    std::vector<UserFileSavePickerRequest> companionPicker;
+    awaitCondition(
+        [&] {
+            companionPicker = pickerQueue.takePending();
+            return !companionPicker.empty();
+        },
+        "the companion picker must be enqueued after the primary file is written");
+    require(companionPicker.size() == 1 &&
+                companionPicker.front().suggestedName.endsWith(QStringLiteral(".txt")),
+            "HTML export must ask separately for its text companion destination");
+    const QString companionUri =
+        QStringLiteral("file://docs/storage/Users/currentUser/Documents/Recognition.txt");
+    require(pickerQueue.complete(companionPicker.front().id, companionUri, 0),
+            "the text companion URI must resume publication");
+    UserFileExportRequest companionExport;
+    bool companionReady = false;
+    awaitCondition(
+        [&] {
+            const auto requests = exportQueue.takePending();
+            if (!requests.empty()) {
+                companionExport = requests.front();
+                companionReady = true;
+            }
+            return companionReady;
+        },
+        "the companion text file must be staged before its URI write");
+    require(companionExport.uri == companionUri && exportQueue.complete(companionExport.id, true),
+            "the text companion must publish to its separately authorized URI");
+    awaitCondition([&] { return completed; },
+                   "HTML and companion publication must complete as one export request");
+    require(succeeded && !QFileInfo::exists(primaryExport.sourcePath) &&
+                !QFileInfo::exists(companionExport.sourcePath),
+            "all HTML staging files must be removed after the two-file publication");
+
+    completed = false;
+    succeeded = true;
+    completionError.clear();
+    controller.start(ExportController::Operation::Save,
+                     ScreenshotRecognitionFileSnapshot{ScreenshotRecognitionFileKind::Markdown,
+                                                       QStringLiteral("# recognized markdown")},
+                     &owner, nullptr, [&](bool success, QString error) {
+                         completed = true;
+                         succeeded = success;
+                         completionError = std::move(error);
+                     });
+    const auto markdownPicker = pickerQueue.takePending();
+    require(markdownPicker.size() == 1 &&
+                markdownPicker.front().suggestedName.endsWith(QStringLiteral(".md")),
+            "Markdown recognition export must request its primary destination first");
+    require(pickerQueue.complete(
+                markdownPicker.front().id,
+                QStringLiteral("file://docs/storage/Users/currentUser/Documents/Recognition.md"),
+                0),
+            "the Markdown primary URI must resume export");
+    UserFileExportRequest markdownPrimary;
+    bool markdownPrimaryReady = false;
+    awaitCondition(
+        [&] {
+            const auto requests = exportQueue.takePending();
+            if (!requests.empty()) {
+                markdownPrimary = requests.front();
+                markdownPrimaryReady = true;
+            }
+            return markdownPrimaryReady;
+        },
+        "Markdown output must be staged before its primary URI write");
+    require(exportQueue.complete(markdownPrimary.id, true),
+            "the Markdown primary user-file write must complete before companion selection");
+    std::vector<UserFileSavePickerRequest> markdownCompanionPicker;
+    awaitCondition(
+        [&] {
+            markdownCompanionPicker = pickerQueue.takePending();
+            return !markdownCompanionPicker.empty();
+        },
+        "Markdown export must enqueue a companion picker after primary publication");
+    require(markdownCompanionPicker.size() == 1 &&
+                markdownCompanionPicker.front().suggestedName.endsWith(QStringLiteral(".txt")),
+            "Markdown export must request a separate companion destination");
+    require(pickerQueue.complete(markdownCompanionPicker.front().id, {}, -1,
+                                 QStringLiteral("cancelled")),
+            "cancelling the companion picker must settle the pending picker request");
+    awaitCondition([&] { return completed; },
+                   "companion picker cancellation must complete the Markdown export request");
+    require(!succeeded && completionError.contains(QStringLiteral("primary result was saved")) &&
+                !QFileInfo::exists(markdownPrimary.sourcePath),
+            "companion cancellation reports partial success and removes all remaining staging");
+}
