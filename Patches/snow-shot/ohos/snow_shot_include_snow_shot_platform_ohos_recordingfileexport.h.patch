+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef SNOW_SHOT_PLATFORM_OHOS_RECORDINGFILEEXPORT_H
+#define SNOW_SHOT_PLATFORM_OHOS_RECORDINGFILEEXPORT_H
+
+#include <QObject>
+#include <QString>
+
+#include <functional>
+
+namespace snow_shot::platform::ohos {
+
+class RecordingFileExport final : public QObject {
+  public:
+    enum class Result { Succeeded, Cancelled, Failed };
+    using Completion = std::function<void(Result, QString)>;
+
+    explicit RecordingFileExport(QObject* parent = nullptr);
+    ~RecordingFileExport() override;
+
+    void setCompletion(Completion completion);
+    [[nodiscard]] bool start(const QString& sourcePath);
+    [[nodiscard]] bool active() const noexcept;
+
+  private:
+    void finish(Result result, QString error = {});
+
+    Completion m_completion;
+    quint64 m_pickerRequestId = 0;
+    quint64 m_exportRequestId = 0;
+    bool m_active = false;
+    bool m_destroying = false;
+};
+
+} // namespace snow_shot::platform::ohos
+
+#endif // SNOW_SHOT_PLATFORM_OHOS_RECORDINGFILEEXPORT_H
