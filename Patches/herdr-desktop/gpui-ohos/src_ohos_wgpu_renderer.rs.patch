+/// Vertex layout the poly-sprite pipeline expects (order, tile first), packed from
+/// whatever order `gpui::PolychromeSprite` happens to use.
+#[repr(C)]
+#[derive(Clone, Copy, bytemuck::Pod, bytemuck::Zeroable)]
+struct PolySpriteInstance {
+    order: u32,
+    pad: u32,
+    texture_id: u32,
+    texture_kind: u32,
+    tile_id: u32,
+    tile_padding: u32,
+    tile_origin_x: i32,
+    tile_origin_y: i32,
+    tile_size_w: i32,
+    tile_size_h: i32,
+    grayscale: u32,
+    opacity: f32,
+    bounds_x: f32,
+    bounds_y: f32,
+    bounds_w: f32,
+    bounds_h: f32,
+    mask_x: f32,
+    mask_y: f32,
+    mask_w: f32,
+    mask_h: f32,
+    corner_tl: f32,
+    corner_tr: f32,
+    corner_br: f32,
+    corner_bl: f32,
+}
+
+impl From<&PolychromeSprite> for PolySpriteInstance {
+    fn from(sprite: &PolychromeSprite) -> Self {
+        let bounds = sprite.bounds;
+        let mask = sprite.content_mask.bounds;
+        PolySpriteInstance {
+            order: sprite.order,
+            pad: sprite.pad,
+            texture_id: sprite.tile.texture_id.index,
+            texture_kind: sprite.tile.texture_id.kind as u32,
+            tile_id: sprite.tile.tile_id.0,
+            tile_padding: sprite.tile.padding,
+            tile_origin_x: sprite.tile.bounds.origin.x.0,
+            tile_origin_y: sprite.tile.bounds.origin.y.0,
+            tile_size_w: sprite.tile.bounds.size.width.0,
+            tile_size_h: sprite.tile.bounds.size.height.0,
+            grayscale: u32::from(sprite.grayscale == true.into()),
+            opacity: sprite.opacity,
+            bounds_x: bounds.origin.x.0,
+            bounds_y: bounds.origin.y.0,
+            bounds_w: bounds.size.width.0,
+            bounds_h: bounds.size.height.0,
+            mask_x: mask.origin.x.0,
+            mask_y: mask.origin.y.0,
+            mask_w: mask.size.width.0,
+            mask_h: mask.size.height.0,
+            corner_tl: sprite.corner_radii.top_left.0,
+            corner_tr: sprite.corner_radii.top_right.0,
+            corner_br: sprite.corner_radii.bottom_right.0,
+            corner_bl: sprite.corner_radii.bottom_left.0,
+        }
+    }
+}
+
+/// Vertex layout the monochrome/subpixel pipelines expect, packed from
+/// `gpui::MonochromeSprite`/`SubpixelSprite` field orders.
+#[repr(C)]
+#[derive(Clone, Copy, bytemuck::Pod, bytemuck::Zeroable)]
+struct MonoSpriteInstance {
+    order: u32,
+    pad: u32,
+    texture_id: u32,
+    texture_kind: u32,
+    tile_id: u32,
+    tile_padding: u32,
+    tile_origin_x: i32,
+    tile_origin_y: i32,
+    tile_size_w: i32,
+    tile_size_h: i32,
+    bounds_x: f32,
+    bounds_y: f32,
+    bounds_w: f32,
+    bounds_h: f32,
+    mask_x: f32,
+    mask_y: f32,
+    mask_w: f32,
+    mask_h: f32,
+    color_r: f32,
+    color_g: f32,
+    color_b: f32,
+    color_a: f32,
+    transform_00: f32,
+    transform_01: f32,
+    transform_10: f32,
+    transform_11: f32,
+    translate_x: f32,
+    translate_y: f32,
+}
+
+fn mono_instance(
+    order: u32,
+    pad: u32,
+    tile: &gpui::AtlasTile,
+    bounds: gpui::Bounds<gpui::ScaledPixels>,
+    content_mask: gpui::ContentMask<gpui::ScaledPixels>,
+    color: gpui::Hsla,
+    transformation: &gpui::TransformationMatrix,
+) -> MonoSpriteInstance {
+    MonoSpriteInstance {
+        order,
+        pad,
+        texture_id: tile.texture_id.index,
+        texture_kind: tile.texture_id.kind as u32,
+        tile_id: tile.tile_id.0,
+        tile_padding: tile.padding,
+        tile_origin_x: tile.bounds.origin.x.0,
+        tile_origin_y: tile.bounds.origin.y.0,
+        tile_size_w: tile.bounds.size.width.0,
+        tile_size_h: tile.bounds.size.height.0,
+        bounds_x: bounds.origin.x.0,
+        bounds_y: bounds.origin.y.0,
+        bounds_w: bounds.size.width.0,
+        bounds_h: bounds.size.height.0,
+        mask_x: content_mask.bounds.origin.x.0,
+        mask_y: content_mask.bounds.origin.y.0,
+        mask_w: content_mask.bounds.size.width.0,
+        mask_h: content_mask.bounds.size.height.0,
+        color_r: color.to_rgb().r,
+        color_g: color.to_rgb().g,
+        color_b: color.to_rgb().b,
+        color_a: color.to_rgb().a,
+        transform_00: transformation.rotation_scale[0][0],
+        transform_01: transformation.rotation_scale[0][1],
+        transform_10: transformation.rotation_scale[1][0],
+        transform_11: transformation.rotation_scale[1][1],
+        translate_x: transformation.translation[0],
+        translate_y: transformation.translation[1],
+    }
+}
+
+impl From<&MonochromeSprite> for MonoSpriteInstance {
+    fn from(sprite: &MonochromeSprite) -> Self {
+        mono_instance(
+            sprite.order,
+            sprite.pad,
+            &sprite.tile,
+            sprite.bounds,
+            sprite.content_mask,
+            sprite.color,
+            &sprite.transformation,
+        )
+    }
+}
+
+impl From<&gpui::SubpixelSprite> for MonoSpriteInstance {
+    fn from(sprite: &gpui::SubpixelSprite) -> Self {
+        mono_instance(
+            sprite.order,
+            sprite.pad,
+            &sprite.tile,
+            sprite.bounds,
+            sprite.content_mask,
+            sprite.color,
+            &sprite.transformation,
+        )
+    }
+}
