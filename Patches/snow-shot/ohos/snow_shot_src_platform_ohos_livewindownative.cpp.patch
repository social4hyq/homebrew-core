+QRect rect(const WindowManager_Rect& value) {
+    if (!value.width || !value.height ||
+        value.width > static_cast<uint32_t>(std::numeric_limits<int>::max()) ||
+        value.height > static_cast<uint32_t>(std::numeric_limits<int>::max()))
+        return {};
+    return {value.posX, value.posY, static_cast<int>(value.width), static_cast<int>(value.height)};
+}
+
+bool sameRect(const QRect& left, const QRect& right) {
+    return left == right;
+}
+
+class MainWindowList final {
+  public:
+    MainWindowList() {
+        m_result = OH_WindowManager_GetAllMainWindowInfo(&m_items, &m_size);
+    }
+    ~MainWindowList() {
+        if (m_items)
+            OH_WindowManager_ReleaseAllMainWindowInfo(m_items);
+    }
+    MainWindowList(const MainWindowList&) = delete;
+    MainWindowList& operator=(const MainWindowList&) = delete;
+    bool valid() const {
+        return m_result == 0 && m_items;
+    }
+    int32_t result() const {
+        return m_result;
+    }
+    size_t size() const {
+        return m_size;
+    }
+    const WindowManager_MainWindowInfo* begin() const {
+        return m_items;
+    }
+    const WindowManager_MainWindowInfo* end() const {
+        return m_items ? m_items + m_size : nullptr;
+    }
+
+  private:
+    WindowManager_MainWindowInfo* m_items = nullptr;
+    size_t m_size = 0;
+    int32_t m_result = -1;
+};
+
+ohos_live_window_detail::WindowLookupState windowLookup(int32_t windowId) {
+    MainWindowList windows;
+    if (!windows.valid()) {
+        qWarning() << "SNOW_OHOS_LIVE_WINDOW_ENUMERATION_FAILED" << windows.result()
+                   << windows.size();
+        return ohos_live_window_detail::WindowLookupState::Unavailable;
+    }
+    const bool visible =
+        std::any_of(windows.begin(), windows.end(), [windowId](const auto& window) {
+            return window.windowId == windowId && window.showing;
+        });
+    return visible ? ohos_live_window_detail::WindowLookupState::Visible
+                   : ohos_live_window_detail::WindowLookupState::Hidden;
+}
+
+bool windowBounds(int32_t windowId, QRect* bounds) {
+    if (!bounds)
+        return false;
+    WindowManager_WindowProperties properties{};
+    const int32_t result = OH_WindowManager_GetWindowProperties(windowId, &properties);
+    if (result != 0) {
+        qWarning() << "SNOW_OHOS_LIVE_WINDOW_PROPERTIES_FAILED" << windowId << result;
+        return false;
+    }
+    *bounds = rect(properties.windowRect);
+    return !bounds->isEmpty();
+}
