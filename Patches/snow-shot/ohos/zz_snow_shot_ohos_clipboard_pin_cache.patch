+        g_latestClipboardPng = png;
+        publishSerial = ++g_latestClipboardPublishSerial;
+    }
+    // Qt's OHOS clipboard write crosses the JS thread; the pasteboard change
+    // counter can still describe the previous owner when setMimeData returns.
+    // Refresh it after the write settles, but never after a newer publication.
+    QTimer::singleShot(250, QCoreApplication::instance(), [publishSerial] {
+        QMutexLocker locker(&g_latestClipboardPngMutex);
+        if (publishSerial != g_latestClipboardPublishSerial)
+            return;
+        g_latestClipboardChangeCount = pasteboardChangeCount();
+    });
+#endif
     return true;
 }
