OHOS: Snow Shot's own strict-warnings switch is overridden by the root
SNOW_APPS_STRICT_COMPILE option, and snow_image/Ant Design/MicroTeX call the
strict-warnings function independently of it. Keep the warnings themselves
but stop promoting them to errors on OHOS, since the SDK's libc++ headers
trigger warnings the upstream toolchains do not.

diff --git a/cmake/ProjectWarnings.cmake b/cmake/ProjectWarnings.cmake
index a4fe0b7..088024c 100644
--- a/cmake/ProjectWarnings.cmake
+++ b/cmake/ProjectWarnings.cmake
@@ -63,7 +63,7 @@ function(snow_apply_strict_warnings target)
         endif()
     elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
         target_compile_options("${target}" PRIVATE
-            -Wall -Wextra -Wpedantic -Werror
+            -Wall -Wextra -Wpedantic
             -Wcast-align -Wcast-qual -Wconversion -Wdouble-promotion
             -Wformat=2 -Wimplicit-fallthrough -Wmissing-declarations
             -Wnon-virtual-dtor -Wnull-dereference -Wold-style-cast
@@ -217,7 +217,7 @@ function(snow_enable_strict_warnings)
         endif()
     elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
         add_compile_options(
-            -Wall -Wextra -Wpedantic -Werror
+            -Wall -Wextra -Wpedantic
             -Wcast-align -Wcast-qual -Wconversion -Wdouble-promotion
             -Wformat=2 -Wimplicit-fallthrough -Wmissing-declarations
             -Wnon-virtual-dtor -Wnull-dereference -Wold-style-cast
