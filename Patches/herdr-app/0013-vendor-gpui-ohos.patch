index 0000000..3557e62
--- /dev/null
+++ b/vendor/gpui-ohos/src/ohos/image_alpha.rs
@@ -0,0 +1,177 @@
+//! Explicit alpha encoding for externally rasterized images. The image and its
+//! registration share a lifetime; ordinary GPUI images retain straight alpha.
+use gpui::{AtlasTextureId, ImageId, PolychromeSprite, RenderImage};
+use parking_lot::Mutex;
+use rustc_hash::FxHashMap;
+use std::{
+    fmt,
+    sync::{Arc, OnceLock, Weak},
+};
+
+type Registrations = FxHashMap<ImageId, Weak<Registration>>;
+
+fn registrations() -> &'static Mutex<Registrations> {
+    static IMAGES: OnceLock<Mutex<Registrations>> = OnceLock::new();
+    IMAGES.get_or_init(Default::default)
+}
+
+/// Keeps an image marked as premultiplied while it is cached or being painted.
+/// Register before the first paint uploads the image into an atlas.
+#[derive(Clone)]
+pub struct PremultipliedImage(Arc<Registration>);
+
+struct Registration {
+    image: Arc<RenderImage>,
+    policy: ImagePolicy,
+}
+
+/// The explicit alpha encoding and sampling policy of a registered image.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ImagePolicy {
+    /// Premultiplied pixels with ordinary linear UI sampling.
+    PremultipliedLinear,
+    /// Straight-alpha pixels with nearest-neighbor raster sampling.
+    StraightNearest,
+    /// Premultiplied pixels with nearest-neighbor raster sampling.
+    PremultipliedNearest,
+}
+
+impl ImagePolicy {
+    fn flags(self) -> u32 {
+        match self {
+            Self::PremultipliedLinear => 1,
+            Self::StraightNearest => 2,
+            Self::PremultipliedNearest => 3,
+        }
+    }
+}
+
+/// An image already has a live owner with a different alpha or sampling policy.
+#[derive(Clone, Debug, PartialEq, Eq)]
+#[non_exhaustive]
+pub struct ImageRegistrationError {
+    /// The image whose existing registration was preserved.
+    pub image_id: ImageId,
+    /// The policy retained by the existing owner.
+    pub existing: ImagePolicy,
+    /// The incompatible policy requested by the caller.
+    pub requested: ImagePolicy,
+}
+
+impl fmt::Display for ImageRegistrationError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(
+            f,
+            "image {:?} is already registered as {:?}; cannot register as {:?}",
+            self.image_id, self.existing, self.requested
+        )
+    }
+}
+
+impl std::error::Error for ImageRegistrationError {}
+
+/// Native font rasters use the original terminal's nearest atlas sampling.
+/// Register before the first upload; ordinary UI images keep linear filtering.
+#[derive(Clone)]
+pub struct RasterImage(Arc<Registration>);
+
+impl Registration {
+    fn new(
+        image: Arc<RenderImage>,
+        policy: ImagePolicy,
+    ) -> Result<Arc<Self>, ImageRegistrationError> {
+        let mut images = registrations().lock();
+        if let Some(existing) = images.get(&image.id).and_then(Weak::upgrade) {
+            drop(images);
+            if existing.policy != policy {
+                return Err(ImageRegistrationError {
+                    image_id: image.id,
+                    existing: existing.policy,
+                    requested: policy,
+                });
+            }
+            return Ok(existing);
+        }
+        let owner = Arc::new(Registration { image, policy });
+        images.insert(owner.image.id, Arc::downgrade(&owner));
+        Ok(owner)
+    }
+}
+
+impl RasterImage {
+    /// Registers straight-alpha pixels for nearest-neighbor sampling.
+    ///
+    /// # Errors
+    /// Returns an error if this image has a live owner with a different policy.
+    pub fn straight(image: Arc<RenderImage>) -> Result<Self, ImageRegistrationError> {
+        Registration::new(image, ImagePolicy::StraightNearest).map(Self)
+    }
+
+    /// Registers premultiplied pixels for nearest-neighbor sampling.
+    ///
+    /// # Errors
+    /// Returns an error if this image has a live owner with a different policy.
+    pub fn premultiplied(image: Arc<RenderImage>) -> Result<Self, ImageRegistrationError> {
+        Registration::new(image, ImagePolicy::PremultipliedNearest).map(Self)
+    }
+
+    pub fn image(&self) -> &Arc<RenderImage> {
+        &self.0.image
+    }
+}
+
+impl PremultipliedImage {
+    /// Registers premultiplied pixels without changing linear UI sampling.
+    ///
+    /// # Errors
+    /// Returns an error if this image has a live owner with a different policy.
+    pub fn new(image: Arc<RenderImage>) -> Result<Self, ImageRegistrationError> {
+        Registration::new(image, ImagePolicy::PremultipliedLinear).map(Self)
+    }
+
+    pub fn image(&self) -> &Arc<RenderImage> {
+        &self.0.image
+    }
+}
+
+impl Drop for Registration {
+    fn drop(&mut self) {
+        let mut images = registrations().lock();
+        // A concurrent constructor may have replaced an expired weak entry.
+        if images
+            .get(&self.image.id)
+            .is_some_and(|entry| std::ptr::eq(entry.as_ptr(), self))
+        {
+            images.remove(&self.image.id);
+        }
+    }
+}
+
+pub(super) fn flags(id: ImageId) -> u32 {
+    // Dropping the last upgraded owner calls Registration::drop, which locks
+    // this registry too. Release the guard before inspecting/releasing it.
+    let owner = {
+        let images = registrations().lock();
+        images.get(&id).and_then(Weak::upgrade)
+    };
+    owner.map_or(0, |owner| owner.policy.flags())
+}
+
+pub(super) fn encode_sprite_flags<'a>(
+    image_flags: &FxHashMap<(AtlasTextureId, u32), u32>,
+    sprites: &'a [PolychromeSprite],
+    scratch: &'a mut Vec<PolychromeSprite>,
+) -> &'a [PolychromeSprite] {
+    if image_flags.is_empty() || sprites.is_empty() {
+        return sprites;
+    }
+    scratch.clear();
+    scratch.extend_from_slice(sprites);
+    for sprite in scratch.iter_mut() {
+        sprite.pad = image_flags
+            .get(&(sprite.tile.texture_id, sprite.tile.tile_id.0))
+            .copied()
+            .unwrap_or(0);
+    }
+    scratch
+}
diff --git a/vendor/gpui-ohos/src/ohos/keyboard.rs b/vendor/gpui-ohos/src/ohos/keyboard.rs
new file mode 100644
index 0000000..457e53b
--- /dev/null
+++ b/vendor/gpui-ohos/src/ohos/keyboard.rs
@@ -0,0 +1,364 @@
+use rustc_hash::FxHashMap as HashMap;
+
+use openharmony_ability::KeyboardEventData;
+use openharmony_ability::xcomponent::{Action, KeyCode, KeyEventData};
+
+use crate::{
+    Capslock, KeyDownEvent, KeyUpEvent, KeybindingKeystroke, Keystroke, Modifiers,
+    ModifiersChangedEvent, PlatformInput, PlatformKeyboardLayout, PlatformKeyboardMapper,
+};
+
+#[derive(Default)]
+pub(crate) struct OhosKeyState {
+    pressed: Vec<KeyCode>,
+    modifiers: Modifiers,
+    capslock: Capslock,
+    numlock: bool,
+}
+
+impl OhosKeyState {
+    pub(crate) fn modifiers(&self) -> Modifiers {
+        self.modifiers
+    }
+
+    pub(crate) fn capslock(&self) -> Capslock {
+        self.capslock
+    }
+
+    pub(crate) fn clear_pressed(&mut self) -> Option<PlatformInput> {
+        self.pressed.clear();
+        if self.modifiers == Modifiers::default() {
+            return None;
+        }
+        self.modifiers = Modifiers::default();
+        Some(self.modifiers_changed())
+    }
+
+    pub(crate) fn handle(&mut self, event: &KeyEventData) -> Vec<PlatformInput> {
+        self.handle_key(event.code, event.action, None)
+    }
+
+    pub(crate) fn handle_arkui(&mut self, event: &KeyboardEventData) -> Vec<PlatformInput> {
+        self.handle_key(event.code, event.action, Some(event))
+    }
+
+    fn handle_key(
+        &mut self,
+        code: KeyCode,
+        action: Action,
+        snapshot: Option<&KeyboardEventData>,
+    ) -> Vec<PlatformInput> {
+        if action == Action::Unknown {
+            return Vec::new();
+        }
+        let held = self.pressed.contains(&code);
+        if let Some(pressed) = snapshot.and_then(|event| event.pressed_keys.as_ref()) {
+            self.pressed.clone_from(pressed);
+        }
+        match action {
+            Action::Down if !self.pressed.contains(&code) => self.pressed.push(code),
+            Action::Up => self.pressed.retain(|pressed| *pressed != code),
+            Action::Down | Action::Unknown => {}
+        }
+
+        let previous_modifiers = self.modifiers;
+        let previous_capslock = self.capslock;
+        if code == KeyCode::CapsLock && action == Action::Down && !held {
+            self.capslock.on = !self.capslock.on;
+        }
+        if code == KeyCode::NumLock && action == Action::Down && !held {
+            self.numlock = !self.numlock;
+        }
+        if let Some(state) = snapshot.and_then(|event| event.caps_lock) {
+            self.capslock.on = state;
+        }
+        if let Some(state) = snapshot.and_then(|event| event.num_lock) {
+            self.numlock = state;
+        }
+        self.modifiers = modifiers_for_keys(&self.pressed);
+
+        let mut output = Vec::with_capacity(2);
+        if self.modifiers != previous_modifiers || self.capslock != previous_capslock {
+            output.push(self.modifiers_changed());
+        }
+        // Ability delivers each physical transition once, including IME-consumed keys.
+        // Their state still matters, but their text/edit/shortcut is owned by the IME.
+        if snapshot.is_some_and(|event| event.ime_consumed) || is_modifier(code) {
+            return output;
+        }
+        let Some(key) =
+            keypad_navigation(code, self.numlock, self.modifiers.shift).or_else(|| key_name(code))
+        else {
+            return output;
+        };
+        let key_char = if self.modifiers.control
+            || self.modifiers.alt
+            || self.modifiers.platform
+            || self.modifiers.function
+            || keypad_navigation(code, self.numlock, self.modifiers.shift).is_some()
+        {
+            None
+        } else {
+            snapshot
+                .and_then(|event| char::from_u32(event.unicode))
+                .filter(|character| !character.is_control())
+                .map(|character| {
+                    // Normalize known shifted pairs without replacing other layouts.
+                    let character = if character.is_ascii_alphabetic() {
+                        if self.modifiers.shift ^ self.capslock.on {
+                            character.to_ascii_uppercase()
+                        } else {
+                            character.to_ascii_lowercase()
+                        }
+                    } else if let Some((plain, shifted)) = printable_key_pair(code)
+                        .filter(|&(plain, shifted)| character == plain || character == shifted)
+                    {
+                        if self.modifiers.shift { shifted } else { plain }
+                    } else {
+                        character
+                    };
+                    character.to_string()
+                })
+                .or_else(|| printable_char(code, self.modifiers, self.capslock))
+        };
+        let keystroke = Keystroke {
+            modifiers: self.modifiers,
+            key: key.to_owned(),
+            key_char,
+        };
+        match action {
+            Action::Down => output.push(PlatformInput::KeyDown(KeyDownEvent {
+                keystroke,
+                is_held: held,
+                prefer_character_input: false,
+            })),
+            Action::Up => output.push(PlatformInput::KeyUp(KeyUpEvent { keystroke })),
+            Action::Unknown => {}
+        }
+        output
+    }
+
+    fn modifiers_changed(&self) -> PlatformInput {
+        PlatformInput::ModifiersChanged(ModifiersChangedEvent {
+            modifiers: self.modifiers,
+            capslock: self.capslock,
+        })
+    }
+}
+
+fn modifiers_for_keys(pressed: &[KeyCode]) -> Modifiers {
+    Modifiers {
+        control: pressed.contains(&KeyCode::CtrlLeft) || pressed.contains(&KeyCode::CtrlRight),
+        alt: pressed.contains(&KeyCode::AltLeft) || pressed.contains(&KeyCode::AltRight),
+        shift: pressed.contains(&KeyCode::ShiftLeft) || pressed.contains(&KeyCode::ShiftRight),
+        platform: pressed.contains(&KeyCode::MetaLeft) || pressed.contains(&KeyCode::MetaRight),
+        function: pressed.contains(&KeyCode::Fn) || pressed.contains(&KeyCode::Function),
+    }
+}
+
+fn is_modifier(code: KeyCode) -> bool {
+    matches!(
+        code,
+        KeyCode::CtrlLeft
+            | KeyCode::CtrlRight
+            | KeyCode::AltLeft
+            | KeyCode::AltRight
+            | KeyCode::ShiftLeft
+            | KeyCode::ShiftRight
+            | KeyCode::MetaLeft
+            | KeyCode::MetaRight
+            | KeyCode::Fn
+            | KeyCode::Function
+            | KeyCode::CapsLock
+            | KeyCode::NumLock
+    )
+}
+
+fn keypad_navigation(code: KeyCode, numlock: bool, shift: bool) -> Option<&'static str> {
+    if numlock && !shift {
+        return None;
+    }
+    match code {
+        KeyCode::Numpad0 => Some("insert"),
+        KeyCode::Numpad1 => Some("end"),
+        KeyCode::Numpad2 => Some("down"),
+        KeyCode::Numpad3 => Some("pagedown"),
+        KeyCode::Numpad4 => Some("left"),
+        KeyCode::Numpad5 => Some("clear"),
+        KeyCode::Numpad6 => Some("right"),
+        KeyCode::Numpad7 => Some("home"),
+        KeyCode::Numpad8 => Some("up"),
+        KeyCode::Numpad9 => Some("pageup"),
+        KeyCode::NumpadDot => Some("delete"),
+        _ => None,
+    }
+}
+
+fn key_name(code: KeyCode) -> Option<&'static str> {
+    match code {
+        KeyCode::A => Some("a"),
+        KeyCode::B => Some("b"),
+        KeyCode::C => Some("c"),
+        KeyCode::D => Some("d"),
+        KeyCode::E => Some("e"),
+        KeyCode::F => Some("f"),
+        KeyCode::G => Some("g"),
+        KeyCode::H => Some("h"),
+        KeyCode::I => Some("i"),
+        KeyCode::J => Some("j"),
+        KeyCode::K => Some("k"),
+        KeyCode::L => Some("l"),
+        KeyCode::M => Some("m"),
+        KeyCode::N => Some("n"),
+        KeyCode::O => Some("o"),
+        KeyCode::P => Some("p"),
+        KeyCode::Q => Some("q"),
+        KeyCode::R => Some("r"),
+        KeyCode::S => Some("s"),
+        KeyCode::T => Some("t"),
+        KeyCode::U => Some("u"),
+        KeyCode::V => Some("v"),
+        KeyCode::W => Some("w"),
+        KeyCode::X => Some("x"),
+        KeyCode::Y => Some("y"),
+        KeyCode::Z => Some("z"),
+        KeyCode::Key0 | KeyCode::Numpad0 => Some("0"),
+        KeyCode::Key1 | KeyCode::Numpad1 => Some("1"),
+        KeyCode::Key2 | KeyCode::Numpad2 => Some("2"),
+        KeyCode::Key3 | KeyCode::Numpad3 => Some("3"),
+        KeyCode::Key4 | KeyCode::Numpad4 => Some("4"),
+        KeyCode::Key5 | KeyCode::Numpad5 => Some("5"),
+        KeyCode::Key6 | KeyCode::Numpad6 => Some("6"),
+        KeyCode::Key7 | KeyCode::Numpad7 => Some("7"),
+        KeyCode::Key8 | KeyCode::Numpad8 => Some("8"),
+        KeyCode::Key9 | KeyCode::Numpad9 => Some("9"),
+        KeyCode::DpadUp => Some("up"),
+        KeyCode::DpadDown => Some("down"),
+        KeyCode::DpadLeft => Some("left"),
+        KeyCode::DpadRight => Some("right"),
+        KeyCode::DpadCenter | KeyCode::Enter | KeyCode::NumpadEnter => Some("enter"),
+        KeyCode::Del => Some("backspace"),
+        KeyCode::ForwardDel => Some("delete"),
+        KeyCode::Tab => Some("tab"),
+        KeyCode::Space => Some("space"),
+        KeyCode::Escape => Some("escape"),
+        KeyCode::PageUp => Some("pageup"),
+        KeyCode::PageDown => Some("pagedown"),
+        KeyCode::MoveHome => Some("home"),
+        KeyCode::MoveEnd => Some("end"),
+        KeyCode::Insert => Some("insert"),
+        KeyCode::Comma => Some(","),
+        KeyCode::Period => Some("."),
+        KeyCode::Grave => Some("`"),
+        KeyCode::Minus => Some("-"),
+        KeyCode::Equals => Some("="),
+        KeyCode::LeftBracket => Some("["),
+        KeyCode::RightBracket => Some("]"),
+        KeyCode::Backslash => Some("\\"),
+        KeyCode::Semicolon => Some(";"),
+        KeyCode::Apostrophe => Some("'"),
+        KeyCode::Slash => Some("/"),
+        KeyCode::F1 => Some("f1"),
+        KeyCode::F2 => Some("f2"),
+        KeyCode::F3 => Some("f3"),
+        KeyCode::F4 => Some("f4"),
+        KeyCode::F5 => Some("f5"),
+        KeyCode::F6 => Some("f6"),
+        KeyCode::F7 => Some("f7"),
+        KeyCode::F8 => Some("f8"),
+        KeyCode::F9 => Some("f9"),
+        KeyCode::F10 => Some("f10"),
+        KeyCode::F11 => Some("f11"),
+        KeyCode::F12 => Some("f12"),
+        KeyCode::NumpadDivide => Some("/"),
+        KeyCode::NumpadMultiply => Some("*"),
+        KeyCode::NumpadSubtract => Some("-"),
+        KeyCode::NumpadAdd => Some("+"),
+        KeyCode::NumpadDot => Some("."),
+        KeyCode::NumpadComma => Some(","),
+        KeyCode::NumpadEquals => Some("="),
+        KeyCode::NumpadLeftParen => Some("("),
+        KeyCode::NumpadRightParen => Some(")"),
+        KeyCode::NumpadPlusMinus => Some("±"),
+        _ => None,
+    }
+}
+
+fn printable_key_pair(code: KeyCode) -> Option<(char, char)> {
+    Some(match code {
+        KeyCode::Key0 => ('0', ')'),
+        KeyCode::Key1 => ('1', '!'),
+        KeyCode::Key2 => ('2', '@'),
+        KeyCode::Key3 => ('3', '#'),
+        KeyCode::Key4 => ('4', '$'),
+        KeyCode::Key5 => ('5', '%'),
+        KeyCode::Key6 => ('6', '^'),
+        KeyCode::Key7 => ('7', '&'),
+        KeyCode::Key8 => ('8', '*'),
+        KeyCode::Key9 => ('9', '('),
+        KeyCode::Minus => ('-', '_'),
+        KeyCode::Equals => ('=', '+'),
+        KeyCode::LeftBracket => ('[', '{'),
+        KeyCode::RightBracket => (']', '}'),
+        KeyCode::Backslash => ('\\', '|'),
+        KeyCode::Semicolon => (';', ':'),
+        KeyCode::Apostrophe => ('\'', '"'),
+        KeyCode::Comma => (',', '<'),
+        KeyCode::Period => ('.', '>'),
+        KeyCode::Slash => ('/', '?'),
+        KeyCode::Grave => ('`', '~'),
+        _ => return None,
+    })
+}
+
+fn printable_char(code: KeyCode, modifiers: Modifiers, capslock: Capslock) -> Option<String> {
+    if modifiers.control || modifiers.alt || modifiers.platform || modifiers.function {
+        return None;
+    }
+    let key = key_name(code)?;
+    let character = if code == KeyCode::Space {
+        ' '
+    } else if let Some((plain, shifted)) = printable_key_pair(code) {
+        if modifiers.shift { shifted } else { plain }
+    } else if key.len() == 1 {
+        let character = key.chars().next()?;
+        if character.is_ascii_alphabetic() && (modifiers.shift ^ capslock.on) {
+            character.to_ascii_uppercase()
+        } else {
+            character
+        }
+    } else if code == KeyCode::NumpadPlusMinus {
+        '±'
+    } else {
+        return None;
+    };
+    Some(character.to_string())
+}
+
+pub(crate) struct OhosKeyboardLayout;
+
+impl PlatformKeyboardLayout for OhosKeyboardLayout {
+    fn id(&self) -> &str {
+        "ohos-default"
+    }
+
+    fn name(&self) -> &str {
+        "OHOS Default"
+    }
+}
+
+pub(crate) struct OhosKeyboardMapper;
+
+impl PlatformKeyboardMapper for OhosKeyboardMapper {
+    fn map_key_equivalent(
+        &self,
+        keystroke: Keystroke,
+        _use_key_equivalents: bool,
+    ) -> KeybindingKeystroke {
+        KeybindingKeystroke::from_keystroke(keystroke)
+    }
+
+    fn get_key_equivalents(&self) -> Option<&HashMap<char, char>> {
+        None
+    }
+}
diff --git a/vendor/gpui-ohos/src/ohos/launch.rs b/vendor/gpui-ohos/src/ohos/launch.rs
