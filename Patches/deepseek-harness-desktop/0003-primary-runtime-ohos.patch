+/**
+ * OHOS primary-runtime payload assembly (replaces the Electron-download +
+ * python-build-standalone flow for the openharmony-arm64 target):
+ * - Node: the Harmonybrew node@24 binary (NEEDED only libc.so — verified
+ *   self-contained; official core bottle, pre-signed), copied into the payload.
+ * - pnpm: copied from this checkout's installed pnpm, foreign native packages
+ *   pruned with the upstream helper.
+ * - Python: NOT shipped (no OHOS python-build-standalone); the manifest keeps
+ *   the locked version string but pythonPackages is empty — agent Python
+ *   skills degrade at use time (v1 scope cut, see docs/M1-host-build.md).
+ *
+ * Layout is byte-compatible with preparePrimaryRuntime's output contract
+ * (primary-runtime/{dependencies/{node,pnpm}, runtime.json}).
+ */
+
+import { execFileSync } from 'node:child_process'
+import { chmodSync, cpSync, mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { createRequire } from 'node:module'
+import { dirname, join, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const APP_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..')
+const MONOREPO_ROOT = resolve(APP_ROOT, '..', '..')
+
+// 复用上游的 pnpm 裁剪助手（不重复造逻辑）。
+const { prunePnpmForeignNativePackages } = await import(
+  join(MONOREPO_ROOT, 'scripts', 'primary-runtime', 'prepare.ts'))
+
+/**
+ * @param {object} options
+ * @param {string} options.output - Desktop runtime resource directory (runtime/).
+ * @param {string} options.version - Carrier desktop release version.
+ * @param {string} [options.nodeBinary] - Self-contained Node executable to embed.
+ * @returns {Promise<string>} The embedded Node version (for versions.json).
+ */
+export async function preparePrimaryRuntimeOhos({ output, version, nodeBinary }) {
+  const node = nodeBinary
+    ?? execFileSync('brew', ['--prefix', 'node@24'], { encoding: 'utf8' }).trim() + '/bin/node'
+  const nodeVersion = execFileSync(node, ['-p', 'process.version'], { encoding: 'utf8' }).trim().replace(/^v/, '')
+
+  const destination = join(resolve(output), 'primary-runtime')
+  rmSync(destination, { recursive: true, force: true })
+  const dependencies = join(destination, 'dependencies')
+  mkdirSync(dependencies, { recursive: true })
+
+  // Node 组件（上游契约：bin/node + LICENSE + node_modules/README.txt）
+  const nodeDir = join(dependencies, 'node')
+  mkdirSync(join(nodeDir, 'bin'), { recursive: true })
+  cpSync(node, join(nodeDir, 'bin', 'node'))
+  chmodSync(join(nodeDir, 'bin', 'node'), 0o755)
+  writeFileSync(join(nodeDir, 'LICENSE'), `Bundled Node.js, from the Harmonybrew official-core node@24 bottle (self-contained: NEEDED libc.so only).\nUpstream license: https://github.com/nodejs/node/blob/main/LICENSE\n`)
+  mkdirSync(join(nodeDir, 'node_modules'))
+  writeFileSync(join(nodeDir, 'node_modules', 'README.txt'), 'Reserved for bundled Node packages. pnpm uses its default installation directories.\n')
+
+  // pnpm 组件（与上游非 archive 路径相同：复制当前 checkout 装好的 pnpm）
+  // 注意 pnpm 的 exports 不放行 './package.json' 子路径，直接定位 node_modules 实体。
+  const pnpmDir = join(APP_ROOT, 'node_modules', 'pnpm')
+  const pnpmVersion = JSON.parse(readFileSync(join(pnpmDir, 'package.json'), 'utf8')).version
+  cpSync(pnpmDir, join(dependencies, 'pnpm'), { recursive: true, dereference: true })
+  prunePnpmForeignNativePackages(join(dependencies, 'pnpm'), 'openharmony', 'arm64')
+
+  const manifest = {
+    desktopVersion: version,
+    platform: 'openharmony',
+    arch: 'arm64',
+    python: '3.12.14',
+    node: nodeVersion,
+    pnpm: pnpmVersion,
+    pythonPackages: {},
+  }
+  writeFileSync(join(destination, 'runtime.json'), `${JSON.stringify(manifest, undefined, 2)}\n`)
+  console.log(`primary-runtime (openharmony): node ${nodeVersion}, pnpm ${pnpmVersion}, python omitted`)
+  return nodeVersion
+}
+
+if (import.meta.main) {
+  const paths = (await import('./desktop-build-paths.mjs')).resolveDesktopTargetBuildPaths()
+  const { version } = JSON.parse(readFileSync(new URL('../package.json', import.meta.url), 'utf8'))
+  await preparePrimaryRuntimeOhos({ output: paths.runtime, version })
+}
