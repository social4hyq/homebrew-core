+// HarmonyOS allows no Unix sockets on the shared home mount and keeps /tmp
+// read-only for apps, so its relocated sockets live in the app runtime dir.
+function shortDaemonSocketDirPrefix(): string {
+  if (!isOpenHarmony()) {
+    return '/tmp/.orca-daemon-'
+  }
+  const runtimeDir = process.env.TMPDIR ?? process.env.XDG_RUNTIME_DIR ?? '/tmp'
+  return `${runtimeDir.replace(/\/+$/, '')}/.orca-daemon-`
+}
 
+export const SHORT_DAEMON_SOCKET_DIR_PREFIX = shortDaemonSocketDirPrefix()
