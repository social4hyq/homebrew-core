+#ifdef Q_OS_HARMONY
+QString stagedUserFilePath(const QString& extension) {
+    QString directory = QStandardPaths::writableLocation(QStandardPaths::AppDataLocation);
+    if (directory.isEmpty() || !QDir().mkpath(directory)) {
+        const QString tempDirectory =
+            QStandardPaths::writableLocation(QStandardPaths::TempLocation);
+        if (tempDirectory.isEmpty())
+            return {};
+        directory = QDir(tempDirectory).filePath(QStringLiteral("snow-shot-user-file-staging"));
+        if (!QDir().mkpath(directory))
+            return {};
+    }
+    return QDir(directory).filePath(
+        QStringLiteral("snow-shot-image-editing-export-%1.%2")
+            .arg(QUuid::createUuid().toString(QUuid::Id128), extension));
+}
+#endif
