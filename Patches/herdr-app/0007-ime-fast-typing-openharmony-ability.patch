diff --git a/vendor/openharmony-ability/src/node.rs b/vendor/openharmony-ability/src/node.rs
new file mode 100644
index 0000000..b6c3f85
--- /dev/null
+++ b/vendor/openharmony-ability/src/node.rs
@@ -0,0 +1,238 @@
+//! Built-in `ohos.node` surface plugin.
+//!
+//! This is the normalized replacement for the former WebView-mode dichotomy and the old slot
+//! registry: every native module is bound to exactly one `DefaultXComponent` root tree at a time,
+//! and plugins (WebView included) are FrameNode providers for that tree. An Ability hosts multiple
+//! components by using multiple native modules. `FrameNode` values never cross N-API.
+//!
+//! The ArkTS half lives in `BridgeHost` (`native_ability`) and is installed automatically ahead
+//! of business plugins, so no registration or factory is required on either side.
+
+use napi_derive_ohos::napi;
+use napi_ohos::{Error, Result};
+
+use crate::{
+    impl_bridge_napi_type, AsyncBridge, BridgeCallOptions, BridgeContextRequirement, BridgePlugin,
+    BridgeRuntime,
+};
+
+mod attachment_owner;
+mod attachment_state;
+mod content_root;
+mod native_attachment;
+pub use attachment_owner::NativeAttachment;
+pub use content_root::ContentRoot;
+pub use native_attachment::{NativeNodeReady, NativeNodeRetiring, NativeSubtreeReady};
+
+/// Plugin identity shared with the ArkTS built-in surface plugin.
+pub const NODE_SURFACE_PLUGIN_ID: &str = "ohos.node";
+
+/// Request marker for `create-container`: the response carries the new handle.
+#[napi(object)]
+#[derive(Clone, Debug, Default)]
+pub struct NodeCreateContainerRequest {}
+
+impl_bridge_napi_type!(
+    NodeCreateContainerRequest,
+    "ohos.node.CreateContainerRequest"
+);
+
+/// Appends the node of `child_handle` under the node of `parent_handle`.
+#[napi(object)]
+#[derive(Clone, Debug)]
+pub struct NodeAppendChildRequest {
+    pub parent_handle: u32,
+    pub child_handle: u32,
+}
+
+impl_bridge_napi_type!(NodeAppendChildRequest, "ohos.node.AppendChildRequest");
+
+/// Appends a handle-owned node to this module's component root.
+#[napi(object)]
+#[derive(Clone, Debug)]
+pub struct NodeMountIntoRootRequest {
+    pub handle: u32,
+}
+
+impl_bridge_napi_type!(NodeMountIntoRootRequest, "ohos.node.MountIntoRootRequest");
+
+/// Detaches a handle-owned node from its parent and disposes it.
+#[napi(object)]
+#[derive(Clone, Debug)]
+pub struct NodeDisposeRequest {
+    pub handle: u32,
+}
+
+impl_bridge_napi_type!(NodeDisposeRequest, "ohos.node.DisposeRequest");
+
+/// Opaque handle of a container `FrameNode` created in ArkTS.
+#[napi(object)]
+#[derive(Clone, Debug)]
+pub struct NodeHandleResponse {
+    pub handle: u32,
+}
+
+impl_bridge_napi_type!(NodeHandleResponse, "ohos.node.HandleResponse");
+
+#[napi(object)]
+#[derive(Clone, Debug)]
+pub struct NodeAcknowledgement {
+    pub accepted: bool,
+}
+
+impl_bridge_napi_type!(NodeAcknowledgement, "ohos.node.Acknowledgement");
+
+impl NodeAcknowledgement {
+    fn ensure(self) -> Result<()> {
+        if self.accepted {
+            Ok(())
+        } else {
+            Err(Error::from_reason(
+                "ohos.node plugin rejected the requested node operation",
+            ))
+        }
+    }
+}
+
+/// Rust facade marker for the built-in `ohos.node` plugin. It is installed automatically by the
+/// ArkTS `BridgeHost`, so it is never registered through [`BridgePlugin`] registration on the
+/// Rust side; outbound calls only use its identity.
+pub struct NodeSurfaceBridgePlugin;
+
+impl BridgePlugin for NodeSurfaceBridgePlugin {
+    type Mode = AsyncBridge;
+
+    const ID: &'static str = NODE_SURFACE_PLUGIN_ID;
+    const REQUIRED_CONTEXTS: &'static [BridgeContextRequirement] =
+        &[BridgeContextRequirement::UiContext];
+}
+
+/// Outbound facade for composing this native module's component FrameNode tree from Rust.
+#[derive(Clone)]
+pub struct NodeSurface {
+    bridge: BridgeRuntime,
+}
+
+impl NodeSurface {
+    pub(crate) fn new(bridge: BridgeRuntime) -> Self {
+        Self { bridge }
+    }
+
+    /// Creates an empty container `FrameNode` and returns its opaque handle.
+    pub async fn create_container(&self) -> Result<u32> {
+        let response = self
+            .bridge
+            .call_async::<NodeSurfaceBridgePlugin, NodeCreateContainerRequest, NodeHandleResponse>(
+                "create-container",
+                NodeCreateContainerRequest {},
+                BridgeCallOptions::default(),
+            )
+            .await?;
+        Ok(response.handle)
+    }
+
+    /// Appends the node of `child_handle` under the node of `parent_handle`.
+    pub async fn append_child(&self, parent_handle: u32, child_handle: u32) -> Result<()> {
+        self.bridge
+            .call_async::<NodeSurfaceBridgePlugin, NodeAppendChildRequest, NodeAcknowledgement>(
+                "append-child",
+                NodeAppendChildRequest {
+                    parent_handle,
+                    child_handle,
+                },
+                BridgeCallOptions::default(),
+            )
+            .await?
+            .ensure()
+    }
+
+    /// Appends a handle-owned node to this module's component root.
+    pub async fn mount_into_root(&self, handle: u32) -> Result<()> {
+        self.bridge
+            .call_async::<NodeSurfaceBridgePlugin, NodeMountIntoRootRequest, NodeAcknowledgement>(
+                "mount-into-root",
+                NodeMountIntoRootRequest { handle },
+                BridgeCallOptions::default(),
+            )
+            .await?
+            .ensure()
+    }
+
+    /// Detaches a handle-owned node from its parent and disposes it.
+    pub async fn dispose(&self, handle: u32) -> Result<()> {
+        self.bridge
+            .call_async::<NodeSurfaceBridgePlugin, NodeDisposeRequest, NodeAcknowledgement>(
+                "dispose",
+                NodeDisposeRequest { handle },
+                BridgeCallOptions::default(),
+            )
+            .await?
+            .ensure()
+    }
+}
+
+/// Convenience accessor: `app.node()` returns the outbound surface facade.
+pub trait NodeExt {
+    fn node(&self) -> Result<NodeSurface>;
+}
+
+impl NodeExt for crate::OpenHarmonyApp {
+    fn node(&self) -> Result<NodeSurface> {
+        Ok(NodeSurface::new(self.bridge()?))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::BridgeNapiType;
+
+    #[test]
+    fn node_actions_have_named_napi_contracts() {
+        assert_eq!(
+            <NativeNodeReady as BridgeNapiType>::TYPE_NAME,
+            "ohos.node.NativeNodeReady"
+        );
+        assert_eq!(
+            <NativeSubtreeReady as BridgeNapiType>::TYPE_NAME,
+            "ohos.node.NativeSubtreeReady"
+        );
+        assert_eq!(
+            <NativeNodeRetiring as BridgeNapiType>::TYPE_NAME,
+            "ohos.node.NativeNodeRetiring"
+        );
+        assert_eq!(
+            <NodeCreateContainerRequest as BridgeNapiType>::TYPE_NAME,
+            "ohos.node.CreateContainerRequest"
+        );
+        assert_eq!(
+            <NodeAppendChildRequest as BridgeNapiType>::TYPE_NAME,
+            "ohos.node.AppendChildRequest"
+        );
+        assert_eq!(
+            <NodeMountIntoRootRequest as BridgeNapiType>::TYPE_NAME,
+            "ohos.node.MountIntoRootRequest"
+        );
+        assert_eq!(
+            <NodeDisposeRequest as BridgeNapiType>::TYPE_NAME,
+            "ohos.node.DisposeRequest"
+        );
+        assert_eq!(
+            <NodeHandleResponse as BridgeNapiType>::TYPE_NAME,
+            "ohos.node.HandleResponse"
+        );
+        assert_eq!(
+            <NodeAcknowledgement as BridgeNapiType>::TYPE_NAME,
+            "ohos.node.Acknowledgement"
+        );
+    }
+
+    #[test]
+    fn plugin_identity_is_the_builtin_contract() {
+        assert_eq!(NodeSurfaceBridgePlugin::ID, "ohos.node");
+        assert_eq!(
+            NodeSurfaceBridgePlugin::REQUIRED_CONTEXTS,
+            &[BridgeContextRequirement::UiContext]
+        );
+    }
+}
diff --git a/vendor/openharmony-ability/src/node/attachment_owner.rs b/vendor/openharmony-ability/src/node/attachment_owner.rs
new file mode 100644
index 0000000..f62881a
--- /dev/null
+++ b/vendor/openharmony-ability/src/node/attachment_owner.rs
@@ -0,0 +1,404 @@
+//! UI-thread ownership of ArkTS content attached to native node trees.
+
+use std::{
+    cell::{Cell, RefCell},
+    collections::BTreeMap,
+    rc::Rc,
+    sync::atomic::AtomicU32,
+};
+
+use napi_ohos::{
+    bindgen_prelude::{FromNapiValue, Object, ObjectRef},
+    Env, Error, JsValue, Result,
+};
+use ohos_arkui_binding::{
+    api::node_content::NodeContent,
+    common::node::{ArkUINode, ArkUINodeRaw},
+    component::attribute::ArkUICommonAttribute,
+    ArkUIHandle,
+};
+
+use super::attachment_state::{allocate_id, Active, AttachmentState};
+
+static NEXT_TARGET_ID: AtomicU32 = AtomicU32::new(1);
+
+thread_local! {
+    static TARGETS: RefCell<BTreeMap<u32, Rc<Target>>> = RefCell::default();
+}
+
+struct RetainedContent {
+    env: Env,
+    frame: Option<ObjectRef>,
+    slot: Option<ObjectRef>,
+}
+
+impl RetainedContent {
+    fn new(env: &Env, frame: &Object<'_>, slot: Option<&Object<'_>>) -> Result<Self> {
+        let mut retained = Self {
+            env: *env,
+            frame: Some(frame.create_ref()?),
+            slot: None,
+        };
+        retained.slot = slot.map(Object::create_ref).transpose()?;
+        Ok(retained)
+    }
+}
+
+impl Drop for RetainedContent {
+    fn drop(&mut self) {
+        for reference in [self.slot.take(), self.frame.take()].into_iter().flatten() {
+            if let Err(error) = reference.unref(&self.env) {
+                crate::error!("Failed to release native attachment reference: {error}");
+            }
+        }
+    }
+}
+
+struct Target {
+    id: u32,
+    state: AttachmentState,
+    parent: RefCell<Option<Rc<RefCell<ArkUINode>>>>,
+    child: RefCell<Option<Rc<RefCell<ArkUINode>>>>,
+    inner: RefCell<Option<Rc<RefCell<ArkUINode>>>>,
+    inner_receiver_active: Cell<bool>,
+    slot: Cell<Option<ArkUIHandle>>,
+    retained: RefCell<Option<RetainedContent>>,
+}
+
+impl Target {
+    fn begin(&self) -> Result<Active<'_>> {
+        self.state.begin().map_err(|error| {
+            Error::from_reason(format!("Native attachment target {} {error}", self.id))
+        })
+    }
+
+    fn detach_inner(&self) -> Result<()> {
+        let inner = self.inner.borrow();
+        if let (Some(handle), Some(inner)) = (self.slot.get(), inner.as_ref()) {
+            if self.inner_receiver_active.get() {
+                inner
+                    .borrow()
+                    .remove_event_receiver()
+                    .map_err(|error| Error::from_reason(error.to_string()))?;
+                self.inner_receiver_active.set(false);
+            }
+            NodeContent::from_handle(handle)
+                .remove_node(&inner.borrow())
+                .map_err(|error| Error::from_reason(error.to_string()))?;
+            self.slot.set(None);
+            ohos_arkui_binding::common::node_registry::unregister(&inner.borrow());
+        }
+        if let Some(child) = self.child.borrow().clone() {
+            let parent = self.parent.borrow();
+            let parent = parent
+                .as_ref()
+                .ok_or_else(|| Error::from_reason("Native attachment parent is retired"))?;
+            let mut parent = parent.borrow_mut();
+            let index = parent
+                .children()
+                .iter()
+                .position(|node| Rc::ptr_eq(node, &child));
+            let native_parent = child
+                .borrow()
+                .parent()
+                .map_err(|error| Error::from_reason(error.to_string()))?;
+            if let Some(native_parent) = native_parent {
+                if native_parent != parent.raw_handle() {
+                    return Err(Error::from_reason(
+                        "Native attachment was reparented outside its target",
+                    ));
+                }
+                if let Some(index) = index {
+                    parent
+                        .remove_child(index)
+                        .map_err(|error| Error::from_reason(error.to_string()))?;
+                } else {
+                    child
+                        .borrow()
+                        .remove_from_parent()
+                        .map_err(|error| Error::from_reason(error.to_string()))?;
+                }
+            } else if let Some(index) = index {
+                parent.children_mut().remove(index);
+            }
+        }
+        self.child.borrow_mut().take();
+        self.retained.borrow_mut().take();
+        Ok(())
+    }
+
+    fn retire(&self) -> Result<()> {
+        // A failed detachment still closes admission, but preserves all native owners for retry.
+        let _active = self.state.begin_retire().map_err(|error| {
+            Error::from_reason(format!("Native attachment target {} {error}", self.id))
+        })?;
+        self.detach_inner()?;
+        self.inner.borrow_mut().take();
+        self.parent.borrow_mut().take();
+        TARGETS.with(|targets| targets.borrow_mut().remove(&self.id));
+        Ok(())
+    }
+}
+
+fn target(id: u32) -> Result<Rc<Target>> {
+    TARGETS
+        .with(|targets| targets.borrow().get(&id).cloned())
+        .ok_or_else(|| Error::from_reason(format!("Unknown native attachment target {id}")))
+}
+
+/// The single UI-thread owner of an externally constructed native subtree.
+///
+/// Target IDs are monotonically allocated and never reused, including across sessions.
+/// This type is neither `Send` nor `Sync`; create, attach, dispatch and retire on the UI thread.
+/// Successful retirement releases the parent and inner node owners even if this wrapper lives on.
+pub struct NativeAttachment(Rc<Target>);
+
+impl NativeAttachment {
+    pub fn new(parent: &Rc<RefCell<ArkUINode>>) -> Result<Self> {
+        Self::create(parent, None)
+    }
+
+    pub fn for_subtree(
+        parent: &Rc<RefCell<ArkUINode>>,
+        inner: &Rc<RefCell<ArkUINode>>,
+    ) -> Result<Self> {
+        if Rc::ptr_eq(parent, inner) {
+            return Err(Error::from_reason(
+                "A subtree attachment needs distinct owned nodes",
+            ));
+        }
+        Self::create(parent, Some(inner.clone()))
+    }
+
+    fn create(
+        parent: &Rc<RefCell<ArkUINode>>,
+        inner: Option<Rc<RefCell<ArkUINode>>>,
+    ) -> Result<Self> {
+        if !parent.borrow().is_owned() || parent.borrow().raw_handle().is_null() {
+            return Err(Error::from_reason(
+                "native retention requires an owned node",
+            ));
+        }
+        ArkUINode::bind_rc(parent);
+        if let Some(inner) = inner.as_ref() {
+            if !inner.borrow().is_owned() || inner.borrow().raw_handle().is_null() {
+                return Err(Error::from_reason(
+                    "native retention requires an owned node",
+                ));
+            }
+            ArkUINode::bind_rc(inner);
+        }
+        let id = allocate_id(&NEXT_TARGET_ID)
+            .ok_or_else(|| Error::from_reason("Native attachment IDs exhausted"))?;
+        let target = Rc::new(Target {
+            id,
+            state: AttachmentState::default(),
+            parent: RefCell::new(Some(parent.clone())),
+            child: RefCell::default(),
+            inner: RefCell::new(inner),
+            inner_receiver_active: Cell::new(false),
+            slot: Cell::new(None),
+            retained: RefCell::default(),
+        });
+        TARGETS.with(|targets| targets.borrow_mut().insert(id, target.clone()));
+        Ok(Self(target))
+    }
+
+    pub fn id(&self) -> u32 {
+        self.0.id
+    }
+
+    /// Runs a platform callback under the same guard as attachment and retirement.
+    /// A retired, unknown, or re-entrant target returns an explicit error without dispatch.
+    pub fn dispatch<R>(id: u32, callback: impl FnOnce() -> R) -> Result<R> {
+        let target = target(id)?;
+        let _active = target.begin()?;
+        if target.child.borrow().is_none() {
+            return Err(Error::from_reason(format!(
+                "Native attachment target {id} is not attached"
+            )));
+        }
+        Ok(callback())
+    }
+
+    pub fn with_child<R>(&self, callback: impl FnOnce(&ArkUINode) -> R) -> Result<Option<R>> {
+        let _active = self.0.begin()?;
+        let child = self.0.child.borrow().clone();
+        Ok(child.map(|child| callback(&child.borrow())))
+    }
+
+    /// Attaches and strongly retains the FrameNode until retirement succeeds.
+    pub fn attach(env: &Env, id: u32, content: &Object<'_>) -> Result<()> {
+        Self::attach_content(env, id, content, None)
+    }
+
+    /// Retains both the wrapper FrameNode and its NodeContent slot.
+    pub fn attach_subtree(
+        env: &Env,
+        id: u32,
+        content: &Object<'_>,
+        slot: &Object<'_>,
+    ) -> Result<()> {
+        Self::attach_content(env, id, content, Some(slot))
+    }
+
+    fn attach_content(
+        env: &Env,
+        id: u32,
+        content: &Object<'_>,
+        slot: Option<&Object<'_>>,
+    ) -> Result<()> {
+        let target = target(id)?;
+        let _active = target.begin()?;
+        if target.child.borrow().is_some() {
+            return Err(Error::from_reason("Native attachment is already occupied"));
+        }
+        let parent = target.parent.borrow();
+        let parent = parent
+            .as_ref()
+            .ok_or_else(|| Error::from_reason("Native attachment parent is retired"))?;
+        let inner = target.inner.borrow();
+        if slot.is_some() != inner.is_some() {
+            return Err(Error::from_reason(
+                "Native attachment subtree does not match its registered target",
+            ));
+        }
+        let retained = RetainedContent::new(env, content, slot)?;
+        // SAFETY: conversion is scoped to this active N-API callback; `retained`
+        // keeps the FrameNode alive until after the native edge is detached.
+        let raw = unsafe { ArkUINodeRaw::from_napi_value(env.raw(), content.raw()) }?;
+        // SAFETY: the target retains the FrameNode and never disposes its borrowed native node.
+        let child = Rc::new(RefCell::new(
+            unsafe { raw.borrowed_node() }
+                .map_err(|error| Error::from_reason(error.to_string()))?,
+        ));
+        let handle = slot
+            .map(|slot| {
+                // SAFETY: the retained NodeContent belongs to this callback's N-API environment.
+                unsafe { ArkUIHandle::from_napi_value(env.raw(), slot.raw()) }
+            })
+            .transpose()?;
+        if let Some(inner) = inner.as_ref() {
+            inner
+                .borrow()
+                .remove_event_receiver()
+                .map_err(|error| Error::from_reason(error.to_string()))?;
+            if let Err(error) = inner.borrow().remove_from_parent() {
+                if let Err(restore_error) = inner.borrow().add_event_receiver() {
+                    crate::error!(
+                        "Failed to restore native subtree event receiver: {restore_error}"
+                    );
+                }
+                return Err(Error::from_reason(error.to_string()));
+            }
+            parent
+                .borrow_mut()
+                .children_mut()
+                .retain(|child| !Rc::ptr_eq(child, inner));
+        }
+        parent
+            .borrow_mut()
+            .add_existing_node(child.clone())
+            .map_err(|error| Error::from_reason(error.to_string()))?;
+        *target.child.borrow_mut() = Some(child);
+        *target.retained.borrow_mut() = Some(retained);
+        if let (Some(handle), Some(inner)) = (handle, inner.as_ref()) {
+            if let Err(error) = NodeContent::from_handle(handle).add_node(&inner.borrow()) {
+                target.detach_inner()?;
+                return Err(Error::from_reason(error.to_string()));
+            }
+            target.slot.set(Some(handle));
+            if let Err(error) =
+                ohos_arkui_binding::common::node_registry::register(&inner.borrow(), inner.clone())
+                    .and_then(|()| inner.borrow().add_event_receiver())
+            {
+                target.detach_inner()?;
+                return Err(Error::from_reason(error.to_string()));
+            }
+            target.inner_receiver_active.set(true);
+        }
+        Ok(())
+    }
+
+    /// Permanently retires the target. Failure preserves its references for a UI-thread retry.
+    pub fn retire(id: u32) -> Result<()> {
+        target(id)?.retire()
+    }
+
+    pub fn invalidate(&self) -> Result<()> {
+        self.0.retire()
+    }
+
+    pub fn detach(&self) -> Result<()> {
+        self.invalidate()
+    }
+}
+
+impl Drop for NativeAttachment {
+    fn drop(&mut self) {
+        if let Err(error) = self.invalidate() {
+            crate::error!("Failed to retire native attachment {}: {error}", self.id());
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn unknown_targets_never_dispatch() {
+        let mut dispatched = false;
+        assert!(NativeAttachment::dispatch(0, || dispatched = true).is_err());
+        assert!(!dispatched);
+        assert!(NativeAttachment::retire(0).is_err());
+    }
+
+    #[test]
+    fn retirement_is_guarded_and_permanently_closes_callback_admission() {
+        let id = allocate_id(&NEXT_TARGET_ID).unwrap();
+        let parent = Rc::new(RefCell::new(ArkUINode::default()));
+        let inner = Rc::new(RefCell::new(ArkUINode::default()));
+        let target = Rc::new(Target {
+            id,
+            state: AttachmentState::default(),
+            parent: RefCell::new(Some(parent.clone())),
+            child: RefCell::default(),
+            inner: RefCell::new(Some(inner.clone())),
+            inner_receiver_active: Cell::new(false),
+            slot: Cell::new(None),
+            retained: RefCell::default(),
+        });
+        let attachment = NativeAttachment(target.clone());
+        TARGETS.with(|targets| targets.borrow_mut().insert(id, target.clone()));
+        {
+            let _callback = target.begin().unwrap();
+            assert!(NativeAttachment::retire(id).is_err());
+            assert_eq!(Rc::strong_count(&parent), 2);
+            assert_eq!(Rc::strong_count(&inner), 2);
+        }
+        NativeAttachment::retire(id).unwrap();
+        // The external attachment still owns Target, but retirement releases both nodes now.
+        assert_eq!(attachment.id(), id);
+        assert!(target.parent.borrow().is_none());
+        assert!(target.inner.borrow().is_none());
+        assert_eq!(Rc::strong_count(&parent), 1);
+        assert_eq!(Rc::strong_count(&inner), 1);
+        let mut dispatched = false;
+        assert!(NativeAttachment::dispatch(id, || dispatched = true).is_err());
+        assert!(!dispatched);
+        assert!(target.begin().is_err());
+        attachment.invalidate().unwrap();
+        drop(attachment);
+        assert_eq!(Rc::strong_count(&parent), 1);
+        assert_eq!(Rc::strong_count(&inner), 1);
+    }
+
+    #[test]
+    fn empty_nodes_cannot_be_retained() {
+        let parent = Rc::new(RefCell::new(ArkUINode::default()));
+        let error = NativeAttachment::new(&parent).err().unwrap();
+        assert_eq!(error.reason, "native retention requires an owned node");
+        assert_eq!(Rc::strong_count(&parent), 1);
+    }
+}
diff --git a/vendor/openharmony-ability/src/node/attachment_state.rs b/vendor/openharmony-ability/src/node/attachment_state.rs
new file mode 100644
index 0000000..05e4ccf
--- /dev/null
+++ b/vendor/openharmony-ability/src/node/attachment_state.rs
@@ -0,0 +1,130 @@
+use std::{
+    cell::Cell,
+    fmt,
+    sync::atomic::{AtomicU32, Ordering},
+};
+
+pub(crate) fn allocate_id(counter: &AtomicU32) -> Option<u32> {
+    let mut id = counter.load(Ordering::Relaxed);
+    loop {
+        let next = id.checked_add(1)?;
+        match counter.compare_exchange_weak(id, next, Ordering::Relaxed, Ordering::Relaxed) {
+            Ok(_) => return Some(id),
+            Err(current) => id = current,
+        }
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum AdmissionError {
+    Retired,
+    Busy,
+}
+
+impl fmt::Display for AdmissionError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(match self {
+            Self::Retired => "is retired",
+            Self::Busy => "already has an operation in progress",
+        })
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct AttachmentState {
+    retired: Cell<bool>,
+    active: Cell<bool>,
+}
+
+impl AttachmentState {
+    pub(crate) fn begin(&self) -> Result<Active<'_>, AdmissionError> {
+        if self.retired.get() {
+            return Err(AdmissionError::Retired);
+        }
+        self.enter()
+    }
+
+    pub(crate) fn begin_retire(&self) -> Result<Active<'_>, AdmissionError> {
+        let active = self.enter()?;
+        self.retired.set(true);
+        Ok(active)
+    }
+
+    fn enter(&self) -> Result<Active<'_>, AdmissionError> {
+        if self.active.replace(true) {
+            Err(AdmissionError::Busy)
+        } else {
+            Ok(Active(&self.active))
+        }
+    }
+}
+
+#[must_use]
+pub(crate) struct Active<'a>(&'a Cell<bool>);
+
+impl Drop for Active<'_> {
+    fn drop(&mut self) {
+        self.0.set(false);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn ids_are_monotonic_and_never_wrap() {
+        let counter = AtomicU32::new(1);
+        assert_eq!(allocate_id(&counter), Some(1));
+        assert_eq!(allocate_id(&counter), Some(2));
+        counter.store(u32::MAX - 1, Ordering::Relaxed);
+        assert_eq!(allocate_id(&counter), Some(u32::MAX - 1));
+        assert_eq!(allocate_id(&counter), None);
+        assert_eq!(allocate_id(&counter), None);
+        assert_eq!(counter.load(Ordering::Relaxed), u32::MAX);
+    }
+
+    #[test]
+    fn callback_holds_the_guard_through_reentrant_retirement() {
+        let state = AttachmentState::default();
+        {
+            let _callback = state.begin().unwrap();
+            assert!(matches!(state.begin(), Err(AdmissionError::Busy)));
+            assert!(matches!(state.begin_retire(), Err(AdmissionError::Busy)));
+        }
+        assert!(state.begin().is_ok());
+    }
+
+    #[test]
+    fn retirement_permanently_rejects_callbacks_but_allows_detachment_retry() {
+        let state = AttachmentState::default();
+        {
+            let _retirement = state.begin_retire().unwrap();
+            assert!(matches!(state.begin(), Err(AdmissionError::Retired)));
+        }
+        assert!(matches!(state.begin(), Err(AdmissionError::Retired)));
+        let _retry = state.begin_retire().unwrap();
+        assert!(matches!(state.begin(), Err(AdmissionError::Retired)));
+    }
+
+    #[test]
+    fn unwinding_a_callback_releases_admission() {
+        let state = AttachmentState::default();
+        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _callback = state.begin().unwrap();
+            panic!("callback failed");
+        }));
+        assert!(state.begin().is_ok());
+    }
+
+    #[test]
+    fn unwinding_retirement_never_reopens_callbacks() {
+        let state = AttachmentState::default();
+        let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _retirement = state.begin_retire().unwrap();
+            panic!("detachment failed");
+        }));
+        assert!(matches!(state.begin(), Err(AdmissionError::Retired)));
+        assert!(state.begin_retire().is_ok());
+    }
+}
