+fn compile_ohos_capture() {
+    let compiler = env::var("SNOW_CAPTURE_OHOS_CXX").expect("OHOS C++ compiler not configured");
+    let sysroot = env::var("SNOW_CAPTURE_OHOS_SYSROOT").expect("OHOS sysroot not configured");
+    println!("cargo:rerun-if-changed=native/ohos_capture.cpp");
+    println!("cargo:rerun-if-env-changed=SNOW_CAPTURE_OHOS_CXX");
+    println!("cargo:rerun-if-env-changed=SNOW_CAPTURE_OHOS_SYSROOT");
+    cc::Build::new()
+        .cpp(true)
+        .std("c++20")
+        .compiler(compiler)
+        .flag(format!("--sysroot={sysroot}"))
+        .warnings_into_errors(true)
+        .file("native/ohos_capture.cpp")
+        .compile("snow_capture_ohos");
+    println!("cargo:rustc-link-lib=dylib=native_display_manager");
+    println!("cargo:rustc-link-lib=dylib=pixelmap");
+}
