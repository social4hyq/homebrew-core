+void ScreenshotToolbarWindow::presentForScrollingCapture(QWidget* previewOwner) {
+    m_scrollingPresentationActive = true;
+#if defined(Q_OS_OHOS) || defined(Q_OS_HARMONY)
+    setOwnerWindow(previewOwner);
+#else
+    Q_UNUSED(previewOwner);
+#endif
+    const auto present = [this] {
+        if (!m_scrollingPresentationActive) {
+            return;
+        }
+#if defined(Q_OS_OHOS) || defined(Q_OS_HARMONY)
+        qInfo() << "SNOW_OHOS_TOOLBAR_BEFORE" << isVisible()
+                << (windowHandle() != nullptr && windowHandle()->isExposed())
+                << (parentWidget() != nullptr && parentWidget()->isVisible());
+#endif
+        show();
+        raise();
+#if defined(Q_OS_OHOS) || defined(Q_OS_HARMONY)
+        qInfo() << "SNOW_OHOS_TOOLBAR_AFTER" << isVisible()
+                << (windowHandle() != nullptr && windowHandle()->isExposed())
+                << (parentWidget() != nullptr && parentWidget()->isVisible());
+#endif
+    };
+    present();
+    QTimer::singleShot(kScrollingToolbarRaiseDelayMs, this, present);
+}
