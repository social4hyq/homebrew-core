OHOS: recordings are staged in the app sandbox, and the system-tray
notification used by other platforms is never shown on OHOS (the tray is
intentionally disabled there), so the existing OpenRecording notification
action is unreachable. Offer the DocumentViewPicker as soon as a recording
is finalized, except for copy-only finishes, reusing the existing
RecordingFileExport path. Also offer the picker after trim/recovery exports,
except when the trim session was a copy.

diff --git a/snow_shot/src/presentation/recording/screenrecordingcontroller.cpp b/snow_shot/src/presentation/recording/screenrecordingcontroller.cpp
--- a/snow_shot/src/presentation/recording/screenrecordingcontroller.cpp
+++ b/snow_shot/src/presentation/recording/screenrecordingcontroller.cpp
@@ -1623,8 +1623,11 @@
         trimSession = new RecordingTrimSession(areaWindow, toolbarWindow, &owner);
         trimSession->reportError = [this](const QString& error) { showError(error); };
         trimSession->exported = [this, session = trimSession](const QString& path) {
+            const bool copy = session->copyExport();
             if (trimSession == session)
                 autoExitAfterRecordingEnds();
+            if (!copy)
+                offerUserFileExport(path);
             notifyExportCompleted(path);
         };
     }
@@ -1784,6 +1787,10 @@
         // Finalized observers can destroy the controller or start a new session.
         // Keep the original Copy intent and its path independent of that callback.
         const QPointer<ScreenRecordingController> guard(&owner);
+        // A copy-only finish keeps the clipboard payload private; other finishes
+        // offer the user a public destination through the picker.
+        if (!shouldCopy)
+            offerUserFileExport(completedPath);
         notifyExportCompleted(completedPath);
         if (guard)
             emit guard->finalized();
@@ -1791,6 +1798,16 @@
             copyFileToClipboard(completedPath);
     }
 
+    void offerUserFileExport(const QString& path) {
+#ifdef Q_OS_HARMONY
+        if (!userFileExporter || automationOwned || automationCommand)
+            return;
+        userFileExporter(path);
+#else
+        Q_UNUSED(path);
+#endif
+    }
+
     void notifyExportCompleted(const QString& path) {
         if (snow_shot::storage::RecordingSettings().notifyAfterExportCompletes())
             emit owner.exportNotificationRequested(path);
@@ -1894,6 +1911,7 @@
                 trimSession->reportError = [this](const QString& error) { showError(error); };
                 trimSession->exported = [this, marker, record](const QString& path) {
                     static_cast<void>(clearRecovery(marker, record));
+                    offerUserFileExport(path);
                     notifyExportCompleted(path);
                 };
                 trimSession->open(record.sourcePath, pendingOutputPath, {}, true, false, {});
@@ -2598,6 +2616,7 @@
     }
 
     PermissionCheck permissionCheck;
+    std::function<void(const QString&)> userFileExporter;
     bool sessionEnding = false;
     bool recoveryOffered = false;
     QJsonObject automationOptions;
@@ -2768,6 +2787,10 @@
     m_impl->permissionCheck = std::move(check);
 }
 
+void ScreenRecordingController::setUserFileExporter(UserFileExporter exporter) {
+    m_impl->userFileExporter = std::move(exporter);
+}
+
 void ScreenRecordingController::open(const QRect& recordingRegion) {
     m_impl->open(recordingRegion);
 }
