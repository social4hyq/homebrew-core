@@ -0,0 +1,24 @@
+use std::{cell::RefCell, rc::Rc};
+
+use napi_ohos::Env;
+
+thread_local! {
+    static MAIN_THREAD_ENV: Rc<RefCell<Option<Env>>> = Rc::new(RefCell::new(None));
+}
+
+pub fn set_main_thread_env(env: Env) {
+    MAIN_THREAD_ENV.with(|rc| {
+        *rc.borrow_mut() = Some(env);
+    });
+}
+
+/// Get a handle to the main thread env.
+/// Only returns Some when called from the main thread where set_main_thread_env was called.
+///
+/// `#[doc(hidden)]` (issue #87 major-10): this exposes raw NAPI machinery that
+/// upper layers (tao/tauri) currently need for TSFN-adjacent calls, but it is
+/// not part of the supported API surface — do not build new features on it.
+#[doc(hidden)]
+pub fn get_main_thread_env() -> Rc<RefCell<Option<Env>>> {
+    MAIN_THREAD_ENV.with(Rc::clone)
+}
diff --git a/vendor/openharmony-ability/src/input/drag.rs b/vendor/openharmony-ability/src/input/drag.rs
new file mode 100644
index 0000000..9d03551
--- /dev/null
+++ b/vendor/openharmony-ability/src/input/drag.rs
@@ -0,0 +1,338 @@
+//! Native drag/drop policy built on owned, typed platform bindings.
+use crate::OpenHarmonyWaker;
+use napi_ohos::{Error, Result};
+use ohos_arkui_binding::{
+    api::drag::{DragAction, DragCompletion, DragEvent},
+    component::attribute::ArkUIAttributeBasic,
+    image_native_binding::{
+        PixelFormat, PixelMap, PixelMapAlphaType, PixelMapInitializationOptions,
+    },
+    types::advanced::DragStatus,
+    XComponent,
+};
+use ohos_udmf_binding::{UdmfData, UdmfRecord, UdsFileUri};
+use std::sync::{
+    atomic::{AtomicU8, Ordering},
+    Arc, Mutex,
+};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DragPhase {
+    Enter,
+    Move,
+    Leave,
+    Drop,
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct DragResponse(Arc<AtomicU8>);
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DragOperation {
+    Copy,
+    Move,
+}
+impl DragOperation {
+    pub(crate) fn native(self) -> ohos_arkui_binding::types::drag::DropOperation {
+        match self {
+            Self::Copy => ohos_arkui_binding::types::drag::DropOperation::Copy,
+            Self::Move => ohos_arkui_binding::types::drag::DropOperation::Move,
+        }
+    }
+}
+/// Validated RGBA preview, in image pixels. The hotspot is relative to its top left.
+#[derive(Clone, Debug)]
+pub struct DragPreview {
+    pub rgba: Vec<u8>,
+    pub width: u32,
+    pub height: u32,
+    pub hotspot_x: f32,
+    pub hotspot_y: f32,
+}
+impl DragPreview {
+    pub fn validate(&self) -> Result<()> {
+        if self.width == 0
+            || self.height == 0
+            || self.width > 1024
+            || self.height > 1024
+            || self.rgba.len() != (self.width * self.height * 4) as usize
+            || !self.hotspot_x.is_finite()
+            || !self.hotspot_y.is_finite()
+        {
+            return Err(Error::from_reason(
+                "Invalid drag preview dimensions, RGBA bytes or hotspot",
+            ));
+        }
+        Ok(())
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NativeDragResult {
+    Dropped(DragOperation),
+    Cancelled,
+    Failed,
+}
+
+impl DragResponse {
+    pub fn accept(&self) {
+        self.accept_operation(DragOperation::Copy);
+    }
+    pub fn accepted(&self) -> bool {
+        self.operation().is_some()
+    }
+    pub fn accept_operation(&self, operation: DragOperation) {
+        self.0.store(
+            match operation {
+                DragOperation::Copy => 1,
+                DragOperation::Move => 2,
+            },
+            Ordering::Release,
+        );
+    }
+    pub fn reject(&self) {
+        self.0.store(0, Ordering::Release);
+    }
+    pub fn operation(&self) -> Option<DragOperation> {
+        match self.0.load(Ordering::Acquire) {
+            1 => Some(DragOperation::Copy),
+            2 => Some(DragOperation::Move),
+            _ => None,
+        }
+    }
+}
+impl PartialEq for DragResponse {
+    fn eq(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.0, &other.0)
+    }
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct DragInputData {
+    pub phase: DragPhase,
+    /// Physical pixels relative to the window, including native content offsets.
+    pub window_x: f32,
+    pub window_y: f32,
+    pub file_uris: Vec<String>,
+    pub response: DragResponse,
+}
+
+impl DragInputData {
+    /// Copies callback-scoped data. No native event or record escapes delivery.
+    pub(crate) fn from_event(event: &DragEvent<'_>, phase: DragPhase) -> Self {
+        let mut file_uris = Vec::new();
+        if matches!(phase, DragPhase::Enter | DragPhase::Drop) {
+            if let Ok(mut data) = UdmfData::try_new() {
+                if event.get_udmf_data(&mut data).is_ok() && (0..=512).contains(&data.count()) {
+                    if let Ok(records) = data.records() {
+                        for record in records {
+                            let Ok(uri) = record.file_uri().and_then(|uri| uri.file_uri()) else {
+                                continue;
+                            };
+                            if uri.starts_with("file://") && !file_uris.contains(&uri) {
+                                file_uris.push(uri);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        Self {
+            phase,
+            window_x: event.touch_point_x_to_window(),
+            window_y: event.touch_point_y_to_window(),
+            file_uris,
+            response: DragResponse::default(),
+        }
+    }
+}
+
+/// UI-thread owner of an outbound native file drag.
+/// Keep the source surface alive until completion, and drop this before releasing that surface.
+pub struct NativeFileDrag {
+    // Native action disposal unregisters callbacks before releasing its data and preview.
+    _action: DragAction,
+    completion: Arc<Mutex<Option<NativeDragResult>>>,
+    _source: XComponent,
+    _pixels: Vec<u8>,
+    _records: Vec<UdmfRecord>,
+    _uris: Vec<UdsFileUri>,
+}
+
+impl NativeFileDrag {
+    /// Capture a typed source view, then release the surface lock before `start`
+    /// because ArkUI can synchronously reenter input dispatch.
+    pub fn node_handle(component: &XComponent) -> XComponent {
+        component.clone()
+    }
+
+    pub fn start(
+        source: XComponent,
+        pointer_id: i32,
+        files: &[(String, bool)],
+        waker: OpenHarmonyWaker,
+    ) -> Result<Self> {
+        Self::start_with_preview(source, pointer_id, files, None, waker)
+    }
+
+    pub fn start_with_preview(
+        source: XComponent,
+        pointer_id: i32,
+        files: &[(String, bool)],
+        preview: Option<DragPreview>,
+        waker: OpenHarmonyWaker,
+    ) -> Result<Self> {
+        if let Some(preview) = &preview {
+            preview.validate()?;
+        }
+        if files.is_empty() || files.len() > 512 {
+            return Err(Error::from_reason("Native drag requires 1..512 files"));
+        }
+        let mut data = UdmfData::try_new().map_err(|e| Error::from_reason(e.to_string()))?;
+        let mut records = Vec::with_capacity(files.len());
+        let mut uris = Vec::with_capacity(files.len());
+        for (value, directory) in files {
+            if !value.starts_with("file://") {
+                return Err(Error::from_reason("Native drag requires file:// URIs"));
+            }
+            let uri = UdsFileUri::new().map_err(|e| Error::from_reason(e.to_string()))?;
+            uri.set_file_uri(value)
+                .map_err(|e| Error::from_reason(e.to_string()))?;
+            uri.set_file_type(if *directory {
+                "general.folder"
+            } else {
+                "general.file"
+            })
+            .map_err(|e| Error::from_reason(e.to_string()))?;
+            let record = UdmfRecord::try_new().map_err(|e| Error::from_reason(e.to_string()))?;
+            record
+                .add_file_uri(&uri)
+                .map_err(|e| Error::from_reason(e.to_string()))?;
+            data.add_record(&record)
+                .map_err(|e| Error::from_reason(e.to_string()))?;
+            records.push(record);
+            uris.push(uri);
+        }
+        let mut options =
+            PixelMapInitializationOptions::new().map_err(|e| Error::from_reason(e.to_string()))?;
+        options
+            .set_width(preview.as_ref().map_or(32, |p| p.width))
+            .map_err(|e| Error::from_reason(e.to_string()))?;
+        options
+            .set_height(preview.as_ref().map_or(32, |p| p.height))
+            .map_err(|e| Error::from_reason(e.to_string()))?;
+        options
+            .set_pixel_format(PixelFormat::Rgba8888)
+            .map_err(|e| Error::from_reason(e.to_string()))?;
+        options
+            .set_src_pixel_format(PixelFormat::Rgba8888)
+            .map_err(|e| Error::from_reason(e.to_string()))?;
+        options
+            .set_alpha_type(PixelMapAlphaType::Unpremultiplied)
+            .map_err(|e| Error::from_reason(e.to_string()))?;
+        let hotspot = preview.as_ref().map(|p| (p.hotspot_x, p.hotspot_y));
+        let mut pixels =
+            preview.map_or_else(|| [0x3c, 0xc7, 0x55, 0xff].repeat(32 * 32), |p| p.rgba);
+        let preview = PixelMap::create(&mut pixels, &mut options)
+            .map_err(|e| Error::from_reason(e.to_string()))?;
+        let mut action = DragAction::new_with_node(source.raw())
+            .map_err(|e| Error::from_reason(e.to_string()))?;
+        action
+            .set_pixel_maps(vec![preview])
+            .map_err(|e| Error::from_reason(e.to_string()))?;
+        action
+            .set_pointer_id(pointer_id)
+            .map_err(|e| Error::from_reason(e.to_string()))?;
+        action
+            .set_data(data)
+            .map_err(|e| Error::from_reason(e.to_string()))?;
+        if let Some((x, y)) = hotspot {
+            action
+                .set_touch_point_x(x)
+                .map_err(|e| Error::from_reason(e.to_string()))?;
+            action
+                .set_touch_point_y(y)
+                .map_err(|e| Error::from_reason(e.to_string()))?;
+        }
+        let completion = Arc::new(Mutex::new(None));
+        let completed = completion.clone();
+        action
+            .register_completion_listener(move |event| {
+                if let Some(result) = native_drag_result(event) {
+                    *completed.lock().unwrap_or_else(|e| e.into_inner()) = Some(result);
+                    waker.wake();
+                }
+            })
+            .map_err(|e| Error::from_reason(e.to_string()))?;
+        action
+            .start_drag()
+            .map_err(|e| Error::from_reason(e.to_string()))?;
+        Ok(Self {
+            _action: action,
+            completion,
+            _source: source,
+            _pixels: pixels,
+            _records: records,
+            _uris: uris,
+        })
+    }
+
+    pub fn ended(&self) -> bool {
+        self.result().is_some()
+    }
+}
+
+impl NativeFileDrag {
+    pub fn result(&self) -> Option<NativeDragResult> {
+        *self.completion.lock().unwrap_or_else(|e| e.into_inner())
+    }
+}
+fn native_drag_result(event: DragCompletion) -> Option<NativeDragResult> {
+    use ohos_arkui_binding::types::drag::{DragResult, DropOperation};
+    if event.status != DragStatus::Ended {
+        return None;
+    }
+    Some(match (event.result, event.operation) {
+        (Some(DragResult::Successful), Some(DropOperation::Copy)) => {
+            NativeDragResult::Dropped(DragOperation::Copy)
+        }
+        (Some(DragResult::Successful), Some(DropOperation::Move)) => {
+            NativeDragResult::Dropped(DragOperation::Move)
+        }
+        (Some(DragResult::Canceled), _) => NativeDragResult::Cancelled,
+        _ => NativeDragResult::Failed,
+    })
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn completion_does_not_report_cancellation_as_success() {
+        use ohos_arkui_binding::types::drag::{DragResult, DropOperation};
+        for (result, operation, expected) in [
+            (
+                Some(DragResult::Successful),
+                Some(DropOperation::Move),
+                NativeDragResult::Dropped(DragOperation::Move),
+            ),
+            (
+                Some(DragResult::Canceled),
+                Some(DropOperation::Copy),
+                NativeDragResult::Cancelled,
+            ),
+            (None, None, NativeDragResult::Failed),
+        ] {
+            assert_eq!(
+                native_drag_result(DragCompletion {
+                    status: DragStatus::Ended,
+                    result,
+                    operation
+                }),
+                Some(expected)
+            );
+        }
+        let response = DragResponse::default();
+        response.accept_operation(DragOperation::Move);
+        assert_eq!(response.operation(), Some(DragOperation::Move));
+        response.reject();
+        assert!(!response.accepted());
+    }
+}
diff --git a/vendor/openharmony-ability/src/input/ime.rs b/vendor/openharmony-ability/src/input/ime.rs
new file mode 100644
index 0000000..8d4a9f6
--- /dev/null
+++ b/vendor/openharmony-ability/src/input/ime.rs
@@ -0,0 +1,293 @@
+use std::sync::{Arc, RwLock};
+
+use napi_ohos::{Error, Result};
+use ohos_ime_binding::{AttachOptions, IME};
+
+use crate::{waker::InputWake, Event, OpenHarmonyApp};
+
+use super::{
+    queue::{Delivery, InputOwner, InputQueue},
+    ImeEvent, InputEvent,
+};
+
+#[derive(Clone)]
+pub(crate) struct ImeCallbackSource {
+    owner: String,
+    platform_window_id: i32,
+    input: InputCallback,
+    ready: bool,
+}
+
+#[derive(Clone)]
+pub(crate) struct InputCallback {
+    queue: Arc<InputQueue<InputEvent>>,
+    waker: Arc<RwLock<Option<Arc<InputWake>>>>,
+    owner: InputOwner,
+}
+
+impl InputCallback {
+    pub(crate) fn send(&self, event: InputEvent) {
+        self.enqueue(self.queue.push(&self.owner, event));
+    }
+
+    pub(crate) fn send_on_ui_thread(&self, app: &OpenHarmonyApp, event: InputEvent) {
+        match self.queue.push(&self.owner, event) {
+            Ok(true) => {
+                app.drain_input();
+                if self.queue.has_pending() {
+                    crate::waker::schedule_input(&self.waker, &self.queue);
+                }
+            }
+            Ok(false) => {}
+            Err(error) => crate::warn!("{error}"),
+        }
+    }
+
+    fn ime(&self, event: ImeEvent) {
+        #[cfg(feature = "keyboard")]
+        if !matches!(event, ImeEvent::ImeStatusEvent(_)) {
+            if let Err(error) = self.queue.ime_edit(&self.owner) {
+                crate::warn!("{error}");
+                return;
+            }
+        }
+        self.send(InputEvent::Ime(event));
+    }
+
+    #[cfg(feature = "keyboard")]
+    pub(crate) fn key(&self, id: super::queue::KeyId, event: crate::KeyboardEventData) {
+        self.enqueue(self.queue.push_key(
+            &self.owner,
+            id,
+            InputEvent::ArkUi(crate::ArkUiInputEvent::Key(event)),
+        ));
+    }
+
+    #[cfg(feature = "keyboard")]
+    pub(crate) fn after_ime(&self, id: super::queue::KeyId) {
+        if let Err(error) = self.queue.after_ime(&self.owner, id) {
+            crate::warn!("{error}");
+        }
+    }
+
+    fn enqueue(&self, result: std::result::Result<bool, &'static str>) {
+        match result {
+            Ok(true) => crate::waker::schedule_input(&self.waker, &self.queue),
+            Ok(false) => {}
+            Err(error) => crate::warn!("{error}"),
+        }
+    }
+}
+
+impl ImeCallbackSource {
+    fn create_ime(&self) -> IME {
+        let ime = IME::new_for_window(AttachOptions::new(false), self.platform_window_id);
+        macro_rules! callback {
+            ($method:ident, |$($arg:ident),*| $event:expr) => {{
+                let input = self.input.clone();
+                ime.$method(move |$($arg),*| input.ime($event));
+            }};
+        }
+        callback!(insert_text, |text| ImeEvent::TextInputEvent(
+            crate::TextInputEventData { text }
+        ));
+        callback!(on_status_change, |status| ImeEvent::ImeStatusEvent(status));
+        callback!(on_backspace, |length| ImeEvent::BackspaceEvent(length));
+        callback!(on_delete_forward, |length| ImeEvent::DeleteForwardEvent(
+            length
+        ));
+        callback!(on_move_cursor, |direction| ImeEvent::MoveCursorEvent(
+            direction
+        ));
+        callback!(on_set_selection, |selection| ImeEvent::SelectionEvent {
+            start: selection.start,
+            end: selection.end,
+        });
+        callback!(on_extend_action, |action| ImeEvent::ExtendActionEvent(
+            action
+        ));
+        callback!(on_enter, |key| ImeEvent::EnterEvent(u32::from(key) as i32));
+        callback!(on_preview, |text, start, end| ImeEvent::PreviewTextEvent {
+            text,
+            start,
+            end,
+        });
+        let input = self.input.clone();
+        ime.on_finish_preview(move || input.ime(ImeEvent::FinishPreviewEvent));
+        ime
+    }
+}
+
+impl OpenHarmonyApp {
+    /// Whether this render owner has a native editor, independently of EGL surface creation.
+    /// Call only on the N-API/UI thread.
+    pub fn is_text_input_ready_for(&self, window_id: i64) -> bool {
+        if let Err(error) = self.ensure_input_main_thread() {
+            crate::warn!("Cannot inspect native editor for window {window_id}: {error}");
+            return false;
+        }
+        self.ime_sources
+            .borrow()
+            .get(&window_id)
+            .is_some_and(|source| {
+                source.ready
+                    && self.render_window_id(&source.owner) == Some(window_id)
+                    && if window_id == 0 {
+                        self.ime.borrow().is_some()
+                    } else {
+                        self.sub_ime.borrow().contains_key(&window_id)
+                    }
+            })
+    }
+
+    pub(crate) fn initialize_render_input(
+        &self,
+        owner: &str,
+        platform_window_id: i32,
+    ) -> Result<()> {
+        let window_id = self
+            .render_window_id(owner)
+            .ok_or_else(|| Error::from_reason("Native input requires a live render owner"))?;
+        if self.is_text_input_ready_for(window_id) {
+            return Ok(());
+        }
+        // A failed retirement retains the old session until detachment succeeds.
+        self.try_detach_ime_for(window_id)?;
+        let source = ImeCallbackSource {
+            owner: owner.to_owned(),
+            platform_window_id,
+            input: InputCallback {
+                queue: self.input_queue.clone(),
+                waker: self.waker.clone(),
+                owner: self
+                    .input_queue
+                    .activate(owner)
+                    .map_err(Error::from_reason)?,
+            },
+            ready: true,
+        };
+        let ime = source.create_ime();
+        if window_id == 0 {
+            *self.ime.borrow_mut() = Some(ime);
+        } else {
+            self.sub_ime.borrow_mut().insert(window_id, ime);
+        }
+        self.ime_sources.borrow_mut().insert(window_id, source);
+        self.notify_text_input_ready(window_id, true);
+        Ok(())
+    }
+
+    pub(crate) fn input_callback(&self, owner: &str) -> Option<InputCallback> {
+        let window_id = self.render_window_id(owner)?;
+        self.ime_sources
+            .borrow()
+            .get(&window_id)
+            .filter(|source| source.ready && source.owner == owner)
+            .map(|source| source.input.clone())
+    }
+
+    pub(crate) fn retire_render_input(&self, owner: &str, window_id: i64) {
+        if let Err(error) = self.input_queue.discard(owner) {
+            crate::warn!("{error}");
+        }
+        let was_ready = self
+            .ime_sources
+            .borrow_mut()
+            .get_mut(&window_id)
+            .map(|source| std::mem::replace(&mut source.ready, false))
+            .unwrap_or(false);
+        if let Err(error) = self.try_detach_ime_for(window_id) {
+            crate::warn!("Cannot detach retiring editor for window {window_id}: {error}");
+            if was_ready {
+                self.notify_text_input_ready(window_id, false);
+            }
+            return;
+        }
+        self.ime_sources.borrow_mut().remove(&window_id);
+        if window_id == 0 {
+            self.ime.borrow_mut().take();
+        } else {
+            self.sub_ime.borrow_mut().remove(&window_id);
+        }
+        if was_ready {
+            self.notify_text_input_ready(window_id, false);
+        }
+    }
+
+    /// Reassign an editor without accepting delayed edits from its previous lifetime.
+    /// Call only on the N-API/UI thread.
+    pub fn reset_ime_for(&self, window_id: i64) -> Result<()> {
+        self.ensure_input_main_thread()?;
+        let source = self
+            .ime_sources
+            .borrow()
+            .get(&window_id)
+            .cloned()
+            .ok_or_else(|| {
+                Error::from_reason(format!("Native IME is not ready for window {window_id}"))
+            })?;
+        self.retire_render_input(&source.owner, window_id);
+        self.initialize_render_input(&source.owner, source.platform_window_id)
+    }
+
+    fn notify_text_input_ready(&self, window_id: i64, ready: bool) {
+        if let Ok(mut handler) = self.event_loop.try_borrow_mut() {
+            if let Some(handler) = handler.as_mut() {
+                handler(Event::TextInputReadyChanged { window_id, ready });
+            }
+        } else {
+            let app = self.clone();
+            self.queue_after_input(move || app.notify_text_input_ready(window_id, ready));
+        }
+    }
+
+    pub(crate) fn drain_input(&self) {
+        // Native focus and drag callbacks can reenter while the application handler runs.
+        // Leave the queue intact until the scheduled main-thread turn can own the handler.
+        if self.event_loop.try_borrow_mut().is_err() {
+            return;
+        }
+        crate::waker::clear_scheduled(&self.waker, &self.input_queue);
+        loop {
+            let delivery = match self.input_queue.pop() {
+                Ok(Some(delivery)) => delivery,
+                Ok(None) => break,
+                Err(error) => {
+                    crate::warn!("{error}");
+                    break;
+                }
+            };
+            match delivery {
+                Delivery::Wake => {
+                    self.drain_after_input();
+                    if let Some(handler) = self.event_loop.borrow_mut().as_mut() {
+                        handler(Event::UserEvent);
+                    }
+                }
+                Delivery::Input {
+                    owner,
+                    mut value,
+                    ime_consumed,
+                } => {
+                    #[cfg(feature = "keyboard")]
+                    if let InputEvent::ArkUi(crate::ArkUiInputEvent::Key(ref mut key)) = value {
+                        key.ime_consumed = ime_consumed.unwrap_or(false);
+                    }
+                    #[cfg(not(feature = "keyboard"))]
+                    let _ = (&mut value, ime_consumed);
+                    if let Some(handler) = self.event_loop.borrow_mut().as_mut() {
+                        match self.render_window_id(&owner) {
+                            Some(0) => handler(Event::Input(value)),
+                            Some(window_id) => handler(Event::SubWindowInput {
+                                window_id,
+                                event: value,
+                            }),
+                            None => {}
+                        }
+                    }
+                }
+            }
+            self.drain_after_input();
+        }
+    }
+}
diff --git a/vendor/openharmony-ability/src/input/keyboard.rs b/vendor/openharmony-ability/src/input/keyboard.rs
new file mode 100644
index 0000000..4202708
--- /dev/null
+++ b/vendor/openharmony-ability/src/input/keyboard.rs
@@ -0,0 +1,152 @@
+#[cfg(all(feature = "keyboard", not(feature = "api-19")))]
+use ohos_arkui_binding::event::KeyLockState;
+#[cfg(feature = "keyboard")]
+use ohos_arkui_binding::event::{inner_event::Event, KeyEventType};
+#[cfg(feature = "keyboard")]
+use ohos_xcomponent_binding::{Action, EventSource, KeyCode};
+#[cfg(feature = "keyboard")]
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Arc,
+};
+
+/// Selects one keyboard stream; the same physical key is never delivered twice.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub enum KeyboardInputDelivery {
+    /// Raw XComponent key codes, available on older systems.
+    #[default]
+    RawXComponent,
+    /// Every ArkUI physical key once, with its IME disposition (API 14+).
+    #[cfg(feature = "keyboard")]
+    ArkUi,
+}
+
+#[cfg(feature = "keyboard")]
+impl KeyboardInputDelivery {
+    pub(crate) fn validate_runtime(self, api: i32) -> napi_ohos::Result<()> {
+        if self == Self::ArkUi && api < 14 {
+            return Err(napi_ohos::Error::from_reason(
+                "ArkUI keyboard delivery requires API 14",
+            ));
+        }
+        Ok(())
+    }
+}
+
+#[cfg(all(test, feature = "keyboard"))]
+mod delivery_tests {
+    use super::KeyboardInputDelivery;
+
+    #[test]
+    fn arkui_keys_use_the_d3_api14_baseline() {
+        for api in [0, 12, 13] {
+            assert!(KeyboardInputDelivery::ArkUi.validate_runtime(api).is_err());
+        }
+        for api in [14, 19, 20, 26] {
+            assert!(KeyboardInputDelivery::ArkUi.validate_runtime(api).is_ok());
+        }
+        assert!(KeyboardInputDelivery::RawXComponent
+            .validate_runtime(12)
+            .is_ok());
+    }
+}
+
+/// An owned snapshot. Native input pointers never outlive their callback.
+#[cfg(feature = "keyboard")]
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct KeyboardEventData {
+    pub code: KeyCode,
+    pub action: Action,
+    pub device_id: i64,
+    pub source: EventSource,
+    pub timestamp: i64,
+    /// System character, or zero when the SDK cannot translate this key.
+    pub unicode: u32,
+    /// `None` means the system query failed, rather than no keys being held.
+    pub pressed_keys: Option<Vec<KeyCode>>,
+    /// Available with `api-19` (API 19+); otherwise unknown.
+    pub caps_lock: Option<bool>,
+    pub num_lock: Option<bool>,
+    /// The transition was handled before post-IME delivery. Update held-key state,
+    /// but do not execute a shortcut or insert hardware text for a consumed key.
+    pub ime_consumed: bool,
+    /// Consume a post-IME key synchronously before its native callback returns.
+    /// Late changes to this owned reply cannot affect a later native key.
+    pub response: KeyboardEventResponse,
+}
+
+#[cfg(feature = "keyboard")]
+#[derive(Clone, Debug, Default)]
+pub struct KeyboardEventResponse(Arc<AtomicBool>);
+
+#[cfg(feature = "keyboard")]
+impl PartialEq for KeyboardEventResponse {
+    fn eq(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.0, &other.0)
+    }
+}
+#[cfg(feature = "keyboard")]
+impl Eq for KeyboardEventResponse {}
+
+#[cfg(feature = "keyboard")]
+impl KeyboardEventResponse {
+    pub fn consume(&self) {
+        self.0.store(true, Ordering::Release);
+    }
+    pub(crate) fn is_consumed(&self) -> bool {
+        self.0.load(Ordering::Acquire)
+    }
+}
+
+#[cfg(feature = "keyboard")]
+impl KeyboardEventData {
+    pub(crate) fn from_node_callback(node_event: &Event) -> Option<Self> {
+        let event = node_event.key_event()?;
+        let action = match event.event_type() {
+            KeyEventType::Down => Action::Down,
+            KeyEventType::Up => Action::Up,
+            // Long-press/click are semantic events, not additional key transitions.
+            _ => return None,
+        };
+        let mut pressed = [0; 64];
+        let mut pressed_keys = event.pressed_keys(&mut pressed).ok().and_then(|length| {
+            pressed.get(..length).map(|codes| {
+                codes
+                    .iter()
+                    .map(|code| KeyCode::from(*code as u32))
+                    .collect::<Vec<_>>()
+            })
+        });
+        let code = KeyCode::from(event.key_code_raw() as u32);
+        if let Some(pressed) = pressed_keys.as_mut() {
+            match action {
+                Action::Up => pressed.retain(|pressed| *pressed != code),
+                Action::Down if !pressed.contains(&code) => pressed.push(code),
+                _ => {}
+            }
+        }
+        #[cfg(feature = "api-19")]
+        let locks = event.lock_state();
+        #[cfg(not(feature = "api-19"))]
+        let locks = KeyLockState::default();
+        Some(Self {
+            code,
+            action,
+            device_id: event.device_id() as i64,
+            // ArkUI and XComponent swap the numeric values for keyboard and joystick.
+            source: match u32::from(event.source()) {
+                1 => EventSource::Mouse,
+                4 => EventSource::Keyboard,
+                5 => EventSource::Joystick,
+                _ => EventSource::Unknown,
+            },
+            timestamp: event.event_time(),
+            unicode: event.unicode(),
+            pressed_keys,
+            caps_lock: locks.caps_lock,
+            num_lock: locks.num_lock,
+            ime_consumed: false,
+            response: KeyboardEventResponse::default(),
+        })
+    }
+}
diff --git a/vendor/openharmony-ability/src/input/mod.rs b/vendor/openharmony-ability/src/input/mod.rs
new file mode 100644
index 0000000..91bda62
--- /dev/null
+++ b/vendor/openharmony-ability/src/input/mod.rs
@@ -0,0 +1,376 @@
+use std::fmt::Debug;
+
+use ohos_arkui_binding::{
+    arkui_input_binding::{
+        ArkUIInputEvent, UIInputAction, UIInputEvent, UIInputSourceType, UIInputToolType,
+    },
+    gesture::gesture_data::GestureInputData,
+};
+use ohos_ime_binding::{Action, Direction, KeyboardStatus};
+use ohos_xcomponent_binding::{KeyEventData, MouseEventData, TouchEventData};
+
+#[cfg(feature = "drag")]
+pub(crate) mod drag;
+mod ime;
+pub(crate) mod queue;
+#[cfg(feature = "drag")]
+pub use drag::{
+    DragInputData, DragOperation, DragPhase, DragPreview, DragResponse, NativeDragResult,
+    NativeFileDrag,
+};
+mod keyboard;
+mod text_input;
+pub(crate) use ime::*;
+pub use keyboard::KeyboardInputDelivery;
+#[cfg(feature = "keyboard")]
+pub use keyboard::{KeyboardEventData, KeyboardEventResponse};
+pub use text_input::*;
+
+#[derive(Clone)]
+pub enum InputEvent {
+    XComponent(XComponentInputEvent),
+    ArkUi(ArkUiInputEvent),
+    Ime(ImeEvent),
+}
+
+impl Debug for InputEvent {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            InputEvent::XComponent(data) => write!(f, "XComponent: {data:?}"),
+            InputEvent::ArkUi(data) => write!(f, "ArkUi: {data:?}"),
+            InputEvent::Ime(data) => write!(f, "Ime: {data:?}"),
+        }
+    }
+}
+
+/// Raw input delivered by the native XComponent callback APIs.
+#[derive(Clone, Debug)]
+pub enum XComponentInputEvent {
+    Key(KeyEventData),
+    Mouse(MouseEventData),
+    Hover(bool),
+    Touch(TouchEventData),
+}
+
+/// Owned ArkUI input and gesture semantics attached to the XComponent node.
+#[derive(Clone, Debug, PartialEq)]
+pub enum ArkUiInputEvent {
+    /// Keyboard focus of the render node, independent of the containing window.
+    FocusChanged(bool),
+    /// Pointer identity only; the existing XComponent callback delivers the input itself.
+    Pointer(PointerInputData),
+    #[cfg(feature = "drag")]
+    Drag(DragInputData),
+    /// One physical transition, including keys consumed by the IME.
+    #[cfg(feature = "keyboard")]
+    Key(KeyboardEventData),
+    Axis(AxisEventData),
+    Gesture(GestureEvent),
+}
+
+/// Controls which touch representation is delivered to the application.
+///
+/// Mouse input remains XComponent events, while wheel and touchpad axis input remains an
+/// ArkUI event regardless of this setting. Configure delivery before the first render starts.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub enum TouchInputDelivery {
+    /// Deliver only raw XComponent touch events.
+    #[default]
+    RawXComponent,
+    /// Deliver only system-recognized ArkUI tap, pan, and swipe gestures.
+    ArkUiGestures,
+    /// Deliver both representations of the same physical touch stream.
+    Both,
+}
+
+impl TouchInputDelivery {
+    pub(crate) fn delivers_raw_touch(self) -> bool {
+        matches!(self, Self::RawXComponent | Self::Both)
+    }
+
+    pub(crate) fn delivers_arkui_gestures(self) -> bool {
+        matches!(self, Self::ArkUiGestures | Self::Both)
+    }
+}
+
+/// Owned pointer metadata captured while an ArkUI callback's raw input is valid.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct PointerInputData {
+    pub event_type: UIInputEvent,
+    pub action: UIInputAction,
+    pub source_type: UIInputSourceType,
+    pub tool_type: UIInputToolType,
+    pub x: f32,
+    pub y: f32,
+    pub window_x: f32,
+    pub window_y: f32,
+    pub display_x: f32,
+    pub display_y: f32,
+    pub timestamp: i64,
+    pub pointer_count: u32,
+    pub pointer_id: Option<i32>,
+    /// Current native mouse button state; absent for non-mouse or unavailable snapshots.
+    pub mouse_buttons_pressed: Option<bool>,
+    /// Pen pose copied while the native input event is alive.
+    pub stylus: Option<StylusInputData>,
+}
+
+/// Native pen pose in degrees, with normalized pressure. Missing values stay unknown.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct StylusInputData {
+    pub pressure: f32,
+    pub tilt_x: f32,
+    pub tilt_y: f32,
+    pub rotation: Option<f64>,
+}
+
+impl PointerInputData {
+    pub(crate) fn from_arkui_event(event: &ArkUIInputEvent) -> Self {
+        let pointer_count = event.pointer_count();
+        #[cfg(feature = "mouse")]
+        let mouse_buttons_pressed = if event.event_type == UIInputEvent::Mouse {
+            let mut buttons = [0; 8];
+            match event.mouse_pressed_buttons(&mut buttons) {
+                Ok(count) => Some(count > 0),
+                Err(error) => {
+                    #[cfg(feature = "log")]
+                    log::warn!("Failed to snapshot pressed mouse buttons: {error:?}");
+                    #[cfg(not(feature = "log"))]
+                    eprintln!("Failed to snapshot pressed mouse buttons: {error:?}");
+                    None
+                }
+            }
+        } else {
+            None
+        };
+        #[cfg(not(feature = "mouse"))]
+        let mouse_buttons_pressed = None;
+        Self {
+            event_type: event.event_type,
+            action: event.action,
+            source_type: event.source_type,
+            tool_type: event.tool_type,
+            x: event.pointer_x(),
+            y: event.pointer_y(),
+            window_x: event.pointer_window_x(),
+            window_y: event.pointer_window_y(),
+            display_x: event.pointer_display_x(),
+            display_y: event.pointer_display_y(),
+            timestamp: event.event_time(),
+            pointer_count,
+            pointer_id: (pointer_count > 0).then(|| event.pointer_id(0)),
+            mouse_buttons_pressed,
+            stylus: (event.tool_type == UIInputToolType::Pen && pointer_count > 0).then(|| {
+                StylusInputData {
+                    pressure: event.pointer_pressure(0),
+                    tilt_x: event.pointer_tilt_x(0),
+                    tilt_y: event.pointer_tilt_y(0),
+                    #[cfg(feature = "stylus")]
+                    rotation: event.pointer_roll_angle().ok(),
+                    #[cfg(not(feature = "stylus"))]
+                    rotation: None,
+                }
+            }),
+        }
+    }
+}
+
+impl From<GestureInputData> for PointerInputData {
+    fn from(event: GestureInputData) -> Self {
+        Self {
+            event_type: event.event_type,
+            action: event.action,
+            source_type: event.source_type,
+            tool_type: event.tool_type,
+            x: event.x,
+            y: event.y,
+            window_x: event.window_x,
+            window_y: event.window_y,
+            display_x: event.display_x,
+            display_y: event.display_y,
+            timestamp: event.timestamp,
+            pointer_count: event.pointer_count,
+            pointer_id: event.pointer_id,
+            mouse_buttons_pressed: None,
+            stylus: None,
+        }
+    }
+}
+
+/// Owned mouse-wheel, touchpad, or rotary-axis scroll data.
+///
+/// The underlying ArkUI input object is only valid during the native callback, so the framework
+/// snapshots its useful values before delivering the event to the application.
+#[derive(Clone, Copy, Debug, PartialEq)]
+#[non_exhaustive]
+pub struct AxisEventData {
+    pub pointer: PointerInputData,
+    pub delta_x: f64,
+    pub delta_y: f64,
+    /// Native wheel step. Zero means unavailable or not a discrete wheel.
+    pub scroll_step: i32,
+}
+
+/// System-recognized gestures emitted according to [`TouchInputDelivery`].
+///
+/// Consumers can use [`GestureEvent::Tap`] as a semantic click, [`GestureEvent::Pan`] as a
+/// scroll-ready stream, and [`GestureEvent::Swipe`] to seed fling or momentum behavior. ArkUI,
+/// rather than each rendering framework, owns gesture recognition and threshold handling.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum GestureEvent {
+    Tap(TapGestureEvent),
+    Pan(PanGestureEvent),
+    Swipe(SwipeGestureEvent),
+}
+
+/// System-recognized single tap with its originating pointer data.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct TapGestureEvent {
+    pub pointer: PointerInputData,
+}
+
+/// Lifecycle phase of a continuous system gesture.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum GesturePhase {
+    Start,
+    Update,
+    End,
+    Cancel,
+}
+
+/// Scroll-ready data produced by ArkUI's pan recognizer.
+///
+/// `offset_*` is the system-provided cumulative displacement. `delta_*` is the displacement
+/// since the previous callback, calculated here so downstream frameworks do not need to retain
+/// their own XComponent scroll state. Velocity is supplied directly by ArkUI.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct PanGestureEvent {
+    pub pointer: PointerInputData,
+    pub phase: GesturePhase,
+    pub delta_x: f32,
+    pub delta_y: f32,
+    pub offset_x: f32,
+    pub offset_y: f32,
+    pub velocity: f32,
+    pub velocity_x: f32,
+    pub velocity_y: f32,
+}
+
+/// Fast-swipe data supplied by ArkUI for fling or momentum handling.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct SwipeGestureEvent {
+    pub pointer: PointerInputData,
+    pub phase: GesturePhase,
+    pub angle: f32,
+    pub velocity: f32,
+}
+
+#[derive(Clone)]
+pub enum ImeEvent {
+    TextInputEvent(TextInputEventData),
+    PreviewTextEvent { text: String, start: i32, end: i32 },
+    FinishPreviewEvent,
+    BackspaceEvent(i32),
+    DeleteForwardEvent(i32),
+    MoveCursorEvent(Direction),
+    SelectionEvent { start: i32, end: i32 },
+    ExtendActionEvent(Action),
+    ImeStatusEvent(KeyboardStatus),
+    EnterEvent(i32),
+}
+
+impl Debug for ImeEvent {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            ImeEvent::TextInputEvent(data) => write!(f, "TextInputEvent: {:?}", data),
+            ImeEvent::PreviewTextEvent { text, start, end } => {
+                write!(f, "PreviewTextEvent: {text:?} ({start}..{end})")
+            }
+            ImeEvent::FinishPreviewEvent => write!(f, "FinishPreviewEvent"),
+            ImeEvent::BackspaceEvent(len) => write!(f, "BackspaceEvent: delete length is {}", len),
+            ImeEvent::DeleteForwardEvent(len) => write!(f, "DeleteForwardEvent: {len}"),
+            ImeEvent::MoveCursorEvent(direction) => write!(f, "MoveCursorEvent: {direction:?}"),
+            ImeEvent::SelectionEvent { start, end } => write!(f, "SelectionEvent: {start}..{end}"),
+            ImeEvent::ExtendActionEvent(action) => write!(f, "ExtendActionEvent: {action:?}"),
+            ImeEvent::ImeStatusEvent(status) => write!(f, "ImeStatusEvent: {:?}", status),
+            ImeEvent::EnterEvent(key) => write!(f, "EnterEvent: {:?}", key),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use ohos_xcomponent_binding::{MouseAction, MouseButton};
+
+    use super::*;
+
+    #[test]
+    fn mouse_event_debug_output_includes_event_data() {
+        let event = InputEvent::XComponent(XComponentInputEvent::Mouse(MouseEventData {
+            x: 12.5,
+            y: 24.0,
+            screen_x: 112.5,
+            screen_y: 224.0,
+            timestamp: 42,
+            action: MouseAction::Move,
+            button: MouseButton::NoneButton,
+        }));
+
+        let output = format!("{event:?}");
+        assert!(output.starts_with("XComponent: Mouse(MouseEventData"));
+        assert!(output.contains("action: Move"));
+        assert!(output.contains("button: NoneButton"));
+    }
+
+    #[test]
+    fn gesture_event_debug_output_includes_scroll_delta() {
+        let event = InputEvent::ArkUi(ArkUiInputEvent::Gesture(GestureEvent::Pan(
+            PanGestureEvent {
+                pointer: pointer_input(),
+                phase: GesturePhase::Update,
+                delta_x: 2.0,
+                delta_y: -4.0,
+                offset_x: 12.0,
+                offset_y: 24.0,
+                velocity: 6.0,
+                velocity_x: 3.0,
+                velocity_y: -5.0,
+            },
+        )));
+
+        let output = format!("{event:?}");
+        assert!(output.starts_with("ArkUi: Gesture(Pan(PanGestureEvent"));
+        assert!(output.contains("phase: Update"));
+        assert!(output.contains("delta_y: -4.0"));
+    }
+
+    fn pointer_input() -> PointerInputData {
+        PointerInputData {
+            event_type: UIInputEvent::Touch,
+            action: UIInputAction::Move,
+            source_type: UIInputSourceType::TouchScreen,
+            tool_type: UIInputToolType::Finger,
+            x: 10.0,
+            y: 20.0,
+            window_x: 10.0,
+            window_y: 20.0,
+            display_x: 10.0,
+            display_y: 20.0,
+            timestamp: 42,
+            pointer_count: 1,
+            pointer_id: Some(0),
+            mouse_buttons_pressed: None,
+            stylus: None,
+        }
+    }
+
+    #[test]
+    fn touch_delivery_selects_exact_streams() {
+        assert!(TouchInputDelivery::RawXComponent.delivers_raw_touch());
+        assert!(!TouchInputDelivery::RawXComponent.delivers_arkui_gestures());
+        assert!(!TouchInputDelivery::ArkUiGestures.delivers_raw_touch());
+        assert!(TouchInputDelivery::ArkUiGestures.delivers_arkui_gestures());
+        assert!(TouchInputDelivery::Both.delivers_raw_touch());
+        assert!(TouchInputDelivery::Both.delivers_arkui_gestures());
+    }
+}
