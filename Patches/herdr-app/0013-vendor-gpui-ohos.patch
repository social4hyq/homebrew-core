+#[gpui::test]
+fn nested_rounded_groups_preserve_the_clip_stack(cx: &mut gpui::TestAppContext) {
+    use gpui::{ParentElement as _, Styled as _};
+    let (pixels, side) = render_div_fixture(cx, || {
+        let mut child = gpui::div().size(px(64.)).bg(gpui::black());
+        for depth in 0..12 {
+            child = gpui::div()
+                .size(px(64.))
+                .rounded(px(20. + depth as f32 * 0.1))
+                .overflow_hidden()
+                .child(child);
