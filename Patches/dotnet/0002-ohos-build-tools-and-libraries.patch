--- /dev/null
+++ b/src/runtime/eng/native/ohos-harmonybrew.toolchain.cmake
@@ -0,0 +1,16 @@
+include("$ENV{OHOS_NDK_HOME}/native/build/cmake/ohos.toolchain.cmake")
+
+# The OHOS build container's CMake glob misses its compiler detection modules.
+set(CMAKE_C_COMPILER_ID Clang CACHE INTERNAL "OpenHarmony NDK C compiler ID")
+set(CMAKE_CXX_COMPILER_ID Clang CACHE INTERNAL "OpenHarmony NDK C++ compiler ID")
+
+# The NDK Clang uses its own sysroot and rejects CMake's -gcc-toolchain flag.
+unset(CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN)
+unset(CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN)
+unset(CMAKE_ASM_COMPILER_EXTERNAL_TOOLCHAIN)
+set(CMAKE_C_COMPILER_VERSION "${CMAKE_ASM_COMPILER_VERSION}" CACHE INTERNAL "OpenHarmony NDK C compiler version")
+set(CMAKE_CXX_COMPILER_VERSION "${CMAKE_ASM_COMPILER_VERSION}" CACHE INTERNAL "OpenHarmony NDK C++ compiler version")
+set(CMAKE_C_STANDARD_COMPUTED_DEFAULT 17 CACHE INTERNAL "OpenHarmony NDK C standard")
+set(CMAKE_CXX_STANDARD_COMPUTED_DEFAULT 14 CACHE INTERNAL "OpenHarmony NDK C++ standard")
+set(CMAKE_C_EXTENSIONS_COMPUTED_DEFAULT ON CACHE INTERNAL "OpenHarmony NDK C extensions")
+set(CMAKE_CXX_EXTENSIONS_COMPUTED_DEFAULT ON CACHE INTERNAL "OpenHarmony NDK C++ extensions")
