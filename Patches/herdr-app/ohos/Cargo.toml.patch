@@ -21,4 +25,3 @@
-gpui_platform = { package = "gpui-pre-platform", version = "=0.3.8", features = ["font-kit", "x11", "wayland", "runtime_shaders"] }
 gpui-shell = { path = "vendor/gpui-kit/crates/shell" }
 gpui-base = { path = "vendor/gpui-kit/crates/base" }
 anyhow = "1"
@@ -53,9 +56,22 @@
 swash = "=0.2.10"
 tiny-skia = { version = "=0.11.4", default-features = false, features = ["std", "simd"] }
 
-[target.'cfg(target_os = "linux")'.dependencies]
+[target.'cfg(all(target_os = "linux", not(target_env = "ohos")))'.dependencies]
+gpui_platform = { package = "gpui-pre-platform", version = "=0.3.8", features = ["font-kit", "x11", "wayland", "runtime_shaders"] }
 gpui_linux = { package = "gpui-pre-linux", version = "=0.3.8", features = ["render-to-image"] }
 
+[target.'cfg(all(target_os = "linux", target_env = "ohos"))'.dependencies]
+gpui_ohos = { package = "gpui-ohos", path = "vendor/gpui-ohos", default-features = false, features = ["gles", "api-26"] }
+openharmony-ability = "1.0.0-beta.5"
+openharmony-ability-derive = "1.0.0-beta.5"
+napi-ohos = "=1.2.0"
+napi-derive-ohos = "=1.2.0"
+ohos-hilog-binding = { version = "0.2.5", features = ["log"] }
+log = "0.4"
+libc = "0.2"
+tracing-log = "0.2"
+ctor = "0.2"
+
 [target.'cfg(unix)'.dependencies]
 libc = "0.2"
 
@@ -76,6 +92,8 @@
 
 # gpui-shell's LLRT modules must share its quickjs-jit VM; gpui-kit's own workspace does the same.
 [patch.crates-io]
+# OHOS: match IME post-key callbacks to their own key; fast typing duplicated characters (HERDR-OHOS:).
+openharmony-ability = { path = "vendor/openharmony-ability" }
 # HERDR: production frame capture without test-support dependencies.
 gpui-pre = { path = "vendor/gpui-pre" }
 gpui-pre-wgpu = { path = "vendor/gpui-pre-wgpu" }
@@ -97,6 +115,10 @@
 # threw it away, ~40% of the main thread with a mod of many small
 # object-returning functions (longbridge/quickjs-jit#38, HERDR:).
 [patch."https://github.com/longbridge/quickjs-jit"]
+quickjs-jit = { path = "vendor/quickjs-jit-src/96593cd" }
+quickjs-jit-core = { path = "vendor/quickjs-jit-src/96593cd/core" }
+quickjs-jit-macro = { path = "vendor/quickjs-jit-src/96593cd/macro" }
+quickjs-jit-sys = { path = "vendor/quickjs-jit-src/96593cd/sys" }
 quickjs-jit-runtime = { path = "vendor/quickjs-jit-runtime" }
 
 # With --target (CI builds Intel Macs on Apple Silicon), stripping a macOS
@@ -107,3 +129,6 @@
 
 [profile.dev.package."*"]
 opt-level = 2
+
+[build-dependencies]
+napi-build-ohos = "=1.2.0"
