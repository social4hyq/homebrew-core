OHOS: keep the hover tip away from the tray icon. Its update path ends in
QOhosTaskPromise being destroyed without notifying the caller, which aborts the
process when the status bar item is created.

diff --git a/snow_shot/src/presentation/services/systemtraycontroller.cpp b/snow_shot/src/presentation/services/systemtraycontroller.cpp
index 5b4793b..7a06e22 100644
--- a/snow_shot/src/presentation/services/systemtraycontroller.cpp
+++ b/snow_shot/src/presentation/services/systemtraycontroller.cpp
@@ -420,8 +420,13 @@ class SystemTrayController::Impl {
         }
         q.setObjectName(QStringLiteral("systemTrayController"));
         trayIcon->setObjectName(QStringLiteral("snowShotSystemTrayIcon"));
+#ifndef Q_OS_HARMONY
+        // updateStatusBarHoverTips() on OHOS ends in QOhosTaskPromise being
+        // destroyed without notifying the caller and aborts the process, so the
+        // tray icon is created without a hover tip there.
         trayIcon->setToolTip(app::edition::isMini ? app::edition::productName()
                                                   : QStringLiteral("SnowShot"));
+#endif
 #ifdef Q_OS_MACOS
         notifications = std::make_unique<platform::macos::SystemNotificationService>(&q);
         using NotificationService = platform::macos::SystemNotificationService;
@@ -801,8 +806,10 @@ class SystemTrayController::Impl {
     }
 
     void retranslateUi() {
+#ifndef Q_OS_HARMONY
         if (app::edition::isMini)
             trayIcon->setToolTip(app::edition::productName());
+#endif
         for (const settings::SettingsTrayMenuGroupDefinition& group : groups) {
             for (const settings::SettingsTrayMenuOptionDefinition& option : group.options) {
                 if (QAction* action = actions.value(option.id)) {
@@ -1032,8 +1039,13 @@ void SystemTrayController::showRecordingExportMessage(const QString& path) {
     if (path.isEmpty())
         return;
     const QString absolutePath = QFileInfo(path).absoluteFilePath();
-    m_impl->showBalloon(tr("Video export completed"), QDir::toNativeSeparators(absolutePath),
-                        QSystemTrayIcon::Information, BalloonKind::RecordingExport, absolutePath);
+#ifdef Q_OS_HARMONY
+    const QString message = tr("Choose a destination in Files to save the recording.");
+#else
+    const QString message = QDir::toNativeSeparators(absolutePath);
+#endif
+    m_impl->showBalloon(tr("Video export completed"), message, QSystemTrayIcon::Information,
+                        BalloonKind::RecordingExport, absolutePath);
 }
 
