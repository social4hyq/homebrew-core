diff --git a/loginrec.c b/loginrec.c
index 7499aa9..ff083fb 100644
--- a/loginrec.c
+++ b/loginrec.c
@@ -294,8 +294,13 @@ login_get_lastlog(struct logininfo *li, const uid_t uid)
 	 */
 	pw = getpwuid(uid);
 	if (pw == NULL)
+#ifdef __OHOS__
+		/* OHOS may not have traditional passwd entries */
+		return NULL;
+#else
 		fatal("%s: Cannot find account for uid %ld", __func__,
 		    (long)uid);
+#endif
 
 	if (strlcpy(li->username, pw->pw_name, sizeof(li->username)) >=
 	    sizeof(li->username)) {
@@ -367,8 +372,13 @@ login_init_entry(struct logininfo *li, pid_t pid, const char *username,
 		strlcpy(li->username, username, sizeof(li->username));
 		pw = getpwnam(li->username);
 		if (pw == NULL) {
+#ifdef __OHOS__
+			li->uid = (uid_t)-1;
+			return 0;
+#else
 			fatal("%s: Cannot find user \"%s\"", __func__,
 			    li->username);
+#endif
 		}
 		li->uid = pw->pw_uid;
 	}
