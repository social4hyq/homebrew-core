+#include <sys/utsname.h>
+
+static bool host_mq_supported(void)
+{
+#ifdef __OHOS__
+    struct utsname host;
+
+    /* HarmonyOS PC terminates message queue syscalls with SIGSYS. */
+    return uname(&host) == 0 && strcmp(host.sysname, "HarmonyOS") != 0;
+#else
+    return true;
+#endif
+}
 
