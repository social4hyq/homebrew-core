+namespace {
+
+size_t t35CurrentRSS()
+{
+    int fd = open("/proc/self/status", O_RDONLY);
+    if (fd < 0)
+        return 0;
+    char buf[4096];
+    ssize_t n = read(fd, buf, sizeof(buf) - 1);
+    close(fd);
+    if (n <= 0)
+        return 0;
+    buf[n] = '\0';
+    const char* p = strstr(buf, "VmRSS:");
+    if (!p)
+        return 0;
+    return strtoul(p + 6, nullptr, 10) * 1024;
+}
+
+// SIGUSR1 probe: is the bmalloc/libpas growth free-but-retained (scavenge
+// reclaims it) or orphaned/live (scavenge cannot)? Send only while parked.
+extern "C" void bmallocDumpHeapCensusT35();
+
+void t35ScavengeProbe()
+{
+    WTFLogAlways("T35 heap census BEFORE scavenge:\n");
+    bmallocDumpHeapCensusT35();
+    size_t before = t35CurrentRSS();
+    bmalloc::api::scavenge();
+    size_t after = t35CurrentRSS();
+    WTFLogAlways("T35 scavenge probe: RSS %zu -> %zu bytes (reclaimed %zd)\n", before, after, static_cast<ssize_t>(before) - static_cast<ssize_t>(after));
+    WTFLogAlways("T35 heap census AFTER scavenge:\n");
+    bmallocDumpHeapCensusT35();
 }
 
+struct T35HandlerInstaller {
+    T35HandlerInstaller()
+    {
+        // Neither handler is async-signal-safe (locks/allocation); send signals
+        // only while the process is parked.
+        struct sigaction action { };
+        sigemptyset(&action.sa_mask);
+        action.sa_flags = SA_RESTART;
+        action.sa_handler = [](int) { MallocCallTracker::singleton().dumpStats(); };
+        sigaction(SIGUSR2, &action, nullptr);
+        action.sa_handler = [](int) { t35ScavengeProbe(); };
+        sigaction(SIGUSR1, &action, nullptr);
+    }
+};
+
+T35HandlerInstaller t35HandlerInstaller;
+
