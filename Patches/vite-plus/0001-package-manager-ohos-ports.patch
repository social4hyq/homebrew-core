+    /// A registry that only serves the OHOS port of `package` with the given port versions.
+    #[cfg(target_env = "ohos")]
+    fn mock_port_registry<'a>(
+        server: &'a httpmock::MockServer,
+        package: &str,
+        binary_path: &str,
+        revisions: &[&str],
+    ) -> Vec<httpmock::Mock<'a>> {
+        use sha2::{Digest, Sha512};
+
+        let packument: serde_json::Map<String, serde_json::Value> =
+            revisions.iter().map(|v| ((*v).to_string(), serde_json::json!({}))).collect();
+        let mut mocks = vec![server.mock(|when, then| {
+            when.method(httpmock::Method::GET).path(format!("/{package}"));
+            then.status(200).json_body(serde_json::json!({ "versions": packument }));
+        })];
+        let filename = package.rsplit('/').next().unwrap();
+        for revision in revisions {
+            let tgz = create_native_package_tgz(binary_path, revision.as_bytes());
+            let integrity =
+                format!("sha512-{}", base64_simd::STANDARD.encode_to_string(Sha512::digest(&tgz)));
+            mocks.push(server.mock(|when, then| {
+                when.method(httpmock::Method::GET).path(format!("/{package}/{revision}"));
+                then.status(200)
+                    .json_body(serde_json::json!({ "dist": { "integrity": integrity } }));
+            }));
+            mocks.push(server.mock(|when, then| {
+                when.method(httpmock::Method::GET)
+                    .path(format!("/{package}/-/{filename}-{revision}.tgz"));
+                then.status(200).header("content-type", "application/octet-stream").body(tgz);
+            }));
+        }
+        mocks
+    }
+
+    #[cfg(target_env = "ohos")]
+    fn create_native_package_tgz(binary_path: &str, content: &[u8]) -> Vec<u8> {
+        let mut tar_builder = tar::Builder::new(Vec::new());
+        let mut header = tar::Header::new_gnu();
+        header.set_size(content.len() as u64);
+        header.set_mode(0o755);
+        tar_builder
+            .append_data(
+                &mut header,
+                format!("package/{binary_path}"),
+                std::io::Cursor::new(content),
+            )
+            .unwrap();
+        let mut gz_data = Vec::new();
+        {
+            let mut encoder =
+                flate2::write::GzEncoder::new(&mut gz_data, flate2::Compression::default());
+            std::io::copy(
+                &mut std::io::Cursor::new(tar_builder.into_inner().unwrap()),
+                &mut encoder,
+            )
+            .unwrap();
+        }
+        gz_data
+    }
+
