@@ -486,6 +486,18 @@ fn clear_osc_evidence_for_agent_transition(terminal: &PaneTerminal, previous_age
     }
 }
 
+/// Clears mouse tracking when an agent process exits and the pane hands the
+/// terminal back to its shell. Programs that exit without resetting mouse
+/// reporting leave the pane forwarding pointer reports into the shell prompt.
+fn clear_mouse_reporting_for_agent_exit(
+    terminal: &PaneTerminal,
+    action: ForegroundShellAgentAction,
+) {
+    if action == ForegroundShellAgentAction::ReportProcessExit {
+        terminal.clear_mouse_reporting();
+    }
+}
