+/// A client connection's read side.
+///
+/// tokio reads a socket when epoll reports it readable, once per change (edge-triggered). On HarmonyOS a
+/// readable event can go missing when the socket also becomes writable at the same time, and the reading
+/// task then sleeps with bytes waiting: a viewer's CREDIT frames pile up unread, the output stream runs out
+/// of credit and stops for good (a flood of terminal output did it). So a thread waits with `poll(2)`, which
+/// reports whatever is still unread every time, and hands the bytes to the task through a channel. The wait
+/// has a timeout: this kernel has been seen to miss poll wakeups as well, so a missed one costs at most the
+/// timeout instead of the connection.
+pub struct AsyncRead {
+    rx: tokio::sync::mpsc::UnboundedReceiver<io::Result<Vec<u8>>>,
+    chunk: Vec<u8>,
+    at: usize,
+    /// Keeps the socket open for as long as this is, and is where `reply_closed` probes.
+    half: tokio::net::unix::OwnedReadHalf,
+}
+
+impl AsyncRead {
+    fn new(half: tokio::net::unix::OwnedReadHalf) -> io::Result<AsyncRead> {
+        let fd = unsafe { libc::dup(half.as_ref().as_raw_fd()) };
+        if fd < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let (tx, rx) = tokio::sync::mpsc::unbounded_channel();
+        std::thread::Builder::new().name("hc-read".into()).spawn(move || {
+            let mut buf = vec![0u8; 64 * 1024];
+            loop {
+                if tx.is_closed() {
+                    break;
+                }
+                let mut p = libc::pollfd { fd, events: libc::POLLIN, revents: 0 };
+                let ready = unsafe { libc::poll(&mut p, 1, 100) };
+                if ready < 0 {
+                    let e = io::Error::last_os_error();
+                    if e.kind() == io::ErrorKind::Interrupted {
+                        continue;
+                    }
+                    let _ = tx.send(Err(e));
+                    break;
+                }
+                if ready == 0 {
+                    continue;
+                }
+                let n = unsafe { libc::recv(fd, buf.as_mut_ptr().cast(), buf.len(), libc::MSG_DONTWAIT) };
+                if n > 0 {
+                    if tx.send(Ok(buf[..n as usize].to_vec())).is_err() {
+                        break;
+                    }
+                } else if n == 0 {
+                    let _ = tx.send(Ok(Vec::new())); // end of stream
+                    break;
+                } else {
+                    let e = io::Error::last_os_error();
+                    if matches!(e.kind(), io::ErrorKind::WouldBlock | io::ErrorKind::Interrupted) {
+                        continue;
+                    }
+                    let _ = tx.send(Err(e));
+                    break;
+                }
+            }
+            unsafe { libc::close(fd) };
+        })?;
+        Ok(AsyncRead { rx, chunk: Vec::new(), at: 0, half })
+    }
+
+    fn fd(&self) -> std::os::fd::RawFd {
+        self.half.as_ref().as_raw_fd()
+    }
+}
+
+impl tokio::io::AsyncRead for AsyncRead {
+    fn poll_read(
+        mut self: std::pin::Pin<&mut Self>,
+        cx: &mut std::task::Context<'_>,
+        out: &mut tokio::io::ReadBuf<'_>,
+    ) -> std::task::Poll<io::Result<()>> {
+        use std::task::Poll;
+        loop {
+            if self.at < self.chunk.len() {
+                let n = (self.chunk.len() - self.at).min(out.remaining());
+                out.put_slice(&self.chunk[self.at..self.at + n]);
+                self.at += n;
+                return Poll::Ready(Ok(()));
+            }
+            match self.rx.poll_recv(cx) {
+                Poll::Ready(Some(Ok(chunk))) => {
+                    if chunk.is_empty() {
+                        return Poll::Ready(Ok(())); // end of stream
+                    }
+                    self.chunk = chunk;
+                    self.at = 0;
+                }
+                Poll::Ready(Some(Err(e))) => return Poll::Ready(Err(e)),
+                Poll::Ready(None) => return Poll::Ready(Ok(())),
+                Poll::Pending => return Poll::Pending,
+            }
+        }
+    }
+}
