+/// A non-empty `PrimitiveBatch::Paths`: its vertices and sprites in the
+/// frame's path uploads, and the bounds everything it draws stays within.
+pub(crate) struct PathBatch {
+    vertices: Range<u32>,
+    sprites: Range<u32>,
+    bounds: Bounds<ScaledPixels>,
+    /// For the first batch of a group, the vertices of the whole group,
+    /// rasterized together before the batch is drawn.
+    group: Option<Range<u32>>,
+}
+
+/// Where one scene's primitives landed in the instance buffer.
+pub(crate) struct SceneUpload {
+    quads: InstanceBinding,
+    shadows: InstanceBinding,
+    underlines: InstanceBinding,
+    monochrome_sprites: InstanceBinding,
+    subpixel_sprites: InstanceBinding,
+    polychrome_sprites: InstanceBinding,
+}
+
+/// Where the frame's path vertices and sprites, those of every scene it
+/// draws, landed in the instance buffer.
+pub(crate) struct PathUpload {
+    vertices: InstanceBinding,
+    sprites: InstanceBinding,
+}
+
+/// A scene the frame draws, with its paths planned.
+struct PlannedScene<'a> {
+    scene: &'a Scene,
+    path_batches: Vec<PathBatch>,
+    groups: Vec<GroupPlan>,
+}
+
+struct GroupPlan {
+    texture: u32,
+    content: usize,
+}
+
+pub(crate) struct DrawGraph<'a> {
+    scenes: &'a [PlannedScene<'a>],
+    uploads: &'a [SceneUpload],
+}
+
+fn plan_scene<'a>(
+    scene: &'a Scene,
+    scenes: &mut Vec<PlannedScene<'a>>,
+    vertices: &mut Vec<PathRasterizationVertex>,
+    sprites: &mut Vec<PathSprite>,
+    mut path_batches: Vec<PathBatch>,
+) -> usize {
+    let mut groups = Vec::new();
+    for sprite in &scene.polychrome_sprites {
+        let Some(frame) =
+            crate::ohos::wgpu_renderer::fast::rounded_clip::group(scene, sprite.tile.texture_id)
+        else {
+            continue;
+        };
+        let child = frame.content.scene().expect("rounded clip content");
+        let content = plan_scene(child, scenes, vertices, sprites, Vec::new());
+        groups.push(GroupPlan {
+            texture: sprite.tile.texture_id.index,
+            content,
+        });
+    }
+    plan_paths(scene, vertices, sprites, &mut path_batches);
+    let index = scenes.len();
+    scenes.push(PlannedScene {
+        scene,
+        path_batches,
+        groups,
+    });
+    index
+}
+
+/// Records `scene` into `frame_view`, cleared to `clear` first, and submits it.
+pub(crate) fn record_into(
+    host: &mut impl FrameHost,
+    scene: &Scene,
+    frame_view: &wgpu::TextureView,
+    clear: wgpu::Color,
+) -> Result<wgpu::SubmissionIndex> {
+    // State can change while the host lends out the native GPU resources.
+    let mut state = std::mem::take(host.frame_state());
+    let result = record_with(host, &mut state, scene, frame_view, clear);
+    *host.frame_state() = state;
+    result
+}
+
+fn record_with(
+    host: &mut impl FrameHost,
+    state: &mut FrameState,
+    scene: &Scene,
+    frame_view: &wgpu::TextureView,
+    clear: wgpu::Color,
+) -> Result<wgpu::SubmissionIndex> {
+    state.bind_groups.begin_frame();
+
+    // The layer tiles to rasterize before the frame draws them.
+    let planned = state
+        .layers
+        .begin_frame(&scene.layers, composite::composited_tiles(scene));
+    let rasters = raster::plan(&scene.layers, &planned);
+
+    let mut vertices = std::mem::take(&mut state.vertices);
+    let mut sprites = std::mem::take(&mut state.sprites);
+    let mut scenes = Vec::with_capacity(rasters.len() + 1);
+    let mut raster_indices = Vec::with_capacity(rasters.len());
+    for raster in &rasters {
+        raster_indices.push(plan_scene(
+            &raster.scene,
+            &mut scenes,
+            &mut vertices,
+            &mut sprites,
+            Vec::new(),
+        ));
+    }
+    let path_batches = std::mem::take(&mut state.path_batches);
+    plan_scene(
+        scene,
+        &mut scenes,
+        &mut vertices,
+        &mut sprites,
+        path_batches,
+    );
+
+    host.prepare_paths(scenes.iter().any(|planned| !planned.scene.paths.is_empty()));
+    let result = upload(host, &scenes, &vertices, &sprites)
+        .with_context(|| {
+            format!(
+                "scene too large: {} paths, {} shadows, {} quads, {} underlines, {} monochrome sprites, {} subpixel sprites, {} polychrome sprites, {} layer tiles to rasterize",
+                scene.paths.len(),
+                scene.shadows.len(),
+                scene.quads.len(),
+                scene.underlines.len(),
+                scene.monochrome_sprites.len(),
+                scene.subpixel_sprites.len(),
+                scene.polychrome_sprites.len(),
+                rasters.len(),
+            )
+        })
+        .map(|(uploads, paths)| {
+            let target = host.target();
+            state.layers.prepare(&target, &scene.layers, &planned);
+            record(
+                &target, state, scene, frame_view, clear, &rasters, &raster_indices, &scenes, &uploads, &paths,
+            )
+        });
+    if result.is_err() {
+        // The tiles this frame was to rasterize were not.
+        state.layers.clear();
+    }
+
+    let mut path_batches = scenes
+        .pop()
+        .map(|main| main.path_batches)
+        .unwrap_or_default();
+    vertices.clear();
+    sprites.clear();
+    path_batches.clear();
+    state.vertices = vertices;
+    state.sprites = sprites;
+    state.path_batches = path_batches;
+    result
+}
+
+/// Collects every path batch's rasterization vertices and sprites, as
+/// upstream's `draw_paths_to_intermediate` and `draw_paths_from_intermediate`
+/// build them, and groups the batches.
+fn plan_paths(
+    scene: &Scene,
+    vertices: &mut Vec<PathRasterizationVertex>,
+    sprites: &mut Vec<PathSprite>,
+    path_batches: &mut Vec<PathBatch>,
+) {
+    if scene.paths.is_empty() {
+        return;
+    }
+    let mut group_start = path_batches.len();
+    for batch in scene.batches() {
+        let PrimitiveBatch::Paths(range) = batch else {
+            continue;
+        };
+        let paths = &scene.paths[range];
+        let Some(first_path) = paths.first() else {
+            continue;
+        };
+
+        let first_vertex = vertices.len() as u32;
+        let mut union = first_path.clipped_bounds();
+        for path in paths {
+            let bounds = path.clipped_bounds();
+            union = union.union(&bounds);
+            vertices.extend(path.vertices.iter().map(|v| PathRasterizationVertex {
+                xy_position: v.xy_position,
+                st_position: v.st_position,
+                color: path.color,
+                bounds,
+            }));
+        }
+
+        let first_sprite = sprites.len() as u32;
+        if paths.last().map(|p| &p.order) == Some(&first_path.order) {
+            sprites.extend(paths.iter().map(|p| PathSprite {
+                bounds: p.clipped_bounds(),
+            }));
+        } else {
+            sprites.push(PathSprite { bounds: union });
+        }
+
+        let near = union.dilate(ScaledPixels(PATH_BATCH_MARGIN));
+        let group = &path_batches[group_start..];
+        if group.is_empty()
+            || group.len() >= MAX_GROUP_PATH_BATCHES
+            || group.iter().any(|batch| near.intersects(&batch.bounds))
+        {
+            close_group(&mut path_batches[group_start..]);
+            group_start = path_batches.len();
+        }
+        path_batches.push(PathBatch {
+            vertices: first_vertex..vertices.len() as u32,
+            sprites: first_sprite..sprites.len() as u32,
+            bounds: union,
+            group: None,
+        });
+    }
+    close_group(&mut path_batches[group_start..]);
+}
+
+/// Gives the first batch of `group` the vertices of all of it.
+fn close_group(group: &mut [PathBatch]) {
+    if let Some(end) = group.last().map(|last| last.vertices.end) {
+        if let Some(first) = group.first_mut() {
+            first.group = Some(first.vertices.start..end);
+        }
+    }
+}
+
+/// Each scene keeps its own instance ranges, but all scene and path data
+/// share one staging allocation. Preserve OHOS image flags inside child scenes.
+fn upload(
+    host: &mut impl FrameHost,
+    scenes: &[PlannedScene],
+    vertices: &[PathRasterizationVertex],
+    sprites: &[PathSprite],
+) -> Result<(Vec<SceneUpload>, PathUpload)> {
+    const SCENE_ARRAYS: usize = 6;
+    let mut encoded = Vec::with_capacity(scenes.len());
+    {
+        let target = host.target();
+        for planned in scenes {
+            let mut scratch = Vec::new();
+            let flags = target
+                .atlas
+                .encode_image_alpha(&planned.scene.polychrome_sprites, &mut scratch);
+            if flags.as_ptr() == planned.scene.polychrome_sprites.as_ptr() {
+                encoded.push(Cow::Borrowed(planned.scene.polychrome_sprites.as_slice()));
+            } else {
+                encoded.push(Cow::Owned(scratch));
+            }
+        }
+    }
+    let mut arrays = Vec::with_capacity(scenes.len() * SCENE_ARRAYS + 2);
+    // SAFETY: GPUI primitives and path records are repr(C) plain data, with
+    // layouts shared by the native OHOS vertex declarations and WGSL inputs.
+    unsafe {
+        for (planned, polychrome) in scenes.iter().zip(&encoded) {
+            let scene = planned.scene;
+            arrays.extend([
+                WgpuRenderer::instance_bytes(&scene.quads),
+                WgpuRenderer::instance_bytes(&scene.shadows),
+                WgpuRenderer::instance_bytes(&scene.underlines),
+                WgpuRenderer::instance_bytes(&scene.monochrome_sprites),
+                WgpuRenderer::instance_bytes(&scene.subpixel_sprites),
+                WgpuRenderer::instance_bytes(polychrome.as_ref()),
+            ]);
+        }
+        arrays.extend([
+            WgpuRenderer::instance_bytes(vertices),
+            WgpuRenderer::instance_bytes(sprites),
+        ]);
+    }
+    let mut strides = [
+        size_of::<gpui::Quad>(),
+        size_of::<gpui::Shadow>(),
+        size_of::<gpui::Underline>(),
+        size_of::<gpui::MonochromeSprite>(),
+        size_of::<gpui::SubpixelSprite>(),
+        size_of::<gpui::PolychromeSprite>(),
+    ]
+    .repeat(scenes.len());
+    strides.extend([
+        size_of::<PathRasterizationVertex>(),
+        size_of::<PathSprite>(),
+    ]);
+    let mut offsets = Vec::with_capacity(arrays.len());
+    let mut end = 0u64;
+    for bytes in &arrays {
+        let offset = end.next_multiple_of(wgpu::COPY_BUFFER_ALIGNMENT);
+        offsets.push(offset);
+        end = offset
+            .checked_add((bytes.len() as u64).max(16))
+            .context("scene upload overflow")?;
+    }
+    let end = end.next_multiple_of(wgpu::COPY_BUFFER_ALIGNMENT);
+    host.reserve_instance_data(end)?;
+    let target = host.target();
+    if arrays.iter().any(|data| !data.is_empty()) {
+        let mut view = target
+            .queue
+            .write_buffer_with(
+                target.instance_buffer,
+                0,
+                wgpu::BufferSize::new(end).context("empty instance upload")?,
+            )
+            .context("instance upload rejected")?;
+        let mut cursor = 0;
+        for (&offset, data) in offsets.iter().zip(&arrays) {
+            let offset = offset as usize;
+            if cursor < offset {
+                view.slice(cursor..offset).fill(0);
+            }
+            let next = offset + data.len();
+            view.slice(offset..next).copy_from_slice(data);
+            cursor = next;
+        }
+        if cursor < end as usize {
+            view.slice(cursor..end as usize).fill(0);
+        }
+    }
+    let bind = |index: usize| InstanceBinding {
+        offset: offsets[index],
+        stride: strides[index] as u64,
+    };
+    let uploads = (0..scenes.len())
+        .map(|scene| {
+            let first = scene * SCENE_ARRAYS;
+            SceneUpload {
+                quads: bind(first),
+                shadows: bind(first + 1),
+                underlines: bind(first + 2),
+                monochrome_sprites: bind(first + 3),
+                subpixel_sprites: bind(first + 4),
+                polychrome_sprites: bind(first + 5),
+            }
+        })
+        .collect();
+    let paths = scenes.len() * SCENE_ARRAYS;
+    Ok((
+        uploads,
+        PathUpload {
+            vertices: bind(paths),
+            sprites: bind(paths + 1),
+        },
+    ))
+}
+
+#[allow(clippy::too_many_arguments)]
+fn record(
+    target: &FrameTarget,
+    state: &FrameState,
+    scene: &Scene,
+    frame_view: &wgpu::TextureView,
+    clear: wgpu::Color,
+    rasters: &[raster::TileRaster],
+    raster_indices: &[usize],
+    scenes: &[PlannedScene],
+    uploads: &[SceneUpload],
+    paths: &PathUpload,
+) -> wgpu::SubmissionIndex {
+    let graph = DrawGraph { scenes, uploads };
+    let mut encoder = target
+        .device
+        .create_command_encoder(&wgpu::CommandEncoderDescriptor {
+            label: Some("main_encoder"),
+        });
+    // Scenes are planned and uploaded tiles first, the frame's own last.
+    for (index, tile) in rasters.iter().enumerate() {
+        let scene_index = raster_indices[index];
+        raster::rasterize(
+            target,
+            state,
+            &mut encoder,
+            &scene.layers,
+            tile,
+            &uploads[scene_index],
+            paths,
+            &scenes[scene_index].path_batches,
+            &graph,
+        );
+    }
+    let main = scenes.len() - 1;
+    draw_scene(
+        target,
+        state,
+        &mut encoder,
+        &SceneDraw {
+            scene,
+            upload: &uploads[main],
+            paths,
+            path_batches: &scenes[main].path_batches,
+            view: frame_view,
+            clear: Some(clear),
+            label: "main_pass",
+            globals: target.globals_bind_group,
+            path_targets: PathTargets {
+                globals: target.path_globals_bind_group,
+                intermediate: target.path_intermediate_view,
+                msaa: target.path_msaa_view,
+            },
+            graph: &graph,
+        },
+    );
+    target.queue.submit(std::iter::once(encoder.finish()))
+}
+
+/// A scene to draw, where, and with what.
+pub(crate) struct SceneDraw<'a> {
+    pub(crate) scene: &'a Scene,
+    pub(crate) upload: &'a SceneUpload,
+    pub(crate) paths: &'a PathUpload,
+    pub(crate) path_batches: &'a [PathBatch],
+    pub(crate) view: &'a wgpu::TextureView,
+    pub(crate) clear: Option<wgpu::Color>,
+    pub(crate) label: &'a str,
+    /// The globals the scene's primitives are drawn with.
+    pub(crate) globals: &'a wgpu::BindGroup,
+    pub(crate) path_targets: PathTargets<'a>,
+    pub(crate) graph: &'a DrawGraph<'a>,
+}
+
+/// What a scene's paths are rasterized with: the globals and the
+/// intermediate texture, both sized like the texture the scene is drawn into.
+#[derive(Clone, Copy)]
+pub(crate) struct PathTargets<'a> {
+    pub(crate) globals: &'a wgpu::BindGroup,
+    pub(crate) intermediate: Option<&'a wgpu::TextureView>,
+    pub(crate) msaa: Option<&'a wgpu::TextureView>,
+}
+
+struct DrawStep<'a> {
+    scene: &'a Scene,
+    upload: &'a SceneUpload,
+    batch: PrimitiveBatch,
+    clip: Option<usize>,
+    path: Option<&'a PathBatch>,
+    path_group: Option<Range<u32>>,
+}
+
+impl DrawStep<'_> {
+    fn path_key(&self) -> (usize, Option<Range<u32>>) {
+        (self.scene as *const Scene as usize, self.path_group.clone())
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+fn collect_steps<'a>(
+    scene: &'a Scene,
+    upload: &'a SceneUpload,
+    paths: &'a [PathBatch],
+    graph: &'a DrawGraph<'a>,
+    clips: &mut Vec<crate::ohos::wgpu_renderer::fast::rounded_clip::Clip>,
+    binding: Option<usize>,
+    steps: &mut Vec<DrawStep<'a>>,
+    clip_sets: &mut Vec<Vec<crate::ohos::wgpu_renderer::fast::rounded_clip::Clip>>,
+) {
+    let mut path_index = 0;
+    let mut path_group = None;
+    for batch in scene.batches() {
+        if let PrimitiveBatch::PolychromeSprites {
+            texture_id,
+            ref range,
+        } = &batch
+        {
+            if crate::ohos::wgpu_renderer::fast::rounded_clip::group(scene, *texture_id).is_some() {
+                let plan = graph
+                    .scenes
+                    .iter()
+                    .find(|plan| std::ptr::eq(plan.scene, scene))
+                    .expect("planned clip scene");
+                let group = plan
+                    .groups
+                    .iter()
+                    .find(|group| group.texture == texture_id.index)
+                    .expect("planned clip group");
+                let child = &graph.scenes[group.content];
+                for index in range.clone() {
+                    clips.push(crate::ohos::wgpu_renderer::fast::rounded_clip::Clip::new(
+                        &scene.polychrome_sprites[index],
+                        child.scene,
+                    ));
+                    let child_binding = clip_sets.len();
+                    clip_sets.push(clips.clone());
+                    collect_steps(
+                        child.scene,
+                        &graph.uploads[group.content],
+                        &child.path_batches,
+                        graph,
+                        clips,
+                        Some(child_binding),
+                        steps,
+                        clip_sets,
+                    );
+                    clips.pop();
+                }
+                continue;
+            }
+        }
+        let path = if matches!(&batch, PrimitiveBatch::Paths(range) if !range.is_empty()) {
+            let path = paths.get(path_index);
+            path_index += 1;
+            if let Some(group) = path.and_then(|path| path.group.clone()) {
+                path_group = Some(group);
+            }
+            path
+        } else {
+            None
+        };
+        steps.push(DrawStep {
+            scene,
+            upload,
+            batch,
+            clip: binding,
+            path,
+            path_group: path_group.clone(),
+        });
+    }
+}
+
+/// Records the passes that draw `draw.scene` into `draw.view`.
+pub(crate) fn draw_scene(
+    target: &FrameTarget,
+    state: &FrameState,
+    encoder: &mut wgpu::CommandEncoder,
+    draw: &SceneDraw,
+) {
+    let pipelines = target.pipelines;
+    let texture_bind_group = |label: &str, view: &wgpu::TextureView| {
+        state.bind_groups.texture(
+            target.device,
+            &target.bind_group_layouts.textures,
+            target.atlas_sampler,
+            label,
+            view,
+        )
+    };
+    let intermediate = draw
+        .path_targets
+        .intermediate
+        .map(|view| texture_bind_group("path_intermediate_texture_bind_group", view));
+
+    let mut steps = Vec::new();
+    let mut clip_sets = Vec::new();
+    collect_steps(
+        draw.scene,
+        draw.upload,
+        draw.path_batches,
+        draw.graph,
+        &mut Vec::new(),
+        None,
+        &mut steps,
+        &mut clip_sets,
+    );
+    let clip_data = (!clip_sets.is_empty()).then(|| {
+        target
+            .bind_group_layouts
+            .rounded_clip
+            .clip_sets(target.device, target.queue, &clip_sets)
+    });
+    let clip_binding = clip_data
+        .as_ref()
+        .map(|data| &data.0)
+        .unwrap_or(&target.bind_group_layouts.rounded_clip.unmasked);
+    let clip_alignment = clip_data.as_ref().map_or(0, |data| data.1);
+    let first_path = steps.iter().find(|step| step.path.is_some());
+    let mut rasterized_group = first_path.and_then(|step| {
+        rasterize_group(
+            target,
+            encoder,
+            draw.path_targets,
+            draw.paths,
+            step.path_group.clone(),
+        )
+        .then_some(step.path_key())
+    });
+    let mut pass = begin_main_pass(encoder, draw.view, draw.label, draw.clear);
+    let mut bound = PassState::default();
+    for step in steps {
+        let path_key = step.path_key();
+        let upload = step.upload;
+        let scene = step.scene;
+        let clip_offset = step
+            .clip
+            .map_or(0, |index| (index as u32 + 1) * clip_alignment);
+        pass.set_bind_group(3, clip_binding, &[clip_offset]);
+        let batch = step.batch;
+        match batch {
+            PrimitiveBatch::Quads(range) => {
+                use crate::ohos::quad_pipeline::QuadPipeline;
+                let mut start = range.start;
+                while start < range.end {
+                    let kind = QuadPipeline::for_quad(&scene.quads[start]);
+                    let mut end = start + 1;
+                    while end < range.end && QuadPipeline::for_quad(&scene.quads[end]) == kind {
+                        end += 1;
+                    }
+                    let pipeline = match kind {
+                        QuadPipeline::General => &pipelines.quads,
+                        QuadPipeline::Solid => &pipelines.solid_quads,
+                        QuadPipeline::Rect => &pipelines.rect_quads,
+                    };
+                    draw_batch(
+                        &mut pass,
+                        &mut bound,
+                        draw.globals,
+                        target.instance_buffer,
+                        pipeline,
+                        &upload.quads,
+                        None,
+                        start..end,
+                    );
+                    start = end;
+                }
+            }
+            PrimitiveBatch::Shadows(range) => draw_batch(
+                &mut pass,
+                &mut bound,
+                draw.globals,
+                target.instance_buffer,
+                &pipelines.shadows,
+                &upload.shadows,
+                None,
+                range,
+            ),
+            PrimitiveBatch::Paths(range) => {
+                if range.is_empty() {
+                    continue;
+                }
+                let Some(batch) = step.path else {
+                    continue;
+                };
+                if rasterized_group != Some(path_key.clone()) {
+                    drop(pass);
+                    rasterized_group = rasterize_group(
+                        target,
+                        encoder,
+                        draw.path_targets,
+                        draw.paths,
+                        step.path_group.clone(),
+                    )
+                    .then_some(path_key);
+                    pass = begin_main_pass(encoder, draw.view, "main_pass_continued", None);
+                    bound.forget();
+                    pass.set_bind_group(3, clip_binding, &[clip_offset]);
+                }
+                if rasterized_group.is_none() || batch.vertices.is_empty() {
+                    continue;
+                }
+                let Some(intermediate) = &intermediate else {
+                    continue;
+                };
+                bound.set_pipeline(&mut pass, &pipelines.paths);
+                bound.set_bind_group(&mut pass, 0, draw.globals);
+                bound.set_bind_group(&mut pass, 1, intermediate);
+                let binding = draw.paths.sprites;
+                pass.set_vertex_buffer(
+                    0,
+                    target.instance_buffer.slice(
+                        binding.offset + u64::from(batch.sprites.start) * binding.stride
+                            ..binding.offset + u64::from(batch.sprites.end) * binding.stride,
+                    ),
+                );
+                pass.draw(0..4, 0..batch.sprites.len() as u32);
+            }
+            PrimitiveBatch::Underlines(range) => draw_batch(
+                &mut pass,
+                &mut bound,
+                draw.globals,
+                target.instance_buffer,
+                &pipelines.underlines,
+                &upload.underlines,
+                None,
+                range,
+            ),
+            PrimitiveBatch::MonochromeSprites { texture_id, range } => {
+                let texture = atlas_bind_group(target.atlas, texture_id);
+                draw_batch(
+                    &mut pass,
+                    &mut bound,
+                    draw.globals,
+                    target.instance_buffer,
+                    &pipelines.mono_sprites,
+                    &upload.monochrome_sprites,
+                    Some(&texture),
+                    range,
+                );
+            }
+            PrimitiveBatch::SubpixelSprites { texture_id, range } => {
+                let texture = atlas_bind_group(target.atlas, texture_id);
+                draw_batch(
+                    &mut pass,
+                    &mut bound,
+                    draw.globals,
+                    target.instance_buffer,
+                    pipelines
+                        .subpixel_sprites
+                        .as_ref()
+                        .unwrap_or(&pipelines.mono_sprites),
+                    &upload.subpixel_sprites,
+                    Some(&texture),
+                    range,
+                );
+            }
+            PrimitiveBatch::PolychromeSprites { texture_id, range }
+                if composite::is_layer_texture(texture_id) =>
+            {
+                let sprites = &scene.polychrome_sprites;
+                for run in composite::tile_runs(sprites, range) {
+                    let Some(view) = composite::texture_for_batch(
+                        &state.layers,
+                        texture_id,
+                        &sprites[run.clone()],
+                    ) else {
+                        continue;
+                    };
+                    draw_batch(
+                        &mut pass,
+                        &mut bound,
+                        draw.globals,
+                        target.instance_buffer,
+                        &pipelines.poly_sprites,
+                        &upload.polychrome_sprites,
+                        Some(&texture_bind_group("layer_tile_bind_group", view)),
+                        run,
+                    );
+                }
+            }
+            PrimitiveBatch::PolychromeSprites { texture_id, range } => {
+                let texture = atlas_bind_group(target.atlas, texture_id);
+                draw_batch(
+                    &mut pass,
+                    &mut bound,
+                    draw.globals,
+                    target.instance_buffer,
+                    &pipelines.poly_sprites,
+                    &upload.polychrome_sprites,
+                    Some(&texture),
+                    range,
+                );
+            }
+            // Surfaces are macOS-only for video playback and are not
+            // implemented by the WGPU renderer.
+            PrimitiveBatch::Surfaces(_surfaces) => {}
+        }
+    }
+    drop(pass);
+}
+
+fn atlas_bind_group(atlas: &WgpuAtlas, texture_id: AtlasTextureId) -> wgpu::BindGroup {
+    atlas.get_texture_info(texture_id).bind_group
+}
+
+/// Begins a pass that draws into `view`, cleared to `clear` if one is given.
+fn begin_main_pass<'a>(
+    encoder: &'a mut wgpu::CommandEncoder,
+    view: &'a wgpu::TextureView,
+    label: &str,
+    clear: Option<wgpu::Color>,
+) -> wgpu::RenderPass<'a> {
+    encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+        label: Some(label),
+        color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+            view,
+            resolve_target: None,
+            ops: wgpu::Operations {
+                load: match clear {
+                    Some(color) => wgpu::LoadOp::Clear(color),
+                    None => wgpu::LoadOp::Load,
+                },
+                store: wgpu::StoreOp::Store,
+            },
+            depth_slice: None,
+        })],
+        depth_stencil_attachment: None,
+        ..Default::default()
+    })
+}
+
+#[allow(clippy::too_many_arguments)]
+fn draw_batch(
+    pass: &mut wgpu::RenderPass<'_>,
+    state: &mut PassState,
+    globals: &wgpu::BindGroup,
+    buffer: &wgpu::Buffer,
+    pipeline: &wgpu::RenderPipeline,
+    instances: &InstanceBinding,
+    texture: Option<&wgpu::BindGroup>,
+    range: Range<usize>,
+) {
+    if range.is_empty() {
+        return;
+    }
+    state.set_pipeline(pass, pipeline);
+    state.set_bind_group(pass, 0, globals);
+    if let Some(texture) = texture {
+        state.set_bind_group(pass, 1, texture);
+    }
+    let start = instances.offset + range.start as u64 * instances.stride;
+    let end = instances.offset + range.end as u64 * instances.stride;
+    pass.set_vertex_buffer(0, buffer.slice(start..end));
+    pass.draw(0..4, 0..range.len() as u32);
+}
+
+/// Rasterizes a group's range of the frame's path vertices into the cleared
+/// intermediate texture, in a pass of its own, as upstream's
+/// `draw_paths_to_intermediate` does for a batch. Returns false if there is
+/// nothing to rasterize or no intermediate texture to rasterize into.
+fn rasterize_group(
+    target: &FrameTarget,
+    encoder: &mut wgpu::CommandEncoder,
+    targets: PathTargets,
+    paths: &PathUpload,
+    vertices: Option<Range<u32>>,
+) -> bool {
+    let Some(vertices) = vertices.filter(|vertices| !vertices.is_empty()) else {
+        return false;
+    };
+    let Some(path_intermediate_view) = targets.intermediate else {
+        return false;
+    };
+    let (target_view, resolve_target) = match targets.msaa {
+        Some(msaa_view) => (msaa_view, Some(path_intermediate_view)),
+        None => (path_intermediate_view, None),
+    };
+    let mut pass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+        label: Some("path_rasterization_pass"),
+        color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+            view: target_view,
+            resolve_target,
+            ops: wgpu::Operations {
+                load: wgpu::LoadOp::Clear(wgpu::Color::TRANSPARENT),
+                store: if resolve_target.is_some() {
+                    wgpu::StoreOp::Discard
+                } else {
+                    wgpu::StoreOp::Store
+                },
+            },
+            depth_slice: None,
+        })],
+        depth_stencil_attachment: None,
+        ..Default::default()
+    });
+    pass.set_pipeline(&target.pipelines.path_rasterization);
+    pass.set_bind_group(0, targets.globals, &[]);
+    pass.set_bind_group(3, &target.bind_group_layouts.rounded_clip.unmasked, &[0]);
+    let binding = paths.vertices;
+    pass.set_vertex_buffer(
+        0,
+        target.instance_buffer.slice(
+            binding.offset + u64::from(vertices.start) * binding.stride
+                ..binding.offset + u64::from(vertices.end) * binding.stride,
+        ),
+    );
+    pass.draw(0..vertices.len() as u32, 0..1);
+    true
+}
diff --git a/src/ohos/fast/layers/composite.rs b/src/ohos/fast/layers/composite.rs
new file mode 100644
index 0000000..55103ef
--- /dev/null
+++ b/src/ohos/fast/layers/composite.rs
@@ -0,0 +1,92 @@
+// Copyright 2022-2025 Zed Industries, Inc.; Copyright 2026 Longbridge.
+// SPDX-License-Identifier: Apache-2.0
+// Adapted from gpui-fast-wgpu 0.1.13 for the OHOS vertex-buffer renderer.
+//! Drawing scroll layer tiles where the scene composites them: polychrome
+//! sprites whose texture id lies in the range no atlas allocates stand for
+//! tiles, and are drawn with the polychrome sprite pipeline from the tiles'
+//! own textures instead of an atlas texture.
+//!
+//! A tile sprite covers the tile's whole texture at whole device pixels, so
+//! every fragment samples a texel center and copies the tile's pixel.
+
+use std::ops::Range;
+
+use gpui::{
+    decode_layer_tile, AtlasTextureId, LayerKey, PolychromeSprite, Scene, TileCoord, TileId,
+};
+
+use crate::ohos::wgpu_renderer::fast::layers::TileCache;
+
+/// The layer tiles `scene` composites, in the order it lists them.
+pub(crate) fn composited_tiles(scene: &Scene) -> impl Iterator<Item = (LayerKey, TileCoord)> + '_ {
+    let has_layers = !scene.layers.frames.is_empty();
+    let direct = scene
+        .polychrome_sprites
+        .iter()
+        .take_while(move |_| has_layers)
+        .filter_map(|sprite| decode_layer_tile(sprite.tile.texture_id, sprite.tile.tile_id));
+    if !scene.polychrome_sprites.iter().any(|sprite| {
+        crate::ohos::wgpu_renderer::fast::rounded_clip::group(scene, sprite.tile.texture_id)
+            .is_some()
+    }) {
+        return itertools::Either::Left(direct);
+    }
+    let mut tiles: Vec<_> = direct.collect();
+    for sprite in &scene.polychrome_sprites {
+        if let Some(child) =
+            crate::ohos::wgpu_renderer::fast::rounded_clip::group(scene, sprite.tile.texture_id)
+                .and_then(|frame| frame.content.scene())
+        {
+            tiles.extend(composited_tiles(child));
+        }
+    }
+    itertools::Either::Right(tiles.into_iter())
+}
+
+/// Whether sprites of `texture` are layer tiles rather than atlas sprites.
+pub(crate) fn is_layer_texture(texture: AtlasTextureId) -> bool {
+    decode_layer_tile(texture, TileId(0)).is_some()
+}
+
+/// Splits a batch of layer tile sprites into runs of the same tile: the
+/// scene batches sprites by texture id, which is one per layer, while each
+/// tile has a texture of its own.
+pub(crate) fn tile_runs(
+    sprites: &[PolychromeSprite],
+    range: Range<usize>,
+) -> impl Iterator<Item = Range<usize>> + '_ {
+    let mut start = range.start;
+    std::iter::from_fn(move || {
+        if start >= range.end {
+            return None;
+        }
+        let tile = sprites[start].tile.tile_id;
+        let end = (start..range.end)
+            .find(|&index| sprites[index].tile.tile_id != tile)
+            .unwrap_or(range.end);
+        let run = start..end;
+        start = end;
+        Some(run)
+    })
+}
+
+/// The texture a run of sprites of one layer tile is drawn from, or `None`
+/// when the cache does not hold the tile, which rasterizing every composited
+/// tile it lacks before the frame is drawn prevents.
+pub(crate) fn texture_for_batch<'a>(
+    cache: &'a TileCache,
+    texture: AtlasTextureId,
+    sprites: &[PolychromeSprite],
+) -> Option<&'a wgpu::TextureView> {
+    let first = sprites.first()?;
+    debug_assert!(
+        sprites
+            .iter()
+            .all(|sprite| sprite.tile.tile_id == first.tile.tile_id),
+        "a run of layer tile sprites spans tiles"
+    );
+    let (layer, tile) = decode_layer_tile(texture, first.tile.tile_id)?;
+    let view = cache.texture(layer, tile);
+    debug_assert!(view.is_some(), "a composited layer tile was not rasterized");
+    view
+}
