+    @location(0) @interpolate(flat) color: vec4<f32>,
+    @location(1) @interpolate(flat) bounds_origin: vec2<f32>,
+    @location(2) @interpolate(flat) bounds_size: vec2<f32>,
+    @location(3) clip_distances: vec4<f32>,
