diff --git a/snow_shot/src/storage/configurationschema.cpp b/snow_shot/src/storage/configurationschema.cpp
--- a/snow_shot/src/storage/configurationschema.cpp
+++ b/snow_shot/src/storage/configurationschema.cpp
@@ -1873,6 +1873,21 @@
     replaceDefault(QStringLiteral("global_shortcuts/pin_clipboard_content"),
                    macGlobalShortcutDefault(QStringLiteral("Meta+3"), 20));
 #endif
+#if defined(Q_OS_HARMONY) || defined(Q_OS_OHOS)
+    const auto replaceOhosDefault = [&result](const QString& key, const QJsonArray& value) {
+        const auto found = std::find_if(result.begin(), result.end(),
+                                        [&key](const auto& entry) { return entry.key == key; });
+        if (found != result.end()) {
+            found->defaultValue = shortcutDefaults(key, value);
+        }
+    };
+    // Keep recording defaults parallel to the OHOS screenshot pair
+    // (Ctrl+Alt+F1 / Ctrl+F1), so the first-run experience is keyboard-first.
+    replaceOhosDefault(QStringLiteral("global_shortcuts/screen_record"),
+                       QJsonArray{QStringLiteral("Ctrl+Alt+F2")});
+    replaceOhosDefault(QStringLiteral("global_shortcuts/screen_record_copy"),
+                       QJsonArray{QStringLiteral("Ctrl+F2")});
+#endif
     result.removeIf([](const ConfigurationSchemaEntry& entry) {
         return !app::editionConfigurationKeyAvailable(entry.key);
     });
