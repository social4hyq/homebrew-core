+#if defined(Q_OS_OHOS) || defined(Q_OS_HARMONY)
+namespace {
+std::shared_ptr<RecordingEffectsFrame> makeOhosPlaybackTimePreview(const QSize& output) {
+    if (output.isEmpty())
+        return {};
+
+    QFont font = QGuiApplication::font();
+    font.setPixelSize(24);
+    const QFontMetrics metrics(font);
+    const QString elapsed = QStringLiteral("00:00");
+    const QString total = QStringLiteral("00:00");
+    const QString separator = QStringLiteral(" / ");
+    constexpr int padding = 12;
+    constexpr int margin = 20;
+    const int elapsedWidth = metrics.horizontalAdvance(elapsed);
+    const int separatorWidth = metrics.horizontalAdvance(separator);
+    const int totalWidth = metrics.horizontalAdvance(total);
+    const int desiredWidth = elapsedWidth + separatorWidth + totalWidth + padding * 2;
+    const int badgeWidth = std::min(desiredWidth, output.width());
+    const int badgeHeight = std::min(std::max(metrics.height() + 16, 40), output.height());
+    const int marginX = std::min(margin, output.width() - badgeWidth);
+    const int marginY = std::min(margin, output.height() - badgeHeight);
+    const QRect bounds(output.width() - marginX - badgeWidth, marginY, badgeWidth, badgeHeight);
+    if (bounds.isEmpty())
+        return {};
+
+    QImage image(bounds.size(), QImage::Format_RGBA8888_Premultiplied);
+    image.fill(Qt::transparent);
+    {
+        QPainter painter(&image);
+        painter.setRenderHint(QPainter::Antialiasing);
+        const QRect localRect(QPoint(0, 0), bounds.size());
+        painter.setPen(QPen(QColor(255, 255, 255, 40), 1));
+        painter.setBrush(QColor(24, 27, 33, 216));
+        painter.drawRoundedRect(localRect.adjusted(0, 0, -1, -1), 8, 8);
+
+        painter.setFont(font);
+        painter.setPen(Qt::white);
+        const int textY = (badgeHeight - metrics.height()) / 2 + metrics.ascent();
+        int textX = padding;
+        painter.drawText(textX, textY, elapsed);
+        textX += elapsedWidth;
+        painter.setPen(QColor(255, 255, 255, 128));
+        painter.drawText(textX, textY, separator);
+        textX += separatorWidth;
+        painter.setPen(QColor(255, 255, 255, 180));
+        painter.drawText(textX, textY, total);
+    }
+
+    auto frame = std::make_shared<RecordingEffectsFrame>();
+    frame->output = output;
+    frame->tiles.push_back({bounds, std::move(image), output});
+    return frame;
+}
+} // namespace
+#endif
