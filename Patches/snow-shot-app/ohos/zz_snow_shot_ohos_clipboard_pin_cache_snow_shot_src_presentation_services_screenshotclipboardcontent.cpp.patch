+#include "snow_shot/presentation/screenshotclipboardservice.h"
 #include "snow_shot/platform/applicationqos.h"
 #include "snow_shot/presentation/screenshotclipboardcontent.h"
 #include "snow_shot/app/supportedpinfiles.h"
@@ -1273,6 +1274,25 @@ snapshotClipboardOnce(QClipboard* clipboard, qreal devicePixelRatio, AllocationC
                 snapshot->detachedImage = value.value<QPixmap>().toImage();
         }
     }
+#if defined(Q_OS_HARMONY)
+    // Reading the system clipboard needs the restricted READ_PASTEBOARD
+    // permission. If the current image was published by this process, reuse it
+    // so copy -> pin remains functional in debug builds. An empty placeholder
+    // snapshot is created above when the MIME data has no readable payload, so
+    // test validity rather than presence here.
+    if (!snapshot.has_value() || !snapshot->isValid()) {
+        if (const auto png = latestPublishedClipboardPng(); png.has_value()) {
+            QImage image = QImage::fromData(*png, "PNG");
+            if (!image.isNull()) {
+                if (!snapshot.has_value())
+                    snapshot.emplace();
+                snapshot->detachedImage = std::move(image);
+                snapshot->devicePixelRatio = devicePixelRatio;
+                snapshot->baseColor = baseColor;
+            }
+        }
+    }
+#endif
     return !rejected && snapshot.has_value() && snapshot->isValid() ? snapshot : std::nullopt;
