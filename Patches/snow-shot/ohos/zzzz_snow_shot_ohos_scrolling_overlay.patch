+void ScreenshotOverlayWindow::setScrollingCaptureOverlayHidden(bool hidden) {
+#if defined(Q_OS_OHOS) || defined(Q_OS_HARMONY)
+    if (m_scrollingCaptureOverlayHidden == hidden)
+        return;
+    m_scrollingCaptureOverlayHidden = hidden;
+    if (hidden) {
+        // The frozen overlay is opaque on OHOS: leaving it on screen would hide
+        // the application being captured and make the captured frames a copy of
+        // the overlay itself. Hiding it exposes the live window to both the user
+        // and the capture pipeline while the toolbar and thumbnail keep running.
+        hide();
+        return;
+    }
+    show();
+    raise();
+#else
+    Q_UNUSED(hidden);
+#endif
+}
