+#[cfg(target_env = "ohos")]
+fn probe_syscall(cache: &AtomicU8, call: fn() -> libc::c_long) -> bool {
+    probe_in_child(cache, || {
+        let result = call();
+        result >= 0 || !matches!(errno(), libc::ENOSYS | libc::EPERM)
+    })
+}
