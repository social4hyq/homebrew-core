diff --git a/snow_shot/tests/live_window_ohos_selection_tests.cpp b/snow_shot/tests/live_window_ohos_selection_tests.cpp
new file mode 100644
index 0000000..d7f4410
--- /dev/null
+++ b/snow_shot/tests/live_window_ohos_selection_tests.cpp
@@ -0,0 +1,55 @@
+#include "platform/ohos/livewindowselection_p.h"
+
+#include <QCoreApplication>
+#include <cstdlib>
+#include <iostream>
+
+namespace {
+using namespace snow_shot::presentation::ohos_live_window_detail;
+using snow_shot::presentation::LiveWindowState;
+
+void require(bool condition, const char* message) {
+    if (!condition) {
+        std::cerr << message << '\n';
+        std::exit(EXIT_FAILURE);
+    }
+}
+
+void selectsTopmostEligibleWindowAndPreservesSystemIdentity() {
+    const QVector<WindowCandidate> candidates{
+        {17, 0, QRect(0, 0, 800, 600), QStringLiteral("top"), true},
+        {18, 0, QRect(0, 0, 800, 600), QStringLiteral("covered"), true},
+        {19, 0, QRect(20, 20, 100, 100), QStringLiteral("hidden"), false},
+        {0, 0, QRect(20, 20, 100, 100), QStringLiteral("invalid"), true},
+    };
+
+    const auto topmost = targetAtPoint(QPoint(25, 25), {}, candidates);
+    require(topmost.has_value(), "A point inside a visible window should resolve.");
+    require(topmost->nativeId == 17 && topmost->title == QStringLiteral("top"),
+            "Candidates are consumed in native stacking order.");
+    require(topmost->processId == 0 && topmost->desktopBounds == QRect(0, 0, 800, 600) &&
+                topmost->hitPoint == QPoint(25, 25),
+            "OHOS window identity and geometry are not fabricated as process identities.");
+
+    const auto next = targetAtPoint(QPoint(25, 25), {17}, candidates);
+    require(next && next->nativeId == 18, "Excluded overlays reveal the next eligible window.");
+    require(!targetAtPoint(QPoint(900, 900), {}, candidates),
+            "Points outside all candidates do not select a window.");
+}
+
+void nativeWindowLookupFailuresRemainRetryable() {
+    require(stateForWindowLookup(WindowLookupState::Visible) == LiveWindowState::Live,
+            "A visible native window remains live.");
+    require(stateForWindowLookup(WindowLookupState::Hidden) == LiveWindowState::Closed,
+            "A window absent from the visible-main-window list is closed.");
+    require(stateForWindowLookup(WindowLookupState::Unavailable) == LiveWindowState::Unavailable,
+            "Window-manager errors must not be misreported as a permanently closed window.");
+}
+} // namespace
+
+int main(int argc, char** argv) {
+    QCoreApplication application(argc, argv);
+    selectsTopmostEligibleWindowAndPreservesSystemIdentity();
+    nativeWindowLookupFailuresRemainRetryable();
+    return EXIT_SUCCESS;
+}

