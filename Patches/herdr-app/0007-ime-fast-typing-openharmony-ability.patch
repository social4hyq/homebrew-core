index 0000000..8363661
--- /dev/null
+++ b/vendor/openharmony-ability/src/input/queue.rs
@@ -0,0 +1,477 @@
+#[cfg(any(feature = "keyboard", test))]
+use std::sync::{
+    atomic::{AtomicU8, Ordering},
+    Weak,
+};
+use std::{
+    collections::{HashMap, VecDeque},
+    sync::{Arc, Mutex},
+};
+
+#[derive(Clone)]
+pub(crate) struct InputOwner {
+    name: String,
+    lifetime: Arc<()>,
+}
+
+enum InputKind {
+    Ordinary,
+    #[cfg(any(feature = "keyboard", test))]
+    Key(Arc<AtomicU8>),
+}
+
+pub(crate) enum Delivery<T> {
+    Input {
+        owner: String,
+        value: T,
+        ime_consumed: Option<bool>,
+    },
+    Wake,
+}
+
+enum Entry<T> {
+    Input {
+        owner: InputOwner,
+        value: T,
+        kind: InputKind,
+    },
+    Wake,
+}
+
+struct State<T> {
+    owners: HashMap<String, Arc<()>>,
+    events: VecDeque<Entry<T>>,
+    /// The latest key sent to the IME, with its identity. The IME answers
+    /// asynchronously: with fast typing the post-IME callback of one key can
+    /// arrive after the next key's pre-IME callback, so an answer only applies
+    /// to the key it names (HERDR-OHOS: this duplicated typed characters).
+    #[cfg(any(feature = "keyboard", test))]
+    current_keys: HashMap<String, (KeyId, Weak<AtomicU8>)>,
+}
+
+/// A physical key transition: raw key code and whether it is a press.
+#[cfg(any(feature = "keyboard", test))]
+pub(crate) type KeyId = (i32, bool);
+
+pub(crate) struct InputQueue<T> {
+    state: Mutex<State<T>>,
+}
+
+impl<T> Default for InputQueue<T> {
+    fn default() -> Self {
+        Self {
+            state: Mutex::new(State {
+                owners: HashMap::new(),
+                events: VecDeque::new(),
+                #[cfg(any(feature = "keyboard", test))]
+                current_keys: HashMap::new(),
+            }),
+        }
+    }
+}
+
+impl<T> InputQueue<T> {
+    pub(crate) fn activate(&self, name: &str) -> Result<InputOwner, &'static str> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| "Native input queue poisoned")?;
+        let lifetime = Arc::new(());
+        state.owners.insert(name.to_owned(), lifetime.clone());
+        #[cfg(any(feature = "keyboard", test))]
+        state.current_keys.remove(name);
+        state
+            .events
+            .retain(|entry| !matches!(entry, Entry::Input { owner, .. } if owner.name == name));
+        Ok(InputOwner {
+            name: name.to_owned(),
+            lifetime,
+        })
+    }
+
+    pub(crate) fn discard(&self, name: &str) -> Result<(), &'static str> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| "Native input queue poisoned")?;
+        state.owners.remove(name);
+        #[cfg(any(feature = "keyboard", test))]
+        state.current_keys.remove(name);
+        state
+            .events
+            .retain(|entry| !matches!(entry, Entry::Input { owner, .. } if owner.name == name));
+        Ok(())
+    }
+
+    pub(crate) fn push(&self, owner: &InputOwner, value: T) -> Result<bool, &'static str> {
+        self.push_with_kind(owner, value, InputKind::Ordinary, None)
+    }
+
+    #[cfg(any(feature = "keyboard", test))]
+    pub(crate) fn push_key(
+        &self,
+        owner: &InputOwner,
+        id: KeyId,
+        value: T,
+    ) -> Result<bool, &'static str> {
+        self.push_with_kind(
+            owner,
+            value,
+            InputKind::Key(Arc::new(AtomicU8::new(0))),
+            Some(id),
+        )
+    }
+
+    fn push_with_kind(
+        &self,
+        owner: &InputOwner,
+        value: T,
+        kind: InputKind,
+        #[allow(unused_variables)] id: Option<(i32, bool)>,
+    ) -> Result<bool, &'static str> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| "Native input queue poisoned")?;
+        if !state
+            .owners
+            .get(&owner.name)
+            .is_some_and(|active| Arc::ptr_eq(active, &owner.lifetime))
+        {
+            return Ok(false);
+        }
+        #[cfg(any(feature = "keyboard", test))]
+        if let (InputKind::Key(disposition), Some(id)) = (&kind, id) {
+            if let Some(previous) = state
+                .current_keys
+                .insert(owner.name.clone(), (id, Arc::downgrade(disposition)))
+                .and_then(|(_, previous)| previous.upgrade())
+            {
+                let _ = previous.compare_exchange(0, 2, Ordering::AcqRel, Ordering::Acquire);
+            }
+        }
+        state.events.push_back(Entry::Input {
+            owner: owner.clone(),
+            value,
+            kind,
+        });
+        Ok(true)
+    }
+
+    /// The IME declined key `id`: it reaches the app.
+    #[cfg(any(feature = "keyboard", test))]
+    pub(crate) fn after_ime(&self, owner: &InputOwner, id: KeyId) -> Result<(), &'static str> {
+        self.resolve_key(owner, 1, |key| key == id)
+    }
+
+    /// The IME edited text: the current key, if it is a press, was its input.
+    #[cfg(any(feature = "keyboard", test))]
+    pub(crate) fn ime_edit(&self, owner: &InputOwner) -> Result<(), &'static str> {
+        self.resolve_key(owner, 2, |(_, down)| down)
+    }
+
+    #[cfg(any(feature = "keyboard", test))]
+    fn resolve_key(
+        &self,
+        owner: &InputOwner,
+        resolved: u8,
+        matches: impl Fn(KeyId) -> bool,
+    ) -> Result<(), &'static str> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| "Native input queue poisoned")?;
+        if !state
+            .owners
+            .get(&owner.name)
+            .is_some_and(|active| Arc::ptr_eq(active, &owner.lifetime))
+        {
+            return Ok(());
+        }
+        // A late answer for an earlier key must not claim the current one.
+        if !state
+            .current_keys
+            .get(&owner.name)
+            .is_some_and(|(id, _)| matches(*id))
+        {
+            return Ok(());
+        }
+        if let Some(disposition) = state
+            .current_keys
+            .remove(&owner.name)
+            .and_then(|(_, current)| current.upgrade())
+        {
+            let _ = disposition.compare_exchange(0, resolved, Ordering::AcqRel, Ordering::Acquire);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn wake(&self) -> Result<(), &'static str> {
+        self.state
+            .lock()
+            .map_err(|_| "Native input queue poisoned")?
+            .events
+            .push_back(Entry::Wake);
+        Ok(())
+    }
+
+    pub(crate) fn has_pending(&self) -> bool {
+        self.state
+            .lock()
+            .map(|state| !state.events.is_empty())
+            .unwrap_or(false)
+    }
+
+    pub(crate) fn pop(&self) -> Result<Option<Delivery<T>>, &'static str> {
+        let mut state = self
+            .state
+            .lock()
+            .map_err(|_| "Native input queue poisoned")?;
+        // IME post callbacks may arrive after a foreground wake. An unresolved
+        // key is not evidence of consumption, and must not stall unrelated wakes.
+        let ready = state.events.iter().position(|entry| match entry {
+            #[cfg(any(feature = "keyboard", test))]
+            Entry::Input {
+                kind: InputKind::Key(disposition),
+                ..
+            } => disposition.load(Ordering::Acquire) != 0,
+            _ => true,
+        });
+        Ok(ready
+            .and_then(|index| state.events.remove(index))
+            .map(|entry| match entry {
+                Entry::Wake => Delivery::Wake,
+                Entry::Input { owner, value, kind } => Delivery::Input {
+                    owner: owner.name,
+                    value,
+                    ime_consumed: match kind {
+                        InputKind::Ordinary => None,
+                        #[cfg(any(feature = "keyboard", test))]
+                        InputKind::Key(disposition) => {
+                            Some(disposition.load(Ordering::Acquire) != 1)
+                        }
+                    },
+                },
+            }))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const K: KeyId = (2017, true);
+
+    fn input<T>(delivery: Option<Delivery<T>>) -> (String, T, Option<bool>) {
+        match delivery.expect("queued delivery") {
+            Delivery::Input {
+                owner,
+                value,
+                ime_consumed,
+            } => (owner, value, ime_consumed),
+            Delivery::Wake => panic!("expected input"),
+        }
+    }
+
+    #[test]
+    fn input_edits_and_wake_share_fifo_order() {
+        let queue = InputQueue::default();
+        let main = queue.activate("main").unwrap();
+        let child = queue.activate("child").unwrap();
+        queue.push(&main, "delete").unwrap();
+        queue.wake().unwrap();
+        queue.push(&child, "preview").unwrap();
+        queue.push(&main, "insert").unwrap();
+        assert_eq!(input(queue.pop().unwrap()), ("main".into(), "delete", None));
+        assert!(matches!(queue.pop().unwrap(), Some(Delivery::Wake)));
+        assert_eq!(
+            input(queue.pop().unwrap()),
+            ("child".into(), "preview", None)
+        );
+        assert_eq!(input(queue.pop().unwrap()), ("main".into(), "insert", None));
+        assert!(queue.pop().unwrap().is_none());
+    }
+
+    #[test]
+    fn each_physical_key_is_delivered_once_without_timestamp_deduplication() {
+        let queue = InputQueue::default();
+        let owner = queue.activate("main").unwrap();
+        for _ in 0..3 {
+            queue.push_key(&owner, K, (42, "a")).unwrap();
+            queue.after_ime(&owner, K).unwrap();
+        }
+        queue.push_key(&owner, K, (42, "a")).unwrap();
+        queue.ime_edit(&owner).unwrap();
+        queue.push(&owner, (42, "composition")).unwrap();
+        for _ in 0..3 {
+            assert_eq!(input(queue.pop().unwrap()).2, Some(false));
+        }
+        assert_eq!(input(queue.pop().unwrap()).2, Some(true));
+        assert_eq!(input(queue.pop().unwrap()).1, (42, "composition"));
+        assert!(queue.pop().unwrap().is_none());
+    }
+
+    #[test]
+    fn foreground_wake_does_not_consume_a_key_before_its_post_ime_callback(
+    ) -> Result<(), &'static str> {
+        let queue = InputQueue::default();
+        let owner = queue.activate("main")?;
+        queue.push_key(&owner, K, "ctrl-w")?;
+        queue.wake()?;
+        assert!(matches!(queue.pop()?, Some(Delivery::Wake)));
+        assert!(queue.pop()?.is_none());
+        queue.after_ime(&owner, K)?;
+        assert_eq!(input(queue.pop()?), ("main".into(), "ctrl-w", Some(false)));
+        assert!(queue.pop()?.is_none());
+        Ok(())
+    }
+
+    #[test]
+    fn ime_edit_resolves_a_key_after_an_early_foreground_drain() -> Result<(), &'static str> {
+        let queue = InputQueue::default();
+        let owner = queue.activate("main")?;
+        queue.push_key(&owner, K, "a")?;
+        assert!(queue.pop()?.is_none());
+        queue.ime_edit(&owner)?;
+        queue.push(&owner, "committed text")?;
+        assert_eq!(input(queue.pop()?), ("main".into(), "a", Some(true)));
+        assert_eq!(input(queue.pop()?).1, "committed text");
+        assert!(queue.pop()?.is_none());
+        Ok(())
+    }
+
+    #[test]
+    fn consumed_key_without_an_edit_is_delivered_before_the_next_key() {
+        let queue = InputQueue::default();
+        let owner = queue.activate("main").unwrap();
+        assert!(!queue.has_pending());
+        queue.push_key(&owner, K, "candidate navigation").unwrap();
+        assert!(queue.has_pending());
+        assert!(queue.pop().unwrap().is_none());
+        queue.push_key(&owner, K, "next key").unwrap();
+        assert_eq!(input(queue.pop().unwrap()).1, "candidate navigation");
+        queue.after_ime(&owner, K).unwrap();
+        assert_eq!(input(queue.pop().unwrap()).2, Some(false));
+        assert!(!queue.has_pending());
+    }
+
+    #[test]
+    fn key_resolution_never_crosses_owner_boundaries() {
+        let queue = InputQueue::default();
+        let main = queue.activate("main").unwrap();
+        let child = queue.activate("child").unwrap();
+        queue.push_key(&main, K, "main").unwrap();
+        queue.push_key(&child, K, "child").unwrap();
+        queue.after_ime(&main, K).unwrap();
+        assert_eq!(input(queue.pop().unwrap()).2, Some(false));
+        assert!(queue.pop().unwrap().is_none());
+        queue.ime_edit(&child).unwrap();
+        assert_eq!(input(queue.pop().unwrap()).2, Some(true));
+    }
+
+    #[test]
+    fn duplicate_post_callback_cannot_reclassify_an_older_consumed_key() {
+        let queue = InputQueue::default();
+        let owner = queue.activate("main").unwrap();
+        queue.push_key(&owner, K, "consumed").unwrap();
+        queue.push_key(&owner, K, "unconsumed").unwrap();
+        queue.after_ime(&owner, K).unwrap();
+        queue.after_ime(&owner, K).unwrap();
+        assert_eq!(input(queue.pop().unwrap()).2, Some(true));
+        assert_eq!(input(queue.pop().unwrap()).2, Some(false));
+        queue.after_ime(&owner, K).unwrap();
+        assert!(queue.pop().unwrap().is_none());
+    }
+
+    #[test]
+    fn retired_key_callbacks_cannot_change_replacement_disposition() {
+        let queue = InputQueue::default();
+        let old = queue.activate("main").unwrap();
+        queue.push_key(&old, K, "old").unwrap();
+        let replacement = queue.activate("main").unwrap();
+        queue.push_key(&replacement, K, "replacement").unwrap();
+        queue.after_ime(&old, K).unwrap();
+        queue.ime_edit(&old).unwrap();
+        queue.after_ime(&replacement, K).unwrap();
+        assert_eq!(
+            input(queue.pop().unwrap()),
+            ("main".into(), "replacement", Some(false))
+        );
+        assert!(queue.pop().unwrap().is_none());
+    }
+
+    #[test]
+    fn draining_releases_the_lock_before_the_handler_can_enqueue_or_retire() {
+        let queue = InputQueue::default();
+        let owner = queue.activate("main").unwrap();
+        queue.push(&owner, 1).unwrap();
+        assert_eq!(input(queue.pop().unwrap()).1, 1);
+        queue.push(&owner, 2).unwrap();
+        queue.discard("main").unwrap();
+        queue.wake().unwrap();
+        assert!(matches!(queue.pop().unwrap(), Some(Delivery::Wake)));
+        assert!(queue.pop().unwrap().is_none());
+    }
+
+    #[test]
+    fn retirement_and_replacement_reject_a_callback_already_running() {
+        let queue = Arc::new(InputQueue::default());
+        let old = queue.activate("main").unwrap();
+        let child = queue.activate("child").unwrap();
+        queue.push(&old, "stale pending edit").unwrap();
+        queue.push(&child, "live child edit").unwrap();
+        queue.wake().unwrap();
+        let (resume, resumed) = std::sync::mpsc::channel();
+        let callback = std::thread::spawn({
+            let queue = queue.clone();
+            move || {
+                resumed.recv().unwrap();
+                queue.push(&old, "late edit").unwrap()
+            }
+        });
+        queue.discard("main").unwrap();
+        let replacement = queue.activate("main").unwrap();
+        resume.send(()).unwrap();
+        assert!(!callback.join().unwrap());
+        queue.push(&replacement, "replacement edit").unwrap();
+        assert_eq!(input(queue.pop().unwrap()).1, "live child edit");
+        assert!(matches!(queue.pop().unwrap(), Some(Delivery::Wake)));
+        assert_eq!(input(queue.pop().unwrap()).1, "replacement edit");
+        assert!(queue.pop().unwrap().is_none());
+    }
+
+    #[test]
+    fn late_post_callback_for_a_release_cannot_claim_the_next_press() {
+        // Fast typing: "n" up is still unanswered when "o" down arrives; the IME
+        // then declines "n" up late and types "o". "o" down must stay consumed by
+        // the IME, or the app inserts it a second time.
+        let queue = InputQueue::default();
+        let owner = queue.activate("main").unwrap();
+        let (n_down, n_up, o_down, o_up) = ((2030, true), (2030, false), (2031, true), (2031, false));
+        queue.push_key(&owner, n_down, "n down").unwrap();
+        queue.ime_edit(&owner).unwrap();
+        queue.push_key(&owner, n_up, "n up").unwrap();
+        queue.push_key(&owner, o_down, "o down").unwrap();
+        queue.after_ime(&owner, n_up).unwrap();
+        queue.ime_edit(&owner).unwrap();
+        queue.push_key(&owner, o_up, "o up").unwrap();
+        queue.after_ime(&owner, o_up).unwrap();
+        assert_eq!(input(queue.pop().unwrap()), ("main".into(), "n down", Some(true)));
+        assert_eq!(input(queue.pop().unwrap()), ("main".into(), "n up", Some(true)));
+        assert_eq!(input(queue.pop().unwrap()), ("main".into(), "o down", Some(true)));
+        assert_eq!(input(queue.pop().unwrap()), ("main".into(), "o up", Some(false)));
+        assert!(queue.pop().unwrap().is_none());
+    }
+
+    #[test]
+    fn late_edit_does_not_consume_the_release_that_followed() {
+        let queue = InputQueue::default();
+        let owner = queue.activate("main").unwrap();
+        queue.push_key(&owner, (2017, true), "a down").unwrap();
+        queue.push_key(&owner, (2017, false), "a up").unwrap();
+        queue.ime_edit(&owner).unwrap();
+        queue.after_ime(&owner, (2017, false)).unwrap();
+        assert_eq!(input(queue.pop().unwrap()).2, Some(true));
+        assert_eq!(input(queue.pop().unwrap()).2, Some(false));
+    }
+}
