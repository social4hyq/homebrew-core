diff -ruN a/sshd.c b/sshd.c
--- a/sshd.c	2026-04-02 08:09:03.000000000 +0000
+++ b/sshd.c	2026-06-04 11:59:23.046411788 +0000
@@ -1317,7 +1317,12 @@
 	saved_argc = ac;
 	rexec_argc = ac;
 	saved_argv = xcalloc(ac + 1, sizeof(*saved_argv));
+#ifdef __OHOS__
+	saved_argv[0] = xstrdup("@@HOMEBREW_PREFIX@@/sbin/sshd");
+	for (i = 1; (int)i < ac; i++)
+#else
 	for (i = 0; (int)i < ac; i++)
+#endif
 		saved_argv[i] = xstrdup(av[i]);
 	saved_argv[i] = NULL;
 
@@ -1327,8 +1332,10 @@
 	av = saved_argv;
 #endif
 
+#ifndef __OHOS__
 	if (geteuid() == 0 && setgroups(0, NULL) == -1)
 		debug("setgroups(): %.200s", strerror(errno));
+#endif
 
 	/* Ensure that fds 0, 1 and 2 are open or directed to /dev/null */
 	sanitise_stdfd();
@@ -1451,8 +1458,10 @@
 			break;
 		}
 	}
+#ifndef __OHOS__
 	if (!test_flag && !inetd_flag && !do_dump_cfg && !path_absolute(av[0]))
 		fatal("sshd requires execution with an absolute path");
+#endif
 
 	closefrom(STDERR_FILENO + 1);
 
@@ -1718,12 +1727,15 @@
 	/* Ensure privsep directory is correctly configured. */
 	need_chroot = ((getuid() == 0 || geteuid() == 0) ||
 	    options.kerberos_authentication);
+#ifndef __OHOS__
 	if ((getpwnam(SSH_PRIVSEP_USER)) == NULL && need_chroot) {
 		fatal("Privilege separation user %s does not exist",
 		    SSH_PRIVSEP_USER);
 	}
 	endpwent();
+#endif
 
+#ifndef __OHOS__
 	if (need_chroot) {
 		if ((stat(_PATH_PRIVSEP_CHROOT_DIR, &sb) == -1) ||
 		    (S_ISDIR(sb.st_mode) == 0))
@@ -1739,6 +1751,7 @@
 			fatal("%s must be owned by root and not group or "
 			    "world-writable.", _PATH_PRIVSEP_CHROOT_DIR);
 	}
+#endif
 
 	if (test_flag > 1)
 		print_config(&connection_info);
@@ -1760,8 +1773,10 @@
 	 * to create a file, and we can't control the code in every
 	 * module which might be used).
 	 */
+#ifndef __OHOS__
 	if (setgroups(0, NULL) < 0)
 		debug("setgroups() failed: %.200s", strerror(errno));
+#endif
 
 	/* Prepare arguments for sshd-session */
 	if (rexec_argc < 0)
@@ -1808,7 +1823,7 @@
 	already_daemon = daemonized();
 	if (!(debug_flag || inetd_flag || no_daemon_flag || already_daemon)) {
 
-		if (daemon(0, 0) == -1)
+		if (daemon(1, 0) == -1)
 			fatal("daemon() failed: %.200s", strerror(errno));
 
 		disconnect_controlling_tty();
@@ -1820,8 +1835,10 @@
 	 * Chdir to the root directory so that the current disk can be
 	 * unmounted if desired.
 	 */
+#ifndef __OHOS__
 	if (chdir("/") == -1)
 		error("chdir(\"/\"): %s", strerror(errno));
+#endif
 
 	/* ignore SIGPIPE */
 	ssh_signal(SIGPIPE, SIG_IGN);

diff -ruN a/sshd-auth.c b/sshd-auth.c
--- a/sshd-auth.c	2026-04-02 08:09:03.000000000 +0000
+++ b/sshd-auth.c	2026-06-04 11:59:23.047411792 +0000
@@ -652,12 +652,22 @@
 	debug("sshd-auth version %s, %s", SSH_VERSION, SSH_OPENSSL_VERSION);
 
 	/* Store privilege separation user for later use if required. */
+#ifdef __OHOS__
+	privsep_chroot = 0;
+	do {
+		struct stat st;
+		if (stat("@@HOMEBREW_PREFIX@@", &st) != -1)
+			privsep_pw = getpwuid(st.st_uid);
+	} while (0);
+	if (privsep_pw == NULL) {
+#else
 	privsep_chroot = (getuid() == 0 || geteuid() == 0);
 	if ((privsep_pw = getpwnam(SSH_PRIVSEP_USER)) == NULL) {
 		if (privsep_chroot || options.kerberos_authentication)
 			fatal("Privilege separation user %s does not exist",
 			    SSH_PRIVSEP_USER);
-	} else {
+	} else
+#endif {
 		privsep_pw = pwcopy(privsep_pw);
 		freezero(privsep_pw->pw_passwd, strlen(privsep_pw->pw_passwd));
 		privsep_pw->pw_passwd = xstrdup("*");
