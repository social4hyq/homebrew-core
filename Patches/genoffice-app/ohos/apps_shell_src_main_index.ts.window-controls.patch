+/** Caption buttons for the windows that have no title bar of their own
+ * (OpenHarmony): the renderer drives the window it lives in, so the main
+ * window and a detached one share the handlers. */
+function registerWindowControlsIpc(): void {
+  // Tracked from the events instead of read back through win.isMaximized():
+  // electron-ohos reports a freshly created window as maximized until its
+  // state first changes, which would paint the restore icon on a floating
+  // window. The shell always creates its windows with explicit bounds, so a
+  // window starts unmaximized.
+  const maximized = new WeakMap<BrowserWindow, boolean>()
+  app.on('browser-window-created', (_event, win) => {
+    maximized.set(win, false)
+    const send = (state: boolean): void => {
+      maximized.set(win, state)
+      if (win.isDestroyed()) return
+      win.webContents.send(WINDOW_CHANNELS.maximizedChanged, state)
+    }
+    win.on('maximize', () => send(true))
+    win.on('unmaximize', () => send(false))
+  })
+  ipcMain.handle(WINDOW_CHANNELS.isMaximized, (event) => {
+    const win = BrowserWindow.fromWebContents(event.sender)
+    return win ? (maximized.get(win) ?? false) : false
+  })
+  ipcMain.handle(WINDOW_CHANNELS.control, (event, action: unknown) => {
+    const win = BrowserWindow.fromWebContents(event.sender)
+    if (!win || win.isDestroyed()) return false
+    const state = maximized.get(win) ?? false
+    if (action === 'minimize') {
+      win.minimize()
+      return state
+    }
+    if (action === 'close') {
+      win.close()
+      return state
+    }
+    if (action !== 'toggle-maximize') return false
+    const next = !state
+    if (next) win.maximize()
+    else win.unmaximize()
+    return next
+  })
+}
