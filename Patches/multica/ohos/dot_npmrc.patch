OHOS: take the @ohos-npm-ports packages from the npm registry, and do not fail
the install when the pinned package manager differs from the pnpm that is run.

diff --git a/.npmrc b/.npmrc
index bf2e764..1c98dd0 100644
--- a/.npmrc
+++ b/.npmrc
@@ -1 +1,3 @@
 shamefully-hoist=true
+@ohos-npm-ports:registry=https://registry.npmjs.org
+pmOnFail=ignore
