+"""
+autosign_hook.py - post-install auto-signing entry for pip
+(kept separate from the signing algorithm).
+
+The signing algorithm itself lives in pip/_internal/selfsign.py,
+which is byte-identical to selfsign.py from the ohos-selfsign repo
+(this file does not modify it).
+
+This module only provides sign_site_packages(), the entry point called
+by pip's InstallCommand: it scans the current interpreter's
+site-packages and auto-signs unsigned ELF .so files.
+
+- Reuses has_codesign_section / sign_file_atomic from selfsign
+  (i.e. selfsign.py).
+- Only ELF-magic files are handled; files already carrying a
+  .codesign section are skipped (idempotent).
+- Symlinks are resolved via realpath and the real target file is
+  signed; the link itself is left untouched (never materialized). No
+  path-escape detection is performed: in normal wheel installs and
+  venv layouts symlinks always point inside the same site-packages,
+  so an extra containment check would only add false-positive risk.
+- No "pre-cleaning / normalization" steps are performed (no symbol
+  stripping, no 64KB alignment): the input ELF is kept as-is and only
+  gets an incremental .codesign injection.
+- Per-file failures are non-fatal and never affect the pip install
+  result.
+"""
+
+import os
+
+from pip._internal.selfsign import has_codesign_section, sign_file_atomic
+
+
+def sign_site_packages() -> None:
+    import site
+
+    sp_dirs = site.getsitepackages()
+    if not sp_dirs:
+        return
+
+    seen = set()
+    for sp in sp_dirs:
+        if not os.path.isdir(sp):
+            continue
+        for root, _dirs, files in os.walk(sp):
+            for filename in files:
+                if not (filename.endswith(".so") or ".so." in filename):
+                    continue
+                full = os.path.join(root, filename)
+                real = os.path.realpath(full)
+                if real in seen:
+                    continue
+                seen.add(real)
+
+                try:
+                    with open(real, "rb") as f:
+                        if f.read(4) != b"\x7fELF":
+                            continue
+                except OSError:
+                    continue
+
+                try:
+                    with open(real, "rb") as f:
+                        data = f.read()
+                    if has_codesign_section(data):
+                        continue
+                    sign_file_atomic(real, False)
+                except Exception:
+                    # Signing failure is non-fatal; keep the pip install result.
+                    continue
