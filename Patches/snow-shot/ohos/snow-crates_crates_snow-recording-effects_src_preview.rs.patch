+    #[test]
+    fn disabled_keyboard_preview_does_not_require_platform_rasterizer() {
+        let mut cfg = config();
+        cfg.show_keyboard = false;
+        cfg.trail = [0; 4];
+        cfg.click = [0; 4];
+        cfg.highlight = [0; 4];
+        cfg.keyboard = Some(crate::keyboard_overlay::KeyboardOverlayConfig {
+            font: None,
+            keycap_size: 64,
+            background_rgba: [0; 4],
+            text_rgba: [255; 4],
+            border_rgba: [0; 4],
+            labels: Default::default(),
+        });
+
+        let (input, _) =
+            initialize(&cfg).expect("a disabled keyboard preview must not initialize its renderer");
+        assert!(input.keyboard.is_none());
+    }
