+void ohosBundledRuntimeAndDefaultModelStayOffline() {
+#if defined(Q_OS_OHOS) || defined(Q_OS_HARMONY)
+    QTemporaryDir root;
+    QTemporaryDir cache;
+    require(root.isValid() && cache.isValid(), "OHOS OCR asset roots should be writable");
+    writeAssetManifest(root.path(), true);
+    ScreenshotOcrAssets::Options options;
+    options.offlineRoot = root.path();
+    options.cacheRoot = cache.path();
+    options.bundledRuntimeRoot = root.path();
+    int downloads = 0;
+    options.downloadOverride = [&](const QString&, const QString&, QString*) {
+        ++downloads;
+        return false;
+    };
+    ScreenshotOcrAssets assets(options);
+    ScreenshotOcrResolvedAssets result;
+    bool failed = false;
+    QObject::connect(&assets, &ScreenshotOcrAssets::ready, &assets,
+                     [&](const ScreenshotOcrResolvedAssets& value) { result = value; });
+    QObject::connect(&assets, &ScreenshotOcrAssets::failed, &assets,
+                     [&](const QString&) { failed = true; });
+    assets.prepare();
+    require(waitUntil([&] { return failed || result.valid(); }, 5'000) && !failed,
+            "OHOS bundled OCR worker and packaged Small model should validate");
+    require(result.offline && result.runtimeDirectory == root.path() && downloads == 0 &&
+                result.processPath == QDir(root.path()).filePath(kWorkerName),
+            "OHOS must use the packaged worker and offline model without downloading code or data");
+#endif
+}
