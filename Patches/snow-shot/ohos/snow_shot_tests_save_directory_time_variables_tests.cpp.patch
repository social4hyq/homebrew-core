+void recordingFallbackDirectories(const QTemporaryDir& temporary) {
+    const QString files = temporary.filePath(QStringLiteral("app-files"));
+    const QString movies = QDir(files).filePath(QStringLiteral("Movies"));
+    const QString documents = QDir(files).filePath(QStringLiteral("Documents"));
+    const auto fallback = recording::screenRecordingFallbackDirectories({}, {}, files);
+    require(fallback == QStringList{movies, documents},
+            "empty OHOS public locations must fall back to writable app Movies and Documents");
+    const QString output = recording::screenRecordingOutputPath(fallback, QStringLiteral("capture"),
+                                                                QStringLiteral("mp4"));
+    require(output == QDir(movies).filePath(QStringLiteral("capture.mp4")) &&
+                QFileInfo(movies).isDir(),
+            "the private Movies fallback must be created and selected for recording output");
+    require(recording::screenRecordingFallbackDirectories(movies, documents, files) ==
+                QStringList{movies, documents},
+            "existing public Movies and Documents locations must not be duplicated");
+}
