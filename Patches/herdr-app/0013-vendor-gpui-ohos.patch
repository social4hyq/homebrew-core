+        gpui::div().size(px(64.)).bg(gpui::white()).child(child)
+    });
+    assert_eq!(pixel(&pixels, side, 0, 0), [255, 255, 255, 255]);
+    assert_eq!(pixel(&pixels, side, side / 2, side / 2), [0, 0, 0, 255]);
