+QString screenRecordingDirectoryProbePath(const QString& path) {
+    if (path.isEmpty())
+        return {};
+
+    QFileInfo info(path);
+    QString candidate = info.isDir() ? info.absoluteFilePath() : info.absolutePath();
+    while (!candidate.isEmpty()) {
+        const QFileInfo candidateInfo(candidate);
+        if (candidateInfo.isDir())
+            return candidateInfo.absoluteFilePath();
+        const QString parent = candidateInfo.dir().absolutePath();
+        if (parent == candidate)
+            break;
+        candidate = parent;
+    }
+    return {};
+}
+
+bool screenRecordingDirectoryWritable(const QString& directory) {
+    if (directory.isEmpty() || !QFileInfo(directory).isDir())
+        return false;
+    QTemporaryFile probe(QDir(directory).filePath(QStringLiteral(".snow-shot-write-probe-XXXXXX")));
+    if (!probe.open())
+        return false;
+    probe.close();
+    return probe.remove();
+}
