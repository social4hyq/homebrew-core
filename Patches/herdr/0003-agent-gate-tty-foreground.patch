# OHOS procfs reports no tpgid and no task children, so foreground_job() misses every
# pane. The two gates behind `agent start` and `agent prompt`/`send-keys` resolve the
# foreground job themselves, so route them through the PTY master's group as well.
diff --git a/src/app/agents.rs b/src/app/agents.rs
index 5033505..070de71 100644
--- a/src/app/agents.rs
+++ b/src/app/agents.rs
@@ -420,7 +420,20 @@ fn available_shell_name(runtime: &crate::terminal::TerminalRuntime) -> Option<St
     if runtime.child_pid().is_none() {
         return Some("sh".into());
     }
-    crate::platform::available_pane_shell(runtime.child_pid()?)
+    let child_pid = runtime.child_pid()?;
+    if let Some(shell) = crate::platform::available_pane_shell(child_pid) {
+        return Some(shell);
+    }
+    crate::platform::available_pane_shell_from_job(child_pid, foreground_job(runtime)?)
+}
+
+fn foreground_job(
+    runtime: &crate::terminal::TerminalRuntime,
+) -> Option<crate::platform::ForegroundJob> {
+    let child_pid = runtime.child_pid()?;
+    crate::detect::foreground_job(child_pid).or_else(|| {
+        crate::detect::foreground_group_leader_job(runtime.pty_foreground_process_group_id()?)
+    })
 }
 
 pub(super) fn runtime_hosts_agent(
