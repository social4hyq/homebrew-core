@@ -19,6 +19,12 @@ const opentuiReactPackageName = "@mbears/opentui-react";
 
 export const opentuiNativePackageForTarget = (target) => {
   const { arch, releasePlatform } = targetParts(target);
+  // OHOS 移植：opentui 0.5.8 port 的原生包走 @opentui scope
+  //（@opentui/core-openharmony-arm64，由 @ohos-npm-ports 重打包提供），
