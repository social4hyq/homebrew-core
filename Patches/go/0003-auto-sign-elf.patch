+// autoSignOutput signs the output ELF binary using binary-sign-tool.
+// Only signs executable (ET_EXEC) and shared object (ET_DYN) ELF files,
+// skipping relocatable (ET_REL, i.e. .o) files which would be corrupted by signing.
+func autoSignOutput() {
+	out := *flagOutfile
+	if out == "" {
+		return
+	}
+	f, err := os.Open(out)
+	if err != nil {
+		return
+	}
+	// Read ELF header: magic(4) + class/data/ver/pad(12) + e_type(2) = 18 bytes
+	buf := make([]byte, 18)
+	if _, err := f.Read(buf); err != nil {
+		f.Close()
+		return
+	}
+	f.Close()
+	// Check ELF magic
+	if buf[0] != 0x7f || buf[1] != 'E' || buf[2] != 'L' || buf[3] != 'F' {
+		return
+	}
+	// Parse e_type at offset 16 (little-endian for both ELF32 and ELF64)
+	eType := int(buf[16]) | int(buf[17])<<8
+	// ET_REL (1) = .o relocatable → skip (signing would corrupt it)
+	// ET_EXEC (2) = executable → sign
+	// ET_DYN  (3) = shared object (.so) → sign
+	if eType != 2 && eType != 3 {
+		return
+	}
+	if _, err := exec.LookPath("binary-sign-tool"); err != nil {
+		return
+	}
+	absOut, err := filepath.Abs(out)
+	if err != nil {
+		return
+	}
+	cmd := exec.Command("binary-sign-tool", "sign", "-inFile", absOut, "-outFile", absOut, "-selfSign", "1")
+	if output, err := cmd.CombinedOutput(); err != nil {
+		log.Printf("warning: binary-sign-tool failed: %v\n%s", err, output)
+	}
+}
