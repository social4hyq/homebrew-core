+    bool ensureRecordingDirectoryAccess() {
+#if !defined(Q_OS_HARMONY)
+        return true;
+#else
+        if (automationOwned || automationCommand ||
+            !automationOptions.value(QStringLiteral("path")).toString().isEmpty()) {
+            return true;
+        }
+        const snow_shot::storage::RecordingSettings settings;
+        const QString configuredTemplate = settings.videoSaveDirectory();
+        if (configuredTemplate.isEmpty())
+            return true;
+
+        const QDateTime timestamp = QDateTime::currentDateTime();
+        const auto names = exportWindowNames(configuredTemplate, settings.videoFilenameFormat());
+        const QString configuredDirectory = snow_shot::storage::expandScreenshotExportVariables(
+            configuredTemplate, timestamp, names);
+        const QString probeDirectory =
+            snow_shot::presentation::recording::screenRecordingDirectoryProbePath(
+                configuredDirectory);
+        if (snow_shot::presentation::recording::screenRecordingDirectoryWritable(probeDirectory))
+            return true;
+
+        const QString selected = QFileDialog::getExistingDirectory(
+            areaWindow, {}, probeDirectory.isEmpty() ? configuredDirectory : probeDirectory);
+        if (selected.isEmpty())
+            return false;
+        if (!snow_shot::presentation::recording::screenRecordingDirectoryWritable(selected)) {
+            showError(tr("The recording operation failed"));
+            return false;
+        }
+        return settings.setVideoSaveDirectory(selected);
+#endif
+    }
