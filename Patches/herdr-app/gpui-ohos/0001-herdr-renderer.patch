+pub(super) fn tiled_scene(
+    source: &gpui::Scene,
+    extent: gpui::Size<gpui::DevicePixels>,
+) -> gpui::Scene {
+    let mut content = gpui::Scene::default();
+    content.replay(0..source.len(), source);
+    content.finish();
+    let frame = gpui::LayerFrame {
+        key: gpui::LayerKey(123),
+        generation: 1,
+        background: gpui::rgba(0xffffffff),
+        tile_size: 512,
+        content: content.into(),
+        dirty_tiles: Vec::new(),
+    };
+    let coord = gpui::TileCoord { x: 0, y: 0 };
+    let bounds = frame.tile_bounds(coord);
+    let mask = gpui::Bounds::new(
+        gpui::point(gpui::ScaledPixels(0.), gpui::ScaledPixels(0.)),
+        gpui::size(
+            gpui::ScaledPixels(extent.width.0 as f32),
+            gpui::ScaledPixels(extent.height.0 as f32),
+        ),
+    );
+    let mut scene = gpui::Scene::default();
+    scene.insert_primitive(gpui::PolychromeSprite {
+        order: 0,
+        pad: 0,
+        grayscale: false.into(),
+        opacity: 1.,
+        bounds,
+        content_mask: gpui::ContentMask { bounds: mask },
+        corner_radii: Default::default(),
+        tile: gpui::AtlasTile {
+            texture_id: gpui::layer_tile_texture_id(frame.key),
+            tile_id: gpui::layer_tile_id(coord),
+            padding: 0,
+            bounds: gpui::Bounds::new(
+                gpui::point(gpui::DevicePixels(0), gpui::DevicePixels(0)),
+                gpui::size(gpui::DevicePixels(512), gpui::DevicePixels(512)),
+            ),
+        },
+    });
+    scene.layers.frames.push(frame);
+    scene.finish();
+    scene
+}
