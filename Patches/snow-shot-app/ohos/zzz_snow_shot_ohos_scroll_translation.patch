diff --git a/snow_shot/src/platform/ohos/scrollinput.cpp b/snow_shot/src/platform/ohos/scrollinput.cpp
new file mode 100644
index 0000000..23c7652
--- /dev/null
+++ b/snow_shot/src/platform/ohos/scrollinput.cpp
@@ -0,0 +1,95 @@
+#include <QRectF>
+
+#include "snow_shot/platform/screenshotnative.h"
+
+#include <multimodalinput/oh_input_manager.h>
+
+#include <atomic>
+
+// The injection-permission entry points are present in libohinput on OHOS PC
+// but are not declared by every SDK header revision. Declare the stable C
+// signatures here so the scrolling controller can request user authorization.
+extern "C" {
+Input_Result OH_Input_RequestInjection(Input_InjectAuthorizeCallback callback);
+Input_Result OH_Input_QueryAuthorizedStatus(Input_InjectionStatus* status);
+}
+
+namespace snow_shot::platform {
+namespace {
+std::atomic_bool injectionRequestInFlight{false};
+std::atomic_bool injectionDenied{false};
+
+void onInjectionAuthorized(Input_InjectionStatus status) {
+    if (status == UNAUTHORIZED)
+        injectionDenied.store(true, std::memory_order_release);
+    injectionRequestInFlight.store(false, std::memory_order_release);
+}
+
+bool ensureInjectionAuthorized() {
+    Input_InjectionStatus status = UNAUTHORIZED;
+    if (OH_Input_QueryAuthorizedStatus(&status) == INPUT_SUCCESS) {
+        if (status == AUTHORIZED)
+            return true;
+        if (status == AUTHORIZING)
+            return false;
+    }
+    if (injectionDenied.load(std::memory_order_acquire) ||
+        injectionRequestInFlight.exchange(true, std::memory_order_acq_rel))
+        return false;
+    const Input_Result result = OH_Input_RequestInjection(&onInjectionAuthorized);
+    if (result == INPUT_INJECTION_AUTHORIZED) {
+        injectionRequestInFlight.store(false, std::memory_order_release);
+        return true;
+    }
+    if (result != INPUT_SUCCESS && result != INPUT_INJECTION_AUTHORIZING) {
+        injectionRequestInFlight.store(false, std::memory_order_release);
+        injectionDenied.store(true, std::memory_order_release);
+    }
+    return false;
+}
+
+ScrollInputResult injectScrollStep(const QRect& selection, const QPoint& delta) {
+    struct Input_MouseEvent* event = OH_Input_CreateMouseEvent();
+    if (event == nullptr)
+        return {ScrollInputResult::Status::PostFailed, 0};
+    const QPoint center = selection.center();
+    const bool horizontal = delta.x() != 0;
+    OH_Input_SetMouseEventAction(event, MOUSE_ACTION_AXIS_UPDATE);
+    OH_Input_SetMouseEventDisplayId(event, 0);
+    OH_Input_SetMouseEventDisplayX(event, center.x());
+    OH_Input_SetMouseEventDisplayY(event, center.y());
+    OH_Input_SetMouseEventGlobalX(event, center.x());
+    OH_Input_SetMouseEventGlobalY(event, center.y());
+    OH_Input_SetMouseEventAxisType(event, horizontal ? MOUSE_AXIS_SCROLL_HORIZONTAL
+                                                     : MOUSE_AXIS_SCROLL_VERTICAL);
+    OH_Input_SetMouseEventAxisValue(event,
+                                    static_cast<float>(horizontal ? delta.x() : delta.y()));
+    const int32_t result = OH_Input_InjectMouseEventGlobal(event);
+    OH_Input_DestroyMouseEvent(&event);
+    switch (result) {
+    case INPUT_SUCCESS:
+        return {ScrollInputResult::Status::Posted, 0};
+    case INPUT_DEVICE_NOT_SUPPORTED:
+        return {ScrollInputResult::Status::Unsupported, 0};
+    case INPUT_PARAMETER_ERROR:
+        return {ScrollInputResult::Status::InvalidRequest, 0};
+    default:
+        return {ScrollInputResult::Status::PostFailed, static_cast<quint32>(result)};
+    }
+}
+} // namespace
+
+bool screenshotScrollPermission() {
+    // The auto-scroller must keep calling us: the first call opens the system
+    // injection-consent dialog, and later calls succeed after user approval.
+    return true;
+}
+
+ScrollInputResult sendScreenshotScroll(const QRect& selection, const QPoint& delta) {
+    if (selection.isEmpty() || delta.isNull())
+        return {ScrollInputResult::Status::InvalidRequest, 0};
+    if (!ensureInjectionAuthorized())
+        return {ScrollInputResult::Status::PostFailed, 0};
+    return injectScrollStep(selection, delta);
+}
+} // namespace snow_shot::platform
