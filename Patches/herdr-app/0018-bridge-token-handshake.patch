+//! Where the core bridge is and the token it wants, as `herdr-app install` baked them into the HAP.
+//!
+//! A HAP cannot start the host's `hc`, so it reaches herdr-core through a bridge on the host (see
+//! `connect_bridge`). The bridge only answers a connection that starts with `HERDR-AUTH <token>`.
+//! The installer puts a `bridge.conf` (`addr=` and `token=` lines) in the HAP; the ArkTS entry copies
+//! it into the app's files directory at start-up, and this reads it from there.
+//!
+//! `HERDR_CORE_TCP` and `HERDR_CORE_TOKEN` override the file (development outside a HAP). Without
+//! either, the address is the default and no token is sent, which an authenticating bridge refuses.
+//!
+//! Std only, so the tests can be built on their own: `rustc --edition 2024 --test src/bridge_auth.rs`.
+
+use std::path::Path;
+
+pub const DEFAULT_ADDR: &str = "127.0.0.1:8765";
+pub const FILE: &str = "bridge.conf";
+
+#[derive(Debug, Default, Clone, PartialEq, Eq)]
+pub struct Config {
+    pub addr: Option<String>,
+    pub token: Option<String>,
+}
+
+/// A token goes on a line by itself, so it may not hold anything that could end or split that line.
+fn plausible_token(token: &str) -> bool {
+    !token.is_empty() && token.chars().all(|c| !c.is_whitespace() && !c.is_control())
+}
+
+pub fn parse(text: &str) -> Config {
+    let mut config = Config::default();
+    for line in text.lines() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let Some((key, value)) = line.split_once('=') else { continue };
+        let value = value.trim();
+        match key.trim() {
+            "addr" if !value.is_empty() => config.addr = Some(value.to_owned()),
+            "token" if plausible_token(value) => config.token = Some(value.to_owned()),
+            _ => {}
+        }
+    }
+    config
+}
+
+/// `bridge.conf` in `dir`, or nothing when it is not there or cannot be read.
+pub fn read(dir: &Path) -> Config {
+    std::fs::read_to_string(dir.join(FILE)).map(|text| parse(&text)).unwrap_or_default()
+}
+
+/// The environment wins over the file, the file over the defaults.
+pub fn resolve(env_addr: Option<String>, env_token: Option<String>, file: Config) -> (String, Option<String>) {
+    let addr = env_addr.filter(|a| !a.is_empty()).or(file.addr).unwrap_or_else(|| DEFAULT_ADDR.to_owned());
+    let token = env_token.filter(|t| plausible_token(t)).or(file.token);
+    (addr, token)
+}
+
+fn resolved(dir: &Path) -> (String, Option<String>) {
+    resolve(std::env::var("HERDR_CORE_TCP").ok(), std::env::var("HERDR_CORE_TOKEN").ok(), read(dir))
+}
+
+pub fn address(dir: &Path) -> String {
+    resolved(dir).0
+}
+
+pub fn token(dir: &Path) -> Option<String> {
+    resolved(dir).1
+}
+
+/// The first line of a connection.
+pub fn auth_line(token: &str) -> String {
+    format!("HERDR-AUTH {token}\n")
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum Reply {
+    Accepted,
+    /// Wrong or missing token. The bridge says nothing more on purpose.
+    Refused,
+    Busy,
+    /// The bridge took the token but could not start `hc`.
+    NoCore,
+    Other(String),
+}
+
+pub fn classify(line: &str) -> Reply {
+    match line.trim() {
+        "OK" => Reply::Accepted,
+        "DENIED" => Reply::Refused,
+        "BUSY" => Reply::Busy,
+        "ERR" => Reply::NoCore,
+        other => Reply::Other(other.chars().take(60).collect()),
+    }
+}
+
+/// What to tell the person for a reply that is not `OK`.
+pub fn explain(reply: &Reply) -> String {
+    match reply {
+        Reply::Accepted => String::new(),
+        Reply::Refused => "the core bridge refused this app's token: run `herdr-app install` again so the app and the bridge share one".into(),
+        Reply::Busy => "the core bridge has too many connections open".into(),
+        Reply::NoCore => "the core bridge could not start herdr-core's `hc`".into(),
+        Reply::Other(text) => format!("the core bridge answered {text:?}, which is not what herdr-bridge says"),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_the_two_keys_and_ignores_the_rest() {
+        let c = parse("# written by herdr-app install\naddr = 127.0.0.1:9001\n\ntoken=abc123\nother=1\nnoequals\n");
+        assert_eq!(c, Config { addr: Some("127.0.0.1:9001".into()), token: Some("abc123".into()) });
+    }
+
+    #[test]
+    fn crlf_and_padding_are_tolerated() {
+        let c = parse("addr=127.0.0.1:1\r\ntoken=  t0k3n  \r\n");
+        assert_eq!(c.addr.as_deref(), Some("127.0.0.1:1"));
+        assert_eq!(c.token.as_deref(), Some("t0k3n"));
+    }
+
+    #[test]
+    fn an_empty_or_unusable_value_is_not_a_value() {
+        assert_eq!(parse("addr=\ntoken=\n"), Config::default());
+        assert_eq!(parse("token=has space\n").token, None);
+        assert_eq!(parse("token=a\tb\n").token, None);
+        assert_eq!(parse(""), Config::default());
+    }
+
+    #[test]
+    fn the_last_value_for_a_key_wins() {
+        assert_eq!(parse("token=one\ntoken=two\n").token.as_deref(), Some("two"));
+    }
+
+    #[test]
+    fn a_token_cannot_carry_a_second_line() {
+        // Both halves would be separate lines to `lines()`; the token is only what is left of the first.
+        let c = parse("token=abc\nHERDR-AUTH evil\n");
+        assert_eq!(c.token.as_deref(), Some("abc"));
+        assert!(!plausible_token("abc\nHERDR-AUTH x"));
+        assert!(!plausible_token("abc\r"));
+        assert!(!plausible_token("a\u{0}b"));
+        assert_eq!(auth_line("abc"), "HERDR-AUTH abc\n");
+    }
+
+    #[test]
+    fn the_environment_beats_the_file_and_the_file_beats_the_default() {
+        let file = Config { addr: Some("127.0.0.1:9001".into()), token: Some("filetoken".into()) };
+        assert_eq!(resolve(None, None, file.clone()), ("127.0.0.1:9001".into(), Some("filetoken".into())));
+        assert_eq!(resolve(Some("127.0.0.1:7".into()), Some("envtoken".into()), file.clone()), ("127.0.0.1:7".into(), Some("envtoken".into())));
+        assert_eq!(resolve(None, None, Config::default()), (DEFAULT_ADDR.into(), None));
+        assert_eq!(resolve(Some(String::new()), Some("bad token".into()), file), ("127.0.0.1:9001".into(), Some("filetoken".into())));
+    }
+
+    #[test]
+    fn reads_the_file_from_a_directory() {
+        let dir = std::env::temp_dir().join(format!("bridge-auth-test-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        assert_eq!(read(&dir), Config::default(), "no file yet");
+        std::fs::write(dir.join(FILE), "addr=127.0.0.1:4242\ntoken=deadbeef\n").unwrap();
+        assert_eq!(read(&dir), Config { addr: Some("127.0.0.1:4242".into()), token: Some("deadbeef".into()) });
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn classifies_what_the_bridge_says() {
+        assert_eq!(classify("OK\n"), Reply::Accepted);
+        assert_eq!(classify("DENIED\n"), Reply::Refused);
+        assert_eq!(classify("BUSY\r\n"), Reply::Busy);
+        assert_eq!(classify("ERR\n"), Reply::NoCore);
+        assert!(matches!(classify("{\"jsonrpc\":\"2.0\"}\n"), Reply::Other(_)));
+        assert!(matches!(classify(""), Reply::Other(_)));
+        assert!(explain(&Reply::Refused).contains("herdr-app install"));
+        assert!(explain(&Reply::Accepted).is_empty());
+    }
+
+    #[test]
+    fn an_unrecognised_reply_is_cut_short_in_the_message() {
+        let Reply::Other(text) = classify(&"x".repeat(500)) else { panic!("not Other") };
+        assert_eq!(text.len(), 60);
+    }
+}
