 void MainWindow::closeEvent(QCloseEvent* event) {
+#ifdef Q_OS_HARMONY
+    const bool enabled = snow_shot::storage::ApplicationStorage::instance()
+                             .configuration().value(QStringLiteral("tray/enabled")).toBool();
+    if (snow_shot::platform::ohos::closeToTray(*this, *event, enabled && snow_shot::platform::ohos::trayAvailable.load())) {
+        qApp->setProperty("snowOhosTrayHidden", true);
+        return;
+    }
+#endif
     QMainWindow::closeEvent(event);
     if (event->isAccepted()) {
         m_geometryMemory.captureAcceptedClose();
     }
 }
 
+void MainWindow::setVisible(bool visible) {
