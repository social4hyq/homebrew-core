{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/social4hyq/homebrew-core/contracts/ohos-app/v1/sign/result.schema.json",
  "title": "signing result — ohos-hap → ohos-app",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "ok"],
  "properties": {
    "protocol_version": { "const": 1 },
    "ok": { "type": "boolean" },
    "output_hap": { "type": "string" },
    "output_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "certificate_fingerprint": { "type": "string", "description": "public fingerprint only" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structure_ok": { "type": "boolean" },
        "signature_ok": { "type": "boolean" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": { "code": { "type": "string" }, "detail": { "type": "string" } }
    }
  }
}
