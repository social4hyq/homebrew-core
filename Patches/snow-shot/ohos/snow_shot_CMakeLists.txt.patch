+        set(SNOW_RUST_CARGO_TARGET_DIR "${CMAKE_BINARY_DIR}/cargo" CACHE PATH
+            "Cargo target directory for the active CMake build tree.")
+    endif()
+    if(NOT DEFINED SNOW_RUST_RELEASE_PROFILE OR SNOW_RUST_RELEASE_PROFILE STREQUAL "")
+        set(SNOW_RUST_RELEASE_PROFILE release CACHE STRING
+            "Cargo profile used for non-Debug Rust builds.")
+    endif()
+    if(CMAKE_BUILD_TYPE STREQUAL "Debug")
+        set(_snow_ocr_cargo_profile dev)
+    else()
+        set(_snow_ocr_cargo_profile "${SNOW_RUST_RELEASE_PROFILE}")
+    endif()
+    set(_snow_ocr_inprocess_shared
+        "${SNOW_RUST_CARGO_TARGET_DIR}/${SNOW_SHOT_RUST_TARGET}/${_snow_ocr_cargo_profile}/libsnow_ocr_inprocess.so")
+    add_custom_command(OUTPUT "${_snow_ocr_inprocess_shared}"
+        COMMAND "${CMAKE_COMMAND}" -E env
+            "CARGO_TARGET_DIR=${SNOW_RUST_CARGO_TARGET_DIR}"
+            "RUSTUP_TOOLCHAIN=${SNOW_SHOT_OCR_TOOLCHAIN}"
+            "RUSTC_BOOTSTRAP=1"
+            "SNOW_CAPTURE_OHOS_CXX=${CMAKE_CXX_COMPILER}"
+            "SNOW_CAPTURE_OHOS_SYSROOT=${CMAKE_SYSROOT}"
+            "${CARGO_EXECUTABLE}" build --locked --package snow-ocr-process
+                --target "${SNOW_SHOT_RUST_TARGET}" --profile "${_snow_ocr_cargo_profile}"
+        DEPENDS
+            "${SNOW_SHOT_CAPTURE_CRATES_DIR}/Cargo.lock"
+            "${SNOW_SHOT_CAPTURE_CRATES_DIR}/crates/snow-ocr-process/Cargo.toml"
+            "${SNOW_SHOT_CAPTURE_CRATES_DIR}/crates/snow-ocr-process/src/lib.rs"
+            "${SNOW_SHOT_CAPTURE_CRATES_DIR}/crates/snow-ocr-process/src/engine.rs"
+        WORKING_DIRECTORY "${SNOW_SHOT_CAPTURE_CRATES_DIR}"
+        COMMENT "Building in-process Snow OCR cdylib"
+        VERBATIM
+    )
+    add_custom_target(snow_ocr_inprocess_build DEPENDS "${_snow_ocr_inprocess_shared}")
+    add_library(snow_ocr_inprocess_cdylib SHARED IMPORTED GLOBAL)
+    set_target_properties(snow_ocr_inprocess_cdylib PROPERTIES
+        IMPORTED_LOCATION "${_snow_ocr_inprocess_shared}"
+        IMPORTED_NO_SONAME TRUE
+        INTERFACE_INCLUDE_DIRECTORIES
+            "${SNOW_SHOT_CAPTURE_CRATES_DIR}/crates/snow-ocr-process/include"
+    )
+endif()
