+        platform.set_app(app);
+        if let Some(app) = platform.app.borrow().clone() {
+            platform
+                .background_executor
+                .spawn(async move {
+                    let client = match SystemStateClient::new(&app) {
+                        Ok(client) => client,
+                        Err(error) => {
