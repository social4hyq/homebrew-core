+void topLevelThumbnailSurvivesHiddenOverlay() {
+    QWidget overlay;
+    overlay.show();
+    auto* thumbnail = new ScreenshotScrollingThumbnailWidget();
+    int shownNotifications = 0;
+    QObject::connect(thumbnail, &ScreenshotScrollingThumbnailWidget::previewShown, thumbnail,
+                     [&shownNotifications] { ++shownNotifications; });
+    thumbnail->show();
+    QApplication::processEvents();
+    require(shownNotifications == 1,
+            "the preview must notify scrolling controls after its native window is shown");
+    overlay.hide();
+    QApplication::processEvents();
+    require(thumbnail->parentWidget() == nullptr && thumbnail->isWindow() && thumbnail->isVisible(),
+            "the scrolling preview must stay visible after the overlay hides");
+    delete thumbnail;
+}
