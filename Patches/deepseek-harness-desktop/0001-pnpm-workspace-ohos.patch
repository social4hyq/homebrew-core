 peerDependencyRules:
   allowedVersions:
@@ -28,9 +32,14 @@ peerDependencyRules:
 # is a hard install error). Every such package MUST be listed; we deny by
 # default and only allow scripts we need. esbuild (native binary) and lefthook
 # (git hooks) genuinely need theirs.
+# OHOS: @pnpm/exe 无 openharmony-arm64 原生二进制，保持 JS 版 pnpm 不做版本切换。
+managePackageManagerVersions: false
+pmOnFail: ignore
+
 allowBuilds:
   esbuild: true
-  lefthook: true
