+/// OHOS has no official native bun/pnpm binaries. ohos-npm-ports republishes them as
+/// `@ohos-npm-ports/*` platform packages versioned `<upstream>-<revision>`.
+#[cfg(target_env = "ohos")]
+const OHOS_BUN_PACKAGE: &str = "@ohos-npm-ports/oven-bun-openharmony-arm64";
+#[cfg(target_env = "ohos")]
+const OHOS_PNPM_PACKAGE: &str = "@ohos-npm-ports/pnpm-exe.openharmony-arm64";
+
+#[cfg(target_env = "ohos")]
+fn ohos_port_package(package_manager_type: PackageManagerType) -> Option<&'static str> {
+    match package_manager_type {
+        PackageManagerType::Bun => Some(OHOS_BUN_PACKAGE),
+        PackageManagerType::Pnpm => Some(OHOS_PNPM_PACKAGE),
+        _ => None,
+    }
+}
+
+/// The upstream `X.Y.Z` that a port version `X.Y.Z-<revision>` republishes.
+#[cfg(target_env = "ohos")]
+fn port_upstream_version(version: &node_semver::Version) -> Option<node_semver::Version> {
+    match version.pre_release.as_slice() {
+        [node_semver::Identifier::Numeric(_)] => {
+            Some(node_semver::Version::new(version.major, version.minor, version.patch))
+        }
+        _ => None,
+    }
+}
+
+/// The highest published port revision of `upstream`.
+#[cfg(target_env = "ohos")]
+fn pick_port_version(
+    upstream: &str,
+    published: &[node_semver::Version],
+) -> Option<node_semver::Version> {
+    let upstream = node_semver::Version::parse(upstream).ok()?;
+    published.iter().filter(|v| port_upstream_version(v).as_ref() == Some(&upstream)).max().cloned()
+}
+
+/// Upstream versions that have been ported to OHOS, or `None` for a manager without a port.
+#[cfg(target_env = "ohos")]
+async fn fetch_ported_versions(
+    package_manager_type: PackageManagerType,
+) -> Result<Option<Vec<node_semver::Version>>, Error> {
+    let Some(package) = ohos_port_package(package_manager_type) else { return Ok(None) };
+    let published = fetch_registry_versions(package).await?;
+    let mut versions: Vec<_> = published.iter().filter_map(port_upstream_version).collect();
+    versions.sort();
+    versions.dedup();
+    Ok(Some(versions))
+}
+
+/// The registry version of the platform package that carries upstream `version`.
+#[cfg(target_env = "ohos")]
+async fn platform_package_version(
+    bin_name: &str,
+    platform_package_name: &str,
+    version: &Str,
+) -> Result<Str, Error> {
+    let published = fetch_registry_versions(platform_package_name).await?;
+    pick_port_version(version, &published).map(|v| Str::from(v.to_string())).ok_or_else(|| {
+        Error::PackageManagerVersionNotFound {
+            name: bin_name.into(),
+            version: version.clone(),
+            url: get_npm_package_metadata_url(platform_package_name).into(),
+        }
+    })
+}
+
+#[cfg(not(target_env = "ohos"))]
+#[allow(clippy::unused_async)]
+async fn platform_package_version(
+    _bin_name: &str,
+    _platform_package_name: &str,
+    version: &Str,
+) -> Result<Str, Error> {
+    Ok(version.clone())
+}
