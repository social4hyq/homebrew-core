OHOS: enable the system tray when the main window first appears. The Qt
OHOS tray is otherwise only switched on from the pause/resume path, so a fresh
launch never requests a status bar item and the app becomes unreachable once
its window is gone.

diff --git a/snow_shot/src/app/applicationcontroller.cpp b/snow_shot/src/app/applicationcontroller.cpp
index 46076e4..acd26aa 100644
--- a/snow_shot/src/app/applicationcontroller.cpp
+++ b/snow_shot/src/app/applicationcontroller.cpp
@@ -1973,6 +1973,16 @@ class ApplicationController::Impl {
         if (storage::ApplicationStorage::instance().directoryChanging())
             return;
         ensureMainWindow().showAndActivate();
+#ifdef Q_OS_HARMONY
+        // Qt on OHOS only enables the tray from the pause/resume path, so at
+        // startup no status bar item is ever requested and the app cannot be
+        // reached once its window is hidden. Enable it when the main window
+        // first appears; setEnabled() is idempotent.
+        systemTray.setEnabled(storage::ApplicationStorage::instance()
+                                  .configuration()
+                                  .value(kTrayEnabledKey)
+                                  .toBool());
+#endif
     }
 
     void restorePinnedWindows() {
