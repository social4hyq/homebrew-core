+/// OHOS-only: sign every `.so` ELF under the unpacked-wheel source directory
+/// in place, before it is linked into site-packages.
+///
+/// The OHOS kernel refuses to `dlopen` an ELF with no `.codesign` section, so
+/// wheel-bundled native modules are unusable without a signature. Signing the
+/// unpacked-wheel source once means every link mode (clone/hardlink/copy/
+/// symlink) propagates already-signed bytes, and the wheel cache stays signed
+/// so re-installs are free. Idempotent: already-signed files are skipped.
+/// Failures are non-fatal (matching ohos-bun's behaviour for `.node` addons).
+#[cfg(target_env = "ohos")]
+fn ohos_sign_wheel_files(wheel_src: &Path) {
+    let debug = std::env::var_os("OHOS_SIGN_DEBUG").is_some();
+    for entry in walkdir::WalkDir::new(wheel_src) {
+        let Ok(entry) = entry else { continue };
+        if !entry.file_type().is_file() {
+            continue;
+        }
+        let Some(name) = entry.file_name().to_str() else {
+            continue;
+        };
+        if !(name.ends_with(".so") || name.contains(".so.")) {
+            continue;
+        }
+        let path = entry.path();
+        match std::fs::read(path) {
+            Ok(bytes) if ohos_sign::has_codesign(&bytes) => {
+                if debug {
+                    eprintln!("[uv-ohos-sign] {}: already signed", path.display());
+                }
+            }
+            Ok(_) => {
+                // catch_unwind: an exotic/malformed ELF must never abort the
+                // whole wheel install. A panic here is contained and the file
+                // is simply left unsigned (clean Permission denied on import,
+                // no crash), matching the non-fatal Err path below.
+                let result =
+                    std::panic::catch_unwind(|| ohos_sign::sign_selfsign_inplace_with_strip(path));
+                if debug {
+                    match result {
+                        Ok(Ok(())) => eprintln!("[uv-ohos-sign] {}: signed", path.display()),
+                        Ok(Err(err)) => {
+                            eprintln!("[uv-ohos-sign] {}: sign failed: {err}", path.display())
+                        }
+                        Err(_) => eprintln!("[uv-ohos-sign] {}: sign panicked", path.display()),
+                    }
+                }
+            }
+            Err(_) => {}
+        }
+    }
+}
