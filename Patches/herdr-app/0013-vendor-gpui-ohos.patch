+    fn start_window_move(&self) {
+        if self.manipulation.get().is_some() {
+            return;
+        }
+        self.begin_manipulation(None);
+        if self.manipulation.get().is_some() {
+            if let Some(subscription) = self.move_subscription.borrow().as_ref() {
+                subscription.request();
+            }
+        }
+    }
