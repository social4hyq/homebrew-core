new file mode 100644
index 0000000..96436cc
--- /dev/null
+++ b/snow_shot/src/platform/ohos/livewindowselection_p.h
@@ -0,0 +1,46 @@
+#ifndef SNOW_SHOT_PLATFORM_OHOS_LIVEWINDOWSELECTION_P_H
+#define SNOW_SHOT_PLATFORM_OHOS_LIVEWINDOWSELECTION_P_H
+
+#include "snow_shot/presentation/livewindowsource.h"
+
+namespace snow_shot::presentation::ohos_live_window_detail {
+
+enum class WindowLookupState { Visible, Hidden, Unavailable };
+
+inline LiveWindowState stateForWindowLookup(WindowLookupState state) {
+    switch (state) {
+    case WindowLookupState::Visible:
+        return LiveWindowState::Live;
+    case WindowLookupState::Hidden:
+        return LiveWindowState::Closed;
+    case WindowLookupState::Unavailable:
+        return LiveWindowState::Unavailable;
+    }
+    return LiveWindowState::Unavailable;
+}
+
+struct WindowCandidate {
+    quintptr nativeId = 0;
+    qint64 processId = 0;
+    QRect bounds;
+    QString title;
+    bool showing = false;
+};
+
+// The input order is the native stacking order (topmost first).
+inline std::optional<LiveWindowTarget> targetAtPoint(const QPoint& point,
+                                                     const QVector<quintptr>& excluded,
+                                                     const QVector<WindowCandidate>& candidates) {
+    for (const auto& candidate : candidates) {
+        if (!candidate.nativeId || !candidate.showing || candidate.bounds.isEmpty() ||
+            excluded.contains(candidate.nativeId) || !candidate.bounds.contains(point))
+            continue;
+        return LiveWindowTarget{candidate.nativeId, candidate.processId, candidate.bounds, point,
+                                candidate.title};
+    }
+    return std::nullopt;
+}
+
+} // namespace snow_shot::presentation::ohos_live_window_detail
+
+#endif

diff --git a/snow_shot/src/platform/ohos/recordingfileexport.cpp b/snow_shot/src/platform/ohos/recordingfileexport.cpp
new file mode 100644
index 0000000..51ae263
--- /dev/null
+++ b/snow_shot/src/platform/ohos/recordingfileexport.cpp
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "snow_shot/platform/ohos/recordingfileexport.h"
+
+#include "snow_shot/platform/ohos/userfileexportqueue.h"
+
+#include <QFileInfo>
+#include <QMetaObject>
+#include <QPointer>
+#include <utility>
+
+namespace snow_shot::platform::ohos {
+
+RecordingFileExport::RecordingFileExport(QObject* parent) : QObject(parent) {}
+
+RecordingFileExport::~RecordingFileExport() {
+    m_destroying = true;
+    if (m_pickerRequestId != 0)
+        static_cast<void>(sharedUserFileSavePickerQueue().cancel(m_pickerRequestId));
+    if (m_exportRequestId != 0)
+        static_cast<void>(sharedUserFileExportQueue().cancel(m_exportRequestId));
+}
+
+void RecordingFileExport::setCompletion(Completion completion) {
+    m_completion = std::move(completion);
+}
+
+bool RecordingFileExport::start(const QString& sourcePath) {
+    if (m_active)
+        return false;
+    const QFileInfo source(sourcePath);
+    if (!source.isFile() || !source.isReadable()) {
+        finish(Result::Failed, QStringLiteral("The recording file is unavailable"));
+        return false;
+    }
+
+    m_active = true;
+    const QString suggestedName = source.completeBaseName() + QStringLiteral(".mp4");
+    const QPointer<RecordingFileExport> guard(this);
+    const quint64 id = sharedUserFileSavePickerQueue().enqueue(
+        suggestedName, {QStringLiteral("MP4|.mp4")},
+        [guard, sourcePath](QString uri, int, QString error) mutable {
+            if (!guard || guard->m_destroying)
+                return;
+            QMetaObject::invokeMethod(
+                guard.data(),
+                [guard, uri = std::move(uri), sourcePath, error = std::move(error)]() mutable {
+                    if (!guard || guard->m_destroying)
+                        return;
+                    guard->m_pickerRequestId = 0;
+                    if (uri.isEmpty()) {
+                        guard->finish(error.isEmpty() ? Result::Cancelled : Result::Failed,
+                                      std::move(error));
+                        return;
+                    }
+                    const QString normalizedUri =
+                        normalizedDocumentViewPickerUri(std::move(uri), QStringLiteral("mp4"));
+                    if (normalizedUri.isEmpty()) {
+                        guard->finish(Result::Failed,
+                                      QStringLiteral("The selected destination is not writable"));
+                        return;
+                    }
+                    const QPointer<RecordingFileExport> exportGuard(guard);
+                    const quint64 exportId = sharedUserFileExportQueue().enqueue(
+                        sourcePath, normalizedUri,
+                        [exportGuard](bool succeeded, QString exportError) mutable {
+                            if (!exportGuard || exportGuard->m_destroying)
+                                return;
+                            QMetaObject::invokeMethod(
+                                exportGuard.data(),
+                                [exportGuard, succeeded,
+                                 exportError = std::move(exportError)]() mutable {
+                                    if (!exportGuard || exportGuard->m_destroying)
+                                        return;
+                                    exportGuard->m_exportRequestId = 0;
+                                    exportGuard->finish(succeeded ? Result::Succeeded
+                                                                  : Result::Failed,
+                                                        std::move(exportError));
+                                },
+                                Qt::QueuedConnection);
+                        });
+                    if (exportId == 0) {
+                        guard->finish(Result::Failed,
+                                      QStringLiteral("The user-file export could not be queued"));
+                        return;
+                    }
+                    guard->m_exportRequestId = exportId;
+                },
+                Qt::QueuedConnection);
+        });
+    if (id == 0) {
+        finish(Result::Failed, QStringLiteral("The document picker could not be opened"));
+        return false;
+    }
+    m_pickerRequestId = id;
+    return true;
+}
+
+bool RecordingFileExport::active() const noexcept {
+    return m_active;
+}
+
+void RecordingFileExport::finish(Result result, QString error) {
+    if (!m_active && result != Result::Failed)
+        return;
+    m_active = false;
+    m_pickerRequestId = 0;
+    m_exportRequestId = 0;
+    if (m_completion)
+        m_completion(result, std::move(error));
+}
+
+} // namespace snow_shot::platform::ohos

diff --git a/snow_shot/src/platform/ohos/userfileexportqueue.cpp b/snow_shot/src/platform/ohos/userfileexportqueue.cpp
new file mode 100644
index 0000000..0ed1985
--- /dev/null
+++ b/snow_shot/src/platform/ohos/userfileexportqueue.cpp
@@ -0,0 +1,155 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "snow_shot/platform/ohos/userfileexportqueue.h"
+
+#include <algorithm>
+#include <QDir>
+#include <QDebug>
+#include <QUrl>
+#include <utility>
+
+namespace snow_shot::platform::ohos {
+
+bool isDocumentViewPickerUri(const QString& path) {
+    return path.startsWith(QStringLiteral("file://docs/"), Qt::CaseSensitive);
+}
+
+QString documentViewPickerUriFromLocalPath(const QString& path) {
+    static const QString userStorageRoot = QStringLiteral("/storage/Users/currentUser/");
+    if (!path.startsWith(userStorageRoot, Qt::CaseSensitive))
+        return {};
+    const QString normalized = QDir::cleanPath(path);
+    if (!normalized.startsWith(userStorageRoot, Qt::CaseSensitive))
+        return {};
+    const QByteArray encoded = QUrl::toPercentEncoding(normalized, QByteArray("/"));
+    return QStringLiteral("file://docs") + QString::fromLatin1(encoded);
+}
+
+QString normalizedDocumentViewPickerUri(QString uri, QString extension) {
+    if (!isDocumentViewPickerUri(uri) || extension.isEmpty() ||
+        extension.contains(QLatin1Char('/')) || extension.contains(QLatin1Char('\\')) ||
+        extension.startsWith(QLatin1Char('.')))
+        return {};
+    const qsizetype separator = uri.lastIndexOf(QLatin1Char('/'));
+    if (separator < 0 || separator + 1 >= uri.size())
+        return {};
+    const qsizetype dot = uri.lastIndexOf(QLatin1Char('.'));
+    if (dot > separator + 1)
+        uri.truncate(dot);
+    else if (uri.endsWith(QLatin1Char('.')))
+        uri.chop(1);
+    return uri + QLatin1Char('.') + extension;
+}
+
+UserFileExportQueue& sharedUserFileExportQueue() {
+    static UserFileExportQueue queue;
+    return queue;
+}
+
+UserFileSavePickerQueue& sharedUserFileSavePickerQueue() {
+    static UserFileSavePickerQueue queue;
+    return queue;
+}
+
+quint64 UserFileExportQueue::enqueue(QString sourcePath, QString uri, Completion completion) {
+    if (sourcePath.isEmpty() || uri.isEmpty() || !completion)
+        return 0;
+
+    std::lock_guard lock(m_mutex);
+    if (m_nextId == 0)
+        return 0;
+    const quint64 id = m_nextId++;
+    m_pending.push_back(id);
+    m_entries.push_back(
+        {UserFileExportRequest{id, std::move(sourcePath), std::move(uri)}, std::move(completion)});
+    qInfo() << "SNOW_USER_FILE_EXPORT_ENQUEUE" << id;
+    return id;
+}
+
+std::vector<UserFileExportRequest> UserFileExportQueue::takePending() {
+    std::lock_guard lock(m_mutex);
+    std::vector<UserFileExportRequest> result;
+    result.reserve(m_pending.size());
+    for (const quint64 id : m_pending) {
+        const auto entry =
+            std::find_if(m_entries.begin(), m_entries.end(),
+                         [id](const Entry& candidate) { return candidate.request.id == id; });
+        if (entry != m_entries.end())
+            result.push_back(entry->request);
+    }
+    m_pending.clear();
+    return result;
+}
+
+bool UserFileExportQueue::complete(quint64 id, bool succeeded, QString error) {
+    Completion completion;
+    {
+        std::lock_guard lock(m_mutex);
+        const auto entry =
+            std::find_if(m_entries.begin(), m_entries.end(),
+                         [id](const Entry& candidate) { return candidate.request.id == id; });
+        if (entry == m_entries.end())
+            return false;
+        completion = std::move(entry->completion);
+        m_entries.erase(entry);
+        std::erase(m_pending, id);
+    }
+    completion(succeeded, std::move(error));
+    return true;
+}
+
+bool UserFileExportQueue::cancel(quint64 id) {
+    return complete(id, false, QStringLiteral("The user-file export was cancelled"));
+}
+
+quint64 UserFileSavePickerQueue::enqueue(QString suggestedName, QStringList suffixChoices,
+                                         Completion completion) {
+    if (suggestedName.isEmpty() || suffixChoices.isEmpty() || !completion)
+        return 0;
+    std::lock_guard lock(m_mutex);
+    if (m_nextId == 0)
+        return 0;
+    const quint64 id = m_nextId++;
+    m_pending.push_back(id);
+    m_entries.push_back(
+        {UserFileSavePickerRequest{id, std::move(suggestedName), std::move(suffixChoices)},
+         std::move(completion)});
+    return id;
+}
+
+std::vector<UserFileSavePickerRequest> UserFileSavePickerQueue::takePending() {
+    std::lock_guard lock(m_mutex);
+    std::vector<UserFileSavePickerRequest> result;
+    result.reserve(m_pending.size());
+    for (const quint64 id : m_pending) {
+        const auto entry =
+            std::find_if(m_entries.begin(), m_entries.end(),
+                         [id](const Entry& candidate) { return candidate.request.id == id; });
+        if (entry != m_entries.end())
+            result.push_back(entry->request);
+    }
+    m_pending.clear();
+    return result;
+}
+
+bool UserFileSavePickerQueue::complete(quint64 id, QString uri, int suffixIndex, QString error) {
+    Completion completion;
+    {
+        std::lock_guard lock(m_mutex);
+        const auto entry =
+            std::find_if(m_entries.begin(), m_entries.end(),
+                         [id](const Entry& candidate) { return candidate.request.id == id; });
+        if (entry == m_entries.end())
+            return false;
+        completion = std::move(entry->completion);
+        m_entries.erase(entry);
+        std::erase(m_pending, id);
+    }
+    completion(std::move(uri), suffixIndex, std::move(error));
+    return true;
+}
+
+bool UserFileSavePickerQueue::cancel(quint64 id) {
+    return complete(id, {}, -1, QStringLiteral("The user-file save was cancelled"));
+}
+
+} // namespace snow_shot::platform::ohos

