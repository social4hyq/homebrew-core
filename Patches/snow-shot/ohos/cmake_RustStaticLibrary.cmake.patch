+    set(oneValueArgs MANIFEST_DIR TOOLCHAIN)
+    set(multiValueArgs TARGETS PACKAGES OUTPUT_NAMES FEATURES ENVIRONMENT)
     cmake_parse_arguments(SNOW_RUST "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})
 
     if(NOT SNOW_RUST_MANIFEST_DIR)
