diff --git a/crates/fspy/src/unix/untracked.rs b/crates/fspy/src/unix/untracked.rs
new file mode 100644
index 0000000..fe41a6b
--- /dev/null
+++ b/crates/fspy/src/unix/untracked.rs
@@ -0,0 +1,29 @@
+//! A statically linked root command is spawned untracked (OHOS has no seccomp
+//! user-notification), so its file accesses are missing from the trace. A
+//! record too large for any frame makes the channel refuse the claim and set
+//! its CLOSED gate, which the receiver reports as lost records, so the task
+//! is not cached.
+
+use fspy_shared::ipc::channel::ChannelConf;
+use wincode::{SchemaWrite, config::DefaultConfig, error::WriteResult, io::Writer};
+
+struct Oversized;
+
+// SAFETY: the channel refuses a claim this large before `write` can run.
+unsafe impl SchemaWrite<DefaultConfig> for Oversized {
+    type Src = Self;
+
+    fn size_of(_src: &Self::Src) -> WriteResult<usize> {
+        Ok(u32::MAX as usize + 1)
+    }
+
+    fn write(_writer: impl Writer, _src: &Self::Src) -> WriteResult<()> {
+        Ok(())
+    }
+}
+
+pub fn mark_tracking_lost(conf: ChannelConf<'_>) {
+    if let Some(sender) = conf.sender(allocator_api2::alloc::Global) {
+        sender.send(&Oversized);
+    }
+}
