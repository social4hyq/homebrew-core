+pub(super) async fn show_platform_error(
+    app: OpenHarmonyApp,
+    window_id: i64,
+    message: &'static str,
+    detail: String,
+) {
+    let result = async {
+        WindowClient::new(&app)?
+            .show_prompt(WindowPromptRequest {
+                window_id,
+                message: message.into(),
+                detail: Some(detail),
+                level: 2,
+                buttons: vec!["OK".into()],
+                cancel_index: Some(0),
+                anchor: None,
+                appearance: None,
+            })
+            .await?;
+        Ok::<(), anyhow::Error>(())
+    }
+    .await;
+    if let Err(error) = result {
+        log::error!("Failed to show OHOS platform error: {error:#}");
+    }
+}
