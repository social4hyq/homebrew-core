+	srv, _ := newServer(t)
+	if err := CheckHealth(portOf(t, srv), 2*time.Second); err != nil {
+		t.Fatalf("healthy bridge reported as down: %v", err)
+	}
+
+	bad := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		http.Error(w, "nope", http.StatusInternalServerError)
+	}))
+	defer bad.Close()
+	if err := CheckHealth(portOf(t, bad), 2*time.Second); err == nil {
+		t.Error("a 500 response must not count as healthy")
+	}
+
+	notJSON := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = w.Write([]byte("hello"))
+	}))
+	defer notJSON.Close()
+	if err := CheckHealth(portOf(t, notJSON), 2*time.Second); err == nil {
+		t.Error("a non-JSON 200 must not count as healthy")
+	}
+
+	port := portOf(t, srv)
+	srv.Close()
+	if err := CheckHealth(port, 500*time.Millisecond); err == nil {
+		t.Error("a closed port must not count as healthy")
+	}
+}
+
+func healthOf(t *testing.T, cfg Config) (int, map[string]any) {
+	t.Helper()
+	srv := httptest.NewServer(NewHandler(cfg))
+	defer srv.Close()
+	resp, body := do(t, "GET", srv.URL+"/health", "", false)
+	out := map[string]any{}
+	if err := json.Unmarshal([]byte(body), &out); err != nil {
+		t.Fatalf("health body %q: %v", body, err)
+	}
+	return resp.StatusCode, out
+}
+
+func TestHealthReportsUsableCLI(t *testing.T) {
+	code, out := healthOf(t, Config{Secret: testSecret, MulticaHome: t.TempDir(), CLIPath: fakeCLI(t, t.TempDir()), Version: "1"})
+	if code != 200 || out["ok"] != true || out["cli_ok"] != true {
+		t.Fatalf("usable CLI: %d %v", code, out)
+	}
+}
+
+// After `brew upgrade` removes the keg the bridge was started from, the CLI
+// path it holds no longer exists. The bridge must say so instead of reporting
+// healthy while every /exec fails.
+func TestHealthReportsMissingCLI(t *testing.T) {
+	gone := filepath.Join(t.TempDir(), "removed-keg", "multica-cli")
+	code, out := healthOf(t, Config{Secret: testSecret, MulticaHome: t.TempDir(), CLIPath: gone, Version: "1"})
+	if code != http.StatusServiceUnavailable || out["ok"] != false || out["cli_ok"] != false {
+		t.Fatalf("missing CLI: %d %v", code, out)
+	}
+	if strings.Contains(toJSON(out), "removed-keg") {
+		t.Errorf("unauthenticated /health must not leak the CLI path: %v", out)
+	}
+}
+
+func TestHealthRejectsDirectoryAsCLI(t *testing.T) {
+	code, out := healthOf(t, Config{Secret: testSecret, MulticaHome: t.TempDir(), CLIPath: t.TempDir(), Version: "1"})
+	if code != http.StatusServiceUnavailable || out["cli_ok"] != false {
+		t.Fatalf("directory as CLI: %d %v", code, out)
+	}
+}
+
+func toJSON(v any) string {
+	b, _ := json.Marshal(v)
+	return string(b)
+}
+
+func TestCheckHealthRequiresUsableCLI(t *testing.T) {
+	// A bridge whose CLI path vanished is not healthy.
+	gone := httptest.NewServer(NewHandler(Config{Secret: testSecret, MulticaHome: t.TempDir(), CLIPath: filepath.Join(t.TempDir(), "gone"), Version: "1"}))
+	defer gone.Close()
+	if err := CheckHealth(portOf(t, gone), 2*time.Second); err == nil {
+		t.Error("a bridge with a missing CLI must not count as healthy")
+	}
+
+	// A bridge that predates the CLI check answers {"ok":true} with no cli_ok.
+	// It cannot vouch for its CLI, so the launcher must replace it once.
+	old := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = w.Write([]byte(`{"ok":true,"version":"0.9.0"}` + "\n"))
+	}))
+	defer old.Close()
+	if err := CheckHealth(portOf(t, old), 2*time.Second); err == nil {
+		t.Error("a bridge without cli_ok (pre-fix bridge) must not count as healthy")
+	}
+
+	// And a good one still passes.
+	srv, _ := newServer(t)
+	if err := CheckHealth(portOf(t, srv), 2*time.Second); err != nil {
+		t.Errorf("healthy bridge reported as down: %v", err)
+	}
+}
