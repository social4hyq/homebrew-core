+pub(super) fn retain_file_access(
+    file_access: Arc<super::file_access::FileAccess>,
+    executor: &BackgroundExecutor,
+    uris: Vec<String>,
+) {
+    if uris.is_empty() {
+        return;
+    }
+    executor
+        .spawn(async move {
+            if let Err(error) = file_access.remember(&uris, false) {
+                warn!("Could not save incoming file access: {error:#}");
+            }
+        })
+        .detach();
+}
