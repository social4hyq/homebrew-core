     // ---- overlays ----------------------------------------------------------
 
+    #[cfg(all(target_os = "linux", target_env = "ohos"))]
+    fn quit_allowed(&mut self, command: &str, confirmed: bool, window: &mut Window, cx: &mut Context<Self>) -> bool {
+        let active = active_terminal_count(&self.live);
+        if confirmed || active == 0 {
+            return true;
+        }
+        // A second close while a dialog is open must not stack another one.
+        if self.overlays.iter().any(|overlay| overlay.kind.modal_keys()) {
+            return false;
+        }
+        let title = if active == 1 { "1 agent or program is still running".into() } else { format!("{active} agents or programs are still running") };
+        self.confirm(
+            &title,
+            "Closing the window will not stop them. herdr-core keeps their terminals running; reopening Herdr reconnects to them.",
+            command,
+            json!({ "confirmed": true }),
+            window,
+            cx,
+        );
+        false
+    }
+
     fn confirm(&mut self, title: &str, detail: &str, command: &str, args: Value, window: &mut Window, cx: &mut Context<Self>) {
