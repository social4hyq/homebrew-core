@@ -130,6 +151,24 @@
 
 static std::atomic<Thread*> targetThread { nullptr };
 
+#if defined(__OHOS__)
+// See reportExecveBegin/reportExecveEnd in Threading.h for the full rationale:
+// Bun's own execve(2) interposer (c-bindings.cpp) reports its in-flight window
+// here so Thread::suspend() can wait it out before starting the signal
+// handshake below.
+static std::atomic<int> g_execveInFlightCount { 0 };
+
+void reportExecveBegin()
+{
+    g_execveInFlightCount.fetch_add(1, std::memory_order_seq_cst);
+}
+
+void reportExecveEnd()
+{
+    g_execveInFlightCount.fetch_sub(1, std::memory_order_seq_cst);
+}
+#endif
