@@ -216,3 +216,84 @@ void forceEnablePGM(uint16_t guardMallocRate)
 
 } } // namespace bmalloc::api
 
+
+// === T35 diagnostic (DNM): per-heap live/free census over all libpas heaps ===
+#include "pas_all_heaps.h"
+#include "pas_heap.h"
+#include "pas_heap_lock.h"
+#include "pas_heap_summary.h"
+
+#include <stdio.h>
+#include <string.h>
+
+static bool t35CensusCallback(pas_heap* heap, void*)
+{
+    pas_heap_summary summary = pas_heap_compute_summary(heap, pas_lock_is_held);
+    fprintf(stderr, "T35HEAP type=%p objsize=%zu allocated=%zu free=%zu committed=%zu meta=%zu\n",
+            static_cast<const void*>(heap->type), pas_heap_get_type_size(heap),
+            summary.allocated, summary.free, summary.committed, summary.meta);
+    return true;
+}
+
+extern "C" void bmallocDumpHeapCensusT35()
+{
+    // pas_all_heaps_for_each_heap asserts pas_heap_lock held.
+    pas_heap_lock_lock();
+    pas_all_heaps_for_each_heap(t35CensusCallback, nullptr);
+    pas_heap_lock_unlock();
+}
+
+// === T35 diagnostic v6 (DNM): live-object census of the common primitive heap.
+// Small objects (<=8KB) aggregated by exact size with a sampled first qword
+// (vtable candidate); large objects dumped individually. Resolves the
+// "tracker flat vs heap allocated grows" contradiction: shows which object
+// sizes accumulate and whether they carry C++ vtables.
+#include "bmalloc_heap_innards.h"
+
+#define T35_OBJ_MAX_SMALL 8192
+#define T35_OBJ_MAX_LARGE_LINES 500
+
+static unsigned long t35ObjCount[T35_OBJ_MAX_SMALL + 1];
+static unsigned long long t35ObjBytes[T35_OBJ_MAX_SMALL + 1];
+static uintptr_t t35ObjSampleV0[T35_OBJ_MAX_SMALL + 1];
+static unsigned long t35LargeCount;
+static unsigned long long t35LargeBytes;
+
+static bool t35ObjCensusCallback(pas_heap*, uintptr_t begin, size_t size, void*)
+{
+    if (size <= T35_OBJ_MAX_SMALL) {
+        t35ObjCount[size]++;
+        t35ObjBytes[size] += size;
+        if (!t35ObjSampleV0[size] && size >= 8)
+            t35ObjSampleV0[size] = *reinterpret_cast<uintptr_t*>(begin);
+    } else {
+        t35LargeCount++;
+        t35LargeBytes += size;
+        if (t35LargeCount <= T35_OBJ_MAX_LARGE_LINES) {
+            uintptr_t v0 = *reinterpret_cast<uintptr_t*>(begin);
+            uintptr_t v1 = *reinterpret_cast<uintptr_t*>(begin + 8);
+            fprintf(stderr, "T35OBJLARGE size=%zu v0=%#lx v1=%#lx\n", size,
+                    static_cast<unsigned long>(v0), static_cast<unsigned long>(v1));
+        }
+    }
+    return true;
+}
+
+extern "C" void bmallocDumpCommonPrimObjectsT35()
+{
+    memset(t35ObjCount, 0, sizeof(t35ObjCount));
+    memset(t35ObjBytes, 0, sizeof(t35ObjBytes));
+    memset(t35ObjSampleV0, 0, sizeof(t35ObjSampleV0));
+    t35LargeCount = 0;
+    t35LargeBytes = 0;
+    pas_heap_lock_lock();
+    pas_heap_for_each_live_object(&bmalloc_common_primitive_heap, t35ObjCensusCallback, nullptr, pas_lock_is_held);
+    pas_heap_lock_unlock();
+    for (size_t s = 1; s <= T35_OBJ_MAX_SMALL; s++) {
+        if (t35ObjCount[s])
+            fprintf(stderr, "T35OBJSIZE size=%zu count=%lu bytes=%llu v0=%#lx\n", s,
+                    t35ObjCount[s], t35ObjBytes[s],
+                    static_cast<unsigned long>(t35ObjSampleV0[s]));
+    }
+    fprintf(stderr, "T35OBJLARGE-TOTAL count=%lu bytes=%llu\n", t35LargeCount, t35LargeBytes);
+}
