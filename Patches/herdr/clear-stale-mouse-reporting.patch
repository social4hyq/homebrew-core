+    /// Clears mouse tracking left enabled by a pane program that exited without
+    /// restoring it, so reports stop reaching the shell that follows it.
+    pub fn clear_mouse_reporting(&self) {
+        let Ok(mut core) = self.core.lock() else {
+            return;
+        };
+        for mode in [
+            MODE_MOUSE_X10,
+            MODE_MOUSE_PRESS_RELEASE,
+            MODE_MOUSE_BUTTON_MOTION,
+            MODE_MOUSE_ANY_MOTION,
+        ] {
+            let _ = core.terminal.mode_set(mode, false);
+        }
+    }
