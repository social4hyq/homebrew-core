OHOS: add the OHOS Rust target, the native capture crate's CXX/sysroot
include injection, and an OCR cdylib nightly-bootstrap path. The static
staticlib TOOLCHAIN/ENVIRONMENT argument forwarding from an earlier revision
of this patch had no caller anywhere in the build graph and was dropped.

--- a/cmake/RustStaticLibrary.cmake
+++ b/cmake/RustStaticLibrary.cmake
@@ -118,6 +118,12 @@
         endif()
     elseif(WIN32)
         set(_target "${_windows_target}")
+    elseif(CMAKE_SYSTEM_NAME STREQUAL "OHOS")
+        if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
+            set(_target aarch64-unknown-linux-ohos)
+        else()
+            message(FATAL_ERROR "Snow Shot Rust components require an arm64 OHOS target")
+        endif()
     elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
         if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
             set(_target aarch64-unknown-linux-gnu)
@@ -249,6 +255,11 @@
     )
     snow_windows_rust_environment(_windows_cargo_environment "${SNOW_RUST_TARGET}")
     list(APPEND _cargo_environment ${_windows_cargo_environment})
+    if(OHOS)
+        list(APPEND _cargo_environment
+            "SNOW_CAPTURE_OHOS_CXX=${CMAKE_CXX_COMPILER}"
+            "SNOW_CAPTURE_OHOS_SYSROOT=${CMAKE_SYSROOT}")
+    endif()
     if(APPLE)
         set(_snow_rust_deployment_target "15.0")
         if(CMAKE_OSX_DEPLOYMENT_TARGET)
@@ -445,6 +456,9 @@
         "CARGO_TARGET_DIR=${SNOW_RUST_CARGO_TARGET_DIR}")
     if(SNOW_RUST_TOOLCHAIN)
         list(APPEND _cargo_environment "RUSTUP_TOOLCHAIN=${SNOW_RUST_TOOLCHAIN}")
+        if(OHOS AND SNOW_RUST_TOOLCHAIN MATCHES "^nightly")
+            list(APPEND _cargo_environment "RUSTC_BOOTSTRAP=1")
+        endif()
     endif()
     snow_windows_rust_environment(_windows_cargo_environment "${_rust_target}")
     list(APPEND _cargo_environment ${_windows_cargo_environment})
