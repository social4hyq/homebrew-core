+// A press on the close button must never turn into a tab.select for the tab
+// that is being closed. GPUI's on_mouse_down stop keeps `pressed` null, but a
+// mouse-up can still reach the tab item (notably from a touch tap): the item's
+// handler currently falls through to tab.select with a now-deleted id, which
+// surfaces as the bottom-right "tab.select failed / no such tab" toast.
+test("the close button's mouse-up does not select the tab being closed", () => {
+  const view = new Tabs();
+  view.init();
+  const root = view.render() as Element;
+  const find = (node: Element, id: string): Element | null => {
+    if (!node || typeof node !== "object" || !node.calls) return null;
+    if (node.calls.id?.[0] === id) return node;
+    for (const child of node.nodes) {
+      const hit = find(child, id);
+      if (hit) return hit;
+    }
+    return null;
+  };
+  const item = find(root, "tab-t2");
+  const close = find(root, "close-t2");
+  expect(item).not.toBeNull();
+  expect(close).not.toBeNull();
+  const cx = { stop_propagation() {}, notify() {} };
+  const ev = { click_count: 1 };
+  // Press on × (stop), click on × (tab.close), then the mouse-up bubbles to the
+  // tab item after the close has removed the tab from the model.
+  (close!.calls.on_mouse_down[1] as Handler)(ev, cx);
+  close!.calls.on_click[0](ev, cx);
+  (item!.calls.on_mouse_up[1] as Handler)(ev, cx);
+  expect(commands).toEqual(["tab.close"]);
+});
+
