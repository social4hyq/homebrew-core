OHOS (probe, temporary): record what the runtime reports as its own executable.
The HAP's module.json declares electron_exec_path_ohos =
/data/storage/el1/bundle/libs/arm64/electron, which the HAP does not ship, so
every spawn of process.execPath (the bundled CLI behind the MCP headless tools)
fails with ENOENT. This line records execPath, whether it exists, the resources
path and the versions, to hilog and to the shared Documents/GenOffice folder
(hilog forwarding differs across runtimes), so a build on another electron-ohos
release can be compared with the 40 one. Delete this patch afterwards.
diff --git a/apps/shell/src/main/index.ts b/apps/shell/src/main/index.ts
--- a/apps/shell/src/main/index.ts
+++ b/apps/shell/src/main/index.ts
@@ -1,3 +1,18 @@
+import { existsSync as execProbeExists, writeFileSync as execProbeWrite } from 'node:fs'
+
+{
+  const executable = process.execPath
+  const line =
+    `[exec-probe] execPath=${executable} exists=${execProbeExists(executable)} ` +
+    `resourcesPath=${process.resourcesPath} electron=${process.versions.electron ?? 'n/a'} ` +
+    `node=${process.versions.node}`
+  console.error(line)
+  try {
+    execProbeWrite('/storage/Users/currentUser/Documents/GenOffice/exec-probe.txt', `${line}\n`)
+  } catch (error) {
+    console.error(`[exec-probe] write failed: ${String(error)}`)
+  }
+}
 import { execSync } from 'node:child_process'
 import {
   cpSync,
