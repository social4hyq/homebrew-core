+    /// Call only on the N-API main thread.
+    pub fn update_ime_cursor_for(&self, window_id: i64, rect: ImeCursorRect) -> Result<()> {
+        self.with_ime_for(window_id, |ime| ime.try_update_cursor(rect))?
