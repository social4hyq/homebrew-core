+#ifndef SNOW_SHOT_PLATFORM_OHOS_TRAYCLOSE_P_H
+#define SNOW_SHOT_PLATFORM_OHOS_TRAYCLOSE_P_H
+#include <QCloseEvent>
+#include <QWidget>
+namespace snow_shot::platform::ohos {
+inline bool closeToTray(QWidget& window, QCloseEvent& event, bool trayEnabled) {
+    if (!trayEnabled)
+        return false;
+    event.ignore();
+    window.hide();
+    return true;
+}
+} // namespace snow_shot::platform::ohos
+#endif
