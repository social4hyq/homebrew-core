+++ b/snow_shot/i18n/core/snow_shot_core_en_US.ts
@@ -838,6 +838,10 @@ so every moment on screen can be expressed clearly and shared easily</translatio
     </context>
     <context>
         <name>SystemTrayController</name>
+        <message>
+            <source>Choose a destination in Files to save the recording.</source>
