OHOS (diagnostic, temporary): report main-process failures to hilog, and probe
what the app may do with a path the save dialog returns. The shell window opened
blank on a device with no output at all, so uncaught exceptions, unhandled
rejections, page load failures, renderer crashes and renderer console messages
go through console.error, and the start of the main bundle is logged.
diagnostics.ts is the first import of index.ts so it runs before every other
module. dialog.showSaveDialog is wrapped: right after it returns a path, each
kind of write the app does (direct write of the picked file, a temp file next to
it, the same from a child process) is tried and its errno logged as [diag-save].
The picked file's content is never changed and the probe's temp files are
removed again. Delete this patch once saving to a picked folder is understood.

diff --git a/apps/shell/src/main/diagnostics.ts b/apps/shell/src/main/diagnostics.ts
new file mode 100644
index 0000000..01759ef
--- /dev/null
+++ b/apps/shell/src/main/diagnostics.ts
@@ -0,0 +1,147 @@
+import { spawnSync } from 'node:child_process'
+import {
+  accessSync,
+  closeSync,
+  constants,
+  ftruncateSync,
+  openSync,
+  renameSync,
+  statSync,
+  unlinkSync,
+  writeSync,
+} from 'node:fs'
+import { dirname, extname, join } from 'node:path'
+import { app, dialog } from 'electron'
+
+// Imported first by index.ts so that it is in place before any other module of
+// the bundle runs. Everything goes through console.error, which electron-ohos
+// forwards to hilog under the "Electron" tag.
+console.error(
+  `[diag] main started packaged=${app.isPackaged} resourcesPath=${process.resourcesPath}`,
+)
+
+process.on('uncaughtException', (error) => {
+  console.error(`[diag] uncaughtException: ${error.stack ?? error.message}`)
+})
+
+process.on('unhandledRejection', (reason) => {
+  const text = reason instanceof Error ? (reason.stack ?? reason.message) : String(reason)
+  console.error(`[diag] unhandledRejection: ${text}`)
+})
+
+app.on('web-contents-created', (_event, contents) => {
+  contents.on('did-fail-load', (_failEvent, code, description, url, isMainFrame) => {
+    console.error(`[diag] did-fail-load ${code} ${description} ${url} mainFrame=${isMainFrame}`)
+  })
+  contents.on('render-process-gone', (_goneEvent, details) => {
+    console.error(`[diag] render-process-gone reason=${details.reason} exitCode=${details.exitCode}`)
+  })
+  contents.on('console-message', (details) => {
+    console.error(
+      `[diag] console ${details.level} ${details.sourceId}:${details.lineNumber} ${details.message}`,
+    )
+  })
+})
+
+// What may the app do with a path the system save dialog returned? The dialog
+// creates an empty file there and electron-ohos persists the access to it, but
+// the writers of the app (the xlsx sidecar, a child process, writes the target
+// directly; the docx save writes a temp file next to the target and renames it)
+// were refused. Probe each kind of operation right after the dialog returns and
+// log the errno of every step. The target's content is never changed: the one
+// write is done on an empty target only and truncated back at once, and the
+// sibling temp file has a hidden unique name and is removed again.
+function describeError(error: unknown): string {
+  const failure = error as NodeJS.ErrnoException
+  return `${failure.code ?? 'ERR'} (${failure.syscall ?? 'no syscall'}) ${failure.message}`
+}
+
+function step(name: string, run: () => void | string): void {
+  try {
+    console.error(`[diag-save] ${name}: ${run() ?? 'ok'}`)
+  } catch (error) {
+    console.error(`[diag-save] ${name}: FAILED ${describeError(error)}`)
+  }
+}
+
+// a child process of the app, like the sidecar: sh does the one operation
+function childStep(name: string, script: string, filePath: string): void {
+  const result = spawnSync('/bin/sh', ['-c', script, 'sh', filePath], {
+    encoding: 'utf8',
+    timeout: 5000,
+  })
+  const failure = result.error ? describeError(result.error) : '-'
+  const stderr = (result.stderr ?? '').trim().slice(0, 200)
+  console.error(
+    `[diag-save] ${name}: status=${result.status} signal=${result.signal} error=${failure} stderr=${stderr}`,
+  )
+}
+
+function probeSavePath(filePath: string): void {
+  const dir = dirname(filePath)
+  console.error(`[diag-save] picked dir=${dir} ext=${extname(filePath)} uid=${process.getuid?.()}`)
+  step('stat directory', () => {
+    const info = statSync(dir)
+    return `mode=${(info.mode & 0o7777).toString(8)} uid=${info.uid} gid=${info.gid}`
+  })
+  let size = -1
+  step('stat target', () => {
+    const info = statSync(filePath)
+    size = info.size
+    return `size=${info.size} mode=${(info.mode & 0o7777).toString(8)} uid=${info.uid}`
+  })
+  step('access W_OK on target', () => accessSync(filePath, constants.W_OK))
+  step('open target O_RDWR', () => closeSync(openSync(filePath, 'r+')))
+  if (size === 0) {
+    step('write 1 byte, then truncate back (empty target only)', () => {
+      const fd = openSync(filePath, 'r+')
+      try {
+        writeSync(fd, ' ')
+        ftruncateSync(fd, 0)
+      } finally {
+        closeSync(fd)
+      }
+    })
+  }
+  const temp = join(dir, `.genoffice-probe-${process.pid}.tmp`)
+  let current: string | null = null
+  step('create sibling temp (O_CREAT|O_EXCL)', () => {
+    closeSync(openSync(temp, 'wx'))
+    current = temp
+  })
+  if (current !== null) {
+    step('rename sibling temp inside the directory', () => {
+      renameSync(temp, `${temp}.2`)
+      current = `${temp}.2`
+    })
+  }
+  if (current !== null) step('unlink sibling temp', () => unlinkSync(current as string))
+  childStep('child process opens target for append', ': >> "$1"', filePath)
+  childStep(
+    'child process creates and removes a sibling temp',
+    't="${1%/*}/.genoffice-probe-child-$$.tmp"; : > "$t" && rm -f "$t"',
+    filePath,
+  )
+}
+
+type ShowSaveDialog = (...args: unknown[]) => Promise<{ canceled: boolean; filePath?: string }>
+
+try {
+  const showSaveDialog = dialog.showSaveDialog.bind(dialog) as unknown as ShowSaveDialog
+  Object.assign(dialog, {
+    showSaveDialog: async (...args: unknown[]) => {
+      const result = await showSaveDialog(...args)
+      if (!result.canceled && result.filePath) {
+        try {
+          probeSavePath(result.filePath)
+        } catch (error) {
+          console.error(`[diag-save] probe failed: ${describeError(error)}`)
+        }
+      }
+      return result
+    },
+  })
+  console.error('[diag-save] dialog.showSaveDialog is wrapped')
+} catch (error) {
+  console.error(`[diag-save] cannot wrap dialog.showSaveDialog: ${describeError(error)}`)
+}
