--- /dev/null
+++ b/apps/desktop/src/ohos-updater-stub.ts
@@ -0,0 +1,37 @@
+/**
+ * OHOS no-op AppUpdater: electron-updater has no openharmony target and its
+ * module-level autoUpdater throws on unknown platforms. The desktop update UI
+ * stays wired upstream-style but is permanently idle; upgrades go through
+ * Harmonybrew (brew upgrade deepseek-harness-desktop).
+ */
+
+import { EventEmitter } from 'node:events'
+import type { AppUpdater } from 'electron-updater'
+
+export class DesktopOhosNoopUpdater extends EventEmitter {
+  autoDownload = false
+  autoInstallOnAppQuit = false
+  autoRunAppAfterInstall = false
+  allowPrerelease = false
+  allowDowngrade = false
+  fullChangelog = false
+  channel: string | null = null
+  logger = null
+
+  setFeedURL(_options: unknown): void {}
+  checkForUpdates(): null {
+    return null
+  }
+  downloadUpdate(): never {
+    throw new Error('desktop updates are not available on OpenHarmony; use brew upgrade')
+  }
+  quitAndInstall(): never {
+    throw new Error('desktop updates are not available on OpenHarmony; use brew upgrade')
+  }
+}
+
+export const isOhos = (process.platform as string) === 'openharmony'
+
+export function createOhosUpdater(): AppUpdater {
+  return new DesktopOhosNoopUpdater() as unknown as AppUpdater
+}
