+bool ScreenshotSelectorServiceClient::releaseCache() {
+    m_ohosWindowRects.clear();
+    m_ohosDisplays.clear();
+    return true;
+}
+
+void ScreenshotSelectorServiceClient::destroyService() {
+    static_cast<void>(releaseCache());
+}
+
+bool ScreenshotSelectorServiceClient::startRefresh(quint64 requestId,
+                                                   const QVector<std::uintptr_t>& excludedHwnds) {
+    Q_UNUSED(excludedHwnds);
+    m_ohosDisplays.clear();
+    m_ohosWindowRects = enumeratedWindowRects(m_ohosDisplays);
+    qInfo() << "SNOW_OHOS_SELECTOR_REFRESH" << requestId << m_ohosWindowRects.size();
+    QMetaObject::invokeMethod(
+        this,
+        snow_shot::runtime::trackRuntimeWork([client = this, requestId]() {
+            if (client->m_callbacks.refreshFinished)
+                client->m_callbacks.refreshFinished(requestId, true);
+        }),
+        Qt::QueuedConnection);
+    return true;
+}
+
+bool ScreenshotSelectorServiceClient::startRefreshWithDisplays(
+    quint64 requestId, const QVector<std::uintptr_t>& excludedHwnds,
+    const QVector<CapturedDisplayModel>& displays) {
+    Q_UNUSED(excludedHwnds);
+    m_ohosDisplays = displays;
+    m_ohosWindowRects = enumeratedWindowRects(m_ohosDisplays);
+    qInfo() << "SNOW_OHOS_SELECTOR_REFRESH" << requestId << m_ohosWindowRects.size()
+            << m_ohosDisplays.size();
+    QMetaObject::invokeMethod(
+        this,
+        snow_shot::runtime::trackRuntimeWork([client = this, requestId]() {
+            if (client->m_callbacks.refreshFinished)
+                client->m_callbacks.refreshFinished(requestId, true);
+        }),
+        Qt::QueuedConnection);
+    return true;
+}
+
+bool ScreenshotSelectorServiceClient::startHitTest(quint64 epoch, quint64 requestId,
+                                                   quint64 generation, const QPoint& point,
+                                                   ScreenshotSelectorHitTestMode mode,
+                                                   quint32 displayId) {
+    ScreenshotSelectorResult result;
+    result.epoch = epoch;
+    result.requestId = requestId;
+    result.generation = generation;
+    result.point = point;
+    result.mode = mode;
+    result.phase = ScreenshotSelectorResultPhase::Initial;
+    result.stopReason = ScreenshotSelectorStopReason::Complete;
+    result.displayId = displayId != 0 ? displayId : static_cast<quint32>(defaultDisplayId());
+    for (const QRect& rect : std::as_const(m_ohosWindowRects)) {
+        if (rect.contains(point)) {
+            result.rects.push_back(QRectF(rect));
+            break;
+        }
+    }
+    result.ok = !result.rects.isEmpty();
+    QMetaObject::invokeMethod(
+        this,
+        snow_shot::runtime::trackRuntimeWork([client = this, result]() {
+            if (client->m_callbacks.resultReady)
+                client->m_callbacks.resultReady(result);
+        }),
+        Qt::QueuedConnection);
+    return true;
+}
