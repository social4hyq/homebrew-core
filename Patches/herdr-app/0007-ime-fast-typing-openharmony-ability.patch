+#[napi]
+pub fn is_desktop_device() -> bool {
+    cfg!(desktop)
+        || crate::version::device_type().is_some_and(|kind| {
+            let kind = kind.trim();
+            kind.eq_ignore_ascii_case("2in1") || kind.eq_ignore_ascii_case("pc")
+        })
+}
