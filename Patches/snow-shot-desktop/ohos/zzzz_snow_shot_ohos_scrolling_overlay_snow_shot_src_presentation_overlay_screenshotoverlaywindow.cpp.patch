+void ScreenshotOverlayWindow::setScrollingCaptureOverlayHidden(bool hidden) {
+#if defined(Q_OS_OHOS) || defined(Q_OS_HARMONY)
+    if (m_scrollingCaptureOverlayHidden == hidden)
+        return;
+    m_scrollingCaptureOverlayHidden = hidden;
+    if (hidden) {
+        // The frozen overlay is opaque on OHOS: leaving it on screen would hide
+        // the application being captured and make the captured frames a copy of
+        // the overlay itself. Hiding it exposes the live window to both the user
+        // and the capture pipeline while the toolbar and thumbnail keep running.
+        hide();
+        return;
+    }
+    show();
+    raise();
+#else
+    Q_UNUSED(hidden);
+#endif
+}
+
 void ScreenshotOverlayWindow::beginScrollingThumbnail(const QRect& localSelection,
                                                       ScreenshotScrollingRecognitionMode mode,
                                                       const QSize& captureViewportSize) {
     clearScrollingResultPreview();
     if (m_scrollingThumbnail == nullptr) {
+#if defined(Q_OS_OHOS) || defined(Q_OS_HARMONY)
+        // The scrolling overlay hides itself on OHOS, so the preview cannot be a
+        // child window of it. Use a top-level frameless window instead: the OHOS
+        // QPA promotes it to its own top-most window that survives the overlay.
+        m_scrollingThumbnail = new ScreenshotScrollingThumbnailWidget();
+        m_scrollingThumbnail->setWindowFlags(Qt::Window | Qt::FramelessWindowHint |
+                                             Qt::WindowStaysOnTopHint |
+                                             Qt::WindowDoesNotAcceptFocus);
+#else
         m_scrollingThumbnail = new ScreenshotScrollingThumbnailWidget(*this);
         // Configure once, before creating the native surface. Reparenting or changing
         // QWidget window flags during capture would hide/recreate visible windows.
         m_scrollingThumbnail->setWindowFlags(Qt::Tool | Qt::FramelessWindowHint |
                                              Qt::WindowStaysOnTopHint |
                                              Qt::WindowDoesNotAcceptFocus);
+#endif
         m_scrollingThumbnail->setAttribute(Qt::WA_ShowWithoutActivating);
         m_scrollingThumbnail->setAttribute(Qt::WA_TranslucentBackground);
         m_scrollingThumbnail->hide();
