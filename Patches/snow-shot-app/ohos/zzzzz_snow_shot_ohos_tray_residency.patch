+#include <atomic>
+
+namespace snow_shot::platform::ohos {
+// ArkTS and the Qt event loop run on different threads. Keep the bridge state
+// independent of QApplication construction and never block either event loop.
+inline std::atomic_bool trayEnabled{true};
+inline std::atomic_bool trayAvailable{false};
+} // namespace snow_shot::platform::ohos
