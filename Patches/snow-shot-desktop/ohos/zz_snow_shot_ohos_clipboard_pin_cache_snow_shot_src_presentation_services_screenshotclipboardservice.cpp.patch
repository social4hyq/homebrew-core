+        QMutexLocker locker(&mutex());
+        latestPng() = png;
+        const auto serial = ++publishSerial();
+        qWarning("SNOW_CLIP_CACHE publish bytes=%d serial=%llu", static_cast<int>(png.size()),
+                 static_cast<unsigned long long>(serial));
+        // Qt's OHOS clipboard write crosses the JS thread; the pasteboard change
+        // counter can still describe the previous owner when setMimeData returns.
+        // Refresh it after the write settles, but never after a newer publication.
+        QTimer::singleShot(250, QCoreApplication::instance(), [serial] {
+            const auto count = pasteboardChangeCount();
+            using namespace snow_shot::presentation::clipboard_cache;
+            QMutexLocker locker(&mutex());
+            if (serial != publishSerial())
+                return;
+            recordedChangeCount() = count;
+            qWarning("SNOW_CLIP_CACHE stored count=%u serial=%llu", count,
+                     static_cast<unsigned long long>(serial));
+        });
+    }
+#endif
+    return attempt;
 }
