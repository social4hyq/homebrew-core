--- a/src/runtime/dns_jsc/dns.rs
+++ b/src/runtime/dns_jsc/dns.rs
@@ -5171,6 +5171,35 @@ impl Resolver {
         resolver.do_lookup(name.slice(), port, options, global_this)
     }
 
+    /// OHOS dual-stack getaddrinfo times out on AAAA when no global IPv6 (2000::/3); ULA fc00::/7 does not count.
+    #[cfg(target_env = "ohos")]
+    fn has_global_ipv6() -> bool {
+        const PATH: &[u8] = b"/proc/net/if_inet6\0";
+        let fd = unsafe {
+            libc::open(PATH.as_ptr().cast::<core::ffi::c_char>(), libc::O_RDONLY | libc::O_CLOEXEC)
+        };
+        if fd < 0 {
+            return false;
+        }
+        let mut buf = [0u8; 4096];
+        let n = unsafe { libc::read(fd, buf.as_mut_ptr().cast::<core::ffi::c_void>(), buf.len()) };
+        unsafe { libc::close(fd) };
+        if n <= 0 {
+            return false;
+        }
+        bun_core::strings::split(&buf[..n as usize], b"\n").any(|line| {
+            if line.is_empty() {
+                return false;
+            }
+            matches!(line[0], b'2' | b'3')
+        })
+    }
+
+    #[cfg(not(target_env = "ohos"))]
+    fn has_global_ipv6() -> bool {
+        true
+    }
+
     pub(crate) fn do_lookup(
         &self,
         name: &[u8],
@@ -5192,6 +5221,11 @@ impl Resolver {
         }
 
         let mut opts = options;
+        // OHOS: dual-stack (AF_UNSPEC) getaddrinfo times out on AAAA without a routable IPv6 address, so force IPv4 when the caller left the family unspecified.
+        #[cfg(target_env = "ohos")]
+        if opts.family == bun_dns::Family::Unspecified && !Self::has_global_ipv6() {
+            opts.family = bun_dns::Family::Inet;
+        }
         let mut backend = opts.backend;
         let normalized = normalize_dns_name(name, &mut backend);
         opts.backend = backend;
