 const errorCode = (error: unknown) => (error as NodeJS.ErrnoException).code ?? ''
+
+/// OpenHarmony's save dialog grants this app access to the picked file only:
+/// a temp file next to it is refused with EPERM, so the atomic path cannot run
+/// for a picked path at all. Writing the picked file in place is the one write
+/// the grant allows, and the caller picked that path explicitly.
+const pickedPathRefusesSibling = (error: unknown) =>
+  (process.platform as string) === 'openharmony' &&
+  (errorCode(error) === 'EPERM' || errorCode(error) === 'EACCES')
 const isRetryableRename = (error: unknown) => RETRYABLE_RENAME_CODES.has(errorCode(error))
 const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))
 const sleepSync = (ms: number) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms)
