+    let polling = false;
+    const timer = setInterval(() => {
+      if (win.isDestroyed()) {
+        stopLogTail();
+        return;
+      }
+      if (polling) return;
+      polling = true;
+      void (async () => {
+        let { text, size } = await host.readRange(logPath, position);
+        // File rotated/truncated — restart from the new beginning.
+        if (size < position) {
+          position = 0;
+          ({ text, size } = await host.readRange(logPath, 0));
+        }
+        if (text.length > 0) {
+          position += Buffer.byteLength(text, "utf-8");
+          sendLines(win, text);
