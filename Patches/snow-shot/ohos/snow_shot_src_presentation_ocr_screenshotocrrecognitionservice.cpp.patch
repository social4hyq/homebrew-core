+
+QByteArray recognizeInProcess(SnowOcrHandle* handle, const QImage& source) {
+    QByteArray payload;
+    if (handle == nullptr || source.isNull() ||
+        !screenshotOcrImageWithinPixelLimit(source.size())) {
+        snow_shot::ocr::protocol::appendU8(payload, 0);
+        snow_shot::ocr::protocol::appendString(
+            payload, QStringLiteral("invalid in-process OCR image or engine"));
+        return payload;
+    }
+
+    const QImage bgr = source.convertToFormat(QImage::Format_BGR888);
+    if (bgr.isNull()) {
+        snow_shot::ocr::protocol::appendU8(payload, 0);
+        snow_shot::ocr::protocol::appendString(payload,
+                                               QStringLiteral("cannot convert OCR image to BGR24"));
+        return payload;
+    }
+    const qsizetype rowBytes = static_cast<qsizetype>(bgr.width()) * 3;
+    const qsizetype totalBytes = rowBytes * bgr.height();
+    QByteArray packed;
+    packed.resize(totalBytes);
+    for (int row = 0; row < bgr.height(); ++row) {
+        std::memcpy(packed.data() + static_cast<qsizetype>(row) * rowBytes, bgr.constScanLine(row),
+                    static_cast<size_t>(rowBytes));
+    }
+
+    char* resultRaw = nullptr;
+    char* errorRaw = nullptr;
+    const int code =
+        snow_ocr_recognize(handle, reinterpret_cast<const uint8_t*>(packed.constData()),
+                           static_cast<size_t>(packed.size()), static_cast<uint32_t>(bgr.width()),
+                           static_cast<uint32_t>(bgr.height()), &resultRaw, &errorRaw);
+    qInfo() << "SNOW_OCR_INPROCESS_RECOGNIZE_RETURN" << code << bgr.size() << (resultRaw != nullptr)
+            << (errorRaw != nullptr);
+    const auto freeString = [](char* value) { snow_ocr_string_free(value); };
+    const std::unique_ptr<char, decltype(freeString)> resultText(resultRaw, freeString);
+    const std::unique_ptr<char, decltype(freeString)> errorText(errorRaw, freeString);
+    if (code != 0 || resultText == nullptr) {
+        snow_shot::ocr::protocol::appendU8(payload, 0);
+        snow_shot::ocr::protocol::appendString(
+            payload, errorText != nullptr ? QString::fromUtf8(errorText.get())
+                                          : QStringLiteral("in-process OCR failed"));
+        return payload;
+    }
+
+    QJsonParseError parseError;
+    const QJsonDocument document =
+        QJsonDocument::fromJson(QByteArray(resultText.get()), &parseError);
+    if (parseError.error != QJsonParseError::NoError || !document.isArray() ||
+        document.array().size() > 100000) {
+        snow_shot::ocr::protocol::appendU8(payload, 0);
+        snow_shot::ocr::protocol::appendString(payload,
+                                               QStringLiteral("invalid in-process OCR response"));
+        return payload;
+    }
+
+    const QJsonArray lines = document.array();
+    qInfo() << "SNOW_OCR_INPROCESS_RESPONSE_LINES" << lines.size();
+    QByteArray encodedLines;
+    for (const QJsonValue& value : lines) {
+        const QJsonObject line = value.toObject();
+        const QJsonArray points = line.value(QStringLiteral("points")).toArray();
+        const QString text = line.value(QStringLiteral("text")).toString();
+        const double score = line.value(QStringLiteral("score")).toDouble(-1.0);
+        if (text.isEmpty() || points.size() != 4 || !std::isfinite(score)) {
+            payload.clear();
+            snow_shot::ocr::protocol::appendU8(payload, 0);
+            snow_shot::ocr::protocol::appendString(payload,
+                                                   QStringLiteral("invalid OCR line geometry"));
+            return payload;
+        }
+        snow_shot::ocr::protocol::appendString(encodedLines, text);
+        appendF32(encodedLines, static_cast<float>(score));
+        for (const QJsonValue& pointValue : points) {
+            const QJsonArray point = pointValue.toArray();
+            if (point.size() != 2 || !point.at(0).isDouble() || !point.at(1).isDouble()) {
+                payload.clear();
+                snow_shot::ocr::protocol::appendU8(payload, 0);
+                snow_shot::ocr::protocol::appendString(payload,
+                                                       QStringLiteral("invalid OCR point"));
+                return payload;
+            }
+            const double x = point.at(0).toDouble();
+            const double y = point.at(1).toDouble();
+            if (!std::isfinite(x) || !std::isfinite(y)) {
+                payload.clear();
+                snow_shot::ocr::protocol::appendU8(payload, 0);
+                snow_shot::ocr::protocol::appendString(payload,
+                                                       QStringLiteral("non-finite OCR point"));
+                return payload;
+            }
+            appendF32(encodedLines, static_cast<float>(x));
+            appendF32(encodedLines, static_cast<float>(y));
+        }
+    }
+    snow_shot::ocr::protocol::appendU8(payload, 1);
+    snow_shot::ocr::protocol::appendString(payload, QStringLiteral("cpu"));
+    snow_shot::ocr::protocol::appendU32(payload, static_cast<quint32>(lines.size()));
+    payload.append(encodedLines);
+    return payload;
+}
