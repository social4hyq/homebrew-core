OHOS: delegate the desktop signing and installation workflow to hap-installer.

diff --git a/scripts/install-desktop-ohos.sh b/scripts/install-desktop-ohos.sh
new file mode 100755
index 0000000..decbefb
--- /dev/null
+++ b/scripts/install-desktop-ohos.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+usage() {
+  printf '%s\n' 'Usage: multica install-desktop' '' \
+    'Sign the bottled desktop HAP with your Huawei Developer account, install it' \
+    'on a connected device, and start the application.'
+}
+
+if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
+  usage
+  exit 0
+fi
+if [[ $# -ne 0 ]]; then
+  usage >&2
+  exit 2
+fi
+
+: "${MULTICA_UNSIGNED_HAP:?multica formula did not set the unsigned HAP path}"
+if [[ ! -f "$MULTICA_UNSIGNED_HAP" ]]; then
+  printf 'multica install-desktop: unsigned HAP not found: %s\n' "$MULTICA_UNSIGNED_HAP" >&2
+  exit 1
+fi
+if ! command -v hap-installer >/dev/null 2>&1; then
+  printf '%s\n' 'multica install-desktop: hap-installer is required; install it with brew install hap-installer.' >&2
+  exit 1
+fi
+
+exec hap-installer \
+  --hap "$MULTICA_UNSIGNED_HAP" \
+  --bundle-id com.huawei.ohos_electron \
+  --app-name MulticaSigning \
+  --module electron \
+  --ability EntryAbility
diff --git a/scripts/multica-dispatch-ohos.sh b/scripts/multica-dispatch-ohos.sh
new file mode 100755
index 0000000..c99730f
--- /dev/null
+++ b/scripts/multica-dispatch-ohos.sh
@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ "${1:-}" == "install-desktop" ]]; then
+  shift
+  exec "$MULTICA_INSTALL_DESKTOP" "$@"
+fi
+
+exec "$MULTICA_REAL_CLI" "$@"
