diff --git a/pnpm-workspace.yaml b/pnpm-workspace.yaml
index 02bb4f0..8043979 100644
--- a/pnpm-workspace.yaml
+++ b/pnpm-workspace.yaml
@@ -18,6 +18,10 @@ overrides:
   'extract-zip>yauzl': '3.4.0'
   '@deepseek-ai/cosmokit': 'link:vendor/cosmokit'
   '@deepseek-ai/schemastery': 'link:vendor/schemastery'
+  # OHOS: esbuild 0.21.5 的 postinstall 硬 fail（0.28.2 起原生认 openharmony）。
+  'esbuild@0.21.5': '0.28.2'
+  # OHOS: lightningcss 上游无 openharmony 子包，override 到社区 port（同名版本线 1.33.0）。
+  'lightningcss': 'npm:@ohos-npm-ports/lightningcss@1.33.0-4'
 
 peerDependencyRules:
   allowedVersions:
@@ -28,9 +32,14 @@ peerDependencyRules:
 # is a hard install error). Every such package MUST be listed; we deny by
 # default and only allow scripts we need. esbuild (native binary) and lefthook
 # (git hooks) genuinely need theirs.
+# OHOS: @pnpm/exe 无 openharmony-arm64 原生二进制，保持 JS 版 pnpm 不做版本切换。
+managePackageManagerVersions: false
+pmOnFail: ignore
+
 allowBuilds:
   esbuild: true
-  lefthook: true
+  # OHOS: lefthook 无 openharmony-arm64 平台包（git hooks 构建期不需要），deny。
+  lefthook: false
   # Cross-platform boundary for the persistent PTY backend, including ConPTY on Windows.
   node-pty: true
   # Pulled in by @earendil-works/pi-ai (optional LLM API backend). pnpm lists
@@ -43,7 +52,9 @@ allowBuilds:
   # Consumers pin 3.1.1: Koffi 3.3.2's source build fails under GCC 13 when
   # optional prebuilts are omitted. Upgrade all consumers together after the
   # replacement passes that build and the release packed-install check.
-  koffi: true
+  # OHOS: koffi 的全部调用点都是 Win32-only 死代码（fs-local/win32、sandbox-windows-acl 等），
+  # 源码构建在 aarch64 下必然失败；运行时由 Patches 里的 windows-acl stub 兜底。
+  koffi: false
   # The Python runtime deploy includes the reviewed workspace postinstall that
   # restores the executable bit on node-pty's macOS spawn helper.
   '@deepseek-ai/dsh-subprocess-local@file:packages/subprocess/subprocess-local': true
@@ -110,6 +121,8 @@ minimumReleaseAgeExclude:
   # Stagehand 4.4.0 carries the reviewed zod 4.6.6 pin; install it without the release-age wait.
   - '@browserbasehq/stagehand@4.4.0'
 patchedDependencies:
+  # OHOS: koffi 源码构建（cnoke/cmake）需要 c++20 强制 + statx 门控（移植自官方 core 的 0003 patch）。
+  'koffi@3.1.1': patches/koffi@3.1.1.patch
   '@botiverse/oar@0.67.0': patches/@botiverse__oar@0.67.0.patch
   '@earendil-works/pi-ai@1.3.0': patches/@earendil-works__pi-ai@1.3.0.patch
   '@electron/osx-sign@1.3.3': patches/@electron__osx-sign@1.3.3.patch
