+                         [id](const Entry& candidate) { return candidate.request.id == id; });
+        if (entry != m_entries.end())
+            result.push_back(entry->request);
+    }
+    m_pending.clear();
+    return result;
+}
+
+bool UserFileSavePickerQueue::complete(quint64 id, QString uri, int suffixIndex, QString error) {
+    Completion completion;
+    {
+        std::lock_guard lock(m_mutex);
+        const auto entry =
+            std::find_if(m_entries.begin(), m_entries.end(),
+                         [id](const Entry& candidate) { return candidate.request.id == id; });
+        if (entry == m_entries.end())
+            return false;
+        completion = std::move(entry->completion);
+        m_entries.erase(entry);
+        std::erase(m_pending, id);
+    }
+    completion(std::move(uri), suffixIndex, std::move(error));
+    return true;
+}
+
+bool UserFileSavePickerQueue::cancel(quint64 id) {
+    return complete(id, {}, -1, QStringLiteral("The user-file save was cancelled"));
+}
