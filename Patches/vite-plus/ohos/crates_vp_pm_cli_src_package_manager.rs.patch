+fn dist_tag_lookup_urls(
+    package_manager_type: PackageManagerType,
+    tag: &str,
+    npm_config: &NpmConfig,
+) -> Vec<Str> {
+    // The registry's `latest` may not be ported to OHOS yet; resolve the port's
+    // packument while retaining the usual registry-scoped cache behavior.
+    #[cfg(target_env = "ohos")]
+    if tag == "latest"
+        && let Some(package) = ohos_port_package(package_manager_type)
+    {
+        return vec![npm_config.package_metadata_url(package).into()];
+    }
+    dist_tag_packages(package_manager_type)
+        .iter()
+        .map(|package_name| npm_config.package_version_url(package_name, tag))
+        .collect()
+}
+
+async fn fetch_resolved_dist_tag(
+    package_manager_type: PackageManagerType,
+    tag: &str,
+    urls: &[Str],
+    npm_config: &NpmConfig,
+) -> Result<Str, Error> {
+    #[cfg(target_env = "ohos")]
+    if tag == "latest"
+        && let Some(package) = ohos_port_package(package_manager_type)
+        && let Some(ported) = fetch_ported_versions(package_manager_type, npm_config).await?
+    {
+        return ported.iter().max().map(|v| Str::from(v.to_string())).ok_or_else(|| {
+            Error::PackageManagerVersionNotFound {
+                name: package_manager_type.to_string().into(),
+                version: tag.into(),
+                url: npm_config.package_metadata_url(package).into(),
+            }
+        });
+    }
+    fetch_dist_tag_version(package_manager_type, tag, urls, npm_config).await
+}
