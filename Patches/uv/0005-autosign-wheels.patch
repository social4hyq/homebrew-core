+/// OHOS-only: the kernel refuses to `dlopen` an ELF with no `.codesign`
+/// section, so wheel-bundled native modules are unusable unsigned. Sign every
+/// `.so` under the unpacked-wheel source before linking: every link mode then
+/// propagates signed bytes and the wheel cache stays signed. Idempotent;
+/// failures are non-fatal.
+#[cfg(target_env = "ohos")]
+fn ohos_sign_wheel_files(wheel_src: &Path) {
+    let debug = std::env::var_os("OHOS_SIGN_DEBUG").is_some();
+    for entry in walkdir::WalkDir::new(wheel_src) {
+        let Ok(entry) = entry else { continue };
+        if !entry.file_type().is_file() {
+            continue;
+        }
+        let Some(name) = entry.file_name().to_str() else {
+            continue;
+        };
+        if !(name.ends_with(".so") || name.contains(".so.")) {
+            continue;
+        }
+        let path = entry.path();
+        match std::fs::read(path) {
+            Ok(bytes) if ohos_sign::has_codesign_section(&bytes) => {
+                if debug {
+                    eprintln!("[uv-ohos-sign] {}: already signed", path.display());
+                }
+            }
+            Ok(_) => {
+                let result =
+                    std::panic::catch_unwind(|| {
+                        ohos_sign::sign_file_atomic(&path.to_string_lossy(), true)
+                    });
+                if debug {
+                    match result {
+                        Ok(Ok(())) => eprintln!("[uv-ohos-sign] {}: signed", path.display()),
+                        Ok(Err(err)) => {
+                            eprintln!("[uv-ohos-sign] {}: sign failed: {err}", path.display())
+                        }
+                        Err(_) => eprintln!("[uv-ohos-sign] {}: sign panicked", path.display()),
+                    }
+                }
+            }
+            Err(_) => {}
+        }
+    }
+}
