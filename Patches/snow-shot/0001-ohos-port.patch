+QImage readPixelMap(OH_PixelmapNative* pixelmap) {
+    OH_Pixelmap_ImageInfo* rawInfo = nullptr;
+    if (!pixelmap || OH_PixelmapImageInfo_Create(&rawInfo) != IMAGE_SUCCESS)
+        return {};
+    std::unique_ptr<OH_Pixelmap_ImageInfo, decltype(&OH_PixelmapImageInfo_Release)> info(
+        rawInfo, OH_PixelmapImageInfo_Release);
+    uint32_t width = 0;
+    uint32_t height = 0;
+    uint32_t stride = 0;
+    int32_t format = PIXEL_FORMAT_UNKNOWN;
+    if (OH_PixelmapNative_GetImageInfo(pixelmap, info.get()) != IMAGE_SUCCESS ||
+        OH_PixelmapImageInfo_GetWidth(info.get(), &width) != IMAGE_SUCCESS ||
+        OH_PixelmapImageInfo_GetHeight(info.get(), &height) != IMAGE_SUCCESS ||
+        OH_PixelmapImageInfo_GetRowStride(info.get(), &stride) != IMAGE_SUCCESS ||
+        OH_PixelmapImageInfo_GetPixelFormat(info.get(), &format) != IMAGE_SUCCESS || !width ||
+        !height || width > static_cast<uint32_t>(std::numeric_limits<int>::max()) ||
+        height > static_cast<uint32_t>(std::numeric_limits<int>::max()))
+        return {};
+    QImage::Format qtFormat = QImage::Format_Invalid;
+    if (format == PIXEL_FORMAT_BGRA_8888)
+        qtFormat = QImage::Format_ARGB32;
+    else if (format == PIXEL_FORMAT_RGBA_8888)
+        qtFormat = QImage::Format_RGBA8888;
+    else if (format == PIXEL_FORMAT_RGB_888)
+        qtFormat = QImage::Format_RGB888;
+    const int bytesPerPixel = qtFormat == QImage::Format_RGB888 ? 3 : 4;
+    const auto minimumStride = static_cast<uint64_t>(width) * static_cast<uint64_t>(bytesPerPixel);
+    if (qtFormat == QImage::Format_Invalid || stride < minimumStride)
+        return {};
+    const size_t byteCount = static_cast<size_t>(stride) * height;
+    std::vector<uint8_t> bytes(byteCount);
+    size_t capacity = byteCount;
+    if (OH_PixelmapNative_ReadPixels(pixelmap, bytes.data(), &capacity) != IMAGE_SUCCESS ||
+        capacity < byteCount)
+        return {};
+    return QImage(bytes.data(), static_cast<int>(width), static_cast<int>(height),
+                  static_cast<int>(stride), qtFormat)
+        .copy();
+}
+
+class OhosWindowCapture final : public live_window_detail::NativeWindowCapture {
+  public:
+    explicit OhosWindowCapture(LiveWindowTarget target) : m_target(std::move(target)) {}
+
+    bool receive(live_window_detail::NativeCaptureFrame* frame) override {
+        if (!frame)
+            return false;
+        constexpr auto framePeriod = std::chrono::milliseconds(200);
+        const auto waitUntil = std::chrono::steady_clock::now() + framePeriod;
+        while (!m_cancelled.load() && std::chrono::steady_clock::now() < waitUntil)
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        if (m_cancelled.load())
+            return false;
+
+        const auto windowId = static_cast<int32_t>(m_target.nativeId);
+        QRect bounds;
+        const auto lookup = windowLookup(windowId);
+        if (lookup != ohos_live_window_detail::WindowLookupState::Visible) {
+            qWarning() << (lookup == ohos_live_window_detail::WindowLookupState::Unavailable
+                               ? "SNOW_OHOS_LIVE_WINDOW_LOOKUP_UNAVAILABLE"
+                               : "SNOW_OHOS_LIVE_WINDOW_NOT_SHOWING")
+                       << windowId;
+            return false;
+        }
+        if (!windowBounds(windowId, &bounds))
+            return false;
+        if (!m_pixelmap || m_pixelmapSize != bounds.size()) {
+            m_pixelmap = makePixelMap(bounds.size());
+            m_pixelmapSize = m_pixelmap ? bounds.size() : QSize();
+        }
+        if (!m_pixelmap) {
+            qWarning() << "SNOW_OHOS_LIVE_WINDOW_PIXELMAP_EMPTY" << windowId << bounds;
+            return false;
+        }
+        const int32_t snapshotResult = OH_WindowManager_Snapshot(windowId, m_pixelmap.get());
+        if (snapshotResult != 0) {
+            qWarning() << "SNOW_OHOS_LIVE_WINDOW_SNAPSHOT_FAILED" << windowId << snapshotResult
+                       << bounds;
+            return false;
+        }
+        auto image = readPixelMap(m_pixelmap.get());
+        if (image.isNull()) {
+            qWarning() << "SNOW_OHOS_LIVE_WINDOW_PIXELMAP_READ_FAILED" << windowId << bounds;
+            return false;
+        }
+        frame->pixels = std::make_shared<OhosWindowFrame>(std::move(image));
+        frame->desktopBounds = bounds;
+        frame->duplicate = false;
+        return true;
+    }
+
+    void cancel() override {
+        m_cancelled.store(true);
+    }
+
+  private:
+    LiveWindowTarget m_target;
+    std::atomic<bool> m_cancelled{false};
+    PixelMap m_pixelmap;
+    QSize m_pixelmapSize;
+};
+
+QVector<ohos_live_window_detail::WindowCandidate> candidatesAtDisplay(uint64_t displayId) {
+    WindowManager_Rect* rawLayout = nullptr;
+    size_t layoutSize = 0;
+    const int32_t result = OH_WindowManager_GetAllWindowLayoutInfoList(
+        static_cast<int64_t>(displayId), &rawLayout, &layoutSize);
+    if (result != 0 || !rawLayout) {
+        qWarning() << "SNOW_OHOS_LIVE_WINDOW_LAYOUT_FAILED" << displayId << result << layoutSize;
+        return {};
+    }
+    std::unique_ptr<WindowManager_Rect, decltype(&OH_WindowManager_ReleaseAllWindowLayoutInfoList)>
+        layout(rawLayout, OH_WindowManager_ReleaseAllWindowLayoutInfoList);
+    MainWindowList windows;
+    if (!windows.valid()) {
+        qWarning() << "SNOW_OHOS_LIVE_WINDOW_ENUMERATION_FAILED" << windows.result()
+                   << windows.size();
+        return {};
+    }
+
+    QVector<ohos_live_window_detail::WindowCandidate> candidates;
+    QVector<int32_t> matchedWindowIds;
+    for (size_t index = 0; index < layoutSize; ++index) {
+        const QRect stackedBounds = rect(layout.get()[index]);
+        if (stackedBounds.isEmpty())
+            continue;
+        for (const auto& window : windows) {
+            if (!window.showing || window.displayId != displayId || window.windowId <= 0 ||
+                matchedWindowIds.contains(window.windowId))
+                continue;
+            WindowManager_WindowProperties properties{};
+            if (OH_WindowManager_GetWindowProperties(window.windowId, &properties) != 0 ||
+                !sameRect(rect(properties.windowRect), stackedBounds))
+                continue;
+            const QString title = window.label ? QString::fromUtf8(window.label) : QString();
+            candidates.append(
+                {static_cast<quintptr>(window.windowId), 0, stackedBounds, title, true});
+            matchedWindowIds.append(window.windowId);
+            break;
+        }
+    }
+    return candidates;
+}
+
+} // namespace
+
+std::optional<LiveWindowTarget> liveWindowTargetAtPoint(const QPoint& point,
+                                                        const QVector<quintptr>& excluded) {
+    MainWindowList windows;
+    if (!windows.valid())
+        return std::nullopt;
+    QVector<uint64_t> visitedDisplays;
+    for (const auto& window : windows) {
+        if (!window.showing || window.windowId <= 0 || visitedDisplays.contains(window.displayId))
+            continue;
+        visitedDisplays.append(window.displayId);
+        auto candidates = candidatesAtDisplay(window.displayId);
+        qInfo() << "SNOW_OHOS_LIVE_WINDOW_CANDIDATES" << window.displayId << candidates.size()
+                << "point" << point;
+        if (auto target = ohos_live_window_detail::targetAtPoint(point, excluded, candidates))
+            return target;
+    }
+    qWarning() << "SNOW_OHOS_LIVE_WINDOW_NO_TARGET" << point << excluded;
+    return std::nullopt;
+}
+
+namespace live_window_detail {
+std::unique_ptr<NativeWindowCapture> createNativeWindowCapture(const LiveWindowTarget& target) {
+    if (!target.nativeId ||
+        target.nativeId > static_cast<quintptr>(std::numeric_limits<int32_t>::max()))
+        return {};
+    return std::make_unique<OhosWindowCapture>(target);
+}
+
+std::unique_ptr<NativeWindowMonitor> createNativeWindowMonitor(const LiveWindowTarget& target) {
+    if (!target.nativeId ||
+        target.nativeId > static_cast<quintptr>(std::numeric_limits<int32_t>::max()))
+        return {};
+    return std::make_unique<OhosWindowMonitor>(target);
+}
+
+std::unique_ptr<NativeWindowPresentation> createNativeWindowPresentation(const LiveWindowTarget&) {
+    return {};
+}
+} // namespace live_window_detail
+} // namespace snow_shot::presentation

