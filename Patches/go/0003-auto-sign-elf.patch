+// autoSignOutput signs the output ELF binary using the vendored selfsign
+// implementation (from ohos-bst-light, see cmd/go/internal/selfsign).
+// Only signs executable (ET_EXEC) and shared object (ET_DYN) ELF files,
+// skipping relocatable (ET_REL, i.e. .o) files which would be corrupted by
+// signing. On HarmonyOS, compiled ELF binaries require code signing to execute
+// (noexec filesystem). This is called after the final build-ID write to
+// ensure the signature is not overwritten.
+func autoSignOutput(path string) error {
+	if path == "" {
+		return nil
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return nil
+	}
+	// Read ELF header: magic(4) + class/data/ver/pad(12) + e_type(2) = 18 bytes
+	buf := make([]byte, 18)
+	if _, err := f.Read(buf); err != nil {
+		f.Close()
+		return nil
+	}
+	f.Close()
+	// Check ELF magic
+	if buf[0] != 0x7f || buf[1] != 'E' || buf[2] != 'L' || buf[3] != 'F' {
+		return nil
+	}
+	// Parse e_type at offset 16 (little-endian for both ELF32 and ELF64)
+	eType := int(buf[16]) | int(buf[17])<<8
+	// ET_REL (1) = .o relocatable -> skip (signing would corrupt it)
+	// ET_EXEC (2) = executable -> sign
+	// ET_DYN  (3) = shared object (.so) -> sign
+	if eType != 2 && eType != 3 {
+		return nil
+	}
+	if err := selfsign.SignFileAtomic(path, false); err != nil {
+		log.Printf("warning: selfsign failed: %v", err)
+	}
+	return nil
+}
