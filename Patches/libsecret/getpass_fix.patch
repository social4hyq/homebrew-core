 static SecretValue *
 read_password_tty (void)
 {
@@ -287,6 +326,6 @@
 	gchar *password;
 
-	password = getpass ("Password: ");
+	password = ohos_getpass ("Password: ");
 	return secret_value_new_full (password, -1, "text/plain",
 	                              (GDestroyNotify)secret_password_wipe);
 }
