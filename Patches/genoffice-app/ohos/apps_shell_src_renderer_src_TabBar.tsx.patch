+const WINDOW_CONTROLS_PLATFORM = 'openharmony'
+
+/** Where the platform draws no title bar of its own (OpenHarmony: the window
+ * has no decoration and electron-ohos implements no titleBarOverlay), the tab
+ * strip carries the window's caption buttons at its right end. */
+function WindowControls() {
+  const api = window.aiOfficeWindow
+  if (!api || api.platform !== WINDOW_CONTROLS_PLATFORM) return null
+  return <WindowControlButtons api={api} />
+}
+
+function WindowControlButtons({ api }: { api: WindowApi }) {
+  const { t } = useI18n()
+  const [maximized, setMaximized] = useState(false)
+  useEffect(() => {
+    let live = true
+    void api.isMaximized().then((value) => {
+      if (live) setMaximized(value)
+    })
+    const off = api.onMaximizedChange(setMaximized)
+    return () => {
+      live = false
+      off()
+    }
+  }, [api])
+  return (
+    <div className="window-controls">
+      <button
+        type="button"
+        className="window-control-btn"
+        title={t('windowMinimize')}
+        aria-label={t('windowMinimize')}
+        onClick={() => api.minimize()}
+      >
+        <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
+          <path d="M2 5.5h6" stroke="currentColor" strokeWidth="1" />
+        </svg>
+      </button>
+      <button
+        type="button"
+        className="window-control-btn"
+        title={maximized ? t('windowRestore') : t('windowMaximize')}
+        aria-label={maximized ? t('windowRestore') : t('windowMaximize')}
+        onClick={() => void api.toggleMaximize()}
+      >
+        {maximized ? (
+          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
+            <path d="M3.5 2.5h4v4" fill="none" stroke="currentColor" strokeWidth="1" />
+            <rect x="2.5" y="3.5" width="4" height="4" fill="none" stroke="currentColor" strokeWidth="1" />
+          </svg>
+        ) : (
+          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
+            <rect x="2.5" y="2.5" width="5" height="5" fill="none" stroke="currentColor" strokeWidth="1" />
+          </svg>
+        )}
+      </button>
+      <button
+        type="button"
+        className="window-control-btn window-control-close"
+        title={t('windowClose')}
+        aria-label={t('windowClose')}
+        onClick={() => api.close()}
+      >
+        <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
+          <path d="M2.5 2.5l5 5M7.5 2.5l-5 5" stroke="currentColor" strokeWidth="1" />
+        </svg>
+      </button>
+    </div>
+  )
+}
