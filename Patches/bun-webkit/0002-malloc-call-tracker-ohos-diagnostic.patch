     static uintptr_t avoidRecordingCount()
     {
+        // musl's pthread_getspecific does no bounds check, and
+        // InvalidThreadSpecificKey == PTHREAD_KEYS_MAX reads past the tsd
+        // array — on threads whose TLS block ends near a page boundary that
+        // is a wild read. Treat "key not yet created" as zero instead.
+        if (avoidRecordingCountKey == InvalidThreadSpecificKey)
+            return 0;
         return std::bit_cast<uintptr_t>(threadSpecificGet(avoidRecordingCountKey));
     }
 };
 
+// Diagnostic gate: recording starts only when T35_FASTMALLOC_TRACK is set in
+// the environment, so an instrumented binary still behaves stock (and passes
+// brew's post-install smoke) without it. SIGUSR2 dumps regardless.
+static bool trackingEnabled()
+{
+    static const bool enabled = getenv("T35_FASTMALLOC_TRACK") != nullptr;
+    return enabled;
+}
