     void showRecordingControls() {
+#ifdef Q_OS_HARMONY
+        // A Qt::Tool area cannot take keyboard focus reliably on OHOS. Keep
+        // the area as the capture-friendly tool window and let the focusable
+        // toolbar own the recording shortcuts. Retry after the window is
+        // mapped; the first activateWindow can arrive before the native
+        // surface is ready.
+        toolbarWindow->showAndActivate();
+        QTimer::singleShot(0, toolbarWindow,
+                           [window = QPointer<ScreenRecordingToolbarWindow>(toolbarWindow)]() {
+                               if (window != nullptr && window->isVisible())
+                                   window->showAndActivate();
+                           });
+#else
         toolbarWindow->showWithoutActivating();
         if (!areaWindow->activateInput()) {
             toolbarWindow->showAndActivate();
         }
+#endif
     }
 
