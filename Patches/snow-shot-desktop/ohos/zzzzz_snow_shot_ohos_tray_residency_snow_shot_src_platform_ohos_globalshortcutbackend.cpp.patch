+napi_value registerNativeWindow(napi_env env, napi_callback_info info) {
+    size_t argc = 2;
+    napi_value argv[2] = {nullptr, nullptr};
+    int32_t id = 0;
+    bool present = false;
+    if (napi_get_cb_info(env, info, &argc, argv, nullptr, nullptr) != napi_ok || argc != 2 ||
+        napi_get_value_int32(env, argv[0], &id) != napi_ok || id <= 0 ||
+        napi_get_value_bool(env, argv[1], &present) != napi_ok) {
+        napi_throw_type_error(env, nullptr, "registerNativeWindow expects a positive id and boolean");
+        return nullptr;
+    }
+    platform::ohos::registerOwnedWindow(id, present);
+    napi_value result = nullptr;
+    napi_get_undefined(env, &result);
+    return result;
+}
+
+napi_value getTrayEnabled(napi_env env, napi_callback_info) {
+    napi_value result = nullptr;
+    napi_get_boolean(env, platform::ohos::trayEnabled.load(), &result);
+    return result;
+}
+
+napi_value setTrayAvailable(napi_env env, napi_callback_info info) {
+    size_t argc = 1;
+    napi_value argv[1] = {nullptr};
+    bool available = false;
+    if (napi_get_cb_info(env, info, &argc, argv, nullptr, nullptr) != napi_ok || argc != 1 ||
+        napi_get_value_bool(env, argv[0], &available) != napi_ok) {
+        napi_throw_type_error(env, nullptr, "setTrayAvailable expects a boolean");
+        return nullptr;
+    }
+    platform::ohos::trayAvailable.store(available);
+    napi_value result = nullptr;
+    napi_get_undefined(env, &result);
+    return result;
+}
+
+napi_value quitFromTray(napi_env env, napi_callback_info) {
+    if (auto* app = QCoreApplication::instance())
+        QMetaObject::invokeMethod(app, [] { QCoreApplication::quit(); }, Qt::QueuedConnection);
+    napi_value result = nullptr;
+    napi_get_undefined(env, &result);
+    return result;
+}
+
+napi_value restoreMainWindow(napi_env env, napi_callback_info) {
+    if (auto* app = QCoreApplication::instance()) {
+        QMetaObject::invokeMethod(app, [app] {
+            const auto window = app->property("snowOhosMainWindow").value<QPointer<QObject>>();
+            if (window) {
+                app->setProperty("snowOhosTrayHidden", false);
+                QMetaObject::invokeMethod(window.data(), "showAndActivate", Qt::DirectConnection);
+            }
+        }, Qt::QueuedConnection);
+    }
+    napi_value result = nullptr;
+    napi_get_undefined(env, &result);
+    return result;
+}
+
+napi_value hideMainWindowForHotkey(napi_env env, napi_callback_info) {
+    if (auto* app = QCoreApplication::instance()) {
+        const auto hideWindow = [app] {
+            if (!app->property("snowOhosTrayHidden").toBool())
+                return;
+            const auto window = app->property("snowOhosMainWindow").value<QPointer<QObject>>();
+            if (window)
+                QMetaObject::invokeMethod(window.data(), "hide", Qt::DirectConnection);
+        };
+        const Qt::ConnectionType connection = QThread::currentThread() == app->thread()
+                                                  ? Qt::DirectConnection
+                                                  : Qt::QueuedConnection;
+        if (!QMetaObject::invokeMethod(app, hideWindow, connection))
+            qWarning() << "SNOW_OHOS_HOTKEY_HIDE_DISPATCH_FAILED";
+    }
+    napi_value result = nullptr;
+    napi_get_undefined(env, &result);
+    return result;
+}
