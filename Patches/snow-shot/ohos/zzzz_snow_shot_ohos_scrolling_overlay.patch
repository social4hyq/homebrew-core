+void ScreenshotToolbarWindow::presentForScrollingCapture() {
+    const auto present = [this] {
+        ScreenshotToolPaletteHost* host = paletteHost();
+        if (host == nullptr || host->palette() == nullptr ||
+            !host->palette()->scrollingScreenshotMode()) {
+            return;
+        }
+        show();
+        raise();
+    };
+    present();
+    QTimer::singleShot(kScrollingToolbarRaiseDelayMs, this, present);
+}
