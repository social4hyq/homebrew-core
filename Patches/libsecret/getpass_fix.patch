+/* OpenHarmony's musl doesn't export getpass(), so reimplement the one
+ * legacy BSD call this tool needs on top of termios (disable echo, read
+ * a line, restore echo). */
+static char *
+ohos_getpass (const char *prompt)
+{
+	static char buf[256];
+	struct termios old_term, new_term;
+	int restore = 0;
+	size_t len;
+
+	fputs (prompt, stderr);
+	fflush (stderr);
+
+	if (tcgetattr (STDIN_FILENO, &old_term) == 0) {
+		new_term = old_term;
+		new_term.c_lflag &= ~ECHO;
+		if (tcsetattr (STDIN_FILENO, TCSAFLUSH, &new_term) == 0)
+			restore = 1;
+	}
+
+	if (!fgets (buf, sizeof (buf), stdin))
+		buf[0] = '\0';
+
+	if (restore)
+		tcsetattr (STDIN_FILENO, TCSAFLUSH, &old_term);
+
+	fputc ('\n', stderr);
+
+	len = strlen (buf);
+	if (len > 0 && buf[len - 1] == '\n')
+		buf[len - 1] = '\0';
+
+	return buf;
+}
