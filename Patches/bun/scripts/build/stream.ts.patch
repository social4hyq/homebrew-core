diff --git a/scripts/build/stream.ts b/scripts/build/stream.ts
index ed0c7fbad5..3986b0213f 100644
--- a/scripts/build/stream.ts
+++ b/scripts/build/stream.ts
@@ -253,17 +253,37 @@ function main(): void {
     writeSync(outFd, lead + prefix + text);
   };
 
+  // process.exit() discards whatever is still in the WriteStream's buffer (nested build failures used to look "silent") — poll-drain, bounded, before exiting; the final message above is already synchronous.
+  const exitAfterFlush = (code: number): void => {
+    const writable = out as import("node:stream").Writable;
+    const deadline = Date.now() + 10_000;
+    const tick = (): void => {
+      const pending = writable.writableLength ?? 0;
+      if (pending === 0 || Date.now() > deadline) {
+        process.exit(code);
+      }
+      setTimeout(tick, 25);
+    };
+    tick();
+  };
+
   child.on("error", err => {
     writeFinal(`spawn failed: ${err.message}\n`);
-    process.exit(127);
+    exitAfterFlush(127);
   });
 
   child.on("close", (code, signal) => {
     if (signal) {
       writeFinal(`killed by ${signal}\n`);
-      process.exit(1);
+      exitAfterFlush(1);
+      return;
+    }
+    if (code === 0) {
+      writeStamp();
+    } else {
+      // Sync final line: even if the flush below hits its deadline, the exit status is on record.
+      writeFinal(`exited with code ${code ?? 1}\n`);
     }
-    if (code === 0) writeStamp();
-    process.exit(code ?? 1);
+    exitAfterFlush(code ?? 1);
   });
 }
