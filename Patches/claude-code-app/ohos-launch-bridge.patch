--- /dev/null
+++ b/web_engine/src/main/ets/utils/ClaudeLaunchQueue.ets
@@ -0,0 +1,20 @@
+// Process-local handoff: never persist or log authentication links.
+export class ClaudeLaunchQueue {
+  private static pending: string[] = [];
+
+  static capture(uri: string | undefined): boolean {
+    if (typeof uri !== 'string' || !uri.toLowerCase().startsWith('claude://')) {
+      return false;
+    }
+    if (uri.length <= 8192 && ClaudeLaunchQueue.pending.length < 8) {
+      ClaudeLaunchQueue.pending.push(uri);
+    }
+    return true;
+  }
+
+  static take(): string[] {
+    const result = ClaudeLaunchQueue.pending;
+    ClaudeLaunchQueue.pending = [];
+    return result;
+  }
+}
